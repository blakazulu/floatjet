    {
      title: 'How to Find Reliable WiFi Anywhere',
      excerpt: 'Tips and tools for staying connected no matter where your travels take you.',
      image: '/images/unsplash/photo-1521295121783-8a321d551ad2-1200w.webp',
      slug: 'blog/find-reliable-wifi-anywhere',
      readTime: '6 min read'
    }
  ]
};

const categories = ['saas', 'vpn', 'hosting', 'gear', 'finance', 'travel'];
const categoryNames: Record<string, string> = {
  saas: 'SaaS',
  vpn: 'VPN',
  hosting: 'Hosting',
  gear: 'Gear',
  finance: 'Finance',
  travel: 'Travel'
};
---

<section class="py-4 md:py-6">
  <div class="container mx-auto px-4 md:px-6">
    <!-- Carousel Container -->
    <div class="relative">
      <!-- Left Arrow -->
      <button
          type="button"
          id="carousel-prev"
          class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-2 md:-translate-x-6 z-20 w-12 h-12 md:w-14 md:h-14 flex items-center justify-center rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-white hover:bg-white/20 hover:scale-110 transition-all duration-300 shadow-lg"
          aria-label="Previous article"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"
             aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>

      <!-- Articles Container -->
      <div class="overflow-hidden mx-8 md:mx-16">
        {categories.map((categoryId, catIndex) => (
            <div
                id={`carousel-${categoryId}`}
                data-category={categoryId}
                class:list={[
                  'carousel-panel',
                  catIndex === 0 ? 'block' : 'hidden'
                ]}
                role="tabpanel"
                aria-labelledby={`tab-${categoryId}`}
            >
              <!-- Slides Container -->
              <div class="carousel-slides-container">
                {articlesByCategory[categoryId as keyof typeof articlesByCategory].map((article, index) => {
                  const isFirstVisible = catIndex === 0 && index === 0;
                  return (
                      <article
                          data-index={index}
                          class:list={[
                            'carousel-slide',
                            index === 0 ? 'active' : ''
                          ]}
                      >
                        <a href={`/${article.slug}`} class="block group">
                          <div
                              class="relative rounded-2xl overflow-hidden bg-white/10 backdrop-blur-md border border-white/20 shadow-xl">
                            <!-- Image -->
                            <div
                                class="relative h-64 md:h-96 overflow-hidden bg-gradient-to-br from-ocean-deep/60 via-jet-stream/40 to-sky-light/30">
                              {isFirstVisible ? (
                                  <Image
                                      src={article.image}
                                      alt={article.title}
                                      width={1200}
                                      height={600}
                                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 carousel-image"
                                      loading="eager"
                                      fetchpriority="high"
                                  />
                              ) : (
                                  <Image
                                      src={article.image}
                                      alt={article.title}
                                      width={1200}
                                      height={600}
                                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 carousel-image"
                                      loading="lazy"
                                  />
                              )}
                              <div
                                  class="absolute inset-0 bg-gradient-to-t from-ocean-deep/90 via-ocean-deep/40 to-transparent"></div>
                            </div>

                            <!-- Content Overlay -->
                            <div class="absolute bottom-0 left-0 right-0 p-6 md:p-10">
                        <span
                            class="inline-block px-3 py-1 mb-4 text-xs font-medium bg-jet-stream/90 text-white rounded-full">
                          {categoryNames[categoryId]}
                        </span>
                              <h2 class="text-2xl md:text-4xl font-bold text-white mb-3 leading-tight group-hover:text-sky-light transition-colors">
                                {article.title}
                              </h2>
                              <p class="text-white/80 text-base md:text-lg mb-4 line-clamp-2 max-w-3xl">
                                {article.excerpt}
                              </p>
                              <div class="flex items-center gap-4 text-white/60 text-sm">
                                <span>{article.readTime}</span>
                                <span class="flex items-center gap-1 text-sky-light group-hover:gap-2 transition-all">
                            Read Article
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                                 stroke="currentColor" aria-hidden="true">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                            </svg>
                          </span>
                              </div>
                            </div>
                          </div>
                        </a>
                      </article>
                  );
                })}
              </div>

              <!-- Dots Indicator -->
              <div class="flex justify-center gap-2 mt-6">
                {articlesByCategory[categoryId as keyof typeof articlesByCategory].map((_, index) => (
                    <button
                        type="button"
                        data-slide={index}
                        class:list={[
                          'carousel-dot w-2.5 h-2.5 rounded-full transition-all duration-300',
                          index === 0 ? 'bg-jet-stream w-8' : 'bg-white/30 hover:bg-white/50'
                        ]}
                        aria-label={`Go to slide ${index + 1}`}
                    />
                ))}
              </div>
            </div>
        ))}
      </div>

      <!-- Right Arrow -->
      <button
          type="button"
          id="carousel-next"
          class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-2 md:translate-x-6 z-20 w-12 h-12 md:w-14 md:h-14 flex items-center justify-center rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-white hover:bg-white/20 hover:scale-110 transition-all duration-300 shadow-lg"
          aria-label="Next article"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"
             aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </button>
    </div>

    <!-- More Articles Button -->
    <div class="text-center mt-8">
      <a
          id="more-articles-btn"
          href="/tools/saas"
          class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl bg-white/10 backdrop-blur-md border border-white/20 text-white font-medium hover:bg-jet-stream hover:border-jet-stream hover:shadow-lg transition-all duration-300"
      >
        <span>More articles from</span>
        <span id="selected-category-name" class="font-bold text-sky-light">SaaS</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"
             aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* Carousel image blur placeholder */
  .carousel-image {
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }

  .carousel-image.loaded {
    opacity: 1;
  }

  .carousel-slides-container {
    position: relative;
    overflow: hidden;
  }

  .carousel-slide {
    display: none;
    opacity: 0;
    transform: translateX(0) scale(1);
    filter: blur(0);
    pointer-events: none;
  }

  .carousel-slide.active {
    display: block;
    opacity: 1;
    pointer-events: auto;
    z-index: 2;
  }

  .carousel-slide.animating-out {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }

  .carousel-slide.animating-out.to-left {
    transform: translateX(-30%) scale(0.95);
  }

  .carousel-slide.animating-out.to-right {
    transform: translateX(30%) scale(0.95);
  }

  .carousel-slide.animating-in {
    display: block;
    opacity: 1;
    z-index: 2;
    animation: slideIn 0.5s ease-out forwards;
  }

  .carousel-slide.animating-in.from-right {
    animation-name: slideInFromRight;
  }

  .carousel-slide.animating-in.from-left {
    animation-name: slideInFromLeft;
  }

  @keyframes slideInFromRight {
    from {
      opacity: 0;
      transform: translateX(30%) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
  }

  @keyframes slideInFromLeft {
    from {
      opacity: 0;
      transform: translateX(-30%) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
  }
</style>

<script>
  // Category and carousel state
  let currentCategory = 'saas';
  let currentSlide = 0;
  let previousSlide = 0;
  let slideDirection: 'left' | 'right' = 'right';
  let autoRotateInterval: ReturnType<typeof setInterval> | null = null;
  let isAnimating = false;

  const categoryNames: Record<string, string> = {
    saas: 'SaaS',
    vpn: 'VPN',
    hosting: 'Hosting',
    gear: 'Gear',
    finance: 'Finance',
    travel: 'Travel'
  };

  const categoryUrls: Record<string, string> = {
    saas: '/tools/saas',
    vpn: '/tools/vpn',
    hosting: '/tools/hosting',
    gear: '/gear',
    finance: '/tools/finance',
    travel: '/guides/travel'
  };

  // Initialize carousel
  function initCarousel() {
    // Reset state
    currentCategory = 'saas';
    currentSlide = 0;
    previousSlide = 0;
    isAnimating = false;

    // Clear any existing interval
    if (autoRotateInterval) {
      clearInterval(autoRotateInterval);
      autoRotateInterval = null;
    }

    initializeSlides();
    initCarouselImages();
    setupCategoryTabs();
    setupCarouselNavigation();
    setupDotNavigation();
    startAutoRotate();
  }

  // Initialize carousel image blur placeholders
  function initCarouselImages() {
    const images = document.querySelectorAll('.carousel-image') as NodeListOf<HTMLImageElement>;
    images.forEach(img => {
      if (img.complete && img.naturalHeight !== 0) {
        img.classList.add('loaded');
      } else {
        img.addEventListener('load', () => {
          img.classList.add('loaded');
        }, {once: true});
      }
    });
  }

  // Cleanup function
  function cleanupCarousel() {
    if (autoRotateInterval) {
      clearInterval(autoRotateInterval);
      autoRotateInterval = null;
    }
  }

  // Initialize on first load
  document.addEventListener('DOMContentLoaded', initCarousel);

  // Re-initialize on Astro page navigation (View Transitions)
  document.addEventListener('astro:page-load', initCarousel);

  // Cleanup before navigating away
  document.addEventListener('astro:before-swap', cleanupCarousel);

  function startAutoRotate() {
    if (autoRotateInterval) clearInterval(autoRotateInterval);
    autoRotateInterval = setInterval(() => {
      if (isAnimating) return;
      previousSlide = currentSlide;
      currentSlide = currentSlide === 2 ? 0 : currentSlide + 1;
      slideDirection = 'right';
      animateSlide();
    }, 15000);
  }

  function resetAutoRotate() {
    startAutoRotate();
  }

  function setupCategoryTabs() {
    const tabs = document.querySelectorAll('.category-tab');
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const category = tab.getAttribute('data-category');
        if (category && category !== currentCategory) {
          switchCategory(category);
        }
      });
    });
  }

  function switchCategory(newCategory: string) {
    // Update tabs
    document.querySelectorAll('.category-tab').forEach(tab => {
      const isSelected = tab.getAttribute('data-category') === newCategory;
      tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
      if (isSelected) {
        tab.classList.remove('bg-white/10', 'text-white/80');
        tab.classList.add('bg-jet-stream', 'text-white', 'shadow-lg');
      } else {
        tab.classList.remove('bg-jet-stream', 'shadow-lg');
        tab.classList.add('bg-white/10', 'text-white/80');
      }
    });

    // Hide current panel, show new panel
    document.querySelectorAll('.carousel-panel').forEach(panel => {
      if (panel.getAttribute('data-category') === newCategory) {
        panel.classList.remove('hidden');
        panel.classList.add('block');
      } else {
        panel.classList.remove('block');
        panel.classList.add('hidden');
      }
    });

    // Reset to first slide
    currentCategory = newCategory;
    currentSlide = 0;
    previousSlide = 0;

    // Reset slides in new panel
    const newPanel = document.querySelector(`.carousel-panel[data-category="${newCategory}"]`);
    if (newPanel) {
      newPanel.querySelectorAll('.carousel-slide').forEach((slide, index) => {
        slide.classList.remove('active', 'animating-in', 'animating-out', 'from-left', 'from-right', 'to-left', 'to-right');
        if (index === 0) {
          slide.classList.add('active');
        }
      });
      newPanel.querySelectorAll('.carousel-dot').forEach((dot, index) => {
        if (index === 0) {
          dot.classList.remove('bg-white/30', 'w-2.5');
          dot.classList.add('bg-jet-stream', 'w-8');
        } else {
          dot.classList.remove('bg-jet-stream', 'w-8');
          dot.classList.add('bg-white/30', 'w-2.5');
        }
      });
    }

    updateMoreButton();
    resetAutoRotate();
  }

  function setupCarouselNavigation() {
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');

    prevBtn?.addEventListener('click', () => {
      if (isAnimating) return;
      previousSlide = currentSlide;
      currentSlide = currentSlide === 0 ? 2 : currentSlide - 1;
      slideDirection = 'left';
      animateSlide();
      resetAutoRotate();
    });

    nextBtn?.addEventListener('click', () => {
      if (isAnimating) return;
      previousSlide = currentSlide;
      currentSlide = currentSlide === 2 ? 0 : currentSlide + 1;
      slideDirection = 'right';
      animateSlide();
      resetAutoRotate();
    });
  }

  function setupDotNavigation() {
    document.querySelectorAll('.carousel-dot').forEach(dot => {
      dot.addEventListener('click', () => {
        if (isAnimating) return;
        const slideIndex = parseInt(dot.getAttribute('data-slide') || '0');
        if (slideIndex === currentSlide) return;
        previousSlide = currentSlide;
        slideDirection = slideIndex > currentSlide ? 'right' : 'left';
        currentSlide = slideIndex;
        animateSlide();
        resetAutoRotate();
      });
    });
  }

  function animateSlide() {
    const currentPanel = document.querySelector(`.carousel-panel[data-category="${currentCategory}"]`);
    if (!currentPanel) return;

    isAnimating = true;
    const slides = currentPanel.querySelectorAll('.carousel-slide');
    const exitSlide = slides[previousSlide];
    const enterSlide = slides[currentSlide];

    // Exit animation
    if (exitSlide) {
      exitSlide.classList.remove('active');
      exitSlide.classList.add('animating-out', slideDirection === 'right' ? 'to-left' : 'to-right');
    }

    // Enter animation
    if (enterSlide) {
      enterSlide.classList.add('animating-in', slideDirection === 'right' ? 'from-right' : 'from-left');
    }

    // Update dots
    currentPanel.querySelectorAll('.carousel-dot').forEach((dot, index) => {
      if (index === currentSlide) {
        dot.classList.remove('bg-white/30', 'w-2.5');
        dot.classList.add('bg-jet-stream', 'w-8');
      } else {
        dot.classList.remove('bg-jet-stream', 'w-8');
        dot.classList.add('bg-white/30', 'w-2.5');
      }
    });

    // Clean up after animation
    setTimeout(() => {
      if (exitSlide) {
        exitSlide.classList.remove('animating-out', 'to-left', 'to-right');
      }
      if (enterSlide) {
        enterSlide.classList.remove('animating-in', 'from-left', 'from-right');
        enterSlide.classList.add('active');
      }
      isAnimating = false;
    }, 500);
  }

  function initializeSlides() {
    document.querySelectorAll('.carousel-panel').forEach(panel => {
      panel.querySelectorAll('.carousel-slide').forEach((slide, index) => {
        slide.classList.remove('animating-in', 'animating-out', 'from-left', 'from-right', 'to-left', 'to-right');
        if (index === 0) {
          slide.classList.add('active');
        } else {
          slide.classList.remove('active');
        }
      });
    });
  }

  function updateMoreButton() {
    const btn = document.getElementById('more-articles-btn') as HTMLAnchorElement;
    const categoryNameSpan = document.getElementById('selected-category-name');

    if (btn && categoryNameSpan) {
      btn.href = categoryUrls[currentCategory];
      categoryNameSpan.textContent = categoryNames[currentCategory];
    }
  }
</script>
