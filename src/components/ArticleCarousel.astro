      image: '/images/unsplash/photo-1526374965328-7f61d4dc18c5-1200w.webp',
      slug: 'tools/best-vpn-digital-nomads',
      readTime: '15 min read'
    },
    {
      title: 'VPN Speed Comparison: Which is Fastest?',
      excerpt: 'We tested 15 popular VPNs to find which ones offer the best speeds for streaming and work.',
      image: '/images/unsplash/photo-1558494949-ef010cbdcc31-1200w.webp',
      slug: 'blog/vpn-speed-comparison',
      readTime: '12 min read'
    },
    {
      title: 'How to Choose a VPN for Public WiFi',
      excerpt: 'Stay safe on coffee shop and airport networks with these essential VPN features and recommendations.',
      image: '/images/unsplash/photo-1521791136064-7986c2920216-1200w.webp',
      slug: 'blog/vpn-public-wifi-guide',
      readTime: '5 min read'
    }
  ],
  hosting: [
    {
      title: 'Best Web Hosting for Remote Businesses',
      excerpt: 'Reliable hosting solutions with global reach, excellent uptime, and scalable resources.',
      image: '/images/unsplash/photo-1558494949-ef010cbdcc31-1200w.webp',
      slug: 'tools/best-web-hosting-remote-business',
      readTime: '9 min read'
    },
    {
      title: 'Managed WordPress Hosting Compared',
      excerpt: 'Find the perfect managed hosting for your WordPress site with our detailed comparison.',
      image: '/images/unsplash/photo-1460925895917-afdab827c52f-1200w.webp',
      slug: 'blog/managed-wordpress-hosting-compared',
      readTime: '11 min read'
    },
    {
