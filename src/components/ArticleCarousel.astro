      readTime: '14 min read'
    }
  ],
  travel: [
    {
      title: 'Best Travel Insurance for Remote Workers',
      excerpt: 'Comprehensive coverage designed for long-term travelers and location-independent professionals.',
      image: '/images/unsplash/photo-1488085061387-422e29b40080-1200w.webp',
