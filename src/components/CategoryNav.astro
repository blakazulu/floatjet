---
import {Monitor, Shield, Server, Settings, DollarSign, Globe} from 'lucide-astro';

const categories = [
  {id: 'saas', name: 'SaaS', href: '/tools/saas'},
  {id: 'vpn', name: 'VPN', href: '/tools/vpn'},
  {id: 'hosting', name: 'Hosting', href: '/tools/hosting'},
  {id: 'gear', name: 'Gear', href: '/gear'},
  {id: 'finance', name: 'Finance', href: '/tools/finance'},
  {id: 'travel', name: 'Travel', href: '/guides/travel'},
];
---

<section class="py-12 md:py-16">
  <div class="container mx-auto px-4 md:px-6">
    <!-- Section Header -->
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-10 text-center font-heading">Browse Categories</h2>

    <!-- Categories Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
      {categories.map(cat => (
          <a
              href={cat.href}
              class="flex items-center justify-center gap-3 px-6 py-4 rounded-xl bg-white/10 backdrop-blur-md border border-white/20 shadow-md hover:shadow-xl hover:bg-white/15 hover:-translate-y-1 transition-all duration-300 group"
          >
            {cat.id === 'saas' &&
                <Monitor class="h-6 w-6 text-sky-light group-hover:scale-110 transition-transform" aria-hidden="true"/>}
            {cat.id === 'vpn' &&
                <Shield class="h-6 w-6 text-sky-light group-hover:scale-110 transition-transform" aria-hidden="true"/>}
            {cat.id === 'hosting' &&
                <Server class="h-6 w-6 text-sky-light group-hover:scale-110 transition-transform" aria-hidden="true"/>}
            {cat.id === 'gear' &&
                <Settings class="h-6 w-6 text-sky-light group-hover:scale-110 transition-transform"
                          aria-hidden="true"/>}
            {cat.id === 'finance' &&
                <DollarSign class="h-6 w-6 text-sky-light group-hover:scale-110 transition-transform"
                            aria-hidden="true"/>}
            {cat.id === 'travel' &&
                <Globe class="h-6 w-6 text-sky-light group-hover:scale-110 transition-transform" aria-hidden="true"/>}
            <span class="font-bold text-base md:text-lg text-white">{cat.name}</span>
          </a>
      ))}
    </div>
  </div>
</section>
