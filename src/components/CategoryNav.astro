---
const categories = [
  {
    name: "SaaS",
    icon: "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
    href: "/tools/saas"
  },
  {
    name: "VPN",
    icon: "M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z",
    href: "/tools/vpn"
  },
  {
    name: "Hosting",
    icon: "M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01",
    href: "/tools/hosting"
  },
  {
    name: "Gear",
    icon: "M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01",
    href: "/gear"
  },
  {
    name: "Finance",
    icon: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
    href: "/tools/finance"
  },
  {
    name: "Travel",
    icon: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6",
    href: "/guides/travel"
  },
];
---

<section class="py-12 md:py-16">
  <div class="container mx-auto px-4 md:px-6">
    <!-- Section Header -->
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-10 text-center">Browse Categories</h2>

    <!-- Categories Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
      {categories.map(cat => (
        <a
          href={cat.href}
          class="flex items-center justify-center gap-3 px-6 py-4 rounded-xl bg-white/10 backdrop-blur-md border border-white/20 shadow-md hover:shadow-xl hover:bg-white/15 hover:-translate-y-1 transition-all duration-300 group"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-sky-light group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={cat.icon} />
          </svg>
          <span class="font-bold text-base md:text-lg text-white">{cat.name}</span>
        </a>
      ))}
    </div>
  </div>
</section>
