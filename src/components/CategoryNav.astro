---

const categories = [
  {id: 'saas', name: 'SaaS', href: '/tools/saas'},
  {id: 'vpn', name: 'VPN', href: '/tools/vpn'},
  {id: 'hosting', name: 'Hosting', href: '/tools/hosting'},
  {id: 'gear', name: 'Gear', href: '/gear'},
  {id: 'finance', name: 'Finance', href: '/tools/finance'},
  {id: 'travel', name: 'Travel', href: '/guides/travel'},
];
---

<section class="py-12 md:py-16">
  <div class="container mx-auto px-4 md:px-6">
    <!-- Section Header -->
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-10 text-center font-heading">Browse Categories</h2>

    <!-- Categories Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
      {categories.map(cat => (
          <a
              href={cat.href}
              class="flex items-center justify-center gap-3 px-6 py-4 rounded-xl bg-white/10 backdrop-blur-md border border-white/20 shadow-md hover:shadow-xl hover:bg-white/15 hover:-translate-y-1 transition-all duration-300 group"
          >
            {cat.id === 'saas' &&
                <svg class="h-6 w-6 text-sky-light group-hover:scale-110 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8m-4-4v4"/></svg>}
            {cat.id === 'vpn' &&
                <svg class="h-6 w-6 text-sky-light group-hover:scale-110 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg>}
            {cat.id === 'hosting' &&
                <svg class="h-6 w-6 text-sky-light group-hover:scale-110 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><path d="M6 6h.01M6 18h.01"/></svg>}
            {cat.id === 'gear' &&
                <Settings class="h-6 w-6 text-sky-light group-hover:scale-110 transition-transform"
                          aria-hidden="true"/>}
            {cat.id === 'finance' &&
                <DollarSign class="h-6 w-6 text-sky-light group-hover:scale-110 transition-transform"
                            aria-hidden="true"/>}
            {cat.id === 'travel' &&
                <svg class="h-6 w-6 text-sky-light group-hover:scale-110 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20M2 12h20"/></svg>}
            <span class="font-bold text-base md:text-lg text-white">{cat.name}</span>
          </a>
      ))}
    </div>
  </div>
</section>
