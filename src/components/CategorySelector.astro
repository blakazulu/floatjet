---

const categories = [
  {id: 'saas', name: 'SaaS'},
  {id: 'vpn', name: 'VPN'},
  {id: 'hosting', name: 'Hosting'},
  {id: 'gear', name: 'Gear'},
  {id: 'finance', name: 'Finance'},
  {id: 'travel', name: 'Travel'},
];
---

<section class="pt-6 md:pt-8 pb-2">
  <div class="container mx-auto px-4 md:px-6">
    <!-- Category Tabs - 3x2 grid on mobile/tablet, 6 inline on desktop -->
    <div class="grid grid-cols-3 lg:flex lg:justify-center gap-2 lg:gap-3 max-w-md lg:max-w-none mx-auto" role="tablist"
         aria-label="Article categories">
      {categories.map((cat, index) => (
          <button
              type="button"
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`carousel-${cat.id}`}
              data-category={cat.id}
              class:list={[
                'category-tab flex items-center justify-center gap-1.5 lg:gap-2 px-2 py-2.5 lg:px-5 lg:py-2.5 rounded-xl font-medium text-xs lg:text-sm transition-all duration-300 cursor-pointer',
                index === 0
                  ? 'bg-jet-stream text-white shadow-lg'
                  : 'bg-white/10 backdrop-blur-md border border-white/20 text-white/80 hover:bg-white/20 hover:text-white'
              ]}
          >
            {cat.id === 'saas' &&
                <svg class="h-4 w-4 lg:h-5 lg:w-5 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8m-4-4v4"/></svg>}
            {cat.id === 'vpn' &&
                <svg class="h-4 w-4 lg:h-5 lg:w-5 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg>}
            {cat.id === 'hosting' &&
                <svg class="h-4 w-4 lg:h-5 lg:w-5 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><path d="M6 6h.01M6 18h.01"/></svg>}
            {cat.id === 'gear' &&
                <svg class="h-4 w-4 lg:h-5 lg:w-5 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 1v6m0 6v6m5.2-13.2-4.2 4.2m-3 3-4.2 4.2M23 12h-6m-6 0H5m13.2 5.2-4.2-4.2m-3-3-4.2-4.2"/></svg>}
            {cat.id === 'finance' &&
                <svg class="h-4 w-4 lg:h-5 lg:w-5 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>}
            {cat.id === 'travel' &&
                <svg class="h-4 w-4 lg:h-5 lg:w-5 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20M2 12h20"/></svg>}
            <span>{cat.name}</span>
          </button>
      ))}
    </div>
  </div>
</section>

<style>
  .category-tab[aria-selected="true"] {
    background-color: var(--color-jet-stream);
    color: white;
    box-shadow: 0 10px 15px -3px rgba(56, 163, 165, 0.3);
  }
</style>
