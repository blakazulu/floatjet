---
import {Monitor, Shield, Server, Settings, DollarSign, Globe} from 'lucide-astro';

const categories = [
  {id: 'saas', name: 'SaaS'},
  {id: 'vpn', name: 'VPN'},
  {id: 'hosting', name: 'Hosting'},
  {id: 'gear', name: 'Gear'},
  {id: 'finance', name: 'Finance'},
  {id: 'travel', name: 'Travel'},
];
---

<section class="pt-6 md:pt-8 pb-2">
  <div class="container mx-auto px-4 md:px-6">
    <!-- Category Tabs - 3x2 grid on mobile/tablet, 6 inline on desktop -->
    <div class="grid grid-cols-3 lg:flex lg:justify-center gap-2 lg:gap-3 max-w-md lg:max-w-none mx-auto" role="tablist"
         aria-label="Article categories">
      {categories.map((cat, index) => (
          <button
              type="button"
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`carousel-${cat.id}`}
              data-category={cat.id}
              class:list={[
                'category-tab flex items-center justify-center gap-1.5 lg:gap-2 px-2 py-2.5 lg:px-5 lg:py-2.5 rounded-xl font-medium text-xs lg:text-sm transition-all duration-300 cursor-pointer',
                index === 0
                  ? 'bg-jet-stream text-white shadow-lg'
                  : 'bg-white/10 backdrop-blur-md border border-white/20 text-white/80 hover:bg-white/20 hover:text-white'
              ]}
          >
            {cat.id === 'saas' &&
                <Monitor class="h-4 w-4 lg:h-5 lg:w-5 shrink-0" aria-hidden="true"/>}
            {cat.id === 'vpn' &&
                <Shield class="h-4 w-4 lg:h-5 lg:w-5 shrink-0" aria-hidden="true"/>}
            {cat.id === 'hosting' &&
                <Server class="h-4 w-4 lg:h-5 lg:w-5 shrink-0" aria-hidden="true"/>}
            {cat.id === 'gear' &&
                <Settings class="h-4 w-4 lg:h-5 lg:w-5 shrink-0" aria-hidden="true"/>}
            {cat.id === 'finance' &&
                <DollarSign class="h-4 w-4 lg:h-5 lg:w-5 shrink-0" aria-hidden="true"/>}
            {cat.id === 'travel' &&
                <Globe class="h-4 w-4 lg:h-5 lg:w-5 shrink-0" aria-hidden="true"/>}
            <span>{cat.name}</span>
          </button>
      ))}
    </div>
  </div>
</section>

<style>
  .category-tab[aria-selected="true"] {
    background-color: var(--color-jet-stream);
    color: white;
    box-shadow: 0 10px 15px -3px rgba(56, 163, 165, 0.3);
  }
</style>
