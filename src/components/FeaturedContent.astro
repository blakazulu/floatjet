---
import { Image } from 'astro:assets';

// Placeholder data for now - one article per category
const featuredArticles = [
  {
    title: "Best Project Management Tools",
    excerpt: "Boost productivity and stay organized with these essential SaaS platforms.",
    image: "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=800&q=80",
    slug: "best-project-management-tools",
    category: "SaaS"
  },
  {
    title: "Best VPNs for Digital Nomads",
    excerpt: "Secure your connection anywhere with our top picks for privacy and speed.",
    image: "https://images.unsplash.com/photo-1614064641938-3bbee52942c7?auto=format&fit=crop&w=800&q=80",
    slug: "best-vpns-digital-nomads",
    category: "VPN"
  },
  {
    title: "Best Web Hosting for Remote Businesses",
    excerpt: "Reliable hosting solutions with global reach and excellent uptime guarantees.",
    image: "https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=800&q=80",
    slug: "best-web-hosting-remote-businesses",
    category: "Hosting"
  },
  {
    title: "Ultimate Home Office Setup",
    excerpt: "Must-have gear to upgrade your workspace for maximum comfort and productivity.",
    image: "https://images.unsplash.com/photo-1493934558415-9d19f0b2b4d2?auto=format&fit=crop&w=800&q=80",
    slug: "ultimate-home-office-setup",
    category: "Gear"
  },
  {
    title: "Best Banking for Digital Nomads",
    excerpt: "International banking solutions with low fees and multi-currency support.",
    image: "https://images.unsplash.com/photo-1579621970563-ebec7560ff3e?auto=format&fit=crop&w=800&q=80",
    slug: "best-banking-digital-nomads",
    category: "Finance"
  },
  {
    title: "Top Travel Insurance for Remote Workers",
    excerpt: "Comprehensive coverage designed for long-term travelers and location-independent professionals.",
    image: "https://images.unsplash.com/photo-1488085061387-422e29b40080?auto=format&fit=crop&w=800&q=80",
    slug: "best-travel-insurance-remote-workers",
    category: "Travel"
  }
];
---

<section class="py-12 md:py-20">
  <div class="container mx-auto px-4 md:px-6">
    <!-- Section Header -->
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-10 text-center">Featured Content</h2>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredArticles.map((article, index) => {
        const isAboveFold = index < 3;
        return (
        <article class="group relative rounded-2xl overflow-hidden transition-all duration-300 hover:-translate-y-1">
          <!-- Glass Card Background -->
          <div class="absolute inset-0 bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl shadow-lg group-hover:shadow-2xl group-hover:bg-white/15 transition-all duration-300"></div>

          <a href={`/blog/${article.slug}`} class="relative block h-full z-10 flex flex-col">
            <!-- Card Image -->
            <div class="relative h-48 overflow-hidden rounded-t-2xl">
              {isAboveFold ? (
                <Image
                  src={article.image}
                  alt={article.title}
                  width={800}
                  height={450}
                  class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                  loading="eager"
                />
              ) : (
                <Image
                  src={article.image}
                  alt={article.title}
                  width={800}
                  height={450}
                  class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              )}
            </div>

            <!-- Card Content -->
            <div class="p-6 flex-1 flex flex-col">
              <h3 class="text-xl font-bold text-white mb-3 leading-tight">
                {article.title}
              </h3>
              <p class="text-white/80 mb-6 text-sm leading-relaxed flex-1">
                {article.excerpt}
              </p>

              <!-- CTA -->
              <div class="flex items-center text-sm font-semibold text-sky-light group-hover:text-white transition-colors">
                Read Review
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2 group-hover:translate-x-1 transition-transform" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                </svg>
              </div>
            </div>
          </a>
        </article>
      )})}
    </div>
  </div>
</section>
