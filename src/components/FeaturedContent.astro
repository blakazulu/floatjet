---
import {Image} from 'astro:assets';
import ImageLoader from '@components/ui/ImageLoader.astro';
import {ArrowUpRight} from 'lucide-astro';

// Placeholder data for now - one article per category
const featuredArticles = [
  {
    title: 'Best Project Management Software',
    excerpt: 'Boost productivity and stay organized with these essential SaaS platforms.',
    image: '/images/unsplash/photo-1454165804606-c3d57bc86b40-800w.webp',
    slug: 'tools/best-project-management-software',
    category: 'SaaS'
  },
  {
    title: 'Best VPNs for Digital Nomads',
    excerpt: 'Secure your connection anywhere with our top picks for privacy and speed.',
    image: '/images/unsplash/photo-1526374965328-7f61d4dc18c5-800w.webp',
    slug: 'tools/best-vpn-digital-nomads',
    category: 'VPN'
  },
  {
    title: 'Best Web Hosting for Remote Businesses',
    excerpt: 'Reliable hosting solutions with global reach and excellent uptime guarantees.',
    image: '/images/unsplash/photo-1558494949-ef010cbdcc31-800w.webp',
    slug: 'blog/best-web-hosting-remote-businesses',
    category: 'Hosting'
  },
  {
    title: 'Ultimate Home Office Setup',
    excerpt: 'Must-have gear to upgrade your workspace for maximum comfort and productivity.',
    image: '/images/unsplash/photo-1493934558415-9d19f0b2b4d2-800w.webp',
    slug: 'blog/ultimate-home-office-setup',
    category: 'Gear'
  },
  {
    title: 'Best Banking for Digital Nomads',
    excerpt: 'International banking solutions with low fees and multi-currency support.',
    image: '/images/unsplash/photo-1579621970563-ebec7560ff3e-800w.webp',
    slug: 'blog/best-banking-digital-nomads',
    category: 'Finance'
  },
  {
    title: 'Top Travel Insurance for Remote Workers',
    excerpt: 'Comprehensive coverage designed for long-term travelers and location-independent professionals.',
    image: '/images/unsplash/photo-1488085061387-422e29b40080-800w.webp',
    slug: 'blog/best-travel-insurance-remote-workers',
    category: 'Travel'
  }
];
---

<section class="py-12 md:py-20 relative">
  <!-- Section Background Overlay -->
  <div
      class="absolute inset-0 bg-[linear-gradient(to_bottom,transparent,rgba(15,23,42,0.9)_10%,rgba(15,23,42,0.9)_90%,transparent)] pointer-events-none"></div>

  <div class="container mx-auto px-4 md:px-6 relative z-10">
    <!-- Section Header -->
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-10 text-center">Featured Content</h2>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredArticles.map((article, index) => (
          <article
              class="group relative rounded-3xl overflow-hidden transition-all duration-300 hover:-translate-y-1">
            <!-- Glass Card Background -->
            <div
                class="absolute inset-0 bg-gradient-to-br from-white/25 via-white/5 to-transparent backdrop-blur-lg border border-white/10 border-t-white/30 border-l-white/30 rounded-3xl shadow-lg group-hover:shadow-2xl group-hover:from-white/30 group-hover:via-white/10 group-hover:to-white/5 transition-all duration-300"></div>

            <a href={`/${article.slug}`} class="relative block h-full z-10 flex flex-col p-4">
              <!-- Card Image -->
              <div
                  class="featured-image-container relative h-48 overflow-hidden rounded-2xl mb-5 shadow-md bg-gradient-to-br from-ocean-deep/60 via-jet-stream/40 to-sky-light/30">
                <ImageLoader/>
                <Image
                    src={article.image}
                    alt={article.title}
                    width={800}
                    height={450}
                    class="w-full h-full object-cover transform group-hover:scale-105 transition-all duration-500 ease-in-out blur-placeholder"
                    loading={index < 3 ? 'eager' : 'lazy'}
                />
              </div>

              <!-- Card Content -->
              <div class="flex-1 flex flex-col px-2">
                <h3 class="text-xl font-bold text-white mb-3 leading-tight">
                  {article.title}
                </h3>
                <p class="text-gray-300 mb-6 text-sm leading-relaxed flex-1">
                  {article.excerpt}
                </p>

                <!-- CTA -->
                <div
                    class="flex items-center text-sm font-semibold text-sky-300 group-hover:text-white transition-colors mt-auto">
                  Read Review
                  <ArrowUpRight class="h-3 w-3 ml-1 group-hover:translate-x-1 transition-transform" aria-hidden="true"/>
                </div>
              </div>
            </a>
          </article>
      ))}
    </div>
  </div>
</section>

<style>
  .blur-placeholder {
    position: relative;
    z-index: 2;
    opacity: 0;
  }

  .blur-placeholder.loaded {
    opacity: 1;
  }

  /* Hide loader when image is loaded */
  .featured-image-container:has(.blur-placeholder.loaded) :global(.image-loader) {
    opacity: 0;
  }
</style>

<script>
  // Blur placeholder fade-in effect
  function initBlurPlaceholders() {
    const images = document.querySelectorAll('.blur-placeholder') as NodeListOf<HTMLImageElement>;
    images.forEach(img => {
      if (img.complete && img.naturalHeight !== 0) {
        img.classList.add('loaded');
      } else {
        img.addEventListener('load', () => {
          img.classList.add('loaded');
        }, {once: true});
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initBlurPlaceholders);
  document.addEventListener('astro:page-load', initBlurPlaceholders);
</script>
