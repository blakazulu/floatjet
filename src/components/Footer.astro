---
import {Image} from 'astro:assets';

const currentYear = new Date().getFullYear();
---

<footer class="relative py-16 mt-20" role="contentinfo">
  <div class="container mx-auto px-4 md:px-6">
    <!-- Affiliate Disclosure - Site-wide (FTC Requirement) -->
    <div class="affiliate-disclosure-footer mb-12 p-6 rounded-xl bg-white/5 border border-white/10">
      <div class="flex items-start gap-3">
        <svg class="h-5 w-5 text-jet-stream flex-shrink-0 mt-0.5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/></svg>
        <div>
          <h4 class="text-sm font-semibold text-white mb-1">Affiliate Disclosure</h4>
          <p class="text-sm text-white/70 leading-relaxed">
            FloatJet participates in affiliate programs. We may earn commissions from qualifying purchases made through
            links on this site at no additional cost to you. We only recommend tools we've personally tested and
            genuinely believe will help you work more efficiently.
          </p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      <!-- Brand -->
      <div class="col-span-1 md:col-span-1">
        <a href="/" class="inline-block mb-4 group" aria-label="FloatJet Home">
          <Image src="/images/logo.webp" alt="FloatJet" width={80} height={32}
                 class="h-8 w-auto object-contain group-hover:scale-110 transition-transform brightness-0 invert" loading="lazy"/>
        </a>
        <p class="text-white/70 text-sm leading-relaxed">
          Empowering digital nomads and remote professionals with the best tools and resources for a
          location-independent lifestyle.
        </p>
      </div>

      <!-- Links Column 1 -->
      <div>
        <h4 class="font-bold text-white mb-4">Explore</h4>
        <ul class="space-y-2 text-sm text-white/70">
          <li><a href="/tools" class="hover:text-sky-light transition-colors">Software Tools</a></li>
          <li><a href="/gear" class="hover:text-sky-light transition-colors">Office Gear</a></li>
          <li><a href="/guides" class="hover:text-sky-light transition-colors">Remote Guides</a></li>
          <li><a href="/deals" class="hover:text-sky-light transition-colors">Exclusive Deals</a></li>
        </ul>
      </div>

      <!-- Links Column 2 -->
      <div>
        <h4 class="font-bold text-white mb-4">Company</h4>
        <ul class="space-y-2 text-sm text-white/70">
          <li><a href="/about" class="hover:text-sky-light transition-colors">About Us</a></li>
          <li><a href="/contact" class="hover:text-sky-light transition-colors">Contact</a></li>
          <li><a href="/privacy" class="hover:text-sky-light transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-sky-light transition-colors">Terms of Service</a></li>
          <li><a href="/sitemap-visual" class="hover:text-sky-light transition-colors">Site Map</a></li>
        </ul>
      </div>

      <!-- Social -->
      <div>
        <h4 class="font-bold text-white mb-4">Connect</h4>
        <div class="flex gap-4">
          <a href="https://x.com/FloatJetWebsite" class="text-white/60 hover:text-sky-light transition-colors"
             aria-label="Follow us on X (Twitter)" target="_blank" rel="noopener noreferrer">
            <span class="sr-only">X (Twitter)</span>
            <svg class="h-6 w-6" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://www.linkedin.com/company/110340950" class="text-white/60 hover:text-sky-light transition-colors"
             aria-label="Follow us on LinkedIn" target="_blank" rel="noopener noreferrer">
            <span class="sr-only">LinkedIn</span>
            <svg class="h-6 w-6" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://www.pinterest.com/floatjet" class="text-white/60 hover:text-sky-light transition-colors"
             aria-label="Follow us on Pinterest" target="_blank" rel="noopener noreferrer">
            <span class="sr-only">Pinterest</span>
            <svg class="h-6 w-6" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0a12 12 0 0 0-4.37 23.17c-.1-.9-.19-2.27.04-3.25l1.39-5.88s-.35-.71-.35-1.76c0-1.65.96-2.89 2.15-2.89 1.01 0 1.5.76 1.5 1.67 0 1.02-.65 2.54-.98 3.95-.28 1.18.59 2.14 1.75 2.14 2.1 0 3.72-2.21 3.72-5.41 0-2.83-2.03-4.81-4.93-4.81-3.36 0-5.33 2.52-5.33 5.12 0 1.02.39 2.11.88 2.7.1.12.11.22.08.34l-.33 1.36c-.05.22-.18.27-.42.16-1.48-.69-2.4-2.86-2.4-4.6 0-3.75 2.73-7.19 7.86-7.19 4.13 0 7.34 2.94 7.34 6.87 0 4.1-2.59 7.4-6.18 7.4-1.21 0-2.35-.63-2.74-1.37l-.75 2.85c-.27 1.04-1 2.35-1.49 3.15A12 12 0 1 0 12 0z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-white/50 text-sm">
        &copy; {currentYear} FloatJet. All rights reserved.
      </p>
      <p class="text-white/40 text-xs">
        Designed for the future of remote work.
      </p>
    </div>
  </div>
</footer>
