---
const currentYear = new Date().getFullYear();

const exploreLinks = [
  { label: "Software Tools", href: "/tools/" },
  { label: "Office Gear", href: "/gear/" },
  { label: "Remote Guides", href: "/guides/" },
  { label: "Blog", href: "/blog/" },
  { label: "Exclusive Deals", href: "/deals/" },
];

const companyLinks = [
  { label: "About Us", href: "/about/" },
  { label: "Our Team", href: "/team/" },
  { label: "Contact", href: "/contact/" },
  { label: "Developers & API", href: "/developers/" },
];

const legalLinks = [
  { label: "Privacy Policy", href: "/privacy/" },
  { label: "Terms of Service", href: "/terms/" },
  { label: "Site Map", href: "/sitemap-visual/" },
];

const socialLinks = [
  {
    label: "Follow us on X (Twitter)",
    href: "https://x.com/FloatJetWebsite",
    path: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z",
  },
  {
    label: "Follow us on LinkedIn",
    href: "https://www.linkedin.com/company/110340950",
    path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  },
  {
    label: "Follow us on Pinterest",
    href: "https://www.pinterest.com/floatjet",
    path: "M12 0a12 12 0 0 0-4.37 23.17c-.1-.9-.19-2.27.04-3.25l1.39-5.88s-.35-.71-.35-1.76c0-1.65.96-2.89 2.15-2.89 1.01 0 1.5.76 1.5 1.67 0 1.02-.65 2.54-.98 3.95-.28 1.18.59 2.14 1.75 2.14 2.1 0 3.72-2.21 3.72-5.41 0-2.83-2.03-4.81-4.93-4.81-3.36 0-5.33 2.52-5.33 5.12 0 1.02.39 2.11.88 2.7.1.12.11.22.08.34l-.33 1.36c-.05.22-.18.27-.42.16-1.48-.69-2.4-2.86-2.4-4.6 0-3.75 2.73-7.19 7.86-7.19 4.13 0 7.34 2.94 7.34 6.87 0 4.1-2.59 7.4-6.18 7.4-1.21 0-2.35-.63-2.74-1.37l-.75 2.85c-.27 1.04-1 2.35-1.49 3.15A12 12 0 1 0 12 0z",
  },
];
---

<!-- Postcard footer -->
<footer class="relative mt-24 px-3 md:px-6 pb-4 md:pb-8" role="contentinfo">
  <div class="max-w-7xl mx-auto bg-card border-[1.5px] border-ink rounded-[26px] md:rounded-[32px] shadow-[4px_5px_0_0_var(--color-ink)] px-6 pt-8 pb-6 md:px-12 md:pt-12 md:pb-7">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8">
      <!-- Message side of the postcard -->
      <div class="lg:col-span-5 lg:pr-10 lg:border-r-[1.5px] lg:border-dashed lg:border-[#C9C1B1] flex flex-col gap-4">
        <a href="/" class="font-display font-bold text-3xl md:text-[34px] tracking-[-0.03em] text-ink w-fit hover:text-ocean-deep transition-colors" aria-label="FloatJet home">floatjet</a>
        <p class="text-[17px] leading-relaxed text-ink-soft max-w-md">
          Tools and gear for people whose office is wherever the wifi is.
        </p>
        <p class="affiliate-disclosure-footer text-sm leading-relaxed text-ink-soft max-w-md">
          <strong class="text-ink">Affiliate disclosure:</strong> FloatJet participates in affiliate programs. We may
          earn commissions from qualifying purchases made through links on this site at no additional cost to you. We
          only recommend tools we've personally tested and genuinely believe will help you work more efficiently.
        </p>
        <p class="hand text-2xl text-teal-ink">see you on the road</p>
      </div>

      <!-- Address side: links -->
      <div class="lg:col-span-7 grid grid-cols-2 md:grid-cols-3 gap-8">
        <div>
          <h2 class="font-display font-bold text-lg text-ink mb-3">Explore</h2>
          <ul class="text-[15px]">
            {exploreLinks.map((link) => (
              <li><a href={link.href} class="inline-flex items-center min-h-12 text-ink hover:text-teal-ink hover:underline underline-offset-4 decoration-2 transition-colors">{link.label}</a></li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="font-display font-bold text-lg text-ink mb-3">Company</h2>
          <ul class="text-[15px]">
            {companyLinks.map((link) => (
              <li><a href={link.href} class="inline-flex items-center min-h-12 text-ink hover:text-teal-ink hover:underline underline-offset-4 decoration-2 transition-colors">{link.label}</a></li>
            ))}
          </ul>
        </div>

        <div class="col-span-2 md:col-span-1 flex md:flex-col md:items-end justify-between gap-5">
          <!-- Stamp -->
          <div class="w-[84px] h-[100px] shrink-0 border-[3px] border-dashed border-coral rounded-sm flex items-center justify-center font-display font-bold text-xl text-ink" aria-hidden="true">
            FJ
          </div>
          <div class="flex gap-2 self-end md:self-auto">
            {socialLinks.map((social) => (
              <a
                href={social.href}
                class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-ink text-sun hover:bg-ocean-deep transition-colors"
                aria-label={social.label}
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg class="h-5 w-5" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d={social.path}/></svg>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="mt-10 pt-5 border-t border-[#E0DACB] flex flex-col md:flex-row md:items-center justify-between gap-3 text-sm text-ink-soft">
      <p>&copy; {currentYear} FloatJet. All rights reserved.</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-1">
        {legalLinks.map((link) => (
          <li><a href={link.href} class="inline-flex items-center min-h-12 text-ink-soft hover:text-ink hover:underline underline-offset-4 transition-colors">{link.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>
