---
const currentYear = new Date().getFullYear();

const exploreLinks = [
  { label: "Software Tools", href: "/tools/" },
  { label: "Office Gear", href: "/gear/" },
  { label: "Remote Guides", href: "/guides/" },
  { label: "Blog", href: "/blog/" },
  { label: "Exclusive Deals", href: "/deals/" },
];

const companyLinks = [
  { label: "About Us", href: "/about/" },
  { label: "Our Team", href: "/team/" },
  { label: "Contact", href: "/contact/" },
  { label: "Privacy Policy", href: "/privacy/" },
  { label: "Terms of Service", href: "/terms/" },
  { label: "Site Map", href: "/sitemap-visual/" },
  { label: "Developers & API", href: "/developers/" },
];
---

<footer class="relative mt-24 px-3 md:px-6 pb-3 md:pb-6" role="contentinfo">
  <div class="relative max-w-7xl mx-auto bg-ink text-sand rounded-[32px] md:rounded-[48px] px-6 py-12 md:px-14 md:py-16 overflow-hidden">
    <!-- Top row: tagline + suggest a tool -->
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8 pb-10 border-b-2 border-sand/15">
      <div class="max-w-xl">
        <a href="/" class="font-display font-black text-3xl md:text-4xl text-sand hover:text-sun transition-colors" aria-label="FloatJet home">floatjet</a>
        <p class="font-display font-bold text-2xl md:text-3xl leading-tight mt-5 text-sand">
          Tools and gear for people whose office is wherever the wifi is.
        </p>
        <p class="hand text-2xl md:text-3xl text-sun mt-3 -rotate-2 w-fit">tested, not copy-pasted</p>
      </div>
      <a href="/contact/" class="btn-pill btn-sun self-start lg:self-auto">
        Suggest a tool to test
        <svg class="h-4 w-4" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
      </a>
    </div>

    <!-- Link columns -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10 py-10">
      <div>
        <h2 class="font-display text-sm font-bold uppercase tracking-wider text-sun mb-4">Explore</h2>
        <ul class="space-y-1 text-[15px]">
          {exploreLinks.map((link) => (
            <li><a href={link.href} class="inline-block py-1.5 text-sand/90 hover:text-sun transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="font-display text-sm font-bold uppercase tracking-wider text-sun mb-4">Company</h2>
        <ul class="space-y-1 text-[15px]">
          {companyLinks.map((link) => (
            <li><a href={link.href} class="inline-block py-1.5 text-sand/90 hover:text-sun transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="col-span-2">
        <h2 class="font-display text-sm font-bold uppercase tracking-wider text-sun mb-4">Affiliate disclosure</h2>
        <div class="affiliate-disclosure-footer bg-sun text-ink rounded-2xl p-5 md:-rotate-1 shadow-[6px_8px_0_0_var(--color-jet-stream)]">
          <p class="text-sm leading-relaxed">
            FloatJet participates in affiliate programs. We may earn commissions from qualifying purchases made through
            links on this site at no additional cost to you. We only recommend tools we've personally tested and
            genuinely believe will help you work more efficiently.
          </p>
        </div>

        <h2 class="font-display text-sm font-bold uppercase tracking-wider text-sun mt-8 mb-4">Connect</h2>
        <div class="flex gap-3">
          <a href="https://x.com/FloatJetWebsite" class="inline-flex items-center justify-center w-12 h-12 rounded-full border-2 border-sand/30 text-sand hover:bg-sun hover:text-ink hover:border-sun transition-colors"
             aria-label="Follow us on X (Twitter)" target="_blank" rel="noopener noreferrer">
            <svg class="h-5 w-5" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://www.linkedin.com/company/110340950" class="inline-flex items-center justify-center w-12 h-12 rounded-full border-2 border-sand/30 text-sand hover:bg-sun hover:text-ink hover:border-sun transition-colors"
             aria-label="Follow us on LinkedIn" target="_blank" rel="noopener noreferrer">
            <svg class="h-5 w-5" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://www.pinterest.com/floatjet" class="inline-flex items-center justify-center w-12 h-12 rounded-full border-2 border-sand/30 text-sand hover:bg-sun hover:text-ink hover:border-sun transition-colors"
             aria-label="Follow us on Pinterest" target="_blank" rel="noopener noreferrer">
            <svg class="h-5 w-5" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0a12 12 0 0 0-4.37 23.17c-.1-.9-.19-2.27.04-3.25l1.39-5.88s-.35-.71-.35-1.76c0-1.65.96-2.89 2.15-2.89 1.01 0 1.5.76 1.5 1.67 0 1.02-.65 2.54-.98 3.95-.28 1.18.59 2.14 1.75 2.14 2.1 0 3.72-2.21 3.72-5.41 0-2.83-2.03-4.81-4.93-4.81-3.36 0-5.33 2.52-5.33 5.12 0 1.02.39 2.11.88 2.7.1.12.11.22.08.34l-.33 1.36c-.05.22-.18.27-.42.16-1.48-.69-2.4-2.86-2.4-4.6 0-3.75 2.73-7.19 7.86-7.19 4.13 0 7.34 2.94 7.34 6.87 0 4.1-2.59 7.4-6.18 7.4-1.21 0-2.35-.63-2.74-1.37l-.75 2.85c-.27 1.04-1 2.35-1.49 3.15A12 12 0 1 0 12 0z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="pt-8 border-t-2 border-sand/15 flex flex-col md:flex-row justify-between items-start md:items-center gap-3 text-sm text-sand/75">
      <p>&copy; {currentYear} FloatJet. All rights reserved.</p>
      <p>Built for the future of remote work.</p>
    </div>
  </div>
</footer>
