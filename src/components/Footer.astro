---
import {Image} from 'astro:assets';

const currentYear = new Date().getFullYear();
---

<footer class="relative py-16 mt-20" role="contentinfo">
  <div class="container mx-auto px-4 md:px-6">
    <!-- Affiliate Disclosure - Site-wide (FTC Requirement) -->
    <div class="affiliate-disclosure-footer mb-12 p-6 rounded-xl bg-white/5 border border-white/10">
      <div class="flex items-start gap-3">
        <svg class="h-5 w-5 text-jet-stream flex-shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"
             fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd"
                d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
                clip-rule="evenodd"/>
        </svg>
        <div>
          <h4 class="text-sm font-semibold text-white mb-1">Affiliate Disclosure</h4>
          <p class="text-sm text-white/70 leading-relaxed">
            FloatJet participates in affiliate programs. We may earn commissions from qualifying purchases made through
            links on this site at no additional cost to you. We only recommend tools we've personally tested and
            genuinely believe will help you work more efficiently.
          </p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      <!-- Brand -->
      <div class="col-span-1 md:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-4 group">
          <Image src="/images/logo.webp" alt="FloatJet Logo" width={32} height={32}
                 class="h-8 w-8 object-contain group-hover:scale-110 transition-transform" loading="lazy"/>
          <span class="font-bold text-xl text-white">FloatJet</span>
        </a>
        <p class="text-white/70 text-sm leading-relaxed">
          Empowering digital nomads and remote professionals with the best tools and resources for a
          location-independent lifestyle.
        </p>
      </div>

      <!-- Links Column 1 -->
      <div>
        <h4 class="font-bold text-white mb-4">Explore</h4>
        <ul class="space-y-2 text-sm text-white/70">
          <li><a href="/tools" class="hover:text-sky-light transition-colors">Software Tools</a></li>
          <li><a href="/gear" class="hover:text-sky-light transition-colors">Office Gear</a></li>
          <li><a href="/guides" class="hover:text-sky-light transition-colors">Remote Guides</a></li>
          <li><a href="/deals" class="hover:text-sky-light transition-colors">Exclusive Deals</a></li>
        </ul>
      </div>

      <!-- Links Column 2 -->
      <div>
        <h4 class="font-bold text-white mb-4">Company</h4>
        <ul class="space-y-2 text-sm text-white/70">
          <li><a href="/about" class="hover:text-sky-light transition-colors">About Us</a></li>
          <li><a href="/contact" class="hover:text-sky-light transition-colors">Contact</a></li>
          <li><a href="/privacy" class="hover:text-sky-light transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-sky-light transition-colors">Terms of Service</a></li>
          <li><a href="/sitemap-visual" class="hover:text-sky-light transition-colors">Site Map</a></li>
        </ul>
      </div>

      <!-- Social -->
      <div>
        <h4 class="font-bold text-white mb-4">Connect</h4>
        <div class="flex gap-4">
          <a href="https://twitter.com/floatjet" class="text-white/60 hover:text-sky-light transition-colors"
             aria-label="Follow us on Twitter">
            <span class="sr-only">Twitter</span>
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path
                  d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"/>
            </svg>
          </a>
          <a href="https://www.pinterest.com/floatjet" class="text-white/60 hover:text-sky-light transition-colors"
             aria-label="Follow us on Pinterest">
            <span class="sr-only">Pinterest</span>
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path
                  d="M12 0a12 12 0 0 0-4.37 23.17c-.1-.9-.19-2.27.04-3.25l1.39-5.88s-.35-.71-.35-1.76c0-1.65.96-2.89 2.15-2.89 1.01 0 1.5.76 1.5 1.67 0 1.02-.65 2.54-.98 3.95-.28 1.18.59 2.14 1.75 2.14 2.1 0 3.72-2.21 3.72-5.41 0-2.83-2.03-4.81-4.93-4.81-3.36 0-5.33 2.52-5.33 5.12 0 1.02.39 2.11.88 2.7.1.12.11.22.08.34l-.33 1.36c-.05.22-.18.27-.42.16-1.48-.69-2.4-2.86-2.4-4.6 0-3.75 2.73-7.19 7.86-7.19 4.13 0 7.34 2.94 7.34 6.87 0 4.1-2.59 7.4-6.18 7.4-1.21 0-2.35-.63-2.74-1.37l-.75 2.85c-.27 1.04-1 2.35-1.49 3.15A12 12 0 1 0 12 0z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-white/50 text-sm">
        &copy; {currentYear} FloatJet. All rights reserved.
      </p>
      <p class="text-white/40 text-xs">
        Designed for the future of remote work.
      </p>
    </div>
  </div>
</footer>
