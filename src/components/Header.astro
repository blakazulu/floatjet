---
const navItems = [
  { name: "Tools", href: "/tools/" },
  { name: "Gear", href: "/gear/" },
  { name: "Guides", href: "/guides/" },
  { name: "Blog", href: "/blog/" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  currentPath === href || (href !== "/" && currentPath.startsWith(href.endsWith("/") ? href : href + "/"));
---

<header class="site-header fixed top-0 left-0 right-0 z-50 bg-paper/95 backdrop-blur-sm border-b-2 border-ink">
  <div class="mx-auto max-w-7xl px-4 md:px-6 h-16 md:h-20 flex items-center justify-between gap-4">
    <!-- Wordmark -->
    <a
      href="/"
      id="logo-link"
      class="font-display font-black text-2xl md:text-[28px] tracking-tight text-ink leading-none hover:text-ocean-deep transition-colors"
      aria-label="FloatJet home"
    >
      floatjet
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-1 bg-ink p-1.5 rounded-full" aria-label="Main navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="nav-link px-5 py-2.5 rounded-full text-[15px] font-bold text-sand hover:bg-ocean-deep transition-colors aria-[current=page]:bg-sun aria-[current=page]:text-ink"
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.name}
        </a>
      ))}
    </nav>

    <!-- Utilities -->
    <div class="flex items-center gap-2 md:gap-3">
      <button
        data-search-trigger
        type="button"
        class="hidden md:inline-flex items-center gap-2 h-12 px-4 rounded-full border-2 border-ink text-ink font-semibold text-sm hover:bg-ink hover:text-paper transition-colors cursor-pointer"
        aria-label="Search (Ctrl+K)"
      >
        <svg class="h-4 w-4" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
        </svg>
        <span>Search</span>
      </button>

      <a
        href="/deals/"
        class="hidden md:inline-flex btn-pill btn-sun !min-h-12 !py-2 !px-5 text-sm aria-[current=page]:!bg-coral"
        aria-current={isActive("/deals/") ? "page" : undefined}
      >
        Deals
      </a>

      <!-- Mobile: search -->
      <button
        data-search-trigger
        type="button"
        class="md:hidden inline-flex items-center justify-center w-12 h-12 rounded-full border-2 border-ink text-ink cursor-pointer"
        aria-label="Search"
      >
        <svg class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
        </svg>
      </button>

      <!-- Mobile: menu -->
      <button
        id="mobile-menu-button"
        type="button"
        class="md:hidden inline-flex items-center gap-2 h-12 px-4 rounded-full bg-ink text-sun font-display font-bold text-sm"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="menu-icon h-4 w-4" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path d="M4 8h16M4 16h16"></path>
        </svg>
        <svg class="close-icon h-4 w-4 hidden" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
        <span>Menu</span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  // Header with proper deduplication for View Transitions (header is transition:persist, so refresh aria-current)

  if (!window.__headerInit) {
    window.__headerInit = true;

    function headerIsActive(href) {
      var currentPath = window.location.pathname;
      if (href === '/') {
        return currentPath === '/';
      }
      return currentPath === href || currentPath.startsWith(href.charAt(href.length - 1) === '/' ? href : href + '/');
    }

    function updateActiveNav() {
      var links = document.querySelectorAll('.site-header nav[aria-label="Main navigation"] a, .site-header a[href="/deals/"]');
      links.forEach(function(link) {
        var href = link.getAttribute('href');
        if (!href) return;
        if (headerIsActive(href)) {
          link.setAttribute('aria-current', 'page');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    }

    // Prevent navigation when clicking on the active link
    function preventActiveNavigation(e) {
      var href = e.currentTarget.getAttribute('href');
      if (href && headerIsActive(href)) {
        e.preventDefault();
        e.stopPropagation();
      }
    }

    function attachNavClickHandlers() {
      var navLinks = document.querySelectorAll('.site-header nav[aria-label="Main navigation"] a');
      navLinks.forEach(function(link) {
        link.addEventListener('click', preventActiveNavigation);
      });

      var logoLink = document.getElementById('logo-link');
      if (logoLink) {
        logoLink.addEventListener('click', preventActiveNavigation);
      }
    }

    function initHeader() {
      updateActiveNav();
      attachNavClickHandlers();
    }

    document.addEventListener('astro:page-load', initHeader);
  }
</script>
