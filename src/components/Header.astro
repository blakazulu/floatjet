---
import {Image} from 'astro:assets';
import {Search, Menu, X, Home, Monitor, Settings, BookOpen, Newspaper, Info, Mail} from 'lucide-astro';

const navItems = [
  {name: 'Tools', href: '/tools'},
  {name: 'Gear', href: '/gear'},
  {name: 'Guides', href: '/guides'},
  {name: 'Blog', href: '/blog'},
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || currentPath.startsWith(href + '/');
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="mx-auto px-4 md:px-6 py-4">
    <div
        class="bg-ocean-deep/90 backdrop-blur-md border border-white/20 rounded-2xl shadow-lg px-6 py-3 flex items-center justify-between max-w-6xl mx-auto">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <Image src="/images/logo.webp" alt="FloatJet Logo" width={40} height={40}
               class="h-10 object-contain group-hover:scale-110 transition-transform" loading="eager"/>
        <span class="text-xl font-bold text-white tracking-wide">FloatJet</span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-8" aria-label="Main navigation">
        {navItems.map(item => (
            <a
                href={item.href}
                class:list={[
                  'text-sm font-medium transition-colors',
                  isActive(item.href) ? 'text-sky-light' : 'text-white/90 hover:text-white'
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.name}
            </a>
        ))}
      </nav>

      <!-- Utility Icons -->
      <div class="flex items-center gap-3">
        <!-- Search Icon -->
        <button
            data-search-trigger
            class="hidden md:flex items-center gap-2 text-white/90 hover:text-white transition-colors group cursor-pointer"
            aria-label="Search (Ctrl+K)"
        >
          <Search class="h-5 w-5" aria-hidden="true"/>
          <span class="text-sm">Search</span>
        </button>

        <!-- Mobile Menu Button -->
        <button
            id="mobile-menu-button"
            class="md:hidden text-white p-1"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
        >
          <Menu class="menu-icon h-6 w-6" aria-hidden="true"/>
          <X class="close-icon h-6 w-6 hidden" aria-hidden="true"/>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Menu Overlay - z-[100] to cover everything -->
<div
    id="mobile-menu-overlay"
    class="fixed inset-0 bg-black/70 backdrop-blur-md z-[100] hidden opacity-0 transition-opacity duration-300"
    aria-hidden="true"
></div>

<!-- Mobile Menu Panel - darker color to differentiate from navbar -->
<nav
    id="mobile-menu"
    class="fixed top-0 right-0 h-full w-80 max-w-[85vw] bg-[#0a2a33] border-l border-white/10 z-[110] transform translate-x-full transition-transform duration-300 ease-out shadow-2xl"
    aria-label="Mobile navigation"
    aria-hidden="true"
>
  <div class="flex flex-col h-full">
    <!-- Menu Header -->
    <div class="flex items-center justify-between px-6 py-5 border-b border-white/10">
      <span class="text-lg font-bold text-white">Menu</span>
      <button
          id="mobile-menu-close"
          class="text-white/80 hover:text-white p-1 transition-colors"
          aria-label="Close menu"
      >
        <X class="h-6 w-6" aria-hidden="true"/>
      </button>
    </div>

    <!-- Menu Links -->
    <div class="flex-1 overflow-y-auto py-4">
      <ul class="space-y-1 px-4">
        <li>
          <a href="/"
             class:list={[
               'mobile-menu-link flex items-center gap-3 px-4 py-3 rounded-xl transition-all',
               currentPath === '/' ? 'text-sky-light bg-white/10' : 'text-white/90 hover:text-white hover:bg-white/10'
             ]}
             aria-current={currentPath === '/' ? 'page' : undefined}>
            <Home class="h-5 w-5" aria-hidden="true"/>
            <span class="font-medium">Home</span>
          </a>
        </li>
        {navItems.map(item => (
            <li>
              <a href={item.href}
                 class:list={[
                   'mobile-menu-link flex items-center gap-3 px-4 py-3 rounded-xl transition-all',
                   isActive(item.href) ? 'text-sky-light bg-white/10' : 'text-white/90 hover:text-white hover:bg-white/10'
                 ]}
                 aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.name === 'Tools' &&
                    <Monitor class="h-5 w-5" aria-hidden="true"/>}
                {item.name === 'Gear' &&
                    <Settings class="h-5 w-5" aria-hidden="true"/>}
                {item.name === 'Guides' &&
                    <BookOpen class="h-5 w-5" aria-hidden="true"/>}
                {item.name === 'Blog' &&
                    <Newspaper class="h-5 w-5" aria-hidden="true"/>}
                <span class="font-medium">{item.name}</span>
              </a>
            </li>
        ))}
      </ul>

      <!-- Search Button (Mobile) -->
      <div class="px-4 mt-2">
        <button
            data-search-trigger
            class="w-full flex items-center gap-3 px-4 py-3 rounded-xl bg-white/10 text-white/90 hover:text-white hover:bg-white/20 transition-all cursor-pointer"
        >
          <Search class="h-5 w-5" aria-hidden="true"/>
          <span class="font-medium">Search articles...</span>
        </button>
      </div>

      <!-- Divider -->
      <div class="my-4 mx-4 border-t border-white/10"></div>

      <!-- Secondary Links -->
      <ul class="space-y-1 px-4">
        <li>
          <a href="/about"
             class="mobile-menu-link flex items-center gap-3 px-4 py-3 rounded-xl text-white/70 hover:text-white hover:bg-white/10 transition-all">
            <Info class="h-5 w-5" aria-hidden="true"/>
            <span>About</span>
          </a>
        </li>
        <li>
          <a href="/contact"
             class="mobile-menu-link flex items-center gap-3 px-4 py-3 rounded-xl text-white/70 hover:text-white hover:bg-white/10 transition-all">
            <Mail class="h-5 w-5" aria-hidden="true"/>
            <span>Contact</span>
          </a>
        </li>
      </ul>
    </div>

    <!-- Menu Footer -->
    <div class="px-6 py-4 border-t border-white/10">
      <p class="text-xs text-white/50 text-center">
        &copy; 2025 FloatJet
      </p>
    </div>
  </div>
</nav>

<script>
  function updateActiveNav() {
    const currentPath = window.location.pathname;
    const isActive = (href: string) => currentPath === href || currentPath.startsWith(href + '/');

    // Desktop nav links
    const desktopLinks = document.querySelectorAll('nav[aria-label="Main navigation"] a');
    desktopLinks.forEach(link => {
      const href = link.getAttribute('href');
      if (href) {
        if (isActive(href)) {
          link.classList.remove('text-white/90', 'hover:text-white');
          link.classList.add('text-sky-light');
          link.setAttribute('aria-current', 'page');
        } else {
          link.classList.remove('text-sky-light');
          link.classList.add('text-white/90', 'hover:text-white');
          link.removeAttribute('aria-current');
        }
      }
    });

    // Mobile nav links
    const mobileLinks = document.querySelectorAll('#mobile-menu .mobile-menu-link');
    mobileLinks.forEach(link => {
      const href = link.getAttribute('href');
      if (href) {
        const active = href === '/' ? currentPath === '/' : isActive(href);
        if (active) {
          link.classList.remove('text-white/90', 'text-white/70', 'hover:text-white');
          link.classList.add('text-sky-light', 'bg-white/10');
          link.setAttribute('aria-current', 'page');
        } else {
          link.classList.remove('text-sky-light', 'bg-white/10');
          link.classList.add('text-white/90', 'hover:text-white');
          link.removeAttribute('aria-current');
        }
      }
    });
  }

  function initMobileMenu() {
    const menuButton = document.getElementById('mobile-menu-button');
    const closeButton = document.getElementById('mobile-menu-close');
    const menu = document.getElementById('mobile-menu');
    const overlay = document.getElementById('mobile-menu-overlay');
    const menuIcon = menuButton?.querySelector('.menu-icon');
    const closeIcon = menuButton?.querySelector('.close-icon');
    const menuLinks = document.querySelectorAll('.mobile-menu-link');

    let isOpen = false;

    function openMenu() {
      isOpen = true;
      menu?.classList.remove('translate-x-full');
      menu?.setAttribute('aria-hidden', 'false');
      overlay?.classList.remove('hidden');
      setTimeout(() => overlay?.classList.remove('opacity-0'), 10);
      menuButton?.setAttribute('aria-expanded', 'true');
      menuButton?.setAttribute('aria-label', 'Close menu');
      menuIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      isOpen = false;
      menu?.classList.add('translate-x-full');
      menu?.setAttribute('aria-hidden', 'true');
      overlay?.classList.add('opacity-0');
      setTimeout(() => overlay?.classList.add('hidden'), 300);
      menuButton?.setAttribute('aria-expanded', 'false');
      menuButton?.setAttribute('aria-label', 'Open menu');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    // Toggle menu on button click
    menuButton?.addEventListener('click', () => {
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Close menu on close button click
    closeButton?.addEventListener('click', closeMenu);

    // Close menu on overlay click
    overlay?.addEventListener('click', closeMenu);

    // Close menu on link click
    menuLinks.forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    // Close menu on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeMenu();
      }
    });

    // Close menu on resize to desktop
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && isOpen) {
        closeMenu();
      }
    });
  }

  // Initialize on first load
  document.addEventListener('DOMContentLoaded', () => {
    initMobileMenu();
    updateActiveNav();
  });

  // Re-initialize on Astro page navigation (View Transitions)
  document.addEventListener('astro:page-load', () => {
    initMobileMenu();
    updateActiveNav();
  });
</script>
