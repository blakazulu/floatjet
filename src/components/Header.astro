---
import { Image } from 'astro:assets';

const navItems = [
  { name: "Tools", href: "/tools" },
  { name: "Gear", href: "/gear" },
  { name: "Guides", href: "/guides" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="mx-auto px-4 md:px-6 py-4">
    <div class="bg-ocean-deep/90 backdrop-blur-md border border-white/20 rounded-2xl shadow-lg px-6 py-3 flex items-center justify-between max-w-6xl mx-auto">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <Image src="/images/logo.webp" alt="FloatJet Logo" width={40} height={40} class="h-10 object-contain group-hover:scale-110 transition-transform" loading="eager" />
        <span class="text-xl font-semibold text-white font-heading tracking-wide">FloatJet</span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-8">
        {navItems.map(item => (
          <a
            href={item.href}
            class="text-sm font-medium text-white/90 hover:text-white transition-colors"
          >
            {item.name}
          </a>
        ))}
      </nav>

      <!-- Utility Icons -->
      <div class="flex items-center gap-3">
        <!-- Search Icon -->
        <button class="hidden md:flex items-center gap-2 text-white/90 hover:text-white transition-colors group">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="text-sm">Search</span>
        </button>

        <!-- User Account Icon -->
        <button class="hidden md:block text-white/90 hover:text-white transition-colors" aria-label="Account">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </button>

        <!-- Settings Icon -->
        <button class="hidden md:block text-white/90 hover:text-white transition-colors" aria-label="Settings">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </button>

        <!-- Mobile Menu Button -->
        <button class="md:hidden text-white p-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>
