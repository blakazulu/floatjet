---
import {Image} from 'astro:assets';

const navItems = [
  {name: 'Tools', href: '/tools'},
  {name: 'Gear', href: '/gear'},
  {name: 'Guides', href: '/guides'},
  {name: 'Blog', href: '/blog'},
];
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="mx-auto px-4 md:px-6 py-4">
    <div
        class="bg-ocean-deep/90 backdrop-blur-md border border-white/20 rounded-2xl shadow-lg px-6 py-3 flex items-center justify-between max-w-6xl mx-auto">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <Image src="/images/logo.webp" alt="FloatJet Logo" width={40} height={40}
               class="h-10 object-contain group-hover:scale-110 transition-transform" loading="eager"/>
        <span class="text-xl font-bold text-white tracking-wide">FloatJet</span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-8" aria-label="Main navigation">
        {navItems.map(item => (
            <a
                href={item.href}
                class="text-sm font-medium text-white/90 hover:text-white transition-colors"
            >
              {item.name}
            </a>
        ))}
      </nav>

      <!-- Utility Icons -->
      <div class="flex items-center gap-3">
        <!-- Search Icon -->
        <button class="hidden md:flex items-center gap-2 text-white/90 hover:text-white transition-colors group"
                aria-label="Search">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <span class="text-sm">Search</span>
        </button>

        <!-- Mobile Menu Button -->
        <button
            id="mobile-menu-button"
            class="md:hidden text-white p-1"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
        >
          <svg class="menu-icon h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
               stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/>
          </svg>
          <svg class="close-icon h-6 w-6 hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
               stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Menu Overlay - z-[60] to cover navbar -->
<div
    id="mobile-menu-overlay"
    class="fixed inset-0 bg-black/70 backdrop-blur-md z-[60] hidden opacity-0 transition-opacity duration-300"
    aria-hidden="true"
></div>

<!-- Mobile Menu Panel - darker color to differentiate from navbar -->
<nav
    id="mobile-menu"
    class="fixed top-0 right-0 h-full w-80 max-w-[85vw] bg-[#0a2a33] border-l border-white/10 z-[70] transform translate-x-full transition-transform duration-300 ease-out shadow-2xl"
    aria-label="Mobile navigation"
    aria-hidden="true"
>
  <div class="flex flex-col h-full">
    <!-- Menu Header -->
    <div class="flex items-center justify-between px-6 py-5 border-b border-white/10">
      <span class="text-lg font-bold text-white">Menu</span>
      <button
          id="mobile-menu-close"
          class="text-white/80 hover:text-white p-1 transition-colors"
          aria-label="Close menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Menu Links -->
    <div class="flex-1 overflow-y-auto py-4">
      <ul class="space-y-1 px-4">
        <li>
          <a href="/"
             class="mobile-menu-link flex items-center gap-3 px-4 py-3 rounded-xl text-white/90 hover:text-white hover:bg-white/10 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            <span class="font-medium">Home</span>
          </a>
        </li>
        {navItems.map(item => (
            <li>
              <a href={item.href}
                 class="mobile-menu-link flex items-center gap-3 px-4 py-3 rounded-xl text-white/90 hover:text-white hover:bg-white/10 transition-all">
                {item.name === 'Tools' && (
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                )}
                {item.name === 'Gear' && (
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                )}
                {item.name === 'Guides' && (
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                    </svg>
                )}
                {item.name === 'Blog' && (
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                    </svg>
                )}
                <span class="font-medium">{item.name}</span>
              </a>
            </li>
        ))}
      </ul>

      <!-- Divider -->
      <div class="my-4 mx-4 border-t border-white/10"></div>

      <!-- Secondary Links -->
      <ul class="space-y-1 px-4">
        <li>
          <a href="/about"
             class="mobile-menu-link flex items-center gap-3 px-4 py-3 rounded-xl text-white/70 hover:text-white hover:bg-white/10 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>About</span>
          </a>
        </li>
        <li>
          <a href="/contact"
             class="mobile-menu-link flex items-center gap-3 px-4 py-3 rounded-xl text-white/70 hover:text-white hover:bg-white/10 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span>Contact</span>
          </a>
        </li>
      </ul>
    </div>

    <!-- Menu Footer -->
    <div class="px-6 py-4 border-t border-white/10">
      <p class="text-xs text-white/50 text-center">
        &copy; 2025 FloatJet
      </p>
    </div>
  </div>
</nav>

<script>
  function initMobileMenu() {
    const menuButton = document.getElementById('mobile-menu-button');
    const closeButton = document.getElementById('mobile-menu-close');
    const menu = document.getElementById('mobile-menu');
    const overlay = document.getElementById('mobile-menu-overlay');
    const menuIcon = menuButton?.querySelector('.menu-icon');
    const closeIcon = menuButton?.querySelector('.close-icon');
    const menuLinks = document.querySelectorAll('.mobile-menu-link');

    let isOpen = false;

    function openMenu() {
      isOpen = true;
      menu?.classList.remove('translate-x-full');
      menu?.setAttribute('aria-hidden', 'false');
      overlay?.classList.remove('hidden');
      setTimeout(() => overlay?.classList.remove('opacity-0'), 10);
      menuButton?.setAttribute('aria-expanded', 'true');
      menuButton?.setAttribute('aria-label', 'Close menu');
      menuIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      isOpen = false;
      menu?.classList.add('translate-x-full');
      menu?.setAttribute('aria-hidden', 'true');
      overlay?.classList.add('opacity-0');
      setTimeout(() => overlay?.classList.add('hidden'), 300);
      menuButton?.setAttribute('aria-expanded', 'false');
      menuButton?.setAttribute('aria-label', 'Open menu');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    // Toggle menu on button click
    menuButton?.addEventListener('click', () => {
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Close menu on close button click
    closeButton?.addEventListener('click', closeMenu);

    // Close menu on overlay click
    overlay?.addEventListener('click', closeMenu);

    // Close menu on link click
    menuLinks.forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    // Close menu on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeMenu();
      }
    });

    // Close menu on resize to desktop
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && isOpen) {
        closeMenu();
      }
    });
  }

  // Initialize on first load
  document.addEventListener('DOMContentLoaded', initMobileMenu);

  // Re-initialize on Astro page navigation (View Transitions)
  document.addEventListener('astro:page-load', initMobileMenu);
</script>
