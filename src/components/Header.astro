---
const navItems = [
  { name: "Tools", href: "/tools/" },
  { name: "Gear", href: "/gear/" },
  { name: "Guides", href: "/guides/" },
  { name: "Blog", href: "/blog/" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  currentPath === href || (href !== "/" && currentPath.startsWith(href.endsWith("/") ? href : href + "/"));
---

<!-- Floating pill header -->
<header class="site-header fixed top-0 left-0 right-0 z-50 px-3 pt-2.5 pb-2 md:px-6 md:pt-4 md:pb-3 pointer-events-none bg-[linear-gradient(to_bottom,var(--color-paper)_55%,transparent)]">
  <div class="pointer-events-auto mx-auto max-w-7xl h-[60px] md:h-[68px] flex items-center justify-between gap-4 pl-5 pr-1.5 md:pl-7 md:pr-2.5 bg-card border-[1.5px] border-ink rounded-full shadow-[3px_4px_0_0_var(--color-ink)]">
    <!-- Wordmark -->
    <a
      href="/"
      id="logo-link"
      class="font-display font-bold text-[22px] md:text-[26px] tracking-[-0.03em] text-ink leading-none hover:text-ocean-deep transition-colors"
      aria-label="FloatJet home"
    >
      floatjet
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="nav-link px-[18px] py-2.5 rounded-full text-[15px] font-semibold text-ink hover:bg-paper transition-colors aria-[current=page]:bg-sand aria-[current=page]:font-bold"
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.name}
        </a>
      ))}
    </nav>

    <!-- Utilities -->
    <div class="flex items-center gap-1.5 md:gap-2">
      <button
        data-search-trigger
        type="button"
        class="inline-flex items-center justify-center w-12 h-12 rounded-full border-[1.5px] border-ink text-ink hover:bg-paper transition-colors cursor-pointer"
        aria-label="Search (Ctrl+K)"
      >
        <svg class="h-[18px] w-[18px]" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
        </svg>
      </button>

      <a
        href="/deals/"
        class="hidden md:inline-flex items-center h-12 px-5 rounded-full bg-sun border-[1.5px] border-ink text-ink font-bold text-[15px] hover:bg-[#FFDB66] transition-colors aria-[current=page]:bg-coral"
        aria-current={isActive("/deals/") ? "page" : undefined}
      >
        Deals
      </a>

      <!-- Mobile: menu -->
      <button
        id="mobile-menu-button"
        type="button"
        class="md:hidden inline-flex items-center justify-center w-12 h-12 rounded-full bg-sun text-ink"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="menu-icon h-[18px] w-[18px]" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path d="M4 8h16M4 16h16"></path>
        </svg>
        <svg class="close-icon h-[18px] w-[18px] hidden" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  // Header with proper deduplication for View Transitions (header is transition:persist, so refresh aria-current)

  if (!window.__headerInit) {
    window.__headerInit = true;

    function headerIsActive(href) {
      var currentPath = window.location.pathname;
      if (href === '/') {
        return currentPath === '/';
      }
      return currentPath === href || currentPath.startsWith(href.charAt(href.length - 1) === '/' ? href : href + '/');
    }

    function updateActiveNav() {
      var links = document.querySelectorAll('.site-header nav[aria-label="Main navigation"] a, .site-header a[href="/deals/"]');
      links.forEach(function(link) {
        var href = link.getAttribute('href');
        if (!href) return;
        if (headerIsActive(href)) {
          link.setAttribute('aria-current', 'page');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    }

    // Prevent navigation when clicking on the active link
    function preventActiveNavigation(e) {
      var href = e.currentTarget.getAttribute('href');
      if (href && headerIsActive(href)) {
        e.preventDefault();
        e.stopPropagation();
      }
    }

    function attachNavClickHandlers() {
      var navLinks = document.querySelectorAll('.site-header nav[aria-label="Main navigation"] a');
      navLinks.forEach(function(link) {
        link.addEventListener('click', preventActiveNavigation);
      });

      var logoLink = document.getElementById('logo-link');
      if (logoLink) {
        logoLink.addEventListener('click', preventActiveNavigation);
      }
    }

    function initHeader() {
      updateActiveNav();
      attachNavClickHandlers();
    }

    document.addEventListener('astro:page-load', initHeader);
  }
</script>
