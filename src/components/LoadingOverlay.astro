---
// Loading overlay shown during page transitions
---

<div id="loading-overlay" class="fixed inset-0 z-[100] pointer-events-none opacity-0 transition-opacity duration-300 bg-paper/90 backdrop-blur-sm"
     transition:persist="loading-overlay" aria-hidden="true">
  <div class="absolute inset-0 flex items-center justify-center">
    <div class="loading-content">
      <div class="loading-sticker font-display font-bold text-3xl md:text-4xl text-ink">floatjet</div>
      <div class="loading-dots">
        <span class="dot bg-sun"></span>
        <span class="dot bg-coral"></span>
        <span class="dot bg-jet-stream"></span>
      </div>
    </div>
  </div>
</div>

<style>
  .loading-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .loading-sticker {
    padding: 1rem 1.75rem;
    background: var(--color-card);
    border: 1.5px solid var(--color-ink);
    border-radius: 999px;
    box-shadow: 4px 5px 0 0 var(--color-ink);
    animation: sticker-wobble 1.6s ease-in-out infinite;
  }

  @keyframes sticker-wobble {
    0%, 100% {
      transform: rotate(-3deg) translateY(0);
    }
    50% {
      transform: rotate(3deg) translateY(-8px);
    }
  }

  .loading-dots {
    display: flex;
    gap: 0.625rem;
  }

  .loading-dots .dot {
    width: 14px;
    height: 14px;
    border-radius: 999px;
    border: 1.5px solid var(--color-ink);
    animation: dot-bounce 1.2s infinite;
    animation-fill-mode: both;
  }

  .loading-dots .dot:nth-child(2) {
    animation-delay: 0.15s;
  }

  .loading-dots .dot:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes dot-bounce {
    0%, 60%, 100% {
      transform: translateY(0);
    }
    30% {
      transform: translateY(-12px);
    }
  }

  #loading-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script is:inline>
  // Only add listeners once (check for flag to prevent duplicates)
  if (!window.__loadingOverlayInit) {
    window.__loadingOverlayInit = true;

    function hideOverlay() {
      const overlay = document.getElementById('loading-overlay');
      overlay?.classList.remove('active');
    }

    function showOverlay() {
      const overlay = document.getElementById('loading-overlay');
      overlay?.classList.add('active');
    }

    // Check if a link is external
    function isExternalLink(url) {
      try {
        const linkUrl = new URL(url, window.location.href);
        return linkUrl.hostname !== window.location.hostname;
      } catch {
        return false;
      }
    }

    // Show overlay when navigation starts (only for internal links)
    document.addEventListener('astro:before-preparation', (event) => {
      // Check if this is an external link
      const target = event.detail?.newLocationHref || event.detail?.to;
      if (target && isExternalLink(target)) {
        return; // Don't show overlay for external links
      }
      showOverlay();
    });

    // Watch for loading indicator to finish (astro-loading-indicator)
    // The indicator has data-astro-transition-persist="astro-loading-indicator"
    function watchLoadingIndicator() {
      const indicator = document.querySelector('[data-astro-transition-persist="astro-loading-indicator"]');
      if (indicator) {
        // Use MutationObserver to detect when indicator hides (opacity changes)
        const observer = new MutationObserver((mutations) => {
          mutations.forEach((mutation) => {
            if (mutation.type === 'attributes' && mutation.attributeName === 'style') {
              const style = indicator.getAttribute('style') || '';
              // When indicator finishes, it sets opacity to 0
              if (style.includes('opacity: 0') || style.includes('opacity:0')) {
                hideOverlay();
              }
            }
          });
        });
        observer.observe(indicator, { attributes: true, attributeFilter: ['style'] });
      }
    }

    // Initialize indicator watcher on page load
    document.addEventListener('astro:page-load', watchLoadingIndicator);

    // Hide overlay when new page is ready (fallback)
    document.addEventListener('astro:after-swap', hideOverlay);

    // Hide on page load (direct navigation or browser back/forward)
    document.addEventListener('astro:page-load', hideOverlay);

    // Hide overlay when using browser back/forward buttons
    window.addEventListener('pageshow', hideOverlay);

    // Safety timeout: auto-hide overlay after 5 seconds if still visible
    document.addEventListener('astro:before-preparation', () => {
      setTimeout(hideOverlay, 5000);
    });

    // Ensure overlay is hidden on initial page load
    hideOverlay();
    watchLoadingIndicator();
  }
</script>
