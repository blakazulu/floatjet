---
import { Image } from "astro:assets";
// Loading overlay shown during page transitions
---

<div id="loading-overlay" class="fixed inset-0 z-[100] pointer-events-none opacity-0 transition-opacity duration-300"
     transition:persist="loading-overlay">
  <!-- Animated gradient backdrop -->
  <div class="absolute inset-0 bg-gradient-to-br from-ocean-deep via-ocean-deep/95 to-jet-stream/20 backdrop-blur-md">
    <!-- Animated wave background -->
    <div class="wave-bg"></div>
  </div>

  <!-- Logo Container with enhanced visibility -->
  <div class="absolute inset-0 flex items-center justify-center">
    <div class="loading-content">
      <!-- Glow circle behind logo -->
      <div class="glow-circle"></div>

      <!-- Logo -->
      <div class="loading-logo">
        <Image
            src="/images/big-logo.webp"
            alt="FloatJet logo"
            width={420}
            height={120}
            loading="eager"
            class="h-24 md:h-32 w-auto object-contain brightness-0 invert"
        />
      </div>

      <!-- Loading text -->
      <div class="loading-text">
        <span class="dot">.</span>
        <span class="dot">.</span>
        <span class="dot">.</span>
      </div>
    </div>
  </div>
</div>

<style>
  /* Wave background animation */
  .wave-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(45deg,
      transparent 30%,
      rgba(56, 163, 165, 0.1) 50%,
      transparent 70%
    );
    background-size: 200% 200%;
    animation: wave-move 3s ease-in-out infinite;
  }

  @keyframes wave-move {
    0%, 100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  /* Loading content container */
  .loading-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  /* Glowing circle behind logo */
  .glow-circle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(128, 206, 215, 0.3) 0%, transparent 70%);
    border-radius: 50%;
    animation: pulse-glow 2s ease-in-out infinite;
  }

  @keyframes pulse-glow {
    0%, 100% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.5;
    }
    50% {
      transform: translate(-50%, -50%) scale(1.2);
      opacity: 0.8;
    }
  }

  /* Logo animations - smooth bounce */
  .loading-logo {
    position: relative;
    z-index: 2;
    animation: smooth-bounce 2s ease-in-out infinite;
  }

  @keyframes smooth-bounce {
    0%, 100% {
      transform: translateY(0) scale(1);
    }
    50% {
      transform: translateY(-12px) scale(1.02);
    }
  }

  /* Enhanced logo visibility with glow */
  .loading-logo img {
    filter: brightness(0) invert(1) drop-shadow(0 0 30px rgba(255, 255, 255, 0.6)) drop-shadow(0 0 60px rgba(128, 206, 215, 0.4));
    animation: logo-glow 2s ease-in-out infinite;
  }

  @keyframes logo-glow {
    0%, 100% {
      filter: brightness(0) invert(1) drop-shadow(0 0 25px rgba(255, 255, 255, 0.5)) drop-shadow(0 0 50px rgba(128, 206, 215, 0.3));
    }
    50% {
      filter: brightness(0) invert(1) drop-shadow(0 0 40px rgba(255, 255, 255, 0.8)) drop-shadow(0 0 80px rgba(128, 206, 215, 0.6));
    }
  }

  /* Loading dots animation */
  .loading-text {
    display: flex;
    gap: 0.5rem;
    font-size: 2rem;
    color: rgba(255, 255, 255, 0.9);
    font-weight: bold;
    letter-spacing: 0.2rem;
  }

  .loading-text .dot {
    animation: dot-bounce 1.4s infinite;
    animation-fill-mode: both;
  }

  .loading-text .dot:nth-child(2) {
    animation-delay: 0.2s;
  }

  .loading-text .dot:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes dot-bounce {
    0%, 60%, 100% {
      transform: translateY(0);
      opacity: 0.5;
    }
    30% {
      transform: translateY(-15px);
      opacity: 1;
    }
  }

  /* Active state with smoother transition */
  #loading-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .glow-circle {
      width: 150px;
      height: 150px;
    }

    .loading-text {
      font-size: 1.5rem;
    }
  }
</style>

<script is:inline>
  // Only add listeners once (check for flag to prevent duplicates)
  if (!window.__loadingOverlayInit) {
    window.__loadingOverlayInit = true;

    function hideOverlay() {
      const overlay = document.getElementById('loading-overlay');
      overlay?.classList.remove('active');
    }

    function showOverlay() {
      const overlay = document.getElementById('loading-overlay');
      overlay?.classList.add('active');
    }

    // Check if a link is external
    function isExternalLink(url) {
      try {
        const linkUrl = new URL(url, window.location.href);
        return linkUrl.hostname !== window.location.hostname;
      } catch {
        return false;
      }
    }

    // Show overlay when navigation starts (only for internal links)
    document.addEventListener('astro:before-preparation', (event) => {
      // Check if this is an external link
      const target = event.detail?.newLocationHref || event.detail?.to;
      if (target && isExternalLink(target)) {
        return; // Don't show overlay for external links
      }
      showOverlay();
    });

    // Watch for loading indicator to finish (astro-loading-indicator)
    // The indicator has data-astro-transition-persist="astro-loading-indicator"
    function watchLoadingIndicator() {
      const indicator = document.querySelector('[data-astro-transition-persist="astro-loading-indicator"]');
      if (indicator) {
        // Use MutationObserver to detect when indicator hides (opacity changes)
        const observer = new MutationObserver((mutations) => {
          mutations.forEach((mutation) => {
            if (mutation.type === 'attributes' && mutation.attributeName === 'style') {
              const style = indicator.getAttribute('style') || '';
              // When indicator finishes, it sets opacity to 0
              if (style.includes('opacity: 0') || style.includes('opacity:0')) {
                hideOverlay();
              }
            }
          });
        });
        observer.observe(indicator, { attributes: true, attributeFilter: ['style'] });
      }
    }

    // Initialize indicator watcher on page load
    document.addEventListener('astro:page-load', watchLoadingIndicator);

    // Hide overlay when new page is ready (fallback)
    document.addEventListener('astro:after-swap', hideOverlay);

    // Hide on page load (direct navigation or browser back/forward)
    document.addEventListener('astro:page-load', hideOverlay);

    // Hide overlay when using browser back/forward buttons
    window.addEventListener('pageshow', hideOverlay);

    // Safety timeout: auto-hide overlay after 5 seconds if still visible
    document.addEventListener('astro:before-preparation', () => {
      setTimeout(hideOverlay, 5000);
    });

    // Ensure overlay is hidden on initial page load
    hideOverlay();
    watchLoadingIndicator();
  }
</script>
