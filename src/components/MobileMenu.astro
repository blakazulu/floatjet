---

const navItems = [
  { name: "Home", href: "/", note: "the desk" },
  { name: "Tools", href: "/tools/", note: "worth paying for" },
  { name: "Gear", href: "/gear/", note: "desk upgrades" },
  { name: "Guides", href: "/guides/", note: "how-tos" },
  { name: "Blog", href: "/blog/", note: "notes from the road" },
  { name: "Deals", href: "/deals/", note: "current discounts" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/"
    ? currentPath === "/"
    : currentPath === href || currentPath.startsWith(href.endsWith("/") ? href : href + "/");
---

<!-- Mobile Menu Overlay -->
<div
    id="mobile-menu-overlay"
    class="fixed inset-0 bg-ink/60 z-[200] hidden opacity-0 transition-opacity duration-300"
    aria-hidden="true"
></div>

<!-- Mobile Menu Panel -->
<nav
    id="mobile-menu"
    class="fixed top-0 right-0 h-full w-80 max-w-[88vw] bg-paper border-l-[1.5px] border-ink z-[210] transform translate-x-full transition-transform duration-300 ease-out"
    aria-label="Mobile navigation"
    aria-hidden="true"
>
  <div class="flex flex-col h-full">
    <!-- Menu Header -->
    <div class="flex items-center justify-between px-5 h-16 border-b-[1.5px] border-ink">
      <span class="font-display font-bold text-xl text-ink">floatjet</span>
      <button
          id="mobile-menu-close"
          type="button"
          class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-ink text-sun"
          aria-label="Close menu"
      >
        <svg class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Menu Links -->
    <div class="flex-1 overflow-y-auto px-4 py-5">
      <ul class="space-y-3">
        {navItems.map((item) => (
            <li>
              <a href={item.href}
                 class="mobile-menu-link group flex items-center justify-between gap-3 px-5 py-3.5 rounded-2xl bg-card border-[1.5px] border-ink text-ink shadow-[4px_5px_0_0_var(--color-ink)] transition-transform active:translate-x-[3px] active:translate-y-[3px] active:shadow-none aria-[current=page]:bg-sun"
                 aria-current={isActive(item.href) ? 'page' : undefined}>
                <span class="font-display font-bold text-lg">{item.name}</span>
                <span class="text-sm text-ink-soft group-aria-[current=page]:text-ink">{item.note}</span>
              </a>
            </li>
        ))}
      </ul>

      <!-- Secondary Links -->
      <ul class="mt-8 flex flex-wrap gap-2">
        <li><a href="/about/" class="mobile-menu-link inline-flex items-center min-h-12 px-4 rounded-full border-[1.5px] border-ink text-sm font-semibold text-ink hover:bg-ink hover:text-paper transition-colors aria-[current=page]:bg-ink aria-[current=page]:text-paper" aria-current={isActive('/about/') ? 'page' : undefined}>About</a></li>
        <li><a href="/team/" class="mobile-menu-link inline-flex items-center min-h-12 px-4 rounded-full border-[1.5px] border-ink text-sm font-semibold text-ink hover:bg-ink hover:text-paper transition-colors aria-[current=page]:bg-ink aria-[current=page]:text-paper" aria-current={isActive('/team/') ? 'page' : undefined}>Team</a></li>
        <li><a href="/contact/" class="mobile-menu-link inline-flex items-center min-h-12 px-4 rounded-full border-[1.5px] border-ink text-sm font-semibold text-ink hover:bg-ink hover:text-paper transition-colors aria-[current=page]:bg-ink aria-[current=page]:text-paper" aria-current={isActive('/contact/') ? 'page' : undefined}>Contact</a></li>
      </ul>
    </div>

    <!-- Menu Footer -->
    <div class="px-5 py-4 border-t-[1.5px] border-ink">
      <p class="text-sm text-ink-soft">Honest reviews for remote workers.</p>
    </div>
  </div>
</nav>

<script is:inline>
  // Mobile Menu with proper cleanup for View Transitions

  if (!window.__mobileMenuInit) {
    window.__mobileMenuInit = true;
    window.__mobileMenuState = { isOpen: false };
    window.__mobileMenuHandlers = { keydown: null, resize: null };

    function updateActiveNav() {
      var currentPath = window.location.pathname;
      document.querySelectorAll('#mobile-menu .mobile-menu-link').forEach(function(link) {
        var href = link.getAttribute('href');
        if (!href) return;
        var active = href === '/'
          ? currentPath === '/'
          : currentPath === href || currentPath.startsWith(href.charAt(href.length - 1) === '/' ? href : href + '/');
        if (active) {
          link.setAttribute('aria-current', 'page');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    }

    function toggleMobileMenu() {
      if (window.__mobileMenuState.isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    function openMenu() {
      var menu = document.getElementById('mobile-menu');
      var overlay = document.getElementById('mobile-menu-overlay');
      var menuButton = document.getElementById('mobile-menu-button');
      var menuIcon = menuButton ? menuButton.querySelector('.menu-icon') : null;
      var closeIcon = menuButton ? menuButton.querySelector('.close-icon') : null;

      window.__mobileMenuState.isOpen = true;
      if (menu) {
        menu.classList.remove('translate-x-full');
        menu.setAttribute('aria-hidden', 'false');
      }
      if (overlay) {
        overlay.classList.remove('hidden');
        setTimeout(function() { overlay.classList.remove('opacity-0'); }, 10);
      }
      if (menuButton) {
        menuButton.setAttribute('aria-expanded', 'true');
        menuButton.setAttribute('aria-label', 'Close menu');
      }
      if (menuIcon) menuIcon.classList.add('hidden');
      if (closeIcon) closeIcon.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      var menu = document.getElementById('mobile-menu');
      var overlay = document.getElementById('mobile-menu-overlay');
      var menuButton = document.getElementById('mobile-menu-button');
      var menuIcon = menuButton ? menuButton.querySelector('.menu-icon') : null;
      var closeIcon = menuButton ? menuButton.querySelector('.close-icon') : null;

      window.__mobileMenuState.isOpen = false;
      if (menu) {
        menu.classList.add('translate-x-full');
        menu.setAttribute('aria-hidden', 'true');
      }
      if (overlay) {
        overlay.classList.add('opacity-0');
        setTimeout(function() { overlay.classList.add('hidden'); }, 300);
      }
      if (menuButton) {
        menuButton.setAttribute('aria-expanded', 'false');
        menuButton.setAttribute('aria-label', 'Open menu');
      }
      if (menuIcon) menuIcon.classList.remove('hidden');
      if (closeIcon) closeIcon.classList.add('hidden');
      document.body.style.overflow = '';
    }

    function cleanupMobileMenu() {
      window.__mobileMenuState.isOpen = false;
      document.body.style.overflow = '';
      if (window.__mobileMenuHandlers.keydown) {
        document.removeEventListener('keydown', window.__mobileMenuHandlers.keydown);
        window.__mobileMenuHandlers.keydown = null;
      }
      if (window.__mobileMenuHandlers.resize) {
        window.removeEventListener('resize', window.__mobileMenuHandlers.resize);
        window.__mobileMenuHandlers.resize = null;
      }
    }

    function initMobileMenu() {
      cleanupMobileMenu();

      var menuButton = document.getElementById('mobile-menu-button');
      var closeButton = document.getElementById('mobile-menu-close');
      var overlay = document.getElementById('mobile-menu-overlay');
      var menuLinks = document.querySelectorAll('.mobile-menu-link');

      // Element listeners - auto-cleaned on DOM swap
      if (menuButton) {
        // Header is persisted across navigations: a stable handler reference prevents stacking duplicate listeners
        menuButton.addEventListener('click', toggleMobileMenu);
      }
      if (closeButton) closeButton.addEventListener('click', closeMenu);
      if (overlay) overlay.addEventListener('click', closeMenu);
      menuLinks.forEach(function(link) {
        link.addEventListener('click', closeMenu);
      });

      // Global keydown handler - store for cleanup
      window.__mobileMenuHandlers.keydown = function(e) {
        if (e.key === 'Escape' && window.__mobileMenuState.isOpen) {
          closeMenu();
        }
      };
      document.addEventListener('keydown', window.__mobileMenuHandlers.keydown);

      // Global resize handler - store for cleanup
      window.__mobileMenuHandlers.resize = function() {
        if (window.innerWidth >= 768 && window.__mobileMenuState.isOpen) {
          closeMenu();
        }
      };
      window.addEventListener('resize', window.__mobileMenuHandlers.resize);
    }

    // Register event listeners once
    document.addEventListener('astro:page-load', function() {
      initMobileMenu();
      updateActiveNav();
    });
    document.addEventListener('astro:before-swap', cleanupMobileMenu);
  }
</script>
