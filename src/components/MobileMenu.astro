---

const navItems = [
  {name: 'Tools', href: '/tools'},
  {name: 'Gear', href: '/gear'},
  {name: 'Guides', href: '/guides'},
  {name: 'Blog', href: '/blog'},
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || currentPath.startsWith(href + '/');
---

<!-- Mobile Menu Overlay -->
<div
    id="mobile-menu-overlay"
    class="fixed inset-0 bg-black/70 backdrop-blur-md z-[200] hidden opacity-0 transition-opacity duration-300"
    aria-hidden="true"
></div>

<!-- Mobile Menu Panel -->
<nav
    id="mobile-menu"
    class="fixed top-0 right-0 h-full w-80 max-w-[85vw] bg-[#0a2a33] border-l border-white/10 z-[210] transform translate-x-full transition-transform duration-300 ease-out shadow-2xl"
    aria-label="Mobile navigation"
    aria-hidden="true"
>
  <div class="flex flex-col h-full">
    <!-- Menu Header -->
    <div class="flex items-center justify-between px-6 py-5 border-b border-white/10">
      <span class="text-lg font-bold text-white">Menu</span>
      <button
          id="mobile-menu-close"
          class="text-white/80 hover:text-white p-1 transition-colors"
          aria-label="Close menu"
      >
        <svg class="h-6 w-6" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Menu Links -->
    <div class="flex-1 overflow-y-auto py-4">
      <ul class="space-y-1 px-4">
        <li>
          <a href="/"
             class:list={[
               'mobile-menu-link flex items-center gap-3 px-4 py-3 rounded-xl transition-all',
               currentPath === '/' ? 'text-sky-light bg-white/10' : 'text-white/90 hover:text-white hover:bg-white/10'
             ]}
             aria-current={currentPath === '/' ? 'page' : undefined}>
            <svg class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>
            <span class="font-medium">Home</span>
          </a>
        </li>
        {navItems.map(item => (
            <li>
              <a href={item.href}
                 class:list={[
                   'mobile-menu-link flex items-center gap-3 px-4 py-3 rounded-xl transition-all',
                   isActive(item.href) ? 'text-sky-light bg-white/10' : 'text-white/90 hover:text-white hover:bg-white/10'
                 ]}
                 aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.name === 'Tools' &&
                    <svg class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8m-4-4v4"/></svg>}
                {item.name === 'Gear' &&
                    <svg class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 1v6m0 6v6m5.2-13.2-4.2 4.2m-3 3-4.2 4.2M23 12h-6m-6 0H5m13.2 5.2-4.2-4.2m-3-3-4.2-4.2"/></svg>}
                {item.name === 'Guides' &&
                    <svg class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>}
                {item.name === 'Blog' &&
                    <svg class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8m8-4h-8m8 8h-8M8 10h.01"/></svg>}
                <span class="font-medium">{item.name}</span>
              </a>
            </li>
        ))}
      </ul>

      <!-- Divider -->
      <div class="my-4 mx-4 border-t border-white/10"></div>

      <!-- Secondary Links -->
      <ul class="space-y-1 px-4">
        <li>
          <a href="/about"
             class="mobile-menu-link flex items-center gap-3 px-4 py-3 rounded-xl text-white/70 hover:text-white hover:bg-white/10 transition-all">
            <svg class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/></svg>
            <span>About</span>
          </a>
        </li>
        <li>
          <a href="/contact"
             class="mobile-menu-link flex items-center gap-3 px-4 py-3 rounded-xl text-white/70 hover:text-white hover:bg-white/10 transition-all">
            <svg class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <span>Contact</span>
          </a>
        </li>
      </ul>
    </div>

    <!-- Menu Footer -->
    <div class="px-6 py-4 border-t border-white/10">
      <p class="text-xs text-white/50 text-center">
        &copy; 2025 FloatJet
      </p>
    </div>
  </div>
</nav>

<script>
  function updateActiveNav() {
    const currentPath = window.location.pathname;
    const isActive = (href: string) => currentPath === href || currentPath.startsWith(href + '/');

    // Mobile nav links
    const mobileLinks = document.querySelectorAll('#mobile-menu .mobile-menu-link');
    mobileLinks.forEach(link => {
      const href = link.getAttribute('href');
      if (href) {
        const active = href === '/' ? currentPath === '/' : isActive(href);
        if (active) {
          link.classList.remove('text-white/90', 'text-white/70', 'hover:text-white');
          link.classList.add('text-sky-light', 'bg-white/10');
          link.setAttribute('aria-current', 'page');
        } else {
          link.classList.remove('text-sky-light', 'bg-white/10');
          link.classList.add('text-white/90', 'hover:text-white');
          link.removeAttribute('aria-current');
        }
      }
    });
  }

  function initMobileMenu() {
    const menuButton = document.getElementById('mobile-menu-button');
    const closeButton = document.getElementById('mobile-menu-close');
    const menu = document.getElementById('mobile-menu');
    const overlay = document.getElementById('mobile-menu-overlay');
    const menuIcon = menuButton?.querySelector('.menu-icon');
    const closeIcon = menuButton?.querySelector('.close-icon');
    const menuLinks = document.querySelectorAll('.mobile-menu-link');

    let isOpen = false;

    function openMenu() {
      isOpen = true;
      menu?.classList.remove('translate-x-full');
      menu?.setAttribute('aria-hidden', 'false');
      overlay?.classList.remove('hidden');
      setTimeout(() => overlay?.classList.remove('opacity-0'), 10);
      menuButton?.setAttribute('aria-expanded', 'true');
      menuButton?.setAttribute('aria-label', 'Close menu');
      menuIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      isOpen = false;
      menu?.classList.add('translate-x-full');
      menu?.setAttribute('aria-hidden', 'true');
      overlay?.classList.add('opacity-0');
      setTimeout(() => overlay?.classList.add('hidden'), 300);
      menuButton?.setAttribute('aria-expanded', 'false');
      menuButton?.setAttribute('aria-label', 'Open menu');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    // Toggle menu on button click
    menuButton?.addEventListener('click', () => {
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Close menu on close button click
    closeButton?.addEventListener('click', closeMenu);

    // Close menu on overlay click
    overlay?.addEventListener('click', closeMenu);

    // Close menu on link click
    menuLinks.forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    // Close menu on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeMenu();
      }
    });

    // Close menu on resize to desktop
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && isOpen) {
        closeMenu();
      }
    });
  }

  // Initialize on first load
  document.addEventListener('DOMContentLoaded', () => {
    initMobileMenu();
    updateActiveNav();
  });

  // Re-initialize on Astro page navigation (View Transitions)
  document.addEventListener('astro:page-load', () => {
    initMobileMenu();
    updateActiveNav();
  });
</script>
