---
import Search from 'astro-pagefind/components/Search';
import {X} from 'lucide-astro';
---

<!-- Search Modal Overlay -->
<div
    id="search-overlay"
    class="fixed inset-0 bg-black/70 backdrop-blur-md z-[80] hidden opacity-0 transition-opacity duration-300"
    aria-hidden="true"
></div>

<!-- Search Modal -->
<div
    id="search-modal"
    class="fixed inset-x-4 top-24 md:inset-x-auto md:left-1/2 md:-translate-x-1/2 md:w-full md:max-w-2xl z-[90] hidden opacity-0 transform scale-95 transition-all duration-300"
    role="dialog"
    aria-modal="true"
    aria-label="Search"
>
  <div class="bg-[#0a2a33] border border-white/20 rounded-2xl shadow-2xl overflow-hidden">
    <!-- Modal Header -->
    <div class="flex items-center justify-between px-6 py-4 border-b border-white/10">
      <h2 class="text-lg font-bold text-white">Search FloatJet</h2>
      <button
          id="search-close"
          class="text-white/80 hover:text-white p-1 transition-colors"
          aria-label="Close search"
      >
        <X class="h-6 w-6" aria-hidden="true"/>
      </button>
    </div>

    <!-- Search Component -->
    <div class="p-4 search-container">
      <div id="search-fallback" class="hidden text-center py-8">
        <p class="text-white/70 mb-2">Search is not available in development mode.</p>
        <p class="text-white/50 text-sm">Run <code class="px-2 py-1 bg-white/10 rounded">npm run build</code> to
          generate the search index.</p>
      </div>

      <!-- Recent Searches (shown when input is empty) -->
      <div id="recent-searches" class="hidden mb-4">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-sm font-semibold text-white/70">Recent Searches</h3>
          <button
              id="clear-recent-searches"
              class="text-xs text-white/50 hover:text-white/80 transition-colors"
          >
            Clear all
          </button>
        </div>
        <div id="recent-searches-list" class="flex flex-wrap gap-2">
          <!-- Recent search chips will be inserted here -->
        </div>
      </div>

      <div id="search-wrapper">
        <Search
            id="search"
            className="pagefind-ui"
            uiOptions={{
              showImages: true,
              showEmptyFilters: false,
              resetStyles: true,
              ranking: {
                termFrequency: 1.0,
                pageLength: 0.75,
                termSimilarity: 1.0,
                termSaturation: 1.4,
              },
            }}
        />
      </div>

      <!-- Search Suggestions (autocomplete) -->
      <div id="search-suggestions" class="hidden mt-2">
        <p class="text-xs text-white/50 mb-2">Suggestions</p>
        <div id="suggestions-list" class="space-y-1">
          <!-- Suggestions will be inserted here -->
        </div>
      </div>
    </div>

    <!-- Keyboard Hint -->
    <div class="px-6 py-3 border-t border-white/10 flex items-center justify-between text-xs text-white/50">
      <span>Type to search articles, tools, and guides</span>
      <span class="hidden md:inline">Press <kbd class="px-2 py-0.5 bg-white/10 rounded">ESC</kbd> to close</span>
    </div>
  </div>
</div>

<style is:global>
  /* Pagefind UI Custom Styles - FloatJet Theme */
  .pagefind-ui {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: #38A3A5;
    --pagefind-ui-text: #ffffff;
    --pagefind-ui-background: transparent;
    --pagefind-ui-border: rgba(255, 255, 255, 0.2);
    --pagefind-ui-tag: rgba(255, 255, 255, 0.1);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 12px;
    --pagefind-ui-image-border-radius: 8px;
    --pagefind-ui-image-box-ratio: 16 / 9;
    --pagefind-ui-font: 'Inter', sans-serif;
  }

  .pagefind-ui .pagefind-ui__search-input {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    font-size: 1rem;
    padding: 0.75rem 1rem 0.75rem 2.75rem;
  }

  /* Hide the default search icon from Pagefind - we style our own input */
  .pagefind-ui .pagefind-ui__search-icon {
    left: 0.75rem;
    opacity: 0.5;
  }

  .pagefind-ui .pagefind-ui__search-input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .pagefind-ui .pagefind-ui__search-input:focus {
    outline: none;
    border-color: #38A3A5;
    box-shadow: 0 0 0 2px rgba(56, 163, 165, 0.3);
  }

  .pagefind-ui .pagefind-ui__search-clear {
    color: rgba(255, 255, 255, 0.7);
  }

  .pagefind-ui .pagefind-ui__search-clear:hover {
    color: white;
  }

  .pagefind-ui .pagefind-ui__results-area {
    margin-top: 1rem;
  }

  .pagefind-ui .pagefind-ui__result {
    padding: 1rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
    margin-bottom: 0.5rem;
    transition: background 0.2s;
  }

  .pagefind-ui .pagefind-ui__result:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .pagefind-ui .pagefind-ui__result-link {
    color: #80CED7;
    font-weight: 600;
    text-decoration: none;
  }

  .pagefind-ui .pagefind-ui__result-link:hover {
    color: #38A3A5;
  }

  .pagefind-ui .pagefind-ui__result-excerpt {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .pagefind-ui mark {
    background: rgba(56, 163, 165, 0.4);
    color: white;
    padding: 0 2px;
    border-radius: 2px;
  }

  .pagefind-ui .pagefind-ui__message {
    color: rgba(255, 255, 255, 0.7);
    text-align: center;
    padding: 2rem;
  }

  /* Result image loading styles */
  .pagefind-ui .pagefind-ui__result-image {
    position: relative;
    background: linear-gradient(135deg, rgba(15, 76, 92, 0.6) 0%, rgba(56, 163, 165, 0.4) 100%);
    overflow: hidden;
  }

  /* Shimmer effect for loading images */
  .pagefind-ui .pagefind-ui__result-image::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
            90deg,
            transparent 0%,
            rgba(255, 255, 255, 0.08) 50%,
            transparent 100%
    );
    background-size: 200% 100%;
    animation: pagefind-shimmer 1.5s ease-in-out infinite;
    z-index: 1;
  }

  .pagefind-ui .pagefind-ui__result-image img {
    position: relative;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }

  .pagefind-ui .pagefind-ui__result-image img[src] {
    opacity: 1;
  }

  @keyframes pagefind-shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  /* Scrollable results */
  .search-container {
    max-height: 60vh;
    overflow-y: auto;
  }

  .search-container::-webkit-scrollbar {
    width: 6px;
  }

  .search-container::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
  }

  .search-container::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
  }

  /* Recent Searches Styles */
  .recent-search-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.9);
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
  }

  .recent-search-chip:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-1px);
  }

  .recent-search-chip .remove-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    transition: background 0.2s;
  }

  .recent-search-chip .remove-btn:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  /* Search Suggestions Styles */
  .suggestion-item {
    padding: 0.75rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .suggestion-item:hover,
  .suggestion-item.selected {
    background: rgba(56, 163, 165, 0.2);
  }

  .suggestion-item mark {
    background: transparent;
    color: #38A3A5;
    font-weight: 600;
  }
</style>

<script>
  // Recent Searches Manager
  const RECENT_SEARCHES_KEY = 'floatjet_recent_searches';
  const MAX_RECENT_SEARCHES = 5;

  interface RecentSearch {
    query: string;
    timestamp: number;
  }

  function getRecentSearches(): RecentSearch[] {
    try {
      const stored = localStorage.getItem(RECENT_SEARCHES_KEY);
      return stored ? JSON.parse(stored) : [];
    } catch {
      return [];
    }
  }

  function saveRecentSearch(query: string) {
    if (!query.trim()) return;

    const recent = getRecentSearches();
    // Remove duplicate if exists
    const filtered = recent.filter(s => s.query !== query);
    // Add to front
    filtered.unshift({query, timestamp: Date.now()});
    // Keep only max items
    const trimmed = filtered.slice(0, MAX_RECENT_SEARCHES);

    try {
      localStorage.setItem(RECENT_SEARCHES_KEY, JSON.stringify(trimmed));
    } catch (e) {
      console.error('Failed to save recent search:', e);
    }
  }

  function removeRecentSearch(query: string) {
    const recent = getRecentSearches();
    const filtered = recent.filter(s => s.query !== query);
    try {
      localStorage.setItem(RECENT_SEARCHES_KEY, JSON.stringify(filtered));
    } catch (e) {
      console.error('Failed to remove recent search:', e);
    }
  }

  function clearAllRecentSearches() {
    try {
      localStorage.removeItem(RECENT_SEARCHES_KEY);
    } catch (e) {
      console.error('Failed to clear recent searches:', e);
    }
  }

  function renderRecentSearches() {
    const container = document.getElementById('recent-searches');
    const list = document.getElementById('recent-searches-list');
    if (!container || !list) return;

    const recent = getRecentSearches();

    if (recent.length === 0) {
      container.classList.add('hidden');
      return;
    }

    list.innerHTML = recent.map(({query}) => `
      <div class="recent-search-chip" data-query="${escapeHtml(query)}">
        <span>${escapeHtml(query)}</span>
        <button class="remove-btn" data-remove="${escapeHtml(query)}" aria-label="Remove">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M9 3L3 9M3 3L9 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    `).join('');

    container.classList.remove('hidden');

    // Attach event listeners
    list.querySelectorAll('.recent-search-chip').forEach(chip => {
      const query = chip.getAttribute('data-query');
      chip.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!target.closest('.remove-btn') && query) {
          performSearch(query);
        }
      });
    });

    list.querySelectorAll('[data-remove]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const query = (btn as HTMLElement).getAttribute('data-remove');
        if (query) {
          removeRecentSearch(query);
          renderRecentSearches();
        }
      });
    });
  }

  function performSearch(query: string) {
    const input = document.querySelector('.pagefind-ui__search-input') as HTMLInputElement;
    if (input) {
      input.value = query;
      input.dispatchEvent(new Event('input', {bubbles: true}));
      saveRecentSearch(query);
      hideRecentSearches();
    }
  }

  function hideRecentSearches() {
    const container = document.getElementById('recent-searches');
    container?.classList.add('hidden');
  }

  function showRecentSearches() {
    renderRecentSearches();
  }

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  // Autocomplete/Suggestions (mock implementation - can be enhanced with Pagefind API)
  let debounceTimer: number;
  const POPULAR_SEARCHES = [
    'best vpn',
    'password manager',
    'standing desk',
    'project management',
    'remote work tools',
    'laptops for remote work',
    'time tracking',
    'video conferencing'
  ];

  function showSuggestions(query: string) {
    const container = document.getElementById('search-suggestions');
    const list = document.getElementById('suggestions-list');
    if (!container || !list || !query.trim()) {
      container?.classList.add('hidden');
      return;
    }

    // Filter popular searches that match the query
    const matches = POPULAR_SEARCHES.filter(s =>
      s.toLowerCase().includes(query.toLowerCase())
    ).slice(0, 5);

    if (matches.length === 0) {
      container.classList.add('hidden');
      return;
    }

    list.innerHTML = matches.map(suggestion => {
      const highlighted = highlightMatch(suggestion, query);
      return `
        <div class="suggestion-item" data-suggestion="${escapeHtml(suggestion)}">
          ${highlighted}
        </div>
      `;
    }).join('');

    container.classList.remove('hidden');

    // Attach click handlers
    list.querySelectorAll('.suggestion-item').forEach(item => {
      item.addEventListener('click', () => {
        const suggestion = item.getAttribute('data-suggestion');
        if (suggestion) {
          performSearch(suggestion);
        }
      });
    });
  }

  function highlightMatch(text: string, query: string): string {
    const index = text.toLowerCase().indexOf(query.toLowerCase());
    if (index === -1) return escapeHtml(text);

    const before = escapeHtml(text.slice(0, index));
    const match = escapeHtml(text.slice(index, index + query.length));
    const after = escapeHtml(text.slice(index + query.length));

    return `${before}<mark>${match}</mark>${after}`;
  }

  function initSearch() {
    const searchButtons = document.querySelectorAll('[data-search-trigger]');
    const closeButton = document.getElementById('search-close');
    const clearRecentBtn = document.getElementById('clear-recent-searches');
    const modal = document.getElementById('search-modal');
    const overlay = document.getElementById('search-overlay');
    let isOpen = false;

    function openSearch() {
      isOpen = true;
      overlay?.classList.remove('hidden');
      modal?.classList.remove('hidden');
      setTimeout(() => {
        overlay?.classList.remove('opacity-0');
        modal?.classList.remove('opacity-0', 'scale-95');
      }, 10);
      document.body.style.overflow = 'hidden';

      // Show recent searches initially
      showRecentSearches();

      // Focus the search input
      setTimeout(() => {
        const input = modal?.querySelector('.pagefind-ui__search-input') as HTMLInputElement;
        input?.focus();
      }, 100);
    }

    function closeSearch() {
      isOpen = false;
      overlay?.classList.add('opacity-0');
      modal?.classList.add('opacity-0', 'scale-95');
      setTimeout(() => {
        overlay?.classList.add('hidden');
        modal?.classList.add('hidden');
      }, 300);
      document.body.style.overflow = '';

      // Clear input and hide suggestions
      const input = modal?.querySelector('.pagefind-ui__search-input') as HTMLInputElement;
      if (input) input.value = '';
      document.getElementById('search-suggestions')?.classList.add('hidden');
    }

    // Open search on button click
    searchButtons.forEach(btn => {
      btn.addEventListener('click', openSearch);
    });

    // Close on close button click
    closeButton?.addEventListener('click', closeSearch);

    // Close on overlay click
    overlay?.addEventListener('click', closeSearch);

    // Clear all recent searches
    clearRecentBtn?.addEventListener('click', () => {
      clearAllRecentSearches();
      renderRecentSearches();
    });

    // Monitor search input for autocomplete
    const setupInputListener = () => {
      const input = modal?.querySelector('.pagefind-ui__search-input') as HTMLInputElement;
      if (!input) return;

      input.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value;

        if (query.trim()) {
          hideRecentSearches();
          clearTimeout(debounceTimer);
          debounceTimer = window.setTimeout(() => {
            showSuggestions(query);
          }, 300);
        } else {
          document.getElementById('search-suggestions')?.classList.add('hidden');
          showRecentSearches();
        }
      });

      // Save search when user hits enter or clicks a result
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          const query = (e.target as HTMLInputElement).value;
          if (query.trim()) {
            saveRecentSearch(query);
          }
        }
      });
    };

    // Setup listener after a delay to ensure Pagefind has rendered
    setTimeout(setupInputListener, 500);

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeSearch();
      }
      // Open search on Cmd/Ctrl + K
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (isOpen) {
          closeSearch();
        } else {
          openSearch();
        }
      }
    });
  }

  // Check if Pagefind is available (it won't be in dev mode)
  async function checkPagefind() {
    try {
      const response = await fetch('/pagefind/pagefind.js', {method: 'HEAD'});
      if (!response.ok) {
        showFallback();
      }
    } catch {
      showFallback();
    }
  }

  function showFallback() {
    const fallback = document.getElementById('search-fallback');
    const wrapper = document.getElementById('search-wrapper');
    if (fallback && wrapper) {
      fallback.classList.remove('hidden');
      wrapper.classList.add('hidden');
    }
  }

  // Initialize on first load
  document.addEventListener('DOMContentLoaded', () => {
    initSearch();
    checkPagefind();
  });

  // Re-initialize on Astro page navigation
  document.addEventListener('astro:page-load', () => {
    initSearch();
    checkPagefind();
  });
</script>
