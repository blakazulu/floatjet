---
import Search from "astro-pagefind/components/Search";
---

<!-- Search Modal Overlay -->
<div
    id="search-overlay"
    class="fixed inset-0 bg-ink/60 z-[80] hidden opacity-0 transition-opacity duration-300"
    aria-hidden="true"
></div>

<!-- Search Modal -->
<div
    id="search-modal"
    class="fixed inset-x-3 top-20 md:inset-x-auto md:left-1/2 md:-translate-x-1/2 md:w-full md:max-w-2xl z-[90] hidden opacity-0 transform scale-95 transition-all duration-300"
    role="dialog"
    aria-modal="true"
    aria-labelledby="search-modal-title"
>
  <div class="bg-paper border-[1.5px] border-ink rounded-[28px] shadow-[5px_6px_0_0_var(--color-ink)] overflow-hidden">
    <!-- Modal Header -->
    <div class="flex items-center justify-between px-5 md:px-6 py-4 border-b-[1.5px] border-ink bg-sun">
      <h2 id="search-modal-title" class="font-display text-lg font-bold text-ink">Search FloatJet</h2>
      <button
          id="search-close"
          type="button"
          class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-ink text-sun"
          aria-label="Close search"
      >
        <svg class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Search Component -->
    <div class="p-4 md:p-5 search-container">
      <div id="search-fallback" class="hidden text-center py-8">
        <p class="text-ink mb-2">Search is not available in development mode.</p>
        <p class="text-ink-soft text-sm">Run <code class="px-2 py-1 bg-ink/10 rounded">npm run build</code> to
          generate the search index.</p>
      </div>

      <!-- Recent Searches (shown when input is empty) -->
      <div id="recent-searches" class="hidden mb-4">
        <div class="flex items-center justify-between mb-3">
          <h3 class="font-body text-sm font-bold text-ink-soft">Recent searches</h3>
          <button
              id="clear-recent-searches"
              type="button"
              class="text-sm font-semibold text-teal-ink underline underline-offset-2 hover:text-ink transition-colors"
          >
            Clear all
          </button>
        </div>
        <div id="recent-searches-list" class="flex flex-wrap gap-2">
          <!-- Recent search chips will be inserted here -->
        </div>
      </div>

      <div id="search-wrapper">
        <Search
            id="search"
            className="pagefind-ui"
            uiOptions={{
              showImages: true,
              showEmptyFilters: false,
              resetStyles: true,
              ranking: {
                termFrequency: 1.0,
                pageLength: 0.75,
                termSimilarity: 1.0,
                termSaturation: 1.4,
              },
            }}
        />
      </div>

      <!-- Search Suggestions (autocomplete) -->
      <div id="search-suggestions" class="hidden mt-2">
        <p class="text-sm font-semibold text-ink-soft mb-2">Suggestions</p>
        <div id="suggestions-list" class="space-y-1">
          <!-- Suggestions will be inserted here -->
        </div>
      </div>
    </div>

    <!-- Keyboard Hint -->
    <div class="px-5 md:px-6 py-3 border-t-[1.5px] border-ink flex items-center justify-between text-sm text-ink-soft">
      <span>Search reviews, tools and guides</span>
      <span class="hidden md:inline">Press <kbd class="px-2 py-0.5 bg-card border border-ink rounded font-jetbrains text-xs text-ink">ESC</kbd> to close</span>
    </div>
  </div>
</div>

<style is:global>
  /* Pagefind UI - Desk Party theme */
  .pagefind-ui {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: #082F38;
    --pagefind-ui-text: #082F38;
    --pagefind-ui-background: #FFFFFF;
    --pagefind-ui-border: #082F38;
    --pagefind-ui-tag: #E0FBFC;
    --pagefind-ui-border-width: 2px;
    --pagefind-ui-border-radius: 16px;
    --pagefind-ui-image-border-radius: 10px;
    --pagefind-ui-image-box-ratio: 16 / 9;
    --pagefind-ui-font: 'Figtree', sans-serif;
  }

  .pagefind-ui .pagefind-ui__search-input {
    background: #FFFFFF;
    color: #082F38;
    font-size: 1rem;
    font-weight: 500;
    padding: 0.75rem 1rem 0.75rem 2.75rem;
    border: 2px solid #082F38;
    border-radius: 999px;
  }

  .pagefind-ui .pagefind-ui__search-icon {
    left: 0.75rem;
    opacity: 0.7;
  }

  .pagefind-ui .pagefind-ui__search-input::placeholder {
    color: #4A6166;
  }

  .pagefind-ui .pagefind-ui__search-input:focus {
    outline: none;
    border-color: #082F38;
    box-shadow: 4px 5px 0 0 #FFD23F;
  }

  .pagefind-ui .pagefind-ui__search-clear {
    color: #082F38;
    font-weight: 600;
  }

  .pagefind-ui .pagefind-ui__search-clear:hover {
    color: #176466;
  }

  .pagefind-ui .pagefind-ui__results-area {
    margin-top: 1rem;
  }

  .pagefind-ui .pagefind-ui__result {
    padding: 1rem;
    border-radius: 16px;
    background: #FFFFFF;
    border: 2px solid #082F38;
    margin-bottom: 0.75rem;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .pagefind-ui .pagefind-ui__result:hover {
    transform: translate(-1px, -2px);
    box-shadow: 4px 5px 0 0 #082F38;
  }

  .pagefind-ui .pagefind-ui__result-link {
    color: #082F38;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .pagefind-ui .pagefind-ui__result-link:hover {
    color: #176466;
    text-decoration: underline;
  }

  .pagefind-ui .pagefind-ui__result-excerpt {
    color: #4A6166;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .pagefind-ui mark {
    background: #FFD23F;
    color: #082F38;
    padding: 0 2px;
    border-radius: 3px;
  }

  .pagefind-ui .pagefind-ui__message {
    color: #4A6166;
    text-align: center;
    padding: 2rem;
  }

  .pagefind-ui .pagefind-ui__button {
    background: #082F38;
    color: #FFD23F;
    border: 0;
    border-radius: 999px;
    font-weight: 700;
  }

  /* Result image loading styles */
  .pagefind-ui .pagefind-ui__result-image {
    position: relative;
    background: #E0FBFC;
    overflow: hidden;
  }

  .pagefind-ui .pagefind-ui__result-image::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
            90deg,
            transparent 0%,
            rgba(255, 255, 255, 0.6) 50%,
            transparent 100%
    );
    background-size: 200% 100%;
    animation: pagefind-shimmer 1.5s ease-in-out infinite;
    z-index: 1;
  }

  .pagefind-ui .pagefind-ui__result-image img {
    position: relative;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }

  .pagefind-ui .pagefind-ui__result-image img[src] {
    opacity: 1;
  }

  @keyframes pagefind-shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  /* Scrollable results */
  .search-container {
    max-height: 60vh;
    overflow-y: auto;
  }

  /* Recent Searches Styles */
  .recent-search-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.375rem 0.5rem 0.375rem 0.875rem;
    background: #FFFFFF;
    border: 2px solid #082F38;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: #082F38;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
  }

  .recent-search-chip:hover {
    background: #FFD23F;
    transform: translateY(-1px);
  }

  .recent-search-chip .remove-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #082F38;
    color: #FFD23F;
    transition: background 0.2s;
  }

  .recent-search-chip .remove-btn:hover {
    background: #0F4C5C;
  }

  /* Search Suggestions Styles */
  .suggestion-item {
    padding: 0.75rem 1rem;
    background: #FFFFFF;
    border: 2px solid transparent;
    border-radius: 12px;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
    font-size: 0.9375rem;
    color: #082F38;
  }

  .suggestion-item:hover,
  .suggestion-item.selected {
    border-color: #082F38;
    background: #E0FBFC;
  }

  .suggestion-item mark {
    background: transparent;
    color: #176466;
    font-weight: 700;
  }
</style>

<script is:inline>
  // Search Modal with proper cleanup for View Transitions

  if (!window.__searchInit) {
    window.__searchInit = true;
    window.__searchState = { isOpen: false };
    window.__searchHandlers = { keydown: null };

    var RECENT_SEARCHES_KEY = 'floatjet_recent_searches';
    var MAX_RECENT_SEARCHES = 5;
    var debounceTimer = null;
    var POPULAR_SEARCHES = [
      'best vpn',
      'password manager',
      'standing desk',
      'project management',
      'remote work tools',
      'laptops for remote work',
      'time tracking',
      'video conferencing'
    ];

    function getRecentSearches() {
      try {
        var stored = localStorage.getItem(RECENT_SEARCHES_KEY);
        return stored ? JSON.parse(stored) : [];
      } catch (e) {
        return [];
      }
    }

    function saveRecentSearch(query) {
      if (!query.trim()) return;
      var recent = getRecentSearches();
      var filtered = recent.filter(function(s) { return s.query !== query; });
      filtered.unshift({query: query, timestamp: Date.now()});
      var trimmed = filtered.slice(0, MAX_RECENT_SEARCHES);
      try {
        localStorage.setItem(RECENT_SEARCHES_KEY, JSON.stringify(trimmed));
      } catch (e) {
        console.error('Failed to save recent search:', e);
      }
    }

    function removeRecentSearch(query) {
      var recent = getRecentSearches();
      var filtered = recent.filter(function(s) { return s.query !== query; });
      try {
        localStorage.setItem(RECENT_SEARCHES_KEY, JSON.stringify(filtered));
      } catch (e) {
        console.error('Failed to remove recent search:', e);
      }
    }

    function clearAllRecentSearches() {
      try {
        localStorage.removeItem(RECENT_SEARCHES_KEY);
      } catch (e) {
        console.error('Failed to clear recent searches:', e);
      }
    }

    function escapeHtml(text) {
      var div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function renderRecentSearches() {
      var container = document.getElementById('recent-searches');
      var list = document.getElementById('recent-searches-list');
      if (!container || !list) return;

      var recent = getRecentSearches();
      if (recent.length === 0) {
        container.classList.add('hidden');
        return;
      }

      list.innerHTML = recent.map(function(item) {
        return '<div class="recent-search-chip" data-query="' + escapeHtml(item.query) + '">' +
          '<span>' + escapeHtml(item.query) + '</span>' +
          '<button class="remove-btn" data-remove="' + escapeHtml(item.query) + '" aria-label="Remove">' +
            '<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">' +
              '<path d="M9 3L3 9M3 3L9 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>' +
            '</svg>' +
          '</button>' +
        '</div>';
      }).join('');

      container.classList.remove('hidden');

      list.querySelectorAll('.recent-search-chip').forEach(function(chip) {
        var query = chip.getAttribute('data-query');
        chip.addEventListener('click', function(e) {
          if (!e.target.closest('.remove-btn') && query) {
            performSearch(query);
          }
        });
      });

      list.querySelectorAll('[data-remove]').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          var query = btn.getAttribute('data-remove');
          if (query) {
            removeRecentSearch(query);
            renderRecentSearches();
          }
        });
      });
    }

    function performSearch(query) {
      var input = document.querySelector('.pagefind-ui__search-input');
      if (input) {
        input.value = query;
        input.dispatchEvent(new Event('input', {bubbles: true}));
        saveRecentSearch(query);
        hideRecentSearches();
      }
    }

    function hideRecentSearches() {
      var container = document.getElementById('recent-searches');
      if (container) container.classList.add('hidden');
    }

    function showRecentSearches() {
      renderRecentSearches();
    }

    function highlightMatch(text, query) {
      var index = text.toLowerCase().indexOf(query.toLowerCase());
      if (index === -1) return escapeHtml(text);
      var before = escapeHtml(text.slice(0, index));
      var match = escapeHtml(text.slice(index, index + query.length));
      var after = escapeHtml(text.slice(index + query.length));
      return before + '<mark>' + match + '</mark>' + after;
    }

    function showSuggestions(query) {
      var container = document.getElementById('search-suggestions');
      var list = document.getElementById('suggestions-list');
      if (!container || !list || !query.trim()) {
        if (container) container.classList.add('hidden');
        return;
      }

      var matches = POPULAR_SEARCHES.filter(function(s) {
        return s.toLowerCase().includes(query.toLowerCase());
      }).slice(0, 5);

      if (matches.length === 0) {
        container.classList.add('hidden');
        return;
      }

      list.innerHTML = matches.map(function(suggestion) {
        return '<div class="suggestion-item" data-suggestion="' + escapeHtml(suggestion) + '">' +
          highlightMatch(suggestion, query) +
        '</div>';
      }).join('');

      container.classList.remove('hidden');

      list.querySelectorAll('.suggestion-item').forEach(function(item) {
        item.addEventListener('click', function() {
          var suggestion = item.getAttribute('data-suggestion');
          if (suggestion) performSearch(suggestion);
        });
      });
    }

    function openSearch() {
      var modal = document.getElementById('search-modal');
      var overlay = document.getElementById('search-overlay');
      window.__searchState.isOpen = true;
      if (overlay) overlay.classList.remove('hidden');
      if (modal) modal.classList.remove('hidden');
      setTimeout(function() {
        if (overlay) overlay.classList.remove('opacity-0');
        if (modal) modal.classList.remove('opacity-0', 'scale-95');
      }, 10);
      document.body.style.overflow = 'hidden';
      showRecentSearches();
      setTimeout(function() {
        var input = modal ? modal.querySelector('.pagefind-ui__search-input') : null;
        if (input) input.focus();
      }, 100);
    }

    function closeSearch() {
      var modal = document.getElementById('search-modal');
      var overlay = document.getElementById('search-overlay');
      window.__searchState.isOpen = false;
      if (overlay) overlay.classList.add('opacity-0');
      if (modal) modal.classList.add('opacity-0', 'scale-95');
      setTimeout(function() {
        if (overlay) overlay.classList.add('hidden');
        if (modal) modal.classList.add('hidden');
      }, 300);
      document.body.style.overflow = '';
      var input = modal ? modal.querySelector('.pagefind-ui__search-input') : null;
      if (input) input.value = '';
      var suggestions = document.getElementById('search-suggestions');
      if (suggestions) suggestions.classList.add('hidden');
    }

    function cleanupSearch() {
      if (window.__searchHandlers.keydown) {
        document.removeEventListener('keydown', window.__searchHandlers.keydown);
        window.__searchHandlers.keydown = null;
      }
    }

    function initSearch() {
      cleanupSearch();

      var searchButtons = document.querySelectorAll('[data-search-trigger]');
      var closeButton = document.getElementById('search-close');
      var clearRecentBtn = document.getElementById('clear-recent-searches');
      var modal = document.getElementById('search-modal');
      var overlay = document.getElementById('search-overlay');

      // Element listeners - auto-cleaned on DOM swap
      searchButtons.forEach(function(btn) {
        btn.addEventListener('click', openSearch);
      });
      if (closeButton) closeButton.addEventListener('click', closeSearch);
      if (overlay) overlay.addEventListener('click', closeSearch);
      if (clearRecentBtn) {
        clearRecentBtn.addEventListener('click', function() {
          clearAllRecentSearches();
          renderRecentSearches();
        });
      }

      // Setup input listeners after delay for Pagefind
      setTimeout(function() {
        var input = modal ? modal.querySelector('.pagefind-ui__search-input') : null;
        if (!input) return;

        input.addEventListener('input', function(e) {
          var query = e.target.value;
          if (query.trim()) {
            hideRecentSearches();
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(function() {
              showSuggestions(query);
            }, 300);
          } else {
            var suggestions = document.getElementById('search-suggestions');
            if (suggestions) suggestions.classList.add('hidden');
            showRecentSearches();
          }
        });

        input.addEventListener('keydown', function(e) {
          if (e.key === 'Enter') {
            var query = e.target.value;
            if (query.trim()) saveRecentSearch(query);
          }
        });
      }, 500);

      // Global keydown handler - store for cleanup
      window.__searchHandlers.keydown = function(e) {
        if (e.key === 'Escape' && window.__searchState.isOpen) {
          closeSearch();
        }
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          if (window.__searchState.isOpen) {
            closeSearch();
          } else {
            openSearch();
          }
        }
      };
      document.addEventListener('keydown', window.__searchHandlers.keydown);
    }

    function checkPagefind() {
      fetch('/pagefind/pagefind.js', {method: 'HEAD'})
        .then(function(response) {
          if (!response.ok) showFallback();
        })
        .catch(function() {
          showFallback();
        });
    }

    function showFallback() {
      var fallback = document.getElementById('search-fallback');
      var wrapper = document.getElementById('search-wrapper');
      if (fallback && wrapper) {
        fallback.classList.remove('hidden');
        wrapper.classList.add('hidden');
      }
    }

    // Register event listeners once
    document.addEventListener('astro:page-load', function() {
      initSearch();
      checkPagefind();
    });
    document.addEventListener('astro:before-swap', cleanupSearch);
  }
</script>
