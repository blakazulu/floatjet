---

interface Props {
  href: string;
  text: string;
  variant?: "primary" | "secondary" | "ghost";
  program?: string;
  product?: string;
  fullWidth?: boolean;
  /** Optional small line under the label, e.g. "3-day free trial" */
  subtext?: string;
}

const { href, text, variant = "primary", program, product, fullWidth = false, subtext } = Astro.props;

const classes = ["cta-button", `cta-${variant}`, fullWidth ? "full-width" : ""]
  .filter(Boolean)
  .join(" ");
---

<a
    href={href}
    class={classes}
    rel="nofollow sponsored noopener"
    target="_blank"
    data-program={program}
    data-product={product || text}
    data-affiliate-track
>
  {subtext ? (
    <span class="cta-label">
      <span>{text}</span>
      <span class="cta-subtext">{subtext}</span>
    </span>
  ) : (
    <span>{text}</span>
  )}
  <svg class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
</a>

<script>
  // GA4 Affiliate Click Tracking
  // Uses dataLayer.push which is forwarded to Partytown worker
  function initAffiliateTracking() {
    document.querySelectorAll('[data-affiliate-track]').forEach(link => {
      // Avoid duplicate listeners
      if (link.hasAttribute('data-tracking-initialized')) return;
      link.setAttribute('data-tracking-initialized', 'true');

      link.addEventListener('click', function(e) {
        const target = e.currentTarget as HTMLAnchorElement;
        const program = target.dataset.program || 'unknown';
        const product = target.dataset.product || 'unknown';
        const linkUrl = target.href;

        // Push to dataLayer (forwarded to GA4 via Partytown)
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'affiliate_click',
          affiliate_name: program,
          product_name: product,
          link_url: linkUrl,
          value: 1.00,
          currency: 'USD'
        });
      });
    });
  }

  // Initialize on page load
  initAffiliateTracking();

  // Re-initialize after Astro view transitions
  document.addEventListener('astro:page-load', initAffiliateTracking);
</script>

<style>
  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: 52px;

    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9375rem;
    line-height: 1.2;
    text-decoration: none;

    padding: 0.875rem 1.625rem;
    border-radius: 999px;

    transition: transform 0.2s, box-shadow 0.2s, background-color 0.2s, color 0.2s;
    cursor: pointer;
  }

  .cta-button.full-width {
    width: 100%;
  }

  .cta-label {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.125rem;
  }

  .cta-subtext {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.75rem;
    opacity: 0.9;
  }

  .cta-button svg {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    transition: transform 0.2s;
  }

  .cta-button:hover svg {
    transform: translateX(4px);
  }

  /* Primary - ink sticker with sun text */
  .cta-primary {
    background: var(--color-ink);
    color: var(--color-sun);
    border: 1.5px solid var(--color-ink);
    box-shadow: 4px 5px 0 0 var(--color-jet-stream);
  }

  .cta-primary:hover {
    transform: translate(-1px, -2px);
    box-shadow: 4px 5px 0 0 var(--color-jet-stream);
  }

  /* Secondary - sun sticker */
  .cta-secondary {
    background: var(--color-sun);
    color: var(--color-ink);
    border: 1.5px solid var(--color-ink);
    box-shadow: 4px 5px 0 0 var(--color-ink);
  }

  .cta-secondary:hover {
    transform: translate(-1px, -2px);
    box-shadow: 4px 5px 0 0 var(--color-ink);
  }

  /* Ghost - text link */
  .cta-ghost {
    background: none;
    min-height: 48px;
    padding: 0.5rem 0;
    color: var(--color-teal-ink);
    border-radius: 0;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .cta-ghost:hover {
    color: var(--color-ink);
  }

  .cta-ghost svg {
    width: 1rem;
    height: 1rem;
  }

  /* Mobile - Full width for primary/secondary */
  @media (max-width: 640px) {
    .cta-primary,
    .cta-secondary {
      width: 100%;
      padding: 1rem 1.5rem;
    }
  }
</style>
