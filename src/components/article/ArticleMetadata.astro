---

interface Props {
  author: string;
  authorUrl?: string;
  pubDate: Date;
  updatedDate?: Date;
  readingTime?: number;
}

const { author, authorUrl, pubDate, updatedDate, readingTime } = Astro.props;

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(date);
};
---

<div class="article-metadata">
  <span class="metadata-item">
    By
    {authorUrl ? (
        <a href={authorUrl} class="author-link">{author}</a>
    ) : (
        <strong class="author-name">{author}</strong>
    )}
  </span>

  <span class="separator" aria-hidden="true">/</span>

  {updatedDate ? (
      <time class="metadata-item" datetime={updatedDate.toISOString()}>
        Updated {formatDate(updatedDate)}
      </time>
  ) : (
      <time class="metadata-item" datetime={pubDate.toISOString()}>
        {formatDate(pubDate)}
      </time>
  )}

  {readingTime && (
      <>
        <span class="separator" aria-hidden="true">/</span>
        <span class="metadata-item reading-time">
        <svg class="clock-icon" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          {readingTime} min read
      </span>
      </>
  )}
</div>

<style>
  .article-metadata {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink-soft);
  }

  .metadata-item {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .author-link {
    color: var(--color-ink);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-sun);
    transition: color 0.2s;
  }

  .author-link:hover {
    color: var(--color-teal-ink);
  }

  .author-name {
    color: var(--color-ink);
    font-weight: 700;
  }

  .separator {
    margin: 0 0.5rem;
    user-select: none;
    color: var(--color-ink-soft);
  }

  .reading-time {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .clock-icon {
    width: 1rem;
    height: 1rem;
    color: var(--color-ink-soft);
  }

  @media (max-width: 640px) {
    .article-metadata {
      font-size: 0.875rem;
    }

    .separator {
      margin: 0 0.375rem;
    }
  }
</style>
