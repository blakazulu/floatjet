---
interface Props {
  items: Array<{
    label: string;
    href?: string;
  }>;
}

const { items } = Astro.props;

// Schema.org BreadcrumbList markup
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    item: item.href ? `https://floatjet.com${item.href}` : undefined,
  })),
};
---

<nav aria-label="Breadcrumb" class="breadcrumbs">
  <ol>
    {items.map((item, index) => (
        <li>
          {item.href ? (
              <a href={item.href}>{item.label}</a>
          ) : (
              <span aria-current="page">{item.label}</span>
          )}
          {index < items.length - 1 && (
              <span class="separator" aria-hidden="true">›</span>
          )}
        </li>
    ))}
  </ol>
</nav>

<!-- BreadcrumbList Schema -->
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}/>

<style>
  .breadcrumbs {
    margin: 0 0 1.25rem;
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .breadcrumbs li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .breadcrumbs a {
    color: var(--color-teal-ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    text-decoration-color: rgba(23, 100, 102, 0.3);
    transition: color 0.2s, text-decoration-color 0.2s;
  }

  .breadcrumbs a:hover {
    color: var(--color-ink);
    text-decoration-color: var(--color-sun);
  }

  .breadcrumbs span[aria-current="page"] {
    color: var(--color-ink-soft);
    max-width: 400px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .breadcrumbs .separator {
    color: var(--color-ink-soft);
    user-select: none;
  }

  /* Mobile: truncate middle items */
  @media (max-width: 640px) {
    .breadcrumbs li:not(:first-child):not(:last-child) {
      display: none;
    }

    .breadcrumbs li:first-child::after {
      content: "...";
      color: var(--color-ink-soft);
      margin-left: 0.5rem;
    }

    .breadcrumbs span[aria-current="page"] {
      max-width: 180px;
    }
  }
</style>
