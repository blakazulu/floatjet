---

interface TableColumn {
  key: string;
  label: string;
  width?: string;
}

interface TableRow {
  [key: string]: string | number | boolean;
}

interface Props {
  columns: TableColumn[];
  rows: TableRow[];
  caption?: string;
  highlight?: number;
}

const { columns, rows, caption, highlight } = Astro.props;
---

<div class="table-wrapper">
  <div class="scroll-hint" aria-hidden="true"></div>
  <table class="comparison-table">
    {caption &&
        <caption class="sr-only">{caption}</caption>}
    <thead>
    <tr>
      {
        columns.map((col) => (
            <th scope="col" style={col.width ? `min-width: ${col.width}` : ''}>
              {col.label}
            </th>
        ))
      }
    </tr>
    </thead>
    <tbody>
    {
      rows.map((row, index) => (
          <tr class={highlight === index ? 'highlighted' : ''}>
            {columns.map((col) => (
                <td data-label={col.label}>
                  {typeof row[col.key] === 'boolean' ? (
                    row[col.key] ? (
                        <span class="check" aria-label="Yes">
                          <svg class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
                        </span>
                    ) : (
                        <span class="cross" aria-label="No">
                          <svg class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg>
                        </span>
                    )
                  ) : (
                      <Fragment set:html={row[col.key]}/>
                  )}
                </td>
            ))}
          </tr>
      ))
    }
    </tbody>
  </table>
</div>

<style>
  .table-wrapper {
    position: relative;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 1.75rem 0 2rem;
    border: 1.5px solid var(--color-ink);
    border-radius: 20px;
    background: var(--color-card);
    box-shadow: 4px 5px 0 0 var(--color-ink);
  }

  /* Remove margin when in full-width section */
  :global(.full-width-section) .table-wrapper {
    margin: 0;
  }

  /* Scroll hint shadow */
  .scroll-hint {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 2rem;
    background: linear-gradient(to left, rgba(8, 47, 56, 0.18), transparent);
    pointer-events: none;
    z-index: 5;
    opacity: 1;
    transition: opacity 0.2s;
  }

  .table-wrapper::-webkit-scrollbar {
    height: 8px;
  }

  .table-wrapper::-webkit-scrollbar-track {
    background: var(--color-paper-deep);
  }

  .table-wrapper::-webkit-scrollbar-thumb {
    background: var(--color-ink);
    border-radius: 999px;
  }

  .comparison-table {
    width: 100%;
    margin: 0;
    border-collapse: collapse;
    background: var(--color-card);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Header */
  .comparison-table thead th {
    background: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.01em;
    color: var(--color-sun);
    text-align: left;
    padding: 1rem 1.25rem;
    white-space: nowrap;
  }

  /* Body */
  .comparison-table tbody tr {
    transition: background 0.2s;
  }

  .comparison-table tbody tr:nth-child(even) {
    background: #FAF8F3;
  }

  .comparison-table tbody tr:hover {
    background: var(--color-sand);
  }

  /* Highlighted Row */
  .comparison-table tbody tr.highlighted {
    background: #FFF4C7;
  }

  .comparison-table tbody tr.highlighted td:first-child {
    box-shadow: inset 6px 0 0 0 var(--color-sun);
  }

  .comparison-table tbody td {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-ink);
    padding: 1rem 1.25rem;
    border-bottom: 1px solid rgba(8, 47, 56, 0.12);
    vertical-align: middle;
  }

  .comparison-table tbody tr:last-child td {
    border-bottom: none;
  }

  .comparison-table :global(strong) {
    font-weight: 700;
    color: var(--color-ink);
  }

  /* Check/Cross icons */
  .check,
  .cross {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.625rem;
    height: 1.625rem;
    border-radius: 50%;
    border: 1.5px solid var(--color-ink);
  }

  .check {
    background: var(--color-sky-light);
    color: var(--color-ink);
  }

  .cross {
    background: var(--color-coral);
    color: var(--color-ink);
  }

  .check svg,
  .cross svg {
    width: 0.875rem;
    height: 0.875rem;
    stroke-width: 3;
  }

  /* Links in table: small sticker buttons */
  .comparison-table :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    background: var(--color-sun);
    border: 1.5px solid var(--color-ink);
    color: var(--color-ink);
    font-weight: 700;
    font-size: 0.8125rem;
    white-space: nowrap;
    text-decoration: none;
    box-shadow: 2px 3px 0 0 var(--color-ink);
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .comparison-table :global(a:hover) {
    transform: translate(-1px, -1px);
    box-shadow: 3px 4px 0 0 var(--color-ink);
  }

  /* Mobile responsive - horizontal scroll */
  @media (max-width: 768px) {
    .comparison-table {
      min-width: 600px;
    }

    .comparison-table thead th,
    .comparison-table tbody td {
      padding: 0.875rem 1rem;
      font-size: 0.875rem;
    }

    .comparison-table thead th {
      font-size: 0.75rem;
    }
  }
</style>

<script is:inline>
  // Comparison Table scroll hint with proper cleanup for View Transitions

  if (!window.__comparisonTableInit) {
    window.__comparisonTableInit = true;
    window.__comparisonTableHandlers = { resize: null };

    function cleanupComparisonTable() {
      if (window.__comparisonTableHandlers.resize) {
        window.removeEventListener('resize', window.__comparisonTableHandlers.resize);
        window.__comparisonTableHandlers.resize = null;
      }
    }

    function initComparisonTable() {
      cleanupComparisonTable();

      var wrappers = document.querySelectorAll('.table-wrapper');
      if (wrappers.length === 0) return;

      // Store all checkScroll functions for resize handler
      var checkScrollFns = [];

      wrappers.forEach(function(wrapper) {
        var hint = wrapper.querySelector('.scroll-hint');

        var checkScroll = function() {
          var isScrolledToEnd =
            wrapper.scrollLeft + wrapper.clientWidth >= wrapper.scrollWidth - 10;
          var hasScroll = wrapper.scrollWidth > wrapper.clientWidth;

          if (hint) {
            hint.style.opacity = hasScroll && !isScrolledToEnd ? '1' : '0';
          }
        };

        // Element listener - auto-cleaned on DOM swap
        wrapper.addEventListener('scroll', checkScroll);
        checkScroll(); // Initial check

        checkScrollFns.push(checkScroll);
      });

      // Single global resize handler for all tables
      window.__comparisonTableHandlers.resize = function() {
        checkScrollFns.forEach(function(fn) { fn(); });
      };
      window.addEventListener('resize', window.__comparisonTableHandlers.resize);
    }

    // Register event listeners once
    document.addEventListener('astro:page-load', initComparisonTable);
    document.addEventListener('astro:before-swap', cleanupComparisonTable);
  }
</script>
