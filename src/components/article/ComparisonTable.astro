---
interface TableColumn {
  key: string;
  label: string;
  width?: string;
}

interface TableRow {
  [key: string]: string | number | boolean;
}

interface Props {
  columns: TableColumn[];
  rows: TableRow[];
  caption?: string;
}

const {columns, rows, caption} = Astro.props;
---

<div class="table-wrapper">
  <div class="scroll-hint" aria-hidden="true"></div>
  <table class="comparison-table">
    {caption &&
        <caption class="sr-only">{caption}</caption>}
    <thead>
    <tr>
      {columns.map(col => (
          <th scope="col" style={col.width ? `min-width: ${col.width}` : ''}>
            {col.label}
          </th>
      ))}
    </tr>
    </thead>
    <tbody>
    {rows.map(row => (
        <tr>
          {columns.map((col, index) => (
              <td data-label={col.label}>
                {typeof row[col.key] === 'boolean' ? (
                  row[col.key] ? (
                      <span class="check" aria-label="Yes">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd"
                            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                            clip-rule="evenodd"/>
                    </svg>
                  </span>
                  ) : (
                      <span class="cross" aria-label="No">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd"
                            d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                            clip-rule="evenodd"/>
                    </svg>
                  </span>
                  )
                ) : (
                    <Fragment set:html={row[col.key]}/>
                )}
              </td>
          ))}
        </tr>
    ))}
    </tbody>
  </table>
</div>

<style>
  .table-wrapper {
    position: relative;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 1.5rem 0;
    border-radius: 0.75rem;
  }

  /* Remove margin when in full-width section */
  :global(.full-width-section) .table-wrapper {
    margin: 0;
  }

  /* Scroll hint shadow */
  .scroll-hint {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 2rem;
    background: linear-gradient(to left, rgba(0, 0, 0, 0.3), transparent);
    pointer-events: none;
    z-index: 5;
    opacity: 1;
    transition: opacity 0.2s;
  }

  .table-wrapper::-webkit-scrollbar {
    height: 6px;
  }

  .table-wrapper::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
  }

  .table-wrapper::-webkit-scrollbar-thumb {
    background: rgba(128, 206, 215, 0.5);
    border-radius: 3px;
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Header */
  .comparison-table thead th {
    position: sticky;
    top: 0;
    background: rgba(15, 76, 92, 0.95);
    backdrop-filter: blur(8px);
    z-index: 10;

    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 0.875rem;
    color: white;
    text-align: left;
    padding: 1rem 1.25rem;
    white-space: nowrap;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  .comparison-table thead th:first-child {
    border-top-left-radius: 0.75rem;
  }

  .comparison-table thead th:last-child {
    border-top-right-radius: 0.75rem;
  }

  /* Body */
  .comparison-table tbody tr {
    transition: background 0.2s;
  }

  .comparison-table tbody tr:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .comparison-table tbody td {
    font-family: 'Inter', sans-serif;
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.9);
    padding: 1rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    vertical-align: middle;
  }

  .comparison-table tbody tr:last-child td {
    border-bottom: none;
  }

  .comparison-table tbody tr:last-child td:first-child {
    border-bottom-left-radius: 0.75rem;
  }

  .comparison-table tbody tr:last-child td:last-child {
    border-bottom-right-radius: 0.75rem;
  }

  /* Check/Cross icons */
  .check,
  .cross {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
  }

  .check {
    background: rgba(56, 163, 165, 0.2);
    color: #38A3A5;
  }

  .cross {
    background: rgba(193, 18, 31, 0.2);
    color: #C1121F;
  }

  .check svg,
  .cross svg {
    width: 1rem;
    height: 1rem;
  }

  /* Links in table */
  .comparison-table :global(a) {
    color: #80CED7;
    text-decoration: none;
  }

  .comparison-table :global(a:hover) {
    text-decoration: underline;
  }

  /* Mobile responsive - horizontal scroll */
  @media (max-width: 768px) {
    .comparison-table {
      min-width: 600px;
    }

    .comparison-table thead th,
    .comparison-table tbody td {
      padding: 0.875rem 1rem;
      font-size: 0.8125rem;
    }
  }
</style>

<script>
  // Hide scroll hint when scrolled to end
  document.addEventListener('DOMContentLoaded', () => {
    const wrappers = document.querySelectorAll('.table-wrapper');

    wrappers.forEach(wrapper => {
      const hint = wrapper.querySelector('.scroll-hint') as HTMLElement;

      const checkScroll = () => {
        const isScrolledToEnd = wrapper.scrollLeft + wrapper.clientWidth >= wrapper.scrollWidth - 10;
        const hasScroll = wrapper.scrollWidth > wrapper.clientWidth;

        if (hint) {
          hint.style.opacity = hasScroll && !isScrolledToEnd ? '1' : '0';
        }
      };

      wrapper.addEventListener('scroll', checkScroll);
      checkScroll(); // Initial check

      // Recheck on window resize
      window.addEventListener('resize', checkScroll);
    });
  });
</script>
