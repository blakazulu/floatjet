---
interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  faqs: FAQ[];
}

const { faqs } = Astro.props;

// FAQ Schema markup for rich snippets
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer.replace(/<[^>]*>/g, '') // Strip HTML for schema
    }
  }))
};
---

<section class="faq-section">
  <h2>Frequently Asked Questions</h2>

  <div class="faq-list">
    {faqs.map((faq) => (
      <details class="faq-item">
        <summary class="faq-question">
          <svg class="faq-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
          </svg>
          <span>{faq.question}</span>
        </summary>
        <div class="faq-answer" set:html={faq.answer} />
      </details>
    ))}
  </div>
</section>

<!-- FAQ Schema Markup for SEO -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .faq-section {
    margin: 4rem 0 2rem;
  }

  .faq-section h2 {
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 2rem;
    color: white;
    margin-bottom: 1.5rem;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    transition: background 0.2s, border-color 0.2s;
  }

  .faq-item:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(128, 206, 215, 0.3);
  }

  .faq-item[open] {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(128, 206, 215, 0.4);
  }

  .faq-question {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    font-size: 1.0625rem;
    color: white;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: #38A3A5;
    flex-shrink: 0;
    margin-top: 0.125rem;
    transition: transform 0.2s;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(90deg);
  }

  .faq-question span {
    flex: 1;
  }

  .faq-answer {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 1rem;
    padding-left: 2rem;
  }

  .faq-answer :global(p) {
    margin-bottom: 0.75rem;
  }

  .faq-answer :global(p:last-child) {
    margin-bottom: 0;
  }

  .faq-answer :global(a) {
    color: #80CED7;
    text-decoration: underline;
  }

  .faq-answer :global(a:hover) {
    color: #38A3A5;
  }

  @media (max-width: 640px) {
    .faq-section h2 {
      font-size: 1.75rem;
    }

    .faq-question {
      font-size: 1rem;
    }

    .faq-answer {
      font-size: 0.9375rem;
      padding-left: 2rem;
    }
  }
</style>
