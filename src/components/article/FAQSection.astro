---

interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  faqs: FAQ[];
}

const { faqs } = Astro.props;

// FAQ Schema markup for rich snippets
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      // Strip HTML for schema - block-level tags become spaces so paragraphs don't run together
      text: faq.answer
        .replace(/<\/?(p|br|li|ul|ol|div|h[1-6])[^>]*>/gi, " ")
        .replace(/<[^>]*>/g, "")
        .replace(/\s+/g, " ")
        .trim(),
    },
  })),
};
---

<section class="faq-section">
  <h2 id="faq">Frequently Asked Questions</h2>

  <div class="faq-list">
    {faqs.map((faq, index) => (
        <details class="faq-item">
          <summary class="faq-question" aria-label={faq.question}>
            <svg class="faq-icon" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
            <span aria-hidden="true">{faq.question}</span>
          </summary>
          <div class="faq-answer" set:html={faq.answer}/>
        </details>
    ))}
  </div>
</section>

<!-- FAQ Schema Markup for SEO -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)}/>

<style>
  .faq-section {
    margin: 4rem 0 2rem;
  }

  .faq-section h2 {
    margin-bottom: 1.5rem;
  }

  /* The article already introduced the FAQ with its own H2: keep ours only as the #faq anchor */
  :global(h2) + .faq-section {
    margin-top: 1.5rem;
  }

  :global(h2) + .faq-section > h2 {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .faq-item {
    background: var(--color-card);
    border: 2px solid var(--color-ink);
    border-radius: 18px;
    padding: 1rem 1.25rem;
    transition: box-shadow 0.2s, transform 0.2s, background-color 0.2s;
  }

  .faq-item:hover {
    box-shadow: 4px 5px 0 0 var(--color-ink);
    transform: translate(-1px, -1px);
  }

  .faq-item[open] {
    background: var(--color-card);
    box-shadow: 6px 8px 0 0 var(--color-sun);
  }

  .faq-question {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    min-height: 28px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.4;
    color: var(--color-ink);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    width: 1.5rem;
    height: 1.5rem;
    padding: 0.2rem;
    border-radius: 999px;
    background: var(--color-sun);
    color: var(--color-ink);
    flex-shrink: 0;
    transition: transform 0.2s;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(90deg);
  }

  .faq-question span {
    flex: 1;
  }

  .faq-answer {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-ink);
    margin-top: 0.875rem;
    padding-left: 2.25rem;
  }

  .faq-answer :global(p) {
    font-size: 1rem;
    margin-bottom: 0.75rem;
  }

  .faq-answer :global(p:last-child) {
    margin-bottom: 0;
  }

  .faq-answer :global(a) {
    color: var(--color-teal-ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .faq-answer :global(a:hover) {
    color: var(--color-ink);
  }

  @media (max-width: 640px) {
    .faq-question {
      font-size: 1rem;
    }

    .faq-answer {
      font-size: 0.9375rem;
      padding-left: 0;
    }
  }
</style>
