---
import ArticleCard from "@components/ui/ArticleCard.astro";

interface Article {
  title: string;
  excerpt: string;
  href: string;
  image: string;
  imageAlt: string;
}

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;
---

<section class="related-articles" id="related-articles">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <div class="rounded-[36px] bg-paper-deep border-2 border-ink px-5 py-10 md:px-10 md:py-14">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-2 mb-8 md:mb-10">
        <div>
          <p class="hand text-2xl text-teal-ink -rotate-1">while you're here</p>
          <h2 class="font-display font-black text-3xl md:text-4xl tracking-tight text-ink">Related articles</h2>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-7">
        {articles.map((article) => (
          <ArticleCard
            href={article.href}
            title={article.title}
            description={article.excerpt}
            image={article.image}
            imageAlt={article.imageAlt}
          />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .related-articles {
    padding: 2rem 0 0;
  }
</style>
