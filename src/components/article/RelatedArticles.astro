---
import { Image } from "astro:assets";
import ImageLoader from "@components/ui/ImageLoader.astro";

interface Article {
  title: string;
  excerpt: string;
  href: string;
  image: string;
  imageAlt: string;
}

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;
---

<section class="related-articles" id="related-articles">
  <div class="container mx-auto px-4 md:px-6">
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-10 text-center font-heading">Related Articles</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {articles.map((article) => (
          <article
              class="group relative rounded-3xl overflow-hidden transition-all duration-300 hover:-translate-y-1">
            <!-- Glass Card Background -->
            <div
                class="absolute inset-0 bg-gradient-to-br from-white/25 via-white/5 to-transparent backdrop-blur-lg border border-white/10 border-t-white/30 border-l-white/30 rounded-3xl shadow-lg group-hover:shadow-2xl group-hover:from-white/30 group-hover:via-white/10 group-hover:to-white/5 transition-all duration-300"></div>

            <a href={article.href} class="relative block h-full z-10 flex flex-col p-4">
              <!-- Card Image -->
              <div
                  class="related-image-container relative h-48 overflow-hidden rounded-2xl mb-5 shadow-md bg-gradient-to-br from-ocean-deep/60 via-jet-stream/40 to-sky-light/30">
                <ImageLoader/>
                <Image
                    src={article.image}
                    alt={article.imageAlt}
                    width={800}
                    height={450}
                    class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500 related-image"
                    loading="lazy"
                />
              </div>

              <!-- Card Content -->
              <div class="flex-1 flex flex-col px-2">
                <h3 class="text-xl font-bold text-white mb-3 leading-tight font-heading">
                  {article.title}
                </h3>
                <p class="text-gray-300 mb-6 text-sm leading-relaxed flex-1">
                  {article.excerpt}
                </p>

                <!-- CTA -->
                <div
                    class="flex items-center text-sm font-semibold text-sky-300 group-hover:text-white transition-colors mt-auto">
                  Read Article
                  <svg class="h-3 w-3 ml-1 group-hover:translate-x-1 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M7 17 17 7m0 0H7m10 0v10"/></svg>
                </div>
              </div>
            </a>
          </article>
      ))}
    </div>
  </div>
</section>

<style>
  .related-articles {
    padding: 4rem 0;
    margin-top: 3rem;
  }

  .related-image {
    position: relative;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }

  .related-image.loaded {
    opacity: 1;
  }

  /* Hide loader when image is loaded */
  .related-image-container:has(.related-image.loaded) :global(.image-loader) {
    opacity: 0;
  }
</style>

<script is:inline>
  // RelatedArticles with proper deduplication for View Transitions

  if (!window.__relatedArticlesInit) {
    window.__relatedArticlesInit = true;

    function initRelatedImages() {
      var images = document.querySelectorAll('.related-image');
      images.forEach(function(img) {
        if (img.complete && img.naturalHeight !== 0) {
          img.classList.add('loaded');
        } else {
          img.addEventListener('load', function() {
            img.classList.add('loaded');
          }, {once: true});
        }
      });
    }

    // Register event listener once
    document.addEventListener('astro:page-load', initRelatedImages);
  }
</script>
