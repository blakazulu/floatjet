---
import {
  FacebookShareButton,
  LinkedInShareButton,
  RedditShareButton,
  SocialShare as SocialShareButtons,
  TwitterShareButton,
  WhatsAppShareButton,
} from "astro-social-share";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "" } = Astro.props;

// Always use production URL for sharing (localhost won't work with social platforms)
const currentUrl = Astro.url.href;
const shareUrl = currentUrl.replace(/^https?:\/\/localhost:\d+/, "https://floatjet.com");

// Select which buttons to show
const buttons = [
  TwitterShareButton,
  LinkedInShareButton,
  FacebookShareButton,
  RedditShareButton,
  WhatsAppShareButton,
];
---

<!-- Desktop: Floating sidebar on left -->
<aside class="social-share-desktop" aria-label="Share this article">
  <div class="share-container">
    <span class="share-label">Share</span>

    <div class="share-buttons">
      <SocialShareButtons
          buttons={buttons}
          url={shareUrl}
          title={title}
          description={description}
      >
        <style slot="astro-social-share-css" is:global>
          .social-share-desktop .astro-social-share {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            margin: 0;
            height: auto;
          }

          .social-share-desktop .astro-social-share a {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 50%;
            background: var(--color-sand);
            border: 1.5px solid var(--color-ink);
            margin: 0;
            transition: all 0.2s ease;
          }

          .social-share-desktop .astro-social-share a:hover {
            background: var(--color-sun);
            transform: scale(1.08);
          }

          .social-share-desktop .astro-social-share a:focus-visible {
            outline: 3px solid var(--color-ocean-deep);
            outline-offset: 2px;
          }

          .social-share-desktop .astro-social-share svg {
            width: 18px;
            height: 18px;
            fill: var(--color-ink);
          }
        </style>
      </SocialShareButtons>

      <!-- Copy Link Button -->
      <button
          type="button"
          class="copy-link-btn"
          aria-label="Copy link to clipboard"
          title="Copy link"
          data-url={shareUrl}
      >
        <svg class="link-icon h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        <svg class="check-icon h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
      </button>
    </div>
  </div>
</aside>

<!-- Mobile: Floating bar at bottom -->
<aside class="social-share-mobile" aria-label="Share this article">
  <div class="share-container-mobile">
    <SocialShareButtons
        buttons={buttons}
        url={shareUrl}
        title={title}
        description={description}
    >
      <style slot="astro-social-share-css" is:global>
        .social-share-mobile .astro-social-share {
          display: flex;
          flex-direction: row;
          gap: 0.75rem;
          margin: 0;
          height: auto;
        }

        .social-share-mobile .astro-social-share a {
          display: flex;
          align-items: center;
          justify-content: center;
          width: 2.75rem;
          height: 2.75rem;
          border-radius: 50%;
          background: var(--color-card);
          border: 1.5px solid var(--color-ink);
          margin: 0;
          transition: all 0.2s ease;
        }

        .social-share-mobile .astro-social-share a:active {
          background: var(--color-sun);
          transform: scale(0.95);
        }

        .social-share-mobile .astro-social-share svg {
          width: 20px;
          height: 20px;
          fill: var(--color-ink);
        }
      </style>
    </SocialShareButtons>

    <!-- Copy Link Button -->
    <button
        type="button"
        class="copy-link-btn-mobile"
        aria-label="Copy link to clipboard"
        title="Copy link"
        data-url={shareUrl}
    >
      <svg class="link-icon h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
      <svg class="check-icon h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
    </button>
  </div>
</aside>

<style>
  /* ==================== DESKTOP: Left sidebar ==================== */
  .social-share-desktop {
    position: fixed;
    left: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    display: none;
  }

  @media (min-width: 1280px) {
    .social-share-desktop {
      display: block;
    }
  }

  .share-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 0.625rem;
    background: var(--color-card);
    border: 1.5px solid var(--color-ink);
    border-radius: 999px;
    box-shadow: 4px 5px 0 0 var(--color-ink);
  }

  .share-label {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-teal-ink);
    writing-mode: vertical-rl;
    text-orientation: mixed;
    transform: rotate(180deg);
  }

  .share-buttons {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .copy-link-btn,
  .copy-link-btn-mobile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--color-sand);
    border: 1.5px solid var(--color-ink);
    color: var(--color-ink);
    cursor: pointer;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .copy-link-btn:hover {
    background: var(--color-sun);
    transform: scale(1.08);
  }

  .copy-link-btn:focus-visible,
  .copy-link-btn-mobile:focus-visible {
    outline: 3px solid var(--color-ocean-deep);
    outline-offset: 2px;
  }

  .copy-link-btn .check-icon,
  .copy-link-btn-mobile .check-icon {
    display: none;
  }

  .copy-link-btn.copied .link-icon,
  .copy-link-btn-mobile.copied .link-icon {
    display: none;
  }

  .copy-link-btn.copied .check-icon,
  .copy-link-btn-mobile.copied .check-icon {
    display: block;
  }

  .copy-link-btn.copied,
  .copy-link-btn-mobile.copied {
    background: var(--color-sky-light);
  }

  /* ==================== MOBILE: Bottom bar ==================== */
  .social-share-mobile {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 40;
    display: block;
    padding: 0.625rem 1rem;
    padding-bottom: calc(0.625rem + env(safe-area-inset-bottom));
    background: var(--color-paper);
    border-top: 2px solid var(--color-ink);
  }

  @media (min-width: 1280px) {
    .social-share-mobile {
      display: none;
    }
  }

  /* Keep the footer clear of the fixed share bar */
  @media (max-width: 1279px) {
    :global(body) {
      padding-bottom: calc(4.25rem + env(safe-area-inset-bottom));
    }
  }

  .share-container-mobile {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.625rem;
  }

  .copy-link-btn-mobile {
    width: 2.75rem;
    height: 2.75rem;
    background: var(--color-card);
  }

  .copy-link-btn-mobile:active {
    background: var(--color-sun);
    transform: scale(0.95);
  }
</style>

<script is:inline>
  // SocialShare with proper deduplication for View Transitions

  if (!window.__socialShareInit) {
    window.__socialShareInit = true;

    function initCopyLink() {
      var copyButtons = document.querySelectorAll('.copy-link-btn, .copy-link-btn-mobile');

      copyButtons.forEach(function(button) {
        button.addEventListener('click', function() {
          var url = button.getAttribute('data-url');
          if (!url) return;

          navigator.clipboard.writeText(url)
            .then(function() {
              button.classList.add('copied');

              // Reset after 2 seconds
              setTimeout(function() {
                button.classList.remove('copied');
              }, 2000);
            })
            .catch(function(err) {
              console.error('Failed to copy:', err);
            });
        });
      });
    }

    // Register event listener once
    document.addEventListener('astro:page-load', initCopyLink);
  }
</script>
