---

interface Heading {
  text: string;
  slug: string;
  /** Defaults to 2 when omitted */
  depth?: number;
}

interface Props {
  headings: Heading[];
  mobile?: boolean;
}

const { headings, mobile = false } = Astro.props;

// Filter to only H2 and H3
const filteredHeadings = headings
  .map((h) => ({ ...h, depth: h.depth ?? 2 }))
  .filter((h) => h.depth === 2 || h.depth === 3);
---

{mobile ? (
<div class="toc-mobile">
  <button class="toc-toggle" aria-label="Toggle table of contents" aria-expanded="false">
    <svg class="toc-icon" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
    <span>Contents</span>
  </button>

  <!-- Backdrop for closing -->
  <div class="toc-backdrop" hidden></div>

  <div class="toc-overlay" hidden>
    <div class="toc-overlay-header">
      <h2>Table of Contents</h2>
      <button class="toc-close" aria-label="Close table of contents">
        <svg class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <nav class="toc-overlay-nav">
      <ul>
        {filteredHeadings.map(heading => (
            <li class={`depth-${heading.depth}`}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
        ))}
      </ul>
    </nav>
  </div>
</div>
  ) : (
<div class="toc-sidebar">
  <div class="toc-content">
    <h2 class="toc-title">In this article</h2>
    <nav>
      <ul class="toc-list">
        {filteredHeadings.map(heading => (
            <li class={`toc-item depth-${heading.depth}`}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
        ))}
      </ul>
    </nav>
  </div>
</div>
  )}

{/* Script only included once via mobile prop - mobile version is rendered second */}
{mobile && (
<script is:inline>
  // Mobile TOC toggle functionality with proper cleanup
  // Script only included once (in mobile version of component)

  if (!window.__tocInit) {
    window.__tocInit = true;

    // Persistent handlers stored on window
    window.__tocHandlers = {
      escapeKey: null,
      scroll: null
    };

    function cleanupTOC() {
      // Remove global listeners using stored references
      if (window.__tocHandlers.escapeKey) {
        document.removeEventListener('keydown', window.__tocHandlers.escapeKey);
        window.__tocHandlers.escapeKey = null;
      }
      if (window.__tocHandlers.scroll) {
        window.removeEventListener('scroll', window.__tocHandlers.scroll);
        window.__tocHandlers.scroll = null;
      }
    }

    function initTOC() {
      // Clean up any existing listeners first
      cleanupTOC();

      // Only run on pages with TOC elements
      var toggleBtn = document.querySelector('.toc-toggle');
      var closeBtn = document.querySelector('.toc-close');
      var overlay = document.querySelector('.toc-overlay');
      var backdrop = document.querySelector('.toc-backdrop');

      // Exit early if no TOC elements exist on this page
      if (!toggleBtn && !overlay && !document.querySelector('.toc-sidebar')) {
        return;
      }

      var links = overlay ? overlay.querySelectorAll('a') : [];

      function openTOC() {
        if (overlay) overlay.removeAttribute('hidden');
        if (backdrop) backdrop.removeAttribute('hidden');
        if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'true');
      }

      function closeTOC() {
        if (overlay) overlay.setAttribute('hidden', '');
        if (backdrop) backdrop.setAttribute('hidden', '');
        if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
      }

      // Element listeners - these get cleaned up automatically when DOM is replaced
      if (toggleBtn) toggleBtn.addEventListener('click', openTOC);
      if (closeBtn) closeBtn.addEventListener('click', closeTOC);
      if (backdrop) backdrop.addEventListener('click', closeTOC);
      links.forEach(function(link) {
        link.addEventListener('click', closeTOC);
      });

      // Global escape key handler - store reference for cleanup
      window.__tocHandlers.escapeKey = function(e) {
        if (e.key === 'Escape' && overlay && !overlay.hasAttribute('hidden')) {
          closeTOC();
        }
      };
      document.addEventListener('keydown', window.__tocHandlers.escapeKey);

      // Active link tracking
      // Track whatever the TOC links point at (headings or wrapping sections), in document order
      var seenIds = {};
      var headingElements = Array.from(document.querySelectorAll('.toc-list a, .toc-overlay-nav a'))
        .map(function(link) { return (link.getAttribute('href') || '').slice(1); })
        .filter(function(id) { if (!id || seenIds[id]) return false; seenIds[id] = true; return true; })
        .map(function(id) { return document.getElementById(id); })
        .filter(Boolean)
        .sort(function(a, b) { return a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1; });
      var tocLinks = document.querySelectorAll('.toc-list a, .toc-overlay-nav a');

      if (headingElements.length === 0) {
        return;
      }

      function setActiveLink(id) {
        tocLinks.forEach(function(link) {
          link.classList.remove('active');
          if (link.getAttribute('href') === '#' + id) {
            link.classList.add('active');
          }
        });
      }

      function updateActiveHeading() {
        var scrollY = window.scrollY + 150;
        var currentHeading = null;

        for (var i = 0; i < headingElements.length; i++) {
          var heading = headingElements[i];
          var rect = heading.getBoundingClientRect();
          var headingTop = rect.top + window.scrollY;

          if (headingTop <= scrollY) {
            currentHeading = heading;
          } else {
            break;
          }
        }

        if (currentHeading) {
          var id = currentHeading.getAttribute('id');
          if (id) setActiveLink(id);
        } else if (headingElements.length > 0) {
          var firstId = headingElements[0].getAttribute('id');
          if (firstId) setActiveLink(firstId);
        }
      }

      // Throttled scroll handler - store reference for cleanup
      var ticking = false;
      window.__tocHandlers.scroll = function() {
        if (!ticking) {
          window.requestAnimationFrame(function() {
            updateActiveHeading();
            ticking = false;
          });
          ticking = true;
        }
      };
      window.addEventListener('scroll', window.__tocHandlers.scroll, { passive: true });

      // Initial check
      updateActiveHeading();
    }

    // Register once - these persist across View Transitions
    document.addEventListener('astro:page-load', initTOC);
    document.addEventListener('astro:before-swap', cleanupTOC);
  }
</script>
)}

<style>
  /* Desktop Sidebar: a sticky note */
  .toc-sidebar {
    position: sticky;
    top: 110px;
    max-height: calc(100vh - 130px);
    overflow-y: auto;
    align-self: start;
    padding: 0 12px 14px 0;
  }

  .toc-content {
    background: var(--color-card);
    border: 1.5px solid var(--color-ink);
    border-radius: 20px;
    box-shadow: 4px 5px 0 0 var(--color-ink);
    padding: 1.25rem 1.25rem 1rem;
  }

  .toc-title {
    display: block;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.2;
    color: var(--color-teal-ink);
    margin: 0 0 0.75rem;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    margin: 0.125rem 0;
  }

  .toc-item.depth-3 {
    padding-left: 0.875rem;
  }

  .toc-list a {
    display: block;
    padding: 0.375rem 0.625rem;
    border-radius: 10px;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color 0.2s, background-color 0.2s;
  }

  .toc-list a:hover {
    color: var(--color-ink);
    background: var(--color-sand);
  }

  .toc-list a.active {
    color: var(--color-ink);
    background: var(--color-sun);
    font-weight: 700;
  }

  /* Mobile TOC - Hidden on desktop */
  .toc-mobile {
    display: block;
  }

  @media (min-width: 1024px) {
    .toc-mobile {
      display: none;
    }
  }

  .toc-toggle {
    position: fixed;
    bottom: calc(5rem + env(safe-area-inset-bottom));
    right: 1rem;
    z-index: 100;

    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;

    background: var(--color-ink);
    color: var(--color-sun);
    border: 1.5px solid var(--color-ink);
    border-radius: 999px;
    padding: 0.75rem 1.25rem;

    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;

    box-shadow: 4px 5px 0 0 var(--color-jet-stream);
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .toc-toggle:hover {
    transform: translateY(-2px);
    box-shadow: 5px 7px 0 0 var(--color-jet-stream);
  }

  .toc-icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  .toc-overlay {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    max-height: 75vh;
    z-index: 110;

    background: var(--color-paper);
    border-top: 2px solid var(--color-ink);
    border-radius: 28px 28px 0 0;

    overflow-y: auto;
    padding-bottom: env(safe-area-inset-bottom);
    animation: slideUp 0.3s ease-out;
  }

  .toc-overlay[hidden] {
    display: none;
  }

  @keyframes slideUp {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }

  .toc-overlay-header {
    position: sticky;
    top: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.25rem 1rem;
    background: var(--color-paper);
    border-bottom: 2px solid var(--color-ink);
  }

  .toc-overlay-header h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-ink);
    margin: 0;
  }

  .toc-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(8, 47, 56, 0.55);
    z-index: 100;
  }

  .toc-backdrop[hidden] {
    display: none;
  }

  .toc-close {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 48px;
    border: none;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-sun);
    cursor: pointer;
  }

  .toc-close svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .toc-overlay-nav {
    padding: 0.5rem 1.25rem 1.5rem;
  }

  .toc-overlay-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-overlay-nav li {
    border-bottom: 1px dashed rgba(8, 47, 56, 0.2);
  }

  .toc-overlay-nav li:last-child {
    border-bottom: none;
  }

  .toc-overlay-nav li.depth-3 {
    padding-left: 1rem;
  }

  .toc-overlay-nav a {
    display: block;
    padding: 0.875rem 0.5rem;
    border-radius: 10px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-ink);
    text-decoration: none;
  }

  .toc-overlay-nav a:hover,
  .toc-overlay-nav a.active {
    background: var(--color-sun);
  }
</style>
