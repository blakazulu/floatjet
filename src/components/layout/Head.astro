---
import { ViewTransitions } from "astro:transitions";
import LoadingIndicator from "astro-loading-indicator/component";
import { getImagePath } from "astro-opengraph-images";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  canonicalUrl?: string;
  /** Keep the page out of search indexes (utility pages) */
  noindex?: boolean;
}

const { title, description, type = "website", canonicalUrl, noindex = false } = Astro.props;

const siteName = "FloatJet";
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;

// Always use auto-generated OG image (astro-opengraph-images requires this)
const { url, site } = Astro;
const imageUrl = getImagePath({ url, site });

// Canonical is built from the site origin + path only, so query strings (UTM etc.) never leak in
const canonical = canonicalUrl || new URL(Astro.url.pathname, "https://floatjet.com").href;
---

<head>
  <!-- Basic Meta Tags -->
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="generator" content={Astro.generator}/>

  <!-- Affiliate Network Verification -->
  <meta name="impact-site-verification" content="599ee020-0afb-4971-9044-d3a825554dbe"/>

  <!-- SEO Meta Tags -->
  <title>{fullTitle}</title>
  <meta name="description" content={description}/>
  <link rel="canonical" href={canonical}/>
  <link rel="alternate" type="application/rss+xml" title="FloatJet" href="/rss.xml"/>

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={type}/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:title" content={fullTitle}/>
  <meta property="og:description" content={description}/>
  <meta property="og:image" content={imageUrl}/>
  <meta property="og:image:width" content="1200"/>
  <meta property="og:image:height" content="630"/>
  <meta property="og:image:alt" content={title}/>
  <meta property="og:site_name" content={siteName}/>
  <meta property="og:locale" content="en_US"/>

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:url" content={canonical}/>
  <meta name="twitter:title" content={fullTitle}/>
  <meta name="twitter:description" content={description}/>
  <meta name="twitter:image" content={imageUrl}/>

  <!-- Favicon and Web App Meta -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/>
  <meta name="theme-color" content="#F4F1EA"/>
  <meta name="mobile-web-app-capable" content="yes"/>
  <meta name="apple-mobile-web-app-status-bar-style" content="default"/>

  <!-- Resource Hints: Preconnect to critical third-party domains -->
  <link rel="preconnect" href="https://www.googletagmanager.com"/>
  <link rel="preconnect" href="https://www.google-analytics.com"/>

  <!-- DNS Prefetch: Affiliate network domains (used on article pages) -->
  <link rel="dns-prefetch" href="https://impact.com"/>
  <link rel="dns-prefetch" href="https://app.impact.com"/>

  <!-- Robots Meta -->
  <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
  />

  <!-- Google Analytics 4 (via Partytown - runs in Web Worker for better performance) -->
  <script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-FWYD66CN1E"></script>
  <script type="text/partytown">
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag('js', new Date());
    gtag('config', 'G-FWYD66CN1E');
  </script>

  <!-- View Transitions for smooth navigation -->
  <ViewTransitions/>

  <!-- Loading indicator for page transitions -->
  <LoadingIndicator color="var(--color-coral)" height="4px"/>
</head>
