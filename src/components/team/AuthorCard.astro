---
import { Image } from "astro:assets";
import type { TeamMember } from "@data/team";

interface Props {
  member: TeamMember;
  variant?: "compact" | "full";
  showLink?: boolean;
}

const { member, variant = "compact", showLink = true } = Astro.props;
---

{variant === "compact" ? (
  <div class="author-card-compact">
    <div class="author-image">
      <Image
        src={member.image}
        alt={member.name}
        width={80}
        height={80}
        loading="lazy"
      />
    </div>
    <div class="author-info">
      <h3 class="author-name">
        {showLink ? (
          <a href={`/authors/${member.slug}`}>{member.name}</a>
        ) : (
          member.name
        )}
      </h3>
      <p class="author-title">{member.title}</p>
      <p class="author-location">{member.location}</p>
    </div>
  </div>
) : (
  <div class="author-card-full">
    <div class="author-header">
      <div class="author-image-large">
        <Image
          src={member.image}
          alt={member.name}
          width={150}
          height={150}
          loading="lazy"
        />
      </div>
      <div class="author-header-info">
        <h3 class="author-name-large">
          {showLink ? (
            <a href={`/authors/${member.slug}`}>{member.name}</a>
          ) : (
            member.name
          )}
        </h3>
        <p class="author-title-large">{member.title}</p>
        <p class="author-location-large">{member.location}</p>
        {member.social && (
          <div class="author-social">
            {member.social.linkedin && (
              <a href={member.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${member.name} on LinkedIn`}>
                <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
            )}
            {member.social.github && (
              <a href={member.social.github} target="_blank" rel="noopener noreferrer" aria-label={`${member.name} on GitHub`}>
                <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                </svg>
              </a>
            )}
            {member.social.twitter && (
              <a href={member.social.twitter} target="_blank" rel="noopener noreferrer" aria-label={`${member.name} on Twitter`}>
                <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>
            )}
          </div>
        )}
      </div>
    </div>
    <p class="author-bio">{member.bioShort}</p>
    <div class="author-categories">
      {member.categories.map((cat) => (
        <span class="category-tag">{cat}</span>
      ))}
    </div>
  </div>
)}

<style>
  /* Compact variant */
  .author-card-compact {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .author-image img {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(56, 163, 165, 0.3);
  }

  .author-info {
    flex: 1;
  }

  .author-name {
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    font-size: 1.125rem;
    color: white;
    margin: 0 0 0.25rem 0;
  }

  .author-name a {
    color: white;
    text-decoration: none;
  }

  .author-name a:hover {
    color: #80CED7;
  }

  .author-title {
    font-size: 0.875rem;
    color: #38A3A5;
    margin: 0 0 0.25rem 0;
  }

  .author-location {
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
  }

  /* Full variant */
  .author-card-full {
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .author-header {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }

  @media (max-width: 480px) {
    .author-header {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }

  .author-image-large img {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid rgba(56, 163, 165, 0.4);
  }

  @media (min-width: 768px) {
    .author-image-large img {
      width: 150px;
      height: 150px;
    }
  }

  .author-header-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .author-name-large {
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 1.5rem;
    color: white;
    margin: 0 0 0.25rem 0;
  }

  .author-name-large a {
    color: white;
    text-decoration: none;
  }

  .author-name-large a:hover {
    color: #80CED7;
  }

  .author-title-large {
    font-size: 1rem;
    color: #38A3A5;
    margin: 0 0 0.25rem 0;
    font-weight: 500;
  }

  .author-location-large {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
    margin: 0 0 0.75rem 0;
  }

  .author-social {
    display: flex;
    gap: 0.75rem;
  }

  @media (max-width: 480px) {
    .author-social {
      justify-content: center;
    }
  }

  .author-social a {
    color: rgba(255, 255, 255, 0.6);
    transition: color 0.2s ease;
  }

  .author-social a:hover {
    color: #80CED7;
  }

  .social-icon {
    width: 20px;
    height: 20px;
  }

  .author-bio {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
    margin: 0 0 1rem 0;
  }

  .author-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .category-tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: rgba(56, 163, 165, 0.2);
    border: 1px solid rgba(56, 163, 165, 0.3);
    border-radius: 9999px;
    font-size: 0.75rem;
    color: #80CED7;
  }
</style>
