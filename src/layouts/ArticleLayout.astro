---
import { Image } from "astro:assets";
import ArticleMetadata from "@components/article/ArticleMetadata.astro";
import Breadcrumbs from "@components/article/Breadcrumbs.astro";
import SocialShare from "@components/article/SocialShare.astro";
import TableOfContents from "@components/article/TableOfContents.astro";
import ImageLoader from "@components/ui/ImageLoader.astro";
import BaseLayout from "./BaseLayout.astro";
import { getArticleBySlug } from "@data/articles";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  readingTime?: number;
  image?: string;
  imageAlt?: string;
  category: string;
  categorySlug: string;
  /** Optional subcategory slug for breadcrumb link (e.g., "furniture" links to /gear/furniture) */
  subcategorySlug?: string;
  headings?: Array<{ text: string; slug: string; depth?: number }>;
}

const {
  title,
  description,
  pubDate,
  updatedDate: updatedDateProp,
  readingTime,
  image,
  imageAlt = "",
  category,
  categorySlug,
  subcategorySlug,
  headings = [],
} = Astro.props;

// Review date comes from src/data/articles.ts (updatedDate) unless passed explicitly
const slug = Astro.url.pathname.split("/").filter(Boolean).pop() ?? "";
const articleData = getArticleBySlug(slug);
const updatedDate =
  updatedDateProp ?? (articleData?.updatedDate ? new Date(articleData.updatedDate) : undefined);

const pageUrl = new URL(Astro.url.pathname, "https://floatjet.com").href;

// All articles are published under the editorial team byline
const author = "FloatJet Editorial Team";
const authorUrl = "/team/";

// Build breadcrumb items
// If subcategorySlug is provided, link to /categorySlug/subcategorySlug/ (e.g., /gear/furniture/)
// Otherwise, link to just /categorySlug/ (e.g., /gear/)
const categoryHref = subcategorySlug
  ? `/${categorySlug}/${subcategorySlug}/`
  : `/${categorySlug}/`;
const breadcrumbItems = [
  { label: "Home", href: "/" },
  { label: category, href: categoryHref },
  { label: title },
];

// Author schema - the editorial team is an Organization, part of FloatJet
const authorSchema = {
  "@type": "Organization",
  name: author,
  url: `https://floatjet.com${authorUrl}`,
  parentOrganization: {
    "@type": "Organization",
    name: "FloatJet",
    url: "https://floatjet.com",
  },
};

// Article Schema markup
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: description,
  mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
  url: pageUrl,
  inLanguage: "en-US",
  image: image ? `https://floatjet.com${image}` : undefined,
  author: authorSchema,
  publisher: {
    "@type": "Organization",
    "@id": "https://floatjet.com/#organization",
    name: "FloatJet",
    logo: {
      "@type": "ImageObject",
      url: "https://floatjet.com/logo.png",
    },
  },
  datePublished: pubDate.toISOString(),
  dateModified: updatedDate ? updatedDate.toISOString() : pubDate.toISOString(),
};
---

<BaseLayout title={`${title} | FloatJet`} description={description} image={image} type="article">
  <!-- Floating Social Share Sidebar -->
  <SocialShare title={title} description={description}/>

  <article class="article-page" data-pagefind-body>
    <!-- Article Header -->
    <header class="article-header">
      <div class="mx-auto max-w-6xl px-4 md:px-6 pt-24 md:pt-32">
        <!-- Breadcrumbs - exclude from search -->
        <div data-pagefind-ignore>
          <Breadcrumbs items={breadcrumbItems}/>
        </div>

        <!-- Description for search meta -->
        <meta data-pagefind-meta="description" content={description}/>

        <a href={categoryHref} class="category-sticker" data-pagefind-ignore>{category}</a>

        <!-- Title - highest priority for search -->
        <h1 class="article-title" data-pagefind-meta="title" data-pagefind-weight="10">{title}</h1>

        <!-- Metadata -->
        <ArticleMetadata
            author={author}
            authorUrl={authorUrl}
            pubDate={pubDate}
            updatedDate={updatedDate}
            readingTime={readingTime}
        />

        <!-- Hero Image -->
        {image && (
            <div class="article-hero">
              <ImageLoader/>
              <Image
                  src={image}
                  alt={imageAlt}
                  width={1200}
                  height={630}
                  class="hero-image"
                  loading="eager"
                  fetchpriority="high"
              />
            </div>
        )}
      </div>
    </header>

    <!-- Article Body with Sidebar -->
    <div class="article-body">
      <div class="mx-auto max-w-6xl px-4 md:px-6">
        <div class="article-grid">
          <!-- Main Content -->
          <div class="article-content">
            <!-- Article Content -->
            <slot/>
          </div>

          <!-- Sidebar (Desktop) - exclude TOC from search -->
          <aside class="article-sidebar" id="toc-sidebar" data-pagefind-ignore>
            <TableOfContents headings={headings}/>
          </aside>
        </div>
      </div>
    </div>

    <!-- Full Width Section (outside article grid) -->
    <div class="full-width-section" id="full-width-section">
      <div class="relative">
        <slot name="full-width"/>
      </div>
    </div>

  </article>

  <!-- Mobile TOC - uses named slot for proper z-index above header -->
  <Fragment slot="toc">
    <TableOfContents headings={headings} mobile/>
  </Fragment>

  <!-- Article Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}/>
</BaseLayout>

<style>
  .article-page {
    min-height: 100vh;
  }

  .article-header {
    position: relative;
  }

  .category-sticker {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0.25rem 0.9rem;
    border-radius: 999px;
    background: var(--color-sun);
    border: 1.5px solid var(--color-ink);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 2px 3px 0 0 var(--color-ink);
    transition: transform 0.2s;
  }

  .category-sticker:hover {
    transform: translateY(-1px);
  }

  .article-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.125rem;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--color-ink);
    margin: 1.25rem 0 1rem;
    max-width: 1000px;
    text-wrap: balance;
  }

  @media (min-width: 768px) {
    .article-title {
      font-size: 3.5rem;
    }
  }

  @media (min-width: 1280px) {
    .article-title {
      font-size: 4rem;
    }
  }

  .article-hero {
    position: relative;
    margin-top: 2rem;
    border-radius: 28px;
    overflow: hidden;
    border: 1.5px solid var(--color-ink);
    box-shadow: 5px 6px 0 0 var(--color-ink);
    background: var(--color-sand);
  }

  .hero-image {
    position: relative;
    z-index: 2;
    width: 100%;
    height: auto;
    object-fit: cover;
    aspect-ratio: 16 / 9;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }

  .hero-image.loaded {
    opacity: 1;
  }

  /* Hide loader when image is loaded */
  .article-hero:has(.hero-image.loaded) :global(.image-loader) {
    opacity: 0;
  }

  .article-body {
    position: relative;
    padding: 3.5rem 0 3rem;
  }

  .article-grid {
    display: grid;
    gap: 3rem;
    margin: 0 auto;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .article-grid {
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: 4rem;
      align-items: stretch;
    }
  }

  .article-content {
    max-width: 760px;
    width: 100%;
    min-width: 0;
    word-wrap: break-word;
    overflow-wrap: break-word;
    color: var(--color-ink);
  }

  /* Anchor targets (headings or wrapping sections) clear the fixed header */
  .article-content :global([id]) {
    scroll-margin-top: 110px;
  }

  /* Article typography */
  .article-content :global(h2) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.625rem;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--color-ink);
    margin-top: 3.5rem;
    margin-bottom: 1rem;
    scroll-margin-top: 110px;
    text-wrap: balance;
  }

  .article-content :global(h2)::before {
    content: "";
    display: block;
    width: 56px;
    height: 10px;
    margin-bottom: 1rem;
    border-radius: 999px;
    background: var(--color-sun);
    border: 1.5px solid var(--color-ink);
  }

  .article-content > :global(h2:first-child) {
    margin-top: 0;
  }

  @media (min-width: 768px) {
    .article-content :global(h2) {
      font-size: 2rem;
    }
  }

  .article-content :global(h3) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3125rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    scroll-margin-top: 110px;
  }

  .article-content :global(h4) {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.1875rem;
    color: var(--color-teal-ink);
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    scroll-margin-top: 110px;
  }

  .article-content :global(p) {
    font-family: var(--font-body);
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-ink);
    margin-bottom: 1.5rem;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    font-family: var(--font-body);
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-ink);
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .article-content :global(ul) {
    list-style: disc;
  }

  .article-content :global(ol) {
    list-style: decimal;
  }

  .article-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .article-content :global(li::marker) {
    color: var(--color-teal-ink);
    font-weight: 700;
  }

  .article-content :global(a:not([class]):not(.comparison-table *)) {
    color: var(--color-teal-ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    text-decoration-color: rgba(23, 100, 102, 0.35);
    transition: color 0.2s, text-decoration-color 0.2s, background-color 0.2s;
  }

  .article-content :global(a:not([class]):not(.comparison-table *):hover) {
    color: var(--color-ink);
    background-color: rgba(255, 210, 63, 0.45);
    text-decoration-color: var(--color-ink);
  }

  .article-content :global(strong) {
    color: var(--color-ink);
    font-weight: 700;
  }

  .article-content :global(blockquote) {
    position: relative;
    margin: 2.5rem 0;
    padding: 1.5rem 1.75rem 1.5rem 3.5rem;
    background: var(--color-card);
    border: 1.5px solid var(--color-ink);
    border-radius: 20px;
    box-shadow: 4px 5px 0 0 var(--color-sky-light);
    font-style: normal;
    color: var(--color-ink);
  }

  .article-content :global(blockquote)::before {
    content: "\201C";
    position: absolute;
    left: 1rem;
    top: 0.25rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 3rem;
    color: var(--color-coral);
    line-height: 1;
  }

  .article-content :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .article-content :global(hr) {
    border: 0;
    border-top: 2px dashed rgba(8, 47, 56, 0.25);
    margin: 3rem 0;
  }

  .article-content :global(code) {
    background: rgba(8, 47, 56, 0.07);
    color: var(--color-ink);
    padding: 0.125rem 0.375rem;
    border-radius: 0.375rem;
    font-family: var(--font-jetbrains);
    font-size: 0.875em;
  }

  .article-content :global(pre) {
    background: var(--color-ink);
    color: var(--color-sand);
    border-radius: 16px;
    padding: 1.25rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .article-content :global(pre code) {
    background: none;
    color: inherit;
    padding: 0;
  }

  .article-content :global(img) {
    border-radius: 16px;
    border: 1.5px solid var(--color-ink);
    margin: 2rem 0;
  }

  .article-content :global(table:not(.comparison-table)) {
    width: 100%;
    margin: 1.5rem 0;
    border-collapse: collapse;
    font-size: 1rem;
  }

  .article-content :global(table:not(.comparison-table) th),
  .article-content :global(table:not(.comparison-table) td) {
    border-bottom: 1px solid rgba(8, 47, 56, 0.15);
    padding: 0.75rem;
    text-align: left;
  }

  /* Sidebar - hidden on mobile, stretches full height on desktop */
  .article-sidebar {
    display: none;
  }

  @media (min-width: 1024px) {
    .article-sidebar {
      display: block;
      position: relative;
    }
  }

  .article-sidebar :global(.toc-sidebar) {
    position: sticky;
    top: 110px;
  }

  /* Full Width Section */
  .full-width-section {
    position: relative;
    padding: 1rem 0 2rem;
  }
</style>

<script is:inline>
  // ArticleLayout with proper cleanup for View Transitions

  if (!window.__articleLayoutInit) {
    window.__articleLayoutInit = true;
    window.__articleLayoutHandlers = { scroll: null, resize: null };

    function initHeroImage() {
      var heroImage = document.querySelector('.hero-image');
      if (heroImage) {
        if (heroImage.complete && heroImage.naturalHeight !== 0) {
          heroImage.classList.add('loaded');
        } else {
          heroImage.addEventListener('load', function() {
            heroImage.classList.add('loaded');
          }, { once: true });
        }
      }
    }

    function cleanupTocSticky() {
      if (window.__articleLayoutHandlers.scroll) {
        window.removeEventListener('scroll', window.__articleLayoutHandlers.scroll);
        window.__articleLayoutHandlers.scroll = null;
      }
      if (window.__articleLayoutHandlers.resize) {
        window.removeEventListener('resize', window.__articleLayoutHandlers.resize);
        window.__articleLayoutHandlers.resize = null;
      }
    }

    function initTocSticky() {
      cleanupTocSticky();

      var tocSidebar = document.getElementById('toc-sidebar');
      var articleGrid = document.querySelector('.article-grid');
      var tocContent = tocSidebar ? tocSidebar.querySelector('.toc-sidebar') : null;

      if (!tocSidebar || !articleGrid || !tocContent) return;

      var tocWidth = tocContent.offsetWidth;

      window.__articleLayoutHandlers.scroll = function() {
        var sidebarRect = tocSidebar.getBoundingClientRect();
        var tocHeight = tocContent.offsetHeight;
        var stickyTop = 100;
        var tocBottomIfSticky = stickyTop + tocHeight;

        if (sidebarRect.bottom < tocBottomIfSticky) {
          tocContent.style.position = 'absolute';
          tocContent.style.top = 'auto';
          tocContent.style.bottom = '0';
          tocContent.style.width = tocWidth + 'px';
        } else {
          tocContent.style.position = 'sticky';
          tocContent.style.top = stickyTop + 'px';
          tocContent.style.bottom = 'auto';
          tocContent.style.width = 'auto';
        }
      };

      window.__articleLayoutHandlers.resize = function() {
        tocContent.style.position = 'sticky';
        tocContent.style.width = 'auto';
        tocWidth = tocContent.offsetWidth;
        window.__articleLayoutHandlers.scroll();
      };

      // Initial check
      window.__articleLayoutHandlers.scroll();

      window.addEventListener('scroll', window.__articleLayoutHandlers.scroll, {passive: true});
      window.addEventListener('resize', window.__articleLayoutHandlers.resize, {passive: true});
    }

    // Register event listeners once
    document.addEventListener('astro:page-load', function() {
      initHeroImage();
      initTocSticky();
    });
    document.addEventListener('astro:before-swap', cleanupTocSticky);
  }
</script>
