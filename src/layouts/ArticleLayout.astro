---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@components/article/Breadcrumbs.astro';
import ArticleMetadata from '@components/article/ArticleMetadata.astro';
import TableOfContents from '@components/article/TableOfContents.astro';
import {Image} from 'astro:assets';

interface Props {
  title: string;
  description: string;
  author: string;
  authorUrl?: string;
  pubDate: Date;
  updatedDate?: Date;
  readingTime?: number;
  image?: string;
  imageAlt?: string;
  category: string;
  categorySlug: string;
  headings?: Array<{ text: string; slug: string; depth: number }>;
}

const {
  title,
  description,
  author,
  authorUrl,
  pubDate,
  updatedDate,
  readingTime,
  image,
  imageAlt = '',
  category,
  categorySlug,
  headings = []
} = Astro.props;

// Build breadcrumb items
const breadcrumbItems = [
  {label: 'Home', href: '/'},
  {label: category, href: `/${categorySlug}`},
  {label: title}
];

// Article Schema markup
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: image ? `https://floatjet.com${image}` : undefined,
  author: {
    '@type': 'Person',
    name: author,
    url: authorUrl
  },
  publisher: {
    '@type': 'Organization',
    name: 'FloatJet',
    logo: {
      '@type': 'ImageObject',
      url: 'https://floatjet.com/logo.png'
    }
  },
  datePublished: pubDate.toISOString(),
  dateModified: updatedDate ? updatedDate.toISOString() : pubDate.toISOString()
};
---

<BaseLayout title={`${title} | FloatJet`} description={description} image={image} type="article">
  <article class="article-page">
    <!-- Article Header -->
    <header class="article-header">
      <div class="container mx-auto px-4 md:px-6 pt-28 md:pt-32">
        <!-- Breadcrumbs -->
        <Breadcrumbs items={breadcrumbItems}/>

        <!-- Title -->
        <h1 class="article-title">{title}</h1>

        <!-- Metadata -->
        <ArticleMetadata
            author={author}
            authorUrl={authorUrl}
            pubDate={pubDate}
            updatedDate={updatedDate}
            readingTime={readingTime}
        />

        <!-- Hero Image -->
        {image && (
            <div class="article-hero">
              <Image
                  src={image}
                  alt={imageAlt}
                  width={1200}
                  height={630}
                  class="hero-image"
                  loading="eager"
              />
            </div>
        )}
      </div>
    </header>

    <!-- Article Body with Sidebar -->
    <div class="article-body">
      <!-- Dark overlay for readability -->
      <div class="article-overlay"></div>
      <div class="container mx-auto px-4 md:px-6 relative z-10">
        <div class="article-grid">
          <!-- Main Content -->
          <div class="article-content prose prose-lg">
            <!-- Article Content -->
            <slot/>
          </div>

          <!-- Sidebar (Desktop) -->
          <aside class="article-sidebar" id="toc-sidebar">
            <TableOfContents headings={headings}/>
          </aside>
        </div>
      </div>
    </div>

    <!-- Full Width Section (outside article grid) -->
    <div class="full-width-section" id="full-width-section">
      <div class="full-width-overlay"></div>
      <div class="relative z-10">
        <slot name="full-width"/>
      </div>
    </div>

  </article>

  <!-- Mobile TOC - uses named slot for proper z-index above header -->
  <Fragment slot="toc">
    <TableOfContents headings={headings} mobile/>
  </Fragment>

  <!-- Article Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}/>
</BaseLayout>

<style>
  .article-page {
    min-height: 100vh;
  }

  .article-header {
    position: relative;
  }

  .article-title {
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 2.5rem;
    line-height: 1.2;
    color: white;
    margin: 1rem 0;
    max-width: 800px;
  }

  @media (min-width: 768px) {
    .article-title {
      font-size: 3.5rem;
    }
  }

  .article-hero {
    margin-top: 2rem;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  .hero-image {
    width: 100%;
    height: auto;
    object-fit: cover;
    aspect-ratio: 16 / 9;
  }

  .article-body {
    position: relative;
    padding: 3rem 0;
  }

  .article-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
            to bottom,
            rgba(15, 76, 92, 0.85) 0%,
            rgba(10, 50, 60, 0.92) 50%,
            rgba(5, 30, 40, 0.95) 100%
    );
    backdrop-filter: blur(8px);
    z-index: 1;
  }

  .article-grid {
    display: grid;
    gap: 3rem;
    max-width: 1280px;
    margin: 0 auto;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .article-grid {
      grid-template-columns: 1fr 280px;
      gap: 4rem;
      align-items: stretch;
    }
  }

  .article-content {
    max-width: 800px;
    width: 100%;
    min-width: 0;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  /* Prose styling for article content */
  .article-content :global(h2) {
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 1.875rem;
    color: white;
    margin-top: 3rem;
    margin-bottom: 1rem;
    scroll-margin-top: 100px;
  }

  .article-content :global(h3) {
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    font-size: 1.5rem;
    color: white;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    scroll-margin-top: 100px;
  }

  .article-content :global(p) {
    font-family: 'Inter', sans-serif;
    font-size: 1.125rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 1.5rem;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    font-family: 'Inter', sans-serif;
    font-size: 1.125rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .article-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .article-content :global(a) {
    color: #80CED7;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-content :global(a:hover) {
    color: #38A3A5;
  }

  .article-content :global(strong) {
    color: white;
    font-weight: 600;
  }

  .article-content :global(blockquote) {
    border-left: 4px solid #38A3A5;
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: rgba(255, 255, 255, 0.8);
  }

  .article-content :global(code) {
    background: rgba(255, 255, 255, 0.1);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875em;
  }

  .article-content :global(pre) {
    background: rgba(0, 0, 0, 0.3);
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .article-content :global(pre code) {
    background: none;
    padding: 0;
  }

  .article-content :global(img) {
    border-radius: 0.75rem;
    margin: 2rem 0;
  }

  /* Sidebar - hidden on mobile, stretches full height on desktop */
  .article-sidebar {
    display: none;
  }

  @media (min-width: 1024px) {
    .article-sidebar {
      display: block;
      position: relative;
      /* NO align-self: start here - let it stretch to full grid height */
    }
  }

  /* Full Width Section */
  .full-width-section {
    position: relative;
    padding: 3rem 0;
  }

  .full-width-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
            to bottom,
            rgba(5, 30, 40, 0.95) 0%,
            rgba(10, 50, 60, 0.92) 50%,
            rgba(15, 76, 92, 0.85) 100%
    );
    backdrop-filter: blur(8px);
    z-index: 1;
  }
</style>

<script>
  // Stop TOC sticky at full-width section
  document.addEventListener('DOMContentLoaded', () => {
    const tocSidebar = document.getElementById('toc-sidebar');
    const fullWidthSection = document.getElementById('full-width-section');
    const tocContent = tocSidebar?.querySelector('.toc-sidebar');

    if (!tocSidebar || !fullWidthSection || !tocContent) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            // Full width section is visible, unstick the TOC
            tocContent.style.position = 'relative';
            tocContent.style.top = 'auto';
          } else {
            // Full width section is not visible, re-enable sticky
            tocContent.style.position = 'sticky';
            tocContent.style.top = '100px';
          }
        });
      },
      { rootMargin: '-100px 0px 0px 0px', threshold: 0 }
    );

    observer.observe(fullWidthSection);
  });
</script>
