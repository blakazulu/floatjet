---
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import LoadingOverlay from "@components/LoadingOverlay.astro";
import Head from "@components/layout/Head.astro";
import MobileMenu from "@components/MobileMenu.astro";
import SearchModal from "@components/SearchModal.astro";
import "@styles/global.css";

// Self-hosted fonts via @fontsource, Latin subset only (Desk Party type system)
import "@fontsource/unbounded/latin-700.css";
import "@fontsource/unbounded/latin-900.css";
import "@fontsource/figtree/latin-400.css";
import "@fontsource/figtree/latin-500.css";
import "@fontsource/figtree/latin-700.css";
import "@fontsource/caveat/latin-700.css";
import "@fontsource/jetbrains-mono/latin-400.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  canonicalUrl?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  type = "website",
  canonicalUrl,
  noindex = false,
} = Astro.props;

// Schema.org Organization + WebSite markup (site-wide entity graph)
const siteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://floatjet.com/#organization",
      name: "FloatJet",
      url: "https://floatjet.com/",
      logo: {
        "@type": "ImageObject",
        url: "https://floatjet.com/logo.png",
        width: 512,
        height: 512,
      },
      description:
        "Find the best remote work and productivity tools for digital nomads and location-independent professionals",
      email: "support@floatjet.com",
      founder: {
        "@type": "Person",
        name: "Liraz Amir",
        url: "https://floatjet.com/authors/liraz-amir/",
      },
      sameAs: ["https://x.com/floatjet", "https://www.pinterest.com/floatjet/"],
    },
    {
      "@type": "WebSite",
      "@id": "https://floatjet.com/#website",
      name: "FloatJet",
      url: "https://floatjet.com/",
      inLanguage: "en-US",
      publisher: { "@id": "https://floatjet.com/#organization" },
    },
  ],
};
---

<!doctype html>
<html lang="en">
<Head
    title={title}
    description={description}
    image={image}
    type={type}
    canonicalUrl={canonicalUrl}
    noindex={noindex}
/>
<body class="flex flex-col min-h-screen relative bg-paper text-ink">
<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[300] btn-pill btn-sun">Skip to content</a>

<div transition:persist="header">
  <Header/>
</div>
<main id="main-content" class="flex-grow" transition:animate="fade">
  <slot/>
</main>
<!-- TOC Portal - rendered via slot:toc for articles -->
<slot name="toc"/>
<div transition:persist="footer">
  <Footer/>
</div>

<!-- Mobile Menu (outside transition:persist to avoid stacking context issues on Android) -->
<MobileMenu/>

<!-- Search Modal -->
<SearchModal/>

<!-- Loading Overlay for page transitions -->
<LoadingOverlay/>

<!-- Schema.org Organization + WebSite markup -->
<script type="application/ld+json" set:html={JSON.stringify(siteSchema)}/>
</body>
</html>
