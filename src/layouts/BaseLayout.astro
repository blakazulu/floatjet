---
import { Image } from "astro:assets";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import LoadingOverlay from "@components/LoadingOverlay.astro";
import Head from "@components/layout/Head.astro";
import MobileMenu from "@components/MobileMenu.astro";
import SearchModal from "@components/SearchModal.astro";
import "@styles/global.css";

// Self-hosted fonts via @fontsource (optimized for performance)
import "@fontsource/outfit/400.css";
import "@fontsource/outfit/600.css";
import "@fontsource/outfit/700.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/jetbrains-mono/400.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  canonicalUrl?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  type = "website",
  canonicalUrl,
  noindex = false,
} = Astro.props;

// Schema.org Organization + WebSite markup (site-wide entity graph)
const siteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://floatjet.com/#organization",
      name: "FloatJet",
      url: "https://floatjet.com/",
      logo: {
        "@type": "ImageObject",
        url: "https://floatjet.com/logo.png",
        width: 512,
        height: 512,
      },
      description:
        "Find the best remote work and productivity tools for digital nomads and location-independent professionals",
      email: "support@floatjet.com",
      founder: {
        "@type": "Person",
        name: "Liraz Amir",
        url: "https://floatjet.com/authors/liraz-amir/",
      },
      sameAs: ["https://x.com/floatjet", "https://www.pinterest.com/floatjet/"],
    },
    {
      "@type": "WebSite",
      "@id": "https://floatjet.com/#website",
      name: "FloatJet",
      url: "https://floatjet.com/",
      inLanguage: "en-US",
      publisher: { "@id": "https://floatjet.com/#organization" },
    },
  ],
};
---

<!doctype html>
<html lang="en">
<Head
    title={title}
    description={description}
    image={image}
    type={type}
    canonicalUrl={canonicalUrl}
    noindex={noindex}
/>
<body class="flex flex-col min-h-screen relative overflow-x-hidden">
<!-- Background Image -->
<div class="fixed inset-0 z-[-1]" transition:persist="background">
  <Image
      src="/images/background.webp"
      alt="Abstract gradient background with soft blue and teal tones"
      width={1920}
      height={1080}
      class="w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
  />
  <!-- Dark overlay for professional feel -->
  <div class="absolute inset-0 bg-black/50"></div>
</div>

<div transition:persist="header">
  <Header/>
</div>
<main class="flex-grow" transition:animate="fade">
  <slot/>
</main>
<!-- TOC Portal - rendered via slot:toc for articles -->
<slot name="toc"/>
<div transition:persist="footer">
  <Footer/>
</div>

<!-- Mobile Menu (outside transition:persist to avoid stacking context issues on Android) -->
<MobileMenu/>

<!-- Search Modal -->
<SearchModal/>

<!-- Loading Overlay for page transitions -->
<LoadingOverlay/>

<!-- Schema.org Organization + WebSite markup -->
<script type="application/ld+json" set:html={JSON.stringify(siteSchema)}/>
</body>
</html>
