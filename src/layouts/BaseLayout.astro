---
import Head from '@components/layout/Head.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import MobileMenu from '@components/MobileMenu.astro';
import SearchModal from '@components/SearchModal.astro';
import LoadingOverlay from '@components/LoadingOverlay.astro';
import {Image} from 'astro:assets';
import '@styles/global.css';

// Self-hosted fonts via @fontsource (optimized for performance)
import '@fontsource/outfit/400.css';
import '@fontsource/outfit/600.css';
import '@fontsource/outfit/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  canonicalUrl?: string;
}

const {
  title,
  description,
  image = '/images/og-default.webp',
  type = 'website',
  canonicalUrl = Astro.url.href
} = Astro.props;

// Schema.org Organization markup
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'FloatJet',
  url: 'https://floatjet.com',
  logo: 'https://floatjet.com/logo.png',
  description: 'Find the best remote work and productivity tools for digital nomads and location-independent professionals',
  sameAs: [
    'https://twitter.com/floatjet',
    'https://www.pinterest.com/floatjet'
  ]
};
---

<!doctype html>
<html lang="en">
<Head
    title={title}
    description={description}
    image={image}
    type={type}
    canonicalUrl={canonicalUrl}
/>
<body class="flex flex-col min-h-screen relative overflow-x-hidden">
<!-- Background Image -->
<div class="fixed inset-0 z-[-1]" transition:persist="background">
  <Image
      src="/images/background.webp"
      alt="Abstract gradient background with soft blue and teal tones"
      width={1920}
      height={1080}
      class="w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
  />
</div>

<div transition:persist="header">
  <Header/>
</div>
<main class="flex-grow" transition:animate="fade">
  <slot/>
</main>
<!-- TOC Portal - rendered via slot:toc for articles -->
<slot name="toc"/>
<div transition:persist="footer">
  <Footer/>
</div>

<!-- Mobile Menu (outside transition:persist to avoid stacking context issues on Android) -->
<MobileMenu/>

<!-- Search Modal -->
<SearchModal/>

<!-- Loading Overlay for page transitions -->
<LoadingOverlay/>

<!-- Schema.org Organization markup -->
<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}/>
</body>
</html>
