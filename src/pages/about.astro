---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'About FloatJet | Tools & Resources for Remote Professionals';
const description = 'Learn about FloatJet\'s mission to help remote workers and digital nomads find the best tools, software, and strategies to work efficiently from anywhere.';
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <article class="max-w-3xl mx-auto">
      <!-- Hero Section -->
      <div class="text-center mb-12">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">About FloatJet</h1>
        <p class="text-xl text-white/80">
          Helping remote professionals work smarter, from anywhere.
        </p>
      </div>

      <!-- Mission Section -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-white mb-4">Our Mission</h2>
        <p class="text-white/80 text-lg leading-relaxed">
          FloatJet exists to cut through the noise and help remote workers, digital nomads, and distributed teams find
          the tools that actually work. We know how overwhelming it can be to choose from hundreds of project management
          apps, VPNs, or productivity tools—each claiming to be "the best."
        </p>
        <p class="text-white/80 text-lg leading-relaxed mt-4">
          That's why we do the research, testing, and comparison work so you don't have to. Our goal is simple: save you
          time and help you make confident decisions about the software and gear that powers your remote work life.
        </p>
      </section>

      <!-- Who We Help Section -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-white mb-4">Who We Help</h2>
        <div class="grid gap-6 md:grid-cols-2">
          <div class="bg-white/5 rounded-xl p-6 border border-white/10">
            <h3 class="text-lg font-semibold text-white mb-2">Remote Workers</h3>
            <p class="text-white/70">
              Whether you're working from home, a co-working space, or your kitchen table, we help you build a
              productive setup without the guesswork.
            </p>
          </div>
          <div class="bg-white/5 rounded-xl p-6 border border-white/10">
            <h3 class="text-lg font-semibold text-white mb-2">Digital Nomads</h3>
            <p class="text-white/70">
              Working while traveling brings unique challenges. We cover VPNs, travel-friendly gear, international
              banking, and location-independent tools.
            </p>
          </div>
          <div class="bg-white/5 rounded-xl p-6 border border-white/10">
            <h3 class="text-lg font-semibold text-white mb-2">Freelancers</h3>
            <p class="text-white/70">
              Running your own business means wearing many hats. We review invoicing, project management, time tracking,
              and client communication tools.
            </p>
          </div>
          <div class="bg-white/5 rounded-xl p-6 border border-white/10">
            <h3 class="text-lg font-semibold text-white mb-2">Remote Teams</h3>
            <p class="text-white/70">
              Managing distributed teams requires the right collaboration stack. We compare tools for communication,
              project management, and team productivity.
            </p>
          </div>
        </div>
      </section>

      <!-- Editorial Standards Section -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-white mb-4">Our Editorial Standards</h2>
        <p class="text-white/80 leading-relaxed mb-4">
          We take our recommendations seriously. Here's how we approach our content:
        </p>
        <ul class="space-y-4">
          <li class="flex gap-3">
            <span class="text-jet-stream font-bold text-lg">1.</span>
            <div>
              <strong class="text-white">Hands-on Testing</strong>
              <p class="text-white/70 mt-1">We actually use the tools we review. No regurgitated press releases or
                copied feature lists—just honest assessments based on real experience.</p>
            </div>
          </li>
          <li class="flex gap-3">
            <span class="text-jet-stream font-bold text-lg">2.</span>
            <div>
              <strong class="text-white">Transparent Comparisons</strong>
              <p class="text-white/70 mt-1">Every product has pros and cons. We highlight both so you can make an
                informed decision based on your specific needs, not just marketing hype.</p>
            </div>
          </li>
          <li class="flex gap-3">
            <span class="text-jet-stream font-bold text-lg">3.</span>
            <div>
              <strong class="text-white">Regular Updates</strong>
              <p class="text-white/70 mt-1">Software changes fast. We revisit and update our reviews to ensure
                recommendations stay current and accurate.</p>
            </div>
          </li>
          <li class="flex gap-3">
            <span class="text-jet-stream font-bold text-lg">4.</span>
            <div>
              <strong class="text-white">User-Focused</strong>
              <p class="text-white/70 mt-1">We evaluate tools from the perspective of someone who needs to get work
                done—not just tick feature boxes.</p>
            </div>
          </li>
        </ul>
      </section>

      <!-- Affiliate Transparency Section -->
      <section class="mb-12 bg-ocean-deep/30 rounded-xl p-6 border border-ocean-deep/50">
        <h2 class="text-2xl font-bold text-white mb-4">How We Make Money</h2>
        <p class="text-white/80 leading-relaxed">
          Full transparency: FloatJet earns money through affiliate partnerships. When you click on certain links and
          make a purchase, we may receive a commission at no extra cost to you.
        </p>
        <p class="text-white/80 leading-relaxed mt-4">
          However, this never influences our editorial content. We recommend products based on quality and fit, not
          commission rates. We've turned down many lucrative partnerships because the products didn't meet our
          standards.
        </p>
        <p class="text-white/80 leading-relaxed mt-4">
          This affiliate revenue allows us to keep FloatJet free and continue producing in-depth, unbiased content. We
          believe this model aligns our incentives with yours: the better our recommendations, the more you trust us,
          and the more likely you are to use our links.
        </p>
      </section>

      <!-- What We Cover Section -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-white mb-4">What We Cover</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="flex items-center gap-3 text-white/80">
            <svg class="w-5 h-5 text-jet-stream flex-shrink-0" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
            <span>Project Management Tools</span>
          </div>
          <div class="flex items-center gap-3 text-white/80">
            <svg class="w-5 h-5 text-jet-stream flex-shrink-0" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
            <span>VPNs & Security Software</span>
          </div>
          <div class="flex items-center gap-3 text-white/80">
            <svg class="w-5 h-5 text-jet-stream flex-shrink-0" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
            <span>Home Office Gear</span>
          </div>
          <div class="flex items-center gap-3 text-white/80">
            <svg class="w-5 h-5 text-jet-stream flex-shrink-0" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
            <span>Communication Tools</span>
          </div>
          <div class="flex items-center gap-3 text-white/80">
            <svg class="w-5 h-5 text-jet-stream flex-shrink-0" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
            <span>Time Tracking & Productivity</span>
          </div>
          <div class="flex items-center gap-3 text-white/80">
            <svg class="w-5 h-5 text-jet-stream flex-shrink-0" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
            <span>Web Hosting & Email</span>
          </div>
          <div class="flex items-center gap-3 text-white/80">
            <svg class="w-5 h-5 text-jet-stream flex-shrink-0" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
            <span>Remote Work Guides</span>
          </div>
          <div class="flex items-center gap-3 text-white/80">
            <svg class="w-5 h-5 text-jet-stream flex-shrink-0" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
            <span>Digital Nomad Resources</span>
          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section
          class="text-center bg-gradient-to-r from-ocean-deep/40 to-jet-stream/20 rounded-xl p-8 border border-white/10">
        <h2 class="text-2xl font-bold text-white mb-3">Got Questions?</h2>
        <p class="text-white/80 mb-6">
          We'd love to hear from you. Whether it's feedback, tool suggestions, or just saying hi.
        </p>
        <a href="/contact"
           class="inline-flex items-center justify-center px-6 py-3 bg-jet-stream text-ocean-deep font-semibold rounded-lg hover:bg-sky-light transition-colors">
          Get in Touch
        </a>
      </section>
    </article>
  </div>
</BaseLayout>
