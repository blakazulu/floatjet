---
import { Image } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import { team, getTeamMember } from "@data/team";

export function getStaticPaths() {
  return team.map((member) => ({
    params: { slug: member.slug },
    props: { member },
  }));
}

const { member } = Astro.props;

if (!member) {
  return Astro.redirect("/404");
}

const title = `${member.name} - ${member.title} | FloatJet`;
const description = member.bioShort;

// Build Person schema
const personSchema = {
  "@context": "https://schema.org",
  ...member.schema,
};
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <article class="max-w-4xl mx-auto">
      <!-- Author Header -->
      <header class="author-header">
        <div class="author-image-wrapper">
          <Image
            src={member.image}
            alt={member.name}
            width={180}
            height={180}
            class="author-image"
            loading="eager"
          />
          {member.role === "founder" && (
            <span class="founder-badge">Founder</span>
          )}
        </div>

        <div class="author-info">
          <h1 class="author-name">{member.name}</h1>
          <p class="author-title">{member.title}</p>
          <p class="author-location">
            <svg class="location-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            {member.location}
          </p>

          {member.social && (
            <div class="author-social">
              {member.social.linkedin && (
                <a href={member.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${member.name} on LinkedIn`} class="social-link">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                  LinkedIn
                </a>
              )}
              {member.social.github && (
                <a href={member.social.github} target="_blank" rel="noopener noreferrer" aria-label={`${member.name} on GitHub`} class="social-link">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                  </svg>
                  GitHub
                </a>
              )}
              {member.social.twitter && (
                <a href={member.social.twitter} target="_blank" rel="noopener noreferrer" aria-label={`${member.name} on Twitter`} class="social-link">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                  Twitter
                </a>
              )}
            </div>
          )}
        </div>
      </header>

      <!-- About Section -->
      <section class="author-section">
        <h2 class="section-title">About</h2>
        <div class="bio-content">
          {member.bioLong.split('\n\n').map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </section>

      <!-- Credentials Section -->
      <section class="author-section">
        <h2 class="section-title">Credentials</h2>
        <ul class="credentials-list">
          {member.credentials.map((credential) => (
            <li>
              <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M20 6 9 17l-5-5"/>
              </svg>
              {credential}
            </li>
          ))}
        </ul>
      </section>

      <!-- Expertise Section -->
      <section class="author-section">
        <h2 class="section-title">Expertise</h2>
        <div class="expertise-grid">
          <div class="expertise-column">
            <h3 class="expertise-subtitle">Primary Focus</h3>
            <ul class="expertise-list">
              {member.expertiseAreas.primary.map((area) => (
                <li>{area}</li>
              ))}
            </ul>
          </div>
          <div class="expertise-column">
            <h3 class="expertise-subtitle">Also Covers</h3>
            <ul class="expertise-list">
              {member.expertiseAreas.secondary.map((area) => (
                <li>{area}</li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- Categories/Topics Section -->
      <section class="author-section">
        <h2 class="section-title">Topics Covered</h2>
        <div class="categories-wrap">
          {member.categories.map((cat) => (
            <span class="category-tag">{cat}</span>
          ))}
        </div>
      </section>

      <!-- Contact Section -->
      <section class="author-section contact-section">
        <h2 class="section-title">Get in Touch</h2>
        <p class="contact-text">
          Have a question or feedback? Reach out at{" "}
          <a href={`mailto:${member.email}`} class="email-link">{member.email}</a>
        </p>
      </section>

      <!-- Back to Team Link -->
      <div class="back-link-wrap">
        <a href="/team" class="back-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m15 18-6-6 6-6"/>
          </svg>
          Back to Team
        </a>
      </div>
    </article>
  </div>

  <!-- Person Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
</BaseLayout>

<style>
  /* Author Header */
  .author-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (min-width: 640px) {
    .author-header {
      flex-direction: row;
      text-align: left;
      gap: 2rem;
    }
  }

  .author-image-wrapper {
    position: relative;
    flex-shrink: 0;
  }

  .author-image {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid rgba(56, 163, 165, 0.4);
  }

  @media (min-width: 640px) {
    .author-image {
      width: 180px;
      height: 180px;
    }
  }

  .founder-badge {
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, #38A3A5, #0F4C5C);
    color: white;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .author-info {
    flex: 1;
  }

  .author-name {
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 2rem;
    color: white;
    margin: 0 0 0.5rem 0;
  }

  @media (min-width: 640px) {
    .author-name {
      font-size: 2.5rem;
    }
  }

  .author-title {
    font-size: 1.25rem;
    color: #38A3A5;
    margin: 0 0 0.5rem 0;
    font-weight: 500;
  }

  .author-location {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.6);
    margin: 0 0 1rem 0;
  }

  @media (min-width: 640px) {
    .author-location {
      justify-content: flex-start;
    }
  }

  .location-icon {
    width: 18px;
    height: 18px;
  }

  .author-social {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  @media (min-width: 640px) {
    .author-social {
      justify-content: flex-start;
    }
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-size: 0.875rem;
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.2s ease;
  }

  .social-link:hover {
    color: #80CED7;
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(128, 206, 215, 0.3);
  }

  .social-link svg {
    width: 18px;
    height: 18px;
  }

  /* Sections */
  .author-section {
    margin-bottom: 2.5rem;
  }

  .section-title {
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 1.5rem;
    color: white;
    margin: 0 0 1rem 0;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid rgba(56, 163, 165, 0.3);
  }

  /* Bio */
  .bio-content p {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 1rem 0;
  }

  .bio-content p:last-child {
    margin-bottom: 0;
  }

  /* Credentials */
  .credentials-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }

  .credentials-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .check-icon {
    width: 20px;
    height: 20px;
    color: #38A3A5;
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Expertise */
  .expertise-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .expertise-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .expertise-subtitle {
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    font-size: 1.125rem;
    color: #80CED7;
    margin: 0 0 0.75rem 0;
  }

  .expertise-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .expertise-list li {
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.8);
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .expertise-list li:last-child {
    border-bottom: none;
  }

  /* Categories */
  .categories-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .category-tag {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: rgba(56, 163, 165, 0.15);
    border: 1px solid rgba(56, 163, 165, 0.3);
    border-radius: 9999px;
    font-size: 0.875rem;
    color: #80CED7;
    font-weight: 500;
  }

  /* Contact */
  .contact-section {
    background: rgba(255, 255, 255, 0.03);
    border-radius: 1rem;
    padding: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .contact-text {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
  }

  .email-link {
    color: #80CED7;
    text-decoration: none;
    font-weight: 500;
  }

  .email-link:hover {
    text-decoration: underline;
  }

  /* Back Link */
  .back-link-wrap {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: #80CED7;
  }

  .back-link svg {
    width: 20px;
    height: 20px;
  }
</style>
