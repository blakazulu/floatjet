---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";

// Import category background images (reusing from guides)
import categoryCommunication from "../images/categories/category-communication.webp";
import categoryFinance from "../images/categories/category-finance-charts.webp";
import categoryHosting from "../images/categories/category-hosting-cloud.webp";
import categoryProductivity from "../images/categories/category-productivity.webp";
import categorySecurity from "../images/categories/category-security.webp";
import categoryTravel from "../images/categories/category-travel.webp";

const title = "Remote Work Blog | FloatJet";
const description =
  "Insights, tips, and guides for remote workers, freelancers, and digital nomads. Expert advice on productivity, travel, security, and more.";

// Category filters with gradients
const categories = [
  { name: "All", href: "/blog", gradient: "from-jet-stream to-sky-light" },
  { name: "Communication", href: "/blog/communication", gradient: "from-violet-500 to-purple-600" },
  { name: "Finance", href: "/blog/finance", gradient: "from-green-500 to-emerald-600" },
  { name: "Hosting", href: "/blog/hosting", gradient: "from-cyan-500 to-blue-500" },
  { name: "Productivity", href: "/blog/productivity", gradient: "from-amber-500 to-orange-500" },
  { name: "Security", href: "/blog/security", gradient: "from-red-500 to-rose-600" },
  { name: "Travel", href: "/blog/travel", gradient: "from-sky-400 to-blue-500" },
];

// All blog articles with images
const allArticles = [
  {
    title: "Best Team Communication Tools",
    description: "Compare Slack, Teams, Discord and more for remote teams.",
    href: "/blog/best-team-communication-tools",
    category: "Communication",
    readTime: 12,
    image: "/images/unsplash/photo-1600880292203-757bb62b4baf-1200w.webp",
    featured: true,
  },
  {
    title: "Async Communication for Remote Teams",
    description: "Master asynchronous communication to boost productivity.",
    href: "/blog/async-communication-remote-teams",
    category: "Communication",
    readTime: 10,
    image: "/images/unsplash/photo-1516321318423-f06f85e504b3-1200w.webp",
    featured: true,
  },
  {
    title: "Best Banking for Digital Nomads",
    description: "Find the best banks and accounts for location-independent workers.",
    href: "/blog/best-banking-digital-nomads",
    category: "Finance",
    readTime: 14,
    image: "/images/unsplash/photo-1601597111158-2fceff292cdc-1200w.webp",
    featured: false,
  },
  {
    title: "Tax Tips for Remote Workers",
    description: "Essential tax advice for freelancers and remote employees.",
    href: "/blog/tax-tips-remote-workers",
    category: "Finance",
    readTime: 13,
    image: "/images/unsplash/photo-1554224155-6726b3ff858f-1200w.webp",
    featured: false,
  },
  {
    title: "Cloud vs Traditional Hosting",
    description: "Compare cloud and traditional hosting for your remote business.",
    href: "/blog/cloud-vs-traditional-hosting",
    category: "Hosting",
    readTime: 11,
    image: "/images/unsplash/photo-1544197150-b99a580bb7a8-1200w.webp",
    featured: false,
  },
  {
    title: "Best CRM Software for Small Business",
    description: "Compare top CRM tools for managing customer relationships.",
    href: "/blog/best-crm-software-small-business",
    category: "Productivity",
    readTime: 14,
    image: "/images/unsplash/photo-1460925895917-afdab827c52f-1200w.webp",
    featured: true,
  },
  {
    title: "Ultimate Home Office Setup Guide",
    description: "Create the perfect workspace for maximum productivity.",
    href: "/blog/ultimate-home-office-setup",
    category: "Productivity",
    readTime: 15,
    image: "/images/unsplash/photo-1593062096033-9a26b09da705-1200w.webp",
    featured: true,
  },
  {
    title: "VPN Speed Comparison",
    description: "We tested VPN speeds across 20+ countries.",
    href: "/blog/vpn-speed-comparison",
    category: "Security",
    readTime: 10,
    image: "/images/unsplash/photo-1555949963-ff9fe0c870eb-1200w.webp",
    featured: false,
  },
  {
    title: "VPN on Public WiFi Guide",
    description: "How to stay safe when using public WiFi networks.",
    href: "/blog/vpn-public-wifi-guide",
    category: "Security",
    readTime: 8,
    image: "/images/unsplash/photo-1555949963-ff9fe0c870eb-1200w.webp",
    featured: false,
  },
  {
    title: "Top Destinations for Digital Nomads",
    description: "Best cities for remote work based on cost, internet, and community.",
    href: "/blog/top-destinations-digital-nomads",
    category: "Travel",
    readTime: 14,
    image: "/images/unsplash/photo-1488646953014-85cb44e25828-1200w.webp",
    featured: true,
  },
  {
    title: "Best Travel Insurance for Remote Workers",
    description: "Compare travel insurance options designed for digital nomads.",
    href: "/blog/best-travel-insurance-remote-workers",
    category: "Travel",
    readTime: 12,
    image: "/images/unsplash/photo-1488646953014-85cb44e25828-1200w.webp",
    featured: false,
  },
];

// Pick random hero from featured articles
const featuredArticles = allArticles.filter((a) => a.featured);
const hero = featuredArticles[Math.floor(Math.random() * featuredArticles.length)];

// Remaining articles shuffled
const remaining = allArticles.filter((a) => a.href !== hero.href);
const shuffled = [...remaining].sort(() => Math.random() - 0.5);
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <!-- Compact Header + Filter Bar -->
    <div class="max-w-6xl mx-auto mb-6">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
        <div>
          <h1 class="text-2xl md:text-3xl font-bold text-white">Remote Work Blog</h1>
          <p class="text-white/60 text-sm mt-1">Insights, tips & guides</p>
        </div>
        <!-- Filter Pills -->
        <div class="flex flex-wrap gap-2">
          {categories.map((cat, i) => (
            <a
              href={cat.href}
              class:list={[
                "px-3 py-1.5 rounded-full text-xs font-medium transition-all duration-300",
                i === 0
                  ? `bg-gradient-to-r ${cat.gradient} text-ocean-deep`
                  : "bg-white/5 text-white/70 hover:bg-white/10 hover:text-white border border-white/10"
              ]}
            >
              {cat.name}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Bento Mosaic Grid -->
    <div class="max-w-6xl mx-auto grid grid-cols-4 md:grid-cols-4 lg:grid-cols-6 gap-2 md:gap-3 auto-rows-[100px] md:auto-rows-[140px] lg:auto-rows-[160px]">

      <!-- HERO CELL: Large featured article -->
      <a
        href={hero.href}
        class="group col-span-4 md:col-span-2 lg:col-span-3 row-span-2 md:row-span-2 relative overflow-hidden rounded-2xl transition-all duration-300 hover:shadow-xl hover:shadow-jet-stream/10"
      >
        <img src={hero.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/10"></div>
        <div class="absolute inset-0 p-4 md:p-6 flex flex-col justify-end">
          <span class="inline-block w-fit px-2 py-0.5 md:px-2.5 md:py-1 bg-jet-stream text-ocean-deep text-[10px] md:text-xs font-bold rounded-full mb-2">
            Featured
          </span>
          <h2 class="text-base md:text-2xl font-bold text-white group-hover:text-jet-stream transition-colors mb-1">
            {hero.title}
          </h2>
          <p class="text-white/70 text-sm line-clamp-2 hidden md:block mb-2">{hero.description}</p>
          <div class="flex items-center gap-3 text-[10px] md:text-xs">
            <span class="text-white/50">{hero.readTime} min</span>
            <span class="text-jet-stream font-medium flex items-center">
              Read
              <svg class="w-3 h-3 ml-1 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
            </span>
          </div>
        </div>
      </a>

      <!-- CATEGORY MINI CELLS: 6 categories -->
      <a href="/blog/communication" class="group col-span-1 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:scale-[1.02]">
        <Image src={categoryCommunication} alt="" class="absolute inset-0 w-full h-full object-cover opacity-30 group-hover:opacity-40 transition-opacity" />
        <div class="absolute inset-0 bg-gradient-to-br from-black/70 to-black/50"></div>
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-violet-400 to-purple-600 rounded-l-xl"></div>
        <div class="relative z-10 h-full p-3 md:p-4 flex flex-col justify-between">
          <svg class="w-6 h-6 md:w-8 md:h-8 text-violet-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
          </svg>
          <div>
            <span class="text-white font-semibold text-sm md:text-base block leading-tight">Comms</span>
            <span class="text-white/50 text-[10px] md:text-xs">2 posts</span>
          </div>
        </div>
      </a>

      <a href="/blog/finance" class="group col-span-1 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:scale-[1.02]">
        <Image src={categoryFinance} alt="" class="absolute inset-0 w-full h-full object-cover opacity-30 group-hover:opacity-40 transition-opacity" />
        <div class="absolute inset-0 bg-gradient-to-br from-black/70 to-black/50"></div>
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-green-400 to-emerald-600 rounded-l-xl"></div>
        <div class="relative z-10 h-full p-3 md:p-4 flex flex-col justify-between">
          <svg class="w-6 h-6 md:w-8 md:h-8 text-green-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
          <div>
            <span class="text-white font-semibold text-sm md:text-base block leading-tight">Finance</span>
            <span class="text-white/50 text-[10px] md:text-xs">3 posts</span>
          </div>
        </div>
      </a>

      <a href="/blog/hosting" class="group col-span-1 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:scale-[1.02]">
        <Image src={categoryHosting} alt="" class="absolute inset-0 w-full h-full object-cover opacity-30 group-hover:opacity-40 transition-opacity" />
        <div class="absolute inset-0 bg-gradient-to-br from-black/70 to-black/50"></div>
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-cyan-400 to-blue-500 rounded-l-xl"></div>
        <div class="relative z-10 h-full p-3 md:p-4 flex flex-col justify-between">
          <svg class="w-6 h-6 md:w-8 md:h-8 text-cyan-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 0 1-3-3m3 3a3 3 0 1 0 0 6h13.5a3 3 0 1 0 0-6m-16.5-3a3 3 0 0 1 3-3h13.5a3 3 0 0 1 3 3m-19.5 0a4.5 4.5 0 0 1 .9-2.7L5.737 5.1a3.375 3.375 0 0 1 2.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 0 1 .9 2.7m0 0a3 3 0 0 1-3 3m0 3h.008v.008h-.008v-.008Zm0-6h.008v.008h-.008v-.008Zm-3 6h.008v.008h-.008v-.008Zm0-6h.008v.008h-.008v-.008Z" />
          </svg>
          <div>
            <span class="text-white font-semibold text-sm md:text-base block leading-tight">Hosting</span>
            <span class="text-white/50 text-[10px] md:text-xs">2 posts</span>
          </div>
        </div>
      </a>

      <a href="/blog/productivity" class="group col-span-1 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:scale-[1.02]">
        <Image src={categoryProductivity} alt="" class="absolute inset-0 w-full h-full object-cover opacity-30 group-hover:opacity-40 transition-opacity" />
        <div class="absolute inset-0 bg-gradient-to-br from-black/70 to-black/50"></div>
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-amber-400 to-orange-500 rounded-l-xl"></div>
        <div class="relative z-10 h-full p-3 md:p-4 flex flex-col justify-between">
          <svg class="w-6 h-6 md:w-8 md:h-8 text-amber-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" />
          </svg>
          <div>
            <span class="text-white font-semibold text-sm md:text-base block leading-tight">Productivity</span>
            <span class="text-white/50 text-[10px] md:text-xs">3 posts</span>
          </div>
        </div>
      </a>

      <!-- Second row of categories -->
      <a href="/blog/security" class="group col-span-2 md:col-span-1 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:scale-[1.02]">
        <Image src={categorySecurity} alt="" class="absolute inset-0 w-full h-full object-cover opacity-30 group-hover:opacity-40 transition-opacity" />
        <div class="absolute inset-0 bg-gradient-to-br from-black/70 to-black/50"></div>
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-red-400 to-rose-600 rounded-l-xl"></div>
        <div class="relative z-10 h-full p-3 md:p-4 flex flex-col justify-between">
          <svg class="w-6 h-6 md:w-8 md:h-8 text-red-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
          </svg>
          <div>
            <span class="text-white font-semibold text-sm md:text-base block leading-tight">Security</span>
            <span class="text-white/50 text-[10px] md:text-xs">2 posts</span>
          </div>
        </div>
      </a>

      <a href="/blog/travel" class="group col-span-2 md:col-span-1 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:scale-[1.02]">
        <Image src={categoryTravel} alt="" class="absolute inset-0 w-full h-full object-cover opacity-30 group-hover:opacity-40 transition-opacity" />
        <div class="absolute inset-0 bg-gradient-to-br from-black/70 to-black/50"></div>
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-sky-400 to-blue-500 rounded-l-xl"></div>
        <div class="relative z-10 h-full p-3 md:p-4 flex flex-col justify-between">
          <svg class="w-6 h-6 md:w-8 md:h-8 text-sky-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
          </svg>
          <div>
            <span class="text-white font-semibold text-sm md:text-base block leading-tight">Travel</span>
            <span class="text-white/50 text-[10px] md:text-xs">4 posts</span>
          </div>
        </div>
      </a>

      <!-- Wide article -->
      <a
        href={shuffled[0]?.href}
        class="group col-span-4 md:col-span-2 lg:col-span-4 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg"
      >
        <img src={shuffled[0]?.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
        <div class="absolute inset-0 p-3 md:p-4 flex items-center">
          <div class="max-w-md">
            <span class="text-jet-stream text-[10px] md:text-xs font-medium mb-1 block">{shuffled[0]?.category}</span>
            <h3 class="text-xs md:text-lg font-semibold text-white group-hover:text-jet-stream transition-colors line-clamp-2">{shuffled[0]?.title}</h3>
            <p class="text-white/60 text-[10px] md:text-xs mt-1 line-clamp-1 hidden md:block">{shuffled[0]?.description}</p>
          </div>
        </div>
      </a>

      <!-- ROW: 4 small cells -->
      {shuffled.slice(1, 5).map((article, i) => (
        <a
          href={article.href}
          class:list={[
            "group col-span-2 md:col-span-1 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg",
            i >= 2 && "hidden md:block"
          ]}
        >
          <img src={article.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
          <div class="absolute inset-0 p-2 md:p-3 flex flex-col justify-end">
            <span class="text-white/50 text-[8px] md:text-[10px] uppercase tracking-wide mb-0.5">{article.category}</span>
            <h3 class="text-[10px] md:text-sm font-semibold text-white group-hover:text-jet-stream transition-colors line-clamp-2 leading-tight">{article.title}</h3>
          </div>
        </a>
      ))}

      <!-- Desktop only: wide + small combo -->
      <a
        href={shuffled[5]?.href}
        class="group hidden lg:block col-span-2 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg"
      >
        <img src={shuffled[5]?.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-transparent"></div>
        <div class="absolute inset-0 p-3 flex items-center">
          <div>
            <span class="text-jet-stream text-[10px] font-medium mb-1 block">{shuffled[5]?.category}</span>
            <h3 class="text-sm font-semibold text-white group-hover:text-jet-stream transition-colors line-clamp-2">{shuffled[5]?.title}</h3>
          </div>
        </div>
      </a>

      <!-- Desktop only: 2 more small cells -->
      {shuffled.slice(6, 8).map((article) => (
        <a
          href={article?.href}
          class="group hidden lg:block col-span-1 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg"
        >
          <img src={article?.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
          <div class="absolute inset-0 p-2 md:p-3 flex flex-col justify-end">
            <span class="text-white/50 text-[8px] md:text-[10px] uppercase tracking-wide mb-0.5">{article?.category}</span>
            <h3 class="text-[10px] md:text-sm font-semibold text-white group-hover:text-jet-stream transition-colors line-clamp-2 leading-tight">{article?.title}</h3>
          </div>
        </a>
      ))}

      <!-- Info cell + CTA cell -->
      <div class="col-span-2 md:col-span-2 lg:col-span-3 row-span-1 bg-black/40 border border-white/10 border-b-jet-stream/50 rounded-xl p-4 md:p-5 flex flex-col justify-center items-center text-center">
        <svg class="w-7 h-7 md:w-8 md:h-8 text-jet-stream mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 0 1-2.25 2.25M16.5 7.5V18a2.25 2.25 0 0 0 2.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 0 0 2.25 2.25h13.5M6 7.5h3v3H6v-3Z" />
        </svg>
        <span class="text-white font-semibold text-sm md:text-base">16+ Articles</span>
        <span class="text-white/60 text-xs md:text-sm">New posts weekly</span>
      </div>

      <a href="/contact" class="group col-span-2 md:col-span-2 lg:col-span-3 row-span-1 bg-black/40 border border-jet-stream/30 border-b-jet-stream/60 rounded-xl p-4 md:p-5 flex flex-col justify-center items-center text-center transition-all duration-300 hover:border-jet-stream/50 hover:bg-black/50">
        <svg class="w-7 h-7 md:w-8 md:h-8 text-sky-light mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />
        </svg>
        <span class="text-white font-semibold text-sm md:text-base">Suggest Topic</span>
        <span class="text-jet-stream text-xs md:text-sm flex items-center mt-1">
          Contact us
          <svg class="w-3 h-3 ml-1 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
        </span>
      </a>

    </div>

  </div>
</BaseLayout>
