---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Remote Work Blog | FloatJet';
const description = 'Insights, tips, and guides for remote workers, freelancers, and digital nomads. Expert advice on productivity, travel, security, and more.';

// Subcategory pages
const categories = [
  {name: 'Communication', href: '/blog/communication', icon: '💬', description: 'Team collaboration tips'},
  {name: 'Finance', href: '/blog/finance', icon: '💰', description: 'Banking & taxes for nomads'},
  {name: 'Hosting', href: '/blog/hosting', icon: '🌐', description: 'Web hosting insights'},
  {name: 'Productivity', href: '/blog/productivity', icon: '🚀', description: 'Work smarter, not harder'},
  {name: 'Security', href: '/blog/security', icon: '🔒', description: 'Stay safe online'},
  {name: 'Travel', href: '/blog/travel', icon: '✈️', description: 'Digital nomad lifestyle'}
];

// All blog articles
const allArticles = [
  {
    title: 'Best Team Communication Tools',
    description: 'Compare Slack, Teams, Discord and more for remote team collaboration.',
    href: '/blog/best-team-communication-tools',
    category: 'Communication',
    icon: '💬',
    readTime: 12
  },
  {
    title: 'Async Communication for Remote Teams',
    description: 'Master asynchronous communication to boost productivity across time zones.',
    href: '/blog/async-communication-remote-teams',
    category: 'Communication',
    icon: '📝',
    readTime: 10
  },
  {
    title: 'Best Banking for Digital Nomads',
    description: 'Find the best banks and accounts for location-independent workers.',
    href: '/blog/best-banking-digital-nomads',
    category: 'Finance',
    icon: '🏦',
    readTime: 14
  },
  {
    title: 'Crypto-Friendly Banks',
    description: 'Banks that work well with cryptocurrency for remote workers.',
    href: '/blog/crypto-friendly-banks',
    category: 'Finance',
    icon: '₿',
    readTime: 11
  },
  {
    title: 'Tax Tips for Remote Workers',
    description: 'Essential tax advice for freelancers and remote employees.',
    href: '/blog/tax-tips-remote-workers',
    category: 'Finance',
    icon: '📊',
    readTime: 13
  },
  {
    title: 'Cloud vs Traditional Hosting',
    description: 'Compare cloud and traditional hosting for your remote business.',
    href: '/blog/cloud-vs-traditional-hosting',
    category: 'Hosting',
    icon: '☁️',
    readTime: 11
  },
  {
    title: 'Managed WordPress Hosting Compared',
    description: 'Find the best managed WordPress hosting for your blog or business.',
    href: '/blog/managed-wordpress-hosting-compared',
    category: 'Hosting',
    icon: '🔧',
    readTime: 13
  },
  {
    title: 'Best CRM Software for Small Business',
    description: 'Compare top CRM tools for managing customer relationships remotely.',
    href: '/blog/best-crm-software-small-business',
    category: 'Productivity',
    icon: '👥',
    readTime: 14
  },
  {
    title: 'Managing Time Zones in Remote Teams',
    description: 'Strategies for effective collaboration across different time zones.',
    href: '/blog/managing-time-zones-remote-teams',
    category: 'Productivity',
    icon: '🌍',
    readTime: 9
  },
  {
    title: 'Ultimate Home Office Setup Guide',
    description: 'Create the perfect workspace for maximum productivity at home.',
    href: '/blog/ultimate-home-office-setup',
    category: 'Productivity',
    icon: '🏠',
    readTime: 15
  },
  {
    title: 'VPN Speed Comparison',
    description: 'We tested VPN speeds across 20+ countries. See which ones are fastest.',
    href: '/blog/vpn-speed-comparison',
    category: 'Security',
    icon: '⚡',
    readTime: 10
  },
  {
    title: 'VPN on Public WiFi Guide',
    description: 'How to stay safe when using public WiFi networks while traveling.',
    href: '/blog/vpn-public-wifi-guide',
    category: 'Security',
    icon: '🛡️',
    readTime: 8
  },
  {
    title: 'How to Find Reliable WiFi Anywhere',
    description: 'Tips and tools for finding fast, reliable internet while traveling.',
    href: '/blog/find-reliable-wifi-anywhere',
    category: 'Travel',
    icon: '📶',
    readTime: 9
  },
  {
    title: 'Best Travel Insurance for Remote Workers',
    description: 'Compare travel insurance options designed for digital nomads.',
    href: '/blog/best-travel-insurance-remote-workers',
    category: 'Travel',
    icon: '🏥',
    readTime: 12
  },
  {
    title: 'Top Destinations for Digital Nomads',
    description: 'Best cities for remote work based on cost, internet, and community.',
    href: '/blog/top-destinations-digital-nomads',
    category: 'Travel',
    icon: '🗺️',
    readTime: 14
  },
  {
    title: 'Essential Travel Tech for Nomads',
    description: 'Must-have gadgets and gear for working while traveling.',
    href: '/blog/essential-travel-tech-nomads',
    category: 'Travel',
    icon: '🎒',
    readTime: 11
  }
];

// Shuffle and limit articles - render all 9, CSS handles responsive visibility
const shuffled = [...allArticles].sort(() => Math.random() - 0.5);
const displayArticles = shuffled.slice(0, 9);
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Remote Work Blog</h1>
      <p class="text-lg text-white/80 max-w-2xl mx-auto">
        Insights, tips, and guides to help you thrive as a remote worker, freelancer, or digital nomad.
      </p>
    </div>

    <!-- Category Links -->
    <div class="grid gap-3 grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 mb-12 max-w-5xl mx-auto">
      {categories.map(cat => (
          <a
              href={cat.href}
              class="group flex flex-col items-center text-center p-4 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-jet-stream/50 rounded-xl transition-all duration-300"
          >
            <span class="text-2xl mb-2">{cat.icon}</span>
            <span class="text-white font-medium group-hover:text-jet-stream transition-colors">{cat.name}</span>
            <span class="text-white/50 text-xs mt-1 hidden sm:block">{cat.description}</span>
          </a>
      ))}
    </div>

    <!-- Articles Grid - Responsive: 3 mobile, 6 tablet, 9 desktop -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {displayArticles.map((article, index) => (
          <a
              href={article.href}
              class:list={[
                'group bg-black/40 hover:bg-black/50 border border-white/10 hover:border-white/20 rounded-xl p-6 transition-all duration-300',
                // Mobile: show first 3

                index >= 3 && 'hidden sm:block',
                // Tablet: show first 6

                index >= 6 && 'sm:hidden lg:block'
              ]}
          >
            <div class="flex items-start gap-4">
              <span class="text-3xl">{article.icon}</span>
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-2">
                <span class="inline-block px-2 py-0.5 bg-jet-stream/20 text-jet-stream text-xs font-medium rounded">
                  {article.category}
                </span>
                  <span class="text-white/40 text-xs">{article.readTime} min</span>
                </div>
                <h2 class="text-lg font-semibold text-white group-hover:text-jet-stream transition-colors mb-2">
                  {article.title}
                </h2>
                <p class="text-white/70 text-sm">
                  {article.description}
                </p>
              </div>
            </div>
            <div class="mt-4 flex items-center text-jet-stream text-sm font-medium">
              Read Article
              <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor"
                   viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </a>
      ))}
    </div>

    <!-- View All Link -->
    <div class="mt-8 text-center">
      <p class="text-white/60 text-sm">Browse by category above to see all articles</p>
    </div>

    <!-- CTA Section -->
    <div class="mt-12 text-center">
      <a href="/contact" class="inline-flex items-center text-jet-stream hover:text-sky-light transition-colors">
        Suggest a topic for us to cover
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>
  </div>
</BaseLayout>
