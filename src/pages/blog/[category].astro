---
import BaseLayout from "../../layouts/BaseLayout.astro";

// Category configuration with metadata
const categoryConfig: Record<string, {
  name: string;
  title: string;
  subtitle: string;
  description: string;
  filterKey: string;
}> = {
  communication: {
    name: "Communication",
    title: "Communication Articles",
    subtitle: "Connect with your remote team",
    description: "Articles on remote team communication. Async collaboration, video calls, messaging tools, and best practices.",
    filterKey: "Communication",
  },
  finance: {
    name: "Finance",
    title: "Finance Articles",
    subtitle: "Manage money as a remote worker",
    description: "Financial articles for remote workers and digital nomads. Banking, taxes, invoicing, and money management.",
    filterKey: "Finance",
  },
  hosting: {
    name: "Hosting",
    title: "Hosting Articles",
    subtitle: "Host your remote business online",
    description: "Web hosting articles for remote businesses. Cloud hosting, VPS, and managed hosting comparisons.",
    filterKey: "Hosting",
  },
  productivity: {
    name: "Productivity",
    title: "Productivity Articles",
    subtitle: "Get more done remotely",
    description: "Boost your remote work productivity. Time management, focus techniques, tools, and workflow tips.",
    filterKey: "Productivity",
  },
  security: {
    name: "Security",
    title: "Security Articles",
    subtitle: "Protect your digital life",
    description: "Stay secure while working remotely. VPN guides, public WiFi safety, and cybersecurity tips.",
    filterKey: "Security",
  },
  travel: {
    name: "Travel",
    title: "Travel Articles",
    subtitle: "Work from anywhere in the world",
    description: "Travel articles for digital nomads. Best destinations, WiFi tips, travel insurance, and remote work locations.",
    filterKey: "Travel",
  },
};

// Category filters with gradients (same as main page)
const categories = [
  { name: "All", href: "/blog", gradient: "from-jet-stream to-sky-light", slug: "" },
  { name: "Communication", href: "/blog/communication", gradient: "from-violet-500 to-purple-600", slug: "communication" },
  { name: "Finance", href: "/blog/finance", gradient: "from-green-500 to-emerald-600", slug: "finance" },
  { name: "Hosting", href: "/blog/hosting", gradient: "from-pink-400 to-fuchsia-500", slug: "hosting" },
  { name: "Productivity", href: "/blog/productivity", gradient: "from-amber-500 to-orange-500", slug: "productivity" },
  { name: "Security", href: "/blog/security", gradient: "from-red-500 to-rose-600", slug: "security" },
  { name: "Travel", href: "/blog/travel", gradient: "from-sky-400 to-blue-500", slug: "travel" },
];

// All articles data (same as main page)
const allArticles = [
  {
    title: "Best Team Communication Tools",
    description: "Compare Slack, Teams, Discord and more for remote teams.",
    href: "/blog/best-team-communication-tools",
    category: "Communication",
    readTime: 12,
    image: "/images/unsplash/photo-1600880292203-757bb62b4baf-1200w.webp",
    featured: true,
  },
  {
    title: "Async Communication for Remote Teams",
    description: "Master asynchronous communication to boost productivity.",
    href: "/blog/async-communication-remote-teams",
    category: "Communication",
    readTime: 10,
    image: "/images/unsplash/photo-1522071820081-009f0129c71c-1200w.webp",
    featured: true,
  },
  {
    title: "Best Banking for Digital Nomads",
    description: "Find the best banks and accounts for location-independent workers.",
    href: "/blog/best-banking-digital-nomads",
    category: "Finance",
    readTime: 14,
    image: "/images/unsplash/photo-1563986768494-4dee2763ff3f-1200w.webp",
    featured: true,
  },
  {
    title: "Tax Tips for Remote Workers",
    description: "Essential tax advice for freelancers and remote employees.",
    href: "/blog/tax-tips-remote-workers",
    category: "Finance",
    readTime: 13,
    image: "/images/unsplash/photo-1554224155-6726b3ff858f-1200w.webp",
    featured: false,
  },
  {
    title: "Cloud vs Traditional Hosting",
    description: "Compare cloud and traditional hosting for your remote business.",
    href: "/blog/cloud-vs-traditional-hosting",
    category: "Hosting",
    readTime: 11,
    image: "/images/unsplash/photo-1451187580459-43490279c0fa-1200w.webp",
    featured: true,
  },
  {
    title: "Best CRM Software for Small Business",
    description: "Compare top CRM tools for managing customer relationships.",
    href: "/blog/best-crm-software-small-business",
    category: "Productivity",
    readTime: 14,
    image: "/images/unsplash/photo-1552664730-d307ca884978-1200w.webp",
    featured: true,
  },
  {
    title: "Ultimate Home Office Setup Guide",
    description: "Create the perfect workspace for maximum productivity.",
    href: "/blog/ultimate-home-office-setup",
    category: "Productivity",
    readTime: 15,
    image: "/images/unsplash/photo-1593642632559-0c6d3fc62b89-1200w.webp",
    featured: true,
  },
  {
    title: "VPN Speed Comparison",
    description: "We tested VPN speeds across 20+ countries.",
    href: "/blog/vpn-speed-comparison",
    category: "Security",
    readTime: 10,
    image: "/images/unsplash/photo-1558494949-ef010cbdcc31-1200w.webp",
    featured: true,
  },
  {
    title: "VPN on Public WiFi Guide",
    description: "How to stay safe when using public WiFi networks.",
    href: "/blog/vpn-public-wifi-guide",
    category: "Security",
    readTime: 8,
    image: "/images/unsplash/photo-1563986768494-4dee2763ff3f-1200w.webp",
    featured: false,
  },
  {
    title: "Top Destinations for Digital Nomads",
    description: "Best cities for remote work based on cost, internet, and community.",
    href: "/blog/top-destinations-digital-nomads",
    category: "Travel",
    readTime: 14,
    image: "/images/unsplash/photo-1528181304800-259b08848526-1200w.webp",
    featured: true,
  },
  {
    title: "Best Travel Insurance for Remote Workers",
    description: "Compare travel insurance options designed for digital nomads.",
    href: "/blog/best-travel-insurance-remote-workers",
    category: "Travel",
    readTime: 12,
    image: "/images/unsplash/photo-1436491865332-7a61a109cc05-1200w.webp",
    featured: false,
  },
];

// Generate static paths for all categories
export function getStaticPaths() {
  return [
    { params: { category: "communication" } },
    { params: { category: "finance" } },
    { params: { category: "hosting" } },
    { params: { category: "productivity" } },
    { params: { category: "security" } },
    { params: { category: "travel" } },
  ];
}

// Get current category from URL
const { category } = Astro.params;
const config = categoryConfig[category as string];

// Filter articles by category
const filteredArticles = allArticles.filter(a => a.category === config.filterKey);

// Pick hero from featured (or first item if none featured)
const featuredInCategory = filteredArticles.filter(a => a.featured);
const hero = featuredInCategory.length > 0
  ? featuredInCategory[Math.floor(Math.random() * featuredInCategory.length)]
  : filteredArticles[0];

// Remaining articles
const remaining = filteredArticles.filter(a => a.href !== hero?.href);

// Page meta
const title = `${config.title} | FloatJet`;
const description = config.description;
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <!-- Compact Header + Filter Bar (same as main page) -->
    <div class="max-w-6xl mx-auto mb-6">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
        <div>
          <h1 class="text-2xl md:text-3xl font-bold text-white">{config.title}</h1>
          <p class="text-white/60 text-sm mt-1">{config.subtitle}</p>
        </div>
        <!-- Filter Pills -->
        <div class="flex flex-wrap gap-2">
          {categories.map((cat) => (
            <a
              href={cat.href}
              class:list={[
                "px-3 py-1.5 rounded-full text-xs transition-all duration-300",
                cat.slug === category
                  ? `bg-gradient-to-r ${cat.gradient} text-white font-bold border-2 border-white`
                  : "bg-white/5 text-white/70 hover:bg-white/10 hover:text-white border border-white/10 font-medium"
              ]}
            >
              {cat.name}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Simple Grid for Subcategory -->
    <div class="max-w-6xl mx-auto grid grid-cols-4 md:grid-cols-4 lg:grid-cols-6 gap-2 md:gap-3 auto-rows-[100px] md:auto-rows-[140px] lg:auto-rows-[160px]">

      {hero && (
        <!-- HERO CELL: Large featured article -->
        <a
          href={hero.href}
          class="group col-span-4 md:col-span-4 lg:col-span-4 row-span-2 relative overflow-hidden rounded-2xl transition-all duration-300 hover:shadow-xl hover:shadow-jet-stream/10"
        >
          <img src={hero.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/10"></div>
          <div class="absolute inset-0 p-4 md:p-6 flex flex-col justify-end">
            <span class="inline-block w-fit px-2 py-0.5 md:px-2.5 md:py-1 bg-jet-stream text-ocean-deep text-[10px] md:text-xs font-bold rounded-full mb-2">
              Featured
            </span>
            <h2 class="text-base md:text-2xl font-bold text-white group-hover:text-jet-stream transition-colors mb-1">
              {hero.title}
            </h2>
            <p class="text-white/70 text-sm line-clamp-2 hidden md:block mb-2">{hero.description}</p>
            <div class="flex items-center gap-3 text-[10px] md:text-xs">
              <span class="text-white/50">{hero.readTime} min</span>
              <span class="text-jet-stream font-medium flex items-center">
                Read
                <svg class="w-3 h-3 ml-1 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
              </span>
            </div>
          </div>
        </a>
      )}

      <!-- Info cell -->
      <div class="col-span-2 lg:col-span-2 row-span-1 bg-black/40 border border-white/10 border-b-jet-stream/50 rounded-xl p-4 md:p-5 flex flex-col justify-center items-center text-center">
        <svg class="w-7 h-7 md:w-8 md:h-8 text-jet-stream mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 0 1-2.25 2.25M16.5 7.5V18a2.25 2.25 0 0 0 2.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 0 0 2.25 2.25h13.5M6 7.5h3v3H6v-3Z" />
        </svg>
        <span class="text-white font-semibold text-sm md:text-base">{filteredArticles.length} Articles</span>
        <span class="text-white/60 text-xs md:text-sm">In this category</span>
      </div>

      <!-- CTA cell -->
      <a href="/contact" class="group col-span-2 lg:col-span-2 row-span-1 bg-black/40 border border-jet-stream/30 border-b-jet-stream/60 rounded-xl p-4 md:p-5 flex flex-col justify-center items-center text-center transition-all duration-300 hover:border-jet-stream/50 hover:bg-black/50">
        <svg class="w-7 h-7 md:w-8 md:h-8 text-sky-light mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />
        </svg>
        <span class="text-white font-semibold text-sm md:text-base">Suggest Topic</span>
        <span class="text-jet-stream text-xs md:text-sm flex items-center mt-1">
          Contact us
          <svg class="w-3 h-3 ml-1 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
        </span>
      </a>

      <!-- Remaining articles in grid -->
      {remaining.slice(0, 2).map((article) => (
        <a
          href={article.href}
          class="group col-span-2 md:col-span-2 lg:col-span-3 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg"
        >
          <img src={article.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent"></div>
          <div class="absolute inset-0 p-3 md:p-4 flex flex-col justify-end">
            <span class="text-jet-stream text-[10px] md:text-xs font-medium mb-1 block">{article.category}</span>
            <h3 class="text-xs md:text-lg font-semibold text-white group-hover:text-jet-stream transition-colors line-clamp-2">{article.title}</h3>
            <p class="text-white/60 text-[10px] md:text-xs mt-1 line-clamp-1 hidden md:block">{article.description}</p>
          </div>
        </a>
      ))}

      <!-- More article cells -->
      {remaining.slice(2).map((article, i) => (
        <a
          href={article.href}
          class:list={[
            "group col-span-2 md:col-span-2 lg:col-span-2 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg",
            i >= 4 && "hidden lg:block"
          ]}
        >
          <img src={article.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
          <div class="absolute inset-0 p-2 md:p-3 flex flex-col justify-end">
            <span class="text-white/50 text-[8px] md:text-[10px] uppercase tracking-wide mb-0.5">{article.category}</span>
            <h3 class="text-[10px] md:text-sm font-semibold text-white group-hover:text-jet-stream transition-colors line-clamp-2 leading-tight">{article.title}</h3>
          </div>
        </a>
      ))}

    </div>

  </div>
</BaseLayout>
