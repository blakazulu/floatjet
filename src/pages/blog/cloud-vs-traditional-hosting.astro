// Related articles
const relatedArticles = [
  {
    title: 'Best Web Hosting for Remote Businesses',
    excerpt: 'Complete comparison of top hosting providers for remote teams and online businesses.',
    href: '/tools/best-web-hosting-remote-business',
    image: 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=800&q=80',
    imageAlt: 'Server room with hosting infrastructure'
  },
  {
    title: 'Managed WordPress Hosting Compared',
    excerpt: 'Find the best managed WordPress host for your blog or business site.',
    href: '/blog/managed-wordpress-hosting-compared',
