---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Crypto-Friendly Banks for Remote Workers | FloatJet';
const description = 'Traditional banks that play nice with cryptocurrency for the modern digital professional.';
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 py-20">
    <article class="max-w-3xl mx-auto">
      <h1 class="text-4xl font-bold text-white mb-4">Crypto-Friendly Banks for Remote Workers</h1>
      <p class="text-white/80 text-lg">Coming soon...</p>
    </article>
  </div>
</BaseLayout>
