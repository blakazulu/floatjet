---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Essential Travel Tech for Digital Nomads | FloatJet';
const description = 'Compact gadgets and accessories that make working from anywhere a breeze.';
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 py-20">
    <article class="max-w-3xl mx-auto">
      <h1 class="text-4xl font-bold text-white mb-4">Essential Travel Tech for Digital Nomads</h1>
      <p class="text-white/80 text-lg">Coming soon...</p>
    </article>
  </div>
</BaseLayout>
