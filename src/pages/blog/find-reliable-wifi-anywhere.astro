---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'How to Find Reliable WiFi Anywhere | FloatJet';
const description = 'Tips and tools for staying connected no matter where your travels take you.';
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 py-20">
    <article class="max-w-3xl mx-auto">
      <h1 class="text-4xl font-bold text-white mb-4">How to Find Reliable WiFi Anywhere</h1>
      <p class="text-white/80 text-lg">Coming soon...</p>
    </article>
  </div>
</BaseLayout>
