---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {ChevronLeft, ChevronRight} from 'lucide-astro';

const title = 'Web Hosting Articles for Remote Workers | FloatJet';
const description = 'Compare web hosting solutions for remote businesses. Cloud hosting, WordPress hosting, and more for digital entrepreneurs without overpaying for resources.';

const mainArticle = {
  title: 'Cloud vs Traditional Hosting',
  description: 'Compare cloud and traditional hosting solutions to find the best fit for your remote business or side project.',
  href: '/blog/cloud-vs-traditional-hosting',
  readTime: '11 min'
};

const articles = [
  {
    title: 'Managed WordPress Hosting Compared',
    description: 'Find the best managed WordPress hosting for your blog or business website.',
    href: '/blog/managed-wordpress-hosting-compared',
    icon: '🔧',
    category: 'Hosting',
    readTime: 13
  }
];

const tips = [
  {
    title: 'Uptime Matters',
    description: 'Look for 99.9%+ uptime guarantees for <a href="/tools/best-ecommerce-hosting" class="text-sky-light hover:underline">business sites</a>',
    icon: '⬆️'
  },
  {
    title: 'Scalability',
    description: 'Choose <a href="/tools/best-vps-hosting-remote-business" class="text-sky-light hover:underline">hosting that grows</a> with your traffic needs',
    icon: '📈'
  },
  {
    title: 'Support Quality',
    description: '24/7 support is essential when <a href="/guides/work-remotely-different-time-zones" class="text-sky-light hover:underline">working across time zones</a>',
    icon: '💬'
  },
  {
    title: 'Backup Strategy',
    description: 'Ensure automatic backups with <a href="/tools/best-cloud-storage-remote-work" class="text-sky-light hover:underline">reliable storage</a>',
    icon: '💾'
  }
];
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <!-- Header -->
    <div class="text-center mb-12">
      <a href="/blog" class="inline-flex items-center text-white/60 hover:text-white text-sm mb-4 transition-colors">
        <ChevronLeft class="w-4 h-4 mr-1" aria-hidden="true"/>
        All Blog Articles
      </a>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Hosting</h1>
      <p class="text-lg text-white/80 max-w-2xl mx-auto">
        Web hosting insights for <a href="/tools/best-web-hosting-remote-business"
                                    class="text-jet-stream hover:text-sky-light underline">remote businesses</a> and
        digital entrepreneurs.
      </p>
    </div>

    <!-- Main Article Card -->
    <a
        href={mainArticle.href}
        class="block max-w-3xl mx-auto mb-12 group bg-gradient-to-r from-ocean-deep/40 to-jet-stream/20 border border-white/20 hover:border-jet-stream/50 rounded-xl p-8 transition-all duration-300"
    >
      <div class="flex items-center gap-2 mb-4">
        <span class="text-4xl">🌐</span>
        <span class="px-3 py-1 bg-jet-stream text-ocean-deep text-xs font-bold rounded-full">Featured Article</span>
      </div>
      <h2 class="text-2xl md:text-3xl font-bold text-white group-hover:text-jet-stream transition-colors mb-3">
        {mainArticle.title}
      </h2>
      <p class="text-white/70 mb-4">
        {mainArticle.description}
      </p>
      <div class="flex items-center justify-between">
        <span class="text-white/50 text-sm">{mainArticle.readTime} read</span>
        <span class="text-jet-stream font-medium flex items-center">
          Read Article
          <ChevronRight class="w-5 h-5 ml-1 group-hover:translate-x-1 transition-transform" aria-hidden="true"/>
        </span>
      </div>
    </a>

    <!-- More Articles -->
    <div class="mb-12">
      <h2 class="text-xl font-semibold text-white text-center mb-8">More Hosting Articles</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {articles.map(article => (
            <a
                href={article.href}
                class="group bg-black/40 hover:bg-black/50 border border-white/10 hover:border-white/20 rounded-xl p-6 transition-all duration-300"
            >
              <div class="flex items-start gap-4">
                <span class="text-3xl flex-shrink-0">{article.icon}</span>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-2">
                  <span class="inline-block px-2 py-0.5 bg-jet-stream/20 text-jet-stream text-xs font-medium rounded">
                    {article.category}
                  </span>
                    <span class="text-white/40 text-xs">{article.readTime} min</span>
                  </div>
                  <h2 class="text-lg font-semibold text-white group-hover:text-jet-stream transition-colors mb-2">
                    {article.title}
                  </h2>
                  <p class="text-white/70 text-sm">{article.description}</p>
                </div>
              </div>
              <div class="mt-4 flex items-center text-jet-stream text-sm font-medium">
                Read Article
                <ChevronRight class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" aria-hidden="true"/>
              </div>
            </a>
        ))}
      </div>

      <!-- Article Count -->
      <div class="mt-6 text-center">
        <p class="text-white/50 text-sm">
          {articles.length + 1} articles in Hosting
        </p>
      </div>
    </div>

    <!-- Tips Section -->
    <div class="max-w-4xl mx-auto mb-12">
      <h2 class="text-xl font-semibold text-white text-center mb-8">Hosting Best Practices</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {tips.map(tip => (
            <div class="flex items-start gap-4 bg-white/5 border border-white/10 rounded-xl p-5">
              <span class="text-2xl">{tip.icon}</span>
              <div>
                <h3 class="text-white font-semibold mb-1">{tip.title}</h3>
                <p class="text-white/60 text-sm">{tip.description}</p>
              </div>
            </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-12 text-center">
      <a
          href={mainArticle.href}
          class="inline-flex items-center justify-center px-6 py-3 bg-jet-stream text-ocean-deep font-semibold rounded-lg hover:bg-sky-light transition-colors"
      >
        Compare Hosting Options
      </a>
    </div>
  </div>
</BaseLayout>
