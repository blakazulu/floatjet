---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Security Articles for Remote Workers | FloatJet";
const description =
  "Stay safe while working remotely. VPN guides, online security tips, and privacy best practices for digital nomads without getting paranoid or hacked constantly.";

const mainArticle = {
  title: "VPN Speed Comparison",
  description:
    "We tested VPN speeds across 20+ countries. See which VPNs are fastest and most reliable for remote work.",
  href: "/blog/vpn-speed-comparison",
  readTime: "10 min",
};

const articles = [
  {
    title: "VPN on Public WiFi Guide",
    description: "How to stay safe when using public WiFi networks in cafes, airports, and hotels.",
    href: "/blog/vpn-public-wifi-guide",
    icon: "🛡️",
    category: "Security",
    readTime: 8,
  },
];

const tips = [
  {
    title: "Always Use a VPN",
    description:
      'Encrypt your connection on all <a href="/guides/do-i-need-vpn-cafes" class="text-sky-light hover:underline">public networks</a>',
    icon: "🔐",
  },
  {
    title: "Enable 2FA",
    description:
      '<a href="/guides/two-factor-authentication-guide" class="text-sky-light hover:underline">Two-factor authentication</a> on all important accounts',
    icon: "📱",
  },
  {
    title: "Use Strong Passwords",
    description:
      'Unique passwords for every account, managed by a <a href="/guides/do-i-really-need-password-manager" class="text-sky-light hover:underline">password manager</a>',
    icon: "🔑",
  },
  {
    title: "Update Regularly",
    description:
      'Keep software and devices updated to <a href="/guides/phishing-scams-remote-workers" class="text-sky-light hover:underline">patch vulnerabilities</a>',
    icon: "🔄",
  },
];
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <!-- Header -->
    <div class="text-center mb-12">
      <a href="/blog" class="inline-flex items-center text-white/60 hover:text-white text-sm mb-4 transition-colors">
        <svg class="w-4 h-4 mr-1" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg>
        All Blog Articles
      </a>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Security</h1>
      <p class="text-lg text-white/80 max-w-2xl mx-auto">
        Stay safe online while <a href="/guides/secure-home-wifi-network"
                                  class="text-jet-stream hover:text-sky-light underline">working from anywhere</a> in
        the world.
      </p>
    </div>

    <!-- Main Article Card -->
    <a
        href={mainArticle. Href}
        class="block max-w-3xl mx-auto mb-12 group bg-gradient-to-r from-ocean-deep/40 to-jet-stream/20 border border-white/20 hover:border-jet-stream/50 rounded-xl p-8 transition-all duration-300"
    >
      <div class="flex items-center gap-2 mb-4">
        <span class="text-4xl">🔒</span>
        <span class="px-3 py-1 bg-jet-stream text-ocean-deep text-xs font-bold rounded-full">Featured Article</span>
      </div>
      <h2 class="text-2xl md:text-3xl font-bold text-white group-hover:text-jet-stream transition-colors mb-3">
        {mainArticle. Title}
      </h2>
      <p class="text-white/70 mb-4">
        {mainArticle. Description}
      </p>
      <div class="flex items-center justify-between">
        <span class="text-white/50 text-sm">{mainArticle. ReadTime} read</span>
        <span class="text-jet-stream font-medium flex items-center">
          Read Article
          <svg class="w-5 h-5 ml-1 group-hover:translate-x-1 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
        </span>
      </div>
    </a>

    <!-- More Articles -->
    <div class="mb-12">
      <h2 class="text-xl font-semibold text-white text-center mb-8">More Security Articles</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {articles. Map(article => (
            <a
                href={article. Href}
                class="group bg-black/40 hover:bg-black/50 border border-white/10 hover:border-white/20 rounded-xl p-6 transition-all duration-300"
            >
              <div class="flex items-start gap-4">
                <span class="text-3xl flex-shrink-0">{article. Icon}</span>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-2">
                  <span class="inline-block px-2 py-0.5 bg-jet-stream/20 text-jet-stream text-xs font-medium rounded">
                    {article. Category}
                  </span>
                    <span class="text-white/40 text-xs">{article. ReadTime} min</span>
                  </div>
                  <h2 class="text-lg font-semibold text-white group-hover:text-jet-stream transition-colors mb-2">
                    {article. Title}
                  </h2>
                  <p class="text-white/70 text-sm">{article. Description}</p>
                </div>
              </div>
              <div class="mt-4 flex items-center text-jet-stream text-sm font-medium">
                Read Article
                <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
              </div>
            </a>
        ))}
      </div>

      <!-- Article Count -->
      <div class="mt-6 text-center">
        <p class="text-white/50 text-sm">
          {articles. Length + 1} articles in Security
        </p>
      </div>
    </div>

    <!-- Tips Section -->
    <div class="max-w-4xl mx-auto mb-12">
      <h2 class="text-xl font-semibold text-white text-center mb-8">Security Best Practices</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {tips. Map(tip => (
            <div class="flex items-start gap-4 bg-white/5 border border-white/10 rounded-xl p-5">
              <span class="text-2xl">{tip. Icon}</span>
              <div>
                <h3 class="text-white font-semibold mb-1">{tip. Title}</h3>
                <p class="text-white/60 text-sm">{tip. Description}</p>
              </div>
            </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-12 text-center">
      <a
          href={mainArticle. Href}
          class="inline-flex items-center justify-center px-6 py-3 bg-jet-stream text-ocean-deep font-semibold rounded-lg hover:bg-sky-light transition-colors"
      >
        Compare VPN Speeds
      </a>
    </div>
  </div>
</BaseLayout>
