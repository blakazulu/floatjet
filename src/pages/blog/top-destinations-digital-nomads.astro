---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Top Destinations for Digital Nomads in 2024 | FloatJet";
const description = "Cities with great WiFi, affordable living, and thriving remote work communities.";
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 py-20">
    <article class="max-w-3xl mx-auto">
      <h1 class="text-4xl font-bold text-white mb-4">Top Destinations for Digital Nomads in 2024</h1>
      <p class="text-white/80 text-lg">Coming soon...</p>
    </article>
  </div>
</BaseLayout>
