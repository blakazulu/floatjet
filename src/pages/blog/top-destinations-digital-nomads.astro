// FAQ data
const faqs = [
  {
    question: 'What is a digital nomad visa?',
    answer: '<p>A digital nomad visa allows remote workers to legally live and work in a foreign country while employed by companies outside that country. Countries like Portugal, Spain, Croatia, and Costa Rica offer these visas, typically requiring proof of remote income ($2,000-4,000/month) and health insurance. They usually last 1-2 years and are renewable.</p>'
