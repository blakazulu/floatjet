---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Travel Articles for Digital Nomads | FloatJet';
const description = 'Essential travel tips for remote workers and digital nomads. Destinations, gear, internet access, and travel insurance without visa headaches or connectivity disasters.';

const mainArticle = {
  title: 'Top Destinations for Digital Nomads',
  description: 'Best cities for remote work based on cost of living, internet speed, community, and quality of life. Updated for 2025.',
  href: '/blog/top-destinations-digital-nomads',
  readTime: '14 min'
};

const articles = [
  {
    title: 'How to Find Reliable WiFi Anywhere',
    description: 'Tips and tools for finding fast, reliable internet while traveling.',
    href: '/blog/find-reliable-wifi-anywhere',
    icon: '📶',
    category: 'Travel',
    readTime: 9
  },
  {
    title: 'Best Travel Insurance for Remote Workers',
    description: 'Compare travel insurance options designed specifically for digital nomads.',
    href: '/blog/best-travel-insurance-remote-workers',
    icon: '🏥',
    category: 'Travel',
    readTime: 12
  },
  {
    title: 'Essential Travel Tech for Nomads',
    description: 'Must-have gadgets and gear for working while traveling the world.',
    href: '/blog/essential-travel-tech-nomads',
    icon: '🎒',
    category: 'Travel',
    readTime: 11
  }
];

const tips = [
  {
    title: 'Test Internet First',
    description: 'Always check <a href="/guides/internet-speed-remote-work" class="text-sky-light hover:underline">WiFi speed</a> before booking accommodations',
    icon: '📶'
  },
  {
    title: 'Get Travel Insurance',
    description: 'Essential coverage for <a href="/guides/digital-nomad-visa-portugal" class="text-sky-light hover:underline">medical emergencies abroad</a>',
    icon: '🏥'
  },
  {
    title: 'Pack Light',
    description: 'One bag travel with <a href="/gear/best-laptop-bags-backpacks" class="text-sky-light hover:underline">quality gear</a> makes moving effortless',
    icon: '🎒'
  },
  {
    title: 'Join Nomad Communities',
    description: 'Connect with others for tips, <a href="/guides/best-coworking-spaces-lisbon" class="text-sky-light hover:underline">coworking</a>, and friendship',
    icon: '👥'
  }
];
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <!-- Header -->
    <div class="text-center mb-12">
      <a href="/blog" class="inline-flex items-center text-white/60 hover:text-white text-sm mb-4 transition-colors">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        All Blog Articles
      </a>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Travel</h1>
      <p class="text-lg text-white/80 max-w-2xl mx-auto">
        Work from anywhere. Tips for the <a href="/guides/can-you-work-remotely-another-country"
                                            class="text-jet-stream hover:text-sky-light underline">digital nomad
        lifestyle</a>.
      </p>
    </div>

    <!-- Main Article Card -->
    <a
        href={mainArticle.href}
        class="block max-w-3xl mx-auto mb-12 group bg-gradient-to-r from-ocean-deep/40 to-jet-stream/20 border border-white/20 hover:border-jet-stream/50 rounded-xl p-8 transition-all duration-300"
    >
      <div class="flex items-center gap-2 mb-4">
        <span class="text-4xl">✈️</span>
        <span class="px-3 py-1 bg-jet-stream text-ocean-deep text-xs font-bold rounded-full">Featured Article</span>
      </div>
      <h2 class="text-2xl md:text-3xl font-bold text-white group-hover:text-jet-stream transition-colors mb-3">
        {mainArticle.title}
      </h2>
      <p class="text-white/70 mb-4">
        {mainArticle.description}
      </p>
      <div class="flex items-center justify-between">
        <span class="text-white/50 text-sm">{mainArticle.readTime} read</span>
        <span class="text-jet-stream font-medium flex items-center">
          Read Article
          <svg class="w-5 h-5 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor"
               viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </span>
      </div>
    </a>

    <!-- More Articles -->
    <div class="mb-12">
      <h2 class="text-xl font-semibold text-white text-center mb-8">More Travel Articles</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {articles.map(article => (
            <a
                href={article.href}
                class="group bg-black/40 hover:bg-black/50 border border-white/10 hover:border-white/20 rounded-xl p-6 transition-all duration-300"
            >
              <div class="flex items-start gap-4">
                <span class="text-3xl flex-shrink-0">{article.icon}</span>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-2">
                  <span class="inline-block px-2 py-0.5 bg-jet-stream/20 text-jet-stream text-xs font-medium rounded">
                    {article.category}
                  </span>
                    <span class="text-white/40 text-xs">{article.readTime} min</span>
                  </div>
                  <h2 class="text-lg font-semibold text-white group-hover:text-jet-stream transition-colors mb-2">
                    {article.title}
                  </h2>
                  <p class="text-white/70 text-sm">{article.description}</p>
                </div>
              </div>
              <div class="mt-4 flex items-center text-jet-stream text-sm font-medium">
                Read Article
                <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none"
                     stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </div>
            </a>
        ))}
      </div>

      <!-- Article Count -->
      <div class="mt-6 text-center">
        <p class="text-white/50 text-sm">
          {articles.length + 1} articles in Travel
        </p>
      </div>
    </div>

    <!-- Tips Section -->
    <div class="max-w-4xl mx-auto mb-12">
      <h2 class="text-xl font-semibold text-white text-center mb-8">Digital Nomad Tips</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {tips.map(tip => (
            <div class="flex items-start gap-4 bg-white/5 border border-white/10 rounded-xl p-5">
              <span class="text-2xl">{tip.icon}</span>
              <div>
                <h3 class="text-white font-semibold mb-1">{tip.title}</h3>
                <p class="text-white/60 text-sm">{tip.description}</p>
              </div>
            </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-12 text-center">
      <a
          href={mainArticle.href}
          class="inline-flex items-center justify-center px-6 py-3 bg-jet-stream text-ocean-deep font-semibold rounded-lg hover:bg-sky-light transition-colors"
      >
        Explore Top Destinations
      </a>
    </div>
  </div>
</BaseLayout>
