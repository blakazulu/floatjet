  <div class="container mx-auto px-4 py-20">
    <article class="max-w-3xl mx-auto">
      <h1 class="text-4xl font-bold text-white mb-4">Must-Have Remote Gear</h1>
      <p class="text-white/80 text-lg">Coming soon...</p>
    </article>
  </div>
</BaseLayout>
