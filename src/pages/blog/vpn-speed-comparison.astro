// Related articles
const relatedArticles = [
  {
    title: 'Best VPNs for Digital Nomads',
    excerpt: 'Complete guide to choosing the right VPN for remote work, with full reviews of top providers.',
    href: '/tools/best-vpn-digital-nomads',
    image: 'https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?auto=format&fit=crop&w=800&q=80',
    imageAlt: 'Digital security concept'
  },
  {
    title: 'VPN & Public WiFi Security Guide',
    excerpt: 'How to stay safe on public networks while traveling and working remotely.',
    href: '/blog/vpn-public-wifi-guide',
    image: 'https://images.unsplash.com/photo-1563013544-824ae1b704d3?auto=format&fit=crop&w=800&q=80',
    imageAlt: 'Person working at cafe on laptop'
  },
  {
    title: 'Find Reliable WiFi Anywhere',
    excerpt: 'Tips and tools for finding fast, stable internet connections while traveling.',
    href: '/blog/find-reliable-wifi-anywhere',
    image: 'https://images.unsplash.com/photo-1521791136064-7986c2920216?auto=format&fit=crop&w=800&q=80',
