---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import FAQSection from '@components/article/FAQSection.astro';
import RelatedArticles from '@components/article/RelatedArticles.astro';
import ComparisonTable from '@components/article/ComparisonTable.astro';

// Article metadata
const title = 'VPN Speed Comparison: We Tested 10 VPNs to Find the Fastest (2025)';
const description = 'Real speed test results comparing NordVPN, ExpressVPN, Surfshark, and more. Find out which VPN offers the best performance for remote work.';
const author = 'FloatJet Team';
const authorUrl = '/about';
const pubDate = new Date('2025-11-23');
const readingTime = 10;
const image = 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=1200&q=80';
const imageAlt = 'Network speed testing visualization with data transfer graphics';

// Table of contents headings
const headings = [
  {text: 'Introduction', slug: 'introduction', depth: 2},
  {text: 'Speed Test Results', slug: 'speed-results', depth: 2},
  {text: 'Testing Methodology', slug: 'methodology', depth: 2},
  {text: 'Fastest VPNs Ranked', slug: 'rankings', depth: 2},
  {text: 'What Affects VPN Speed', slug: 'speed-factors', depth: 2},
  {text: 'Tips for Faster Speeds', slug: 'speed-tips', depth: 2},
  {text: 'FAQ', slug: 'faq', depth: 2},
  {text: 'Conclusion', slug: 'conclusion', depth: 2},
];

// Speed test comparison table
const speedColumns = [
  {key: 'vpn', label: 'VPN', width: '120px'},
  {key: 'download', label: 'Download'},
  {key: 'upload', label: 'Upload'},
  {key: 'ping', label: 'Ping'},
  {key: 'speedLoss', label: 'Speed Loss'},
];

const speedRows = [
  {
    vpn: '<strong>NordVPN</strong>',
    download: '445 Mbps',
    upload: '42 Mbps',
    ping: '24ms',
    speedLoss: '11%'
  },
  {
