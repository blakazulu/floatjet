    ping: '28ms',
    speedLoss: '14%'
  },
  {
    vpn: '<strong>Surfshark</strong>',
    download: '410 Mbps',
    upload: '38 Mbps',
    ping: '31ms',
    speedLoss: '18%'
  },
  {
    vpn: '<strong>CyberGhost</strong>',
    download: '385 Mbps',
    upload: '35 Mbps',
    ping: '35ms',
    speedLoss: '23%'
  },
  {
    vpn: '<strong>ProtonVPN</strong>',
    download: '378 Mbps',
    upload: '34 Mbps',
    ping: '38ms',
    speedLoss: '24%'
  },
  {
    vpn: '<strong>Private Internet Access</strong>',
    download: '365 Mbps',
    upload: '32 Mbps',
    ping: '42ms',
    speedLoss: '27%'
  },
];

// FAQ data
const faqs = [
  {
    question: 'Will a VPN always slow down my internet?',
    answer: '<p>Yes, VPNs add some overhead because your traffic is encrypted and routed through an additional server. However, premium VPNs like NordVPN and ExpressVPN typically only reduce speeds by 10-15%, which is barely noticeable for most activities including video calls and streaming.</p>'
  },
  {
    question: 'Which VPN protocol is fastest?',
    answer: '<p><strong>WireGuard</strong> (or NordVPN\'s NordLynx) is currently the fastest VPN protocol, offering speeds 2-3x faster than OpenVPN while maintaining strong security. Most modern VPNs now support WireGuard.</p>'
  },
  {
    question: 'Does server distance affect VPN speed?',
    answer: '<p>Yes, significantly. Connecting to a server in your own country will always be faster than connecting halfway around the world. For best speeds, use the "Quick Connect" feature or manually select a nearby server.</p>'
  },
  {
    question: 'Can a VPN actually make my internet faster?',
    answer: '<p>In some cases, yes. If your ISP throttles certain traffic (like streaming or gaming), a VPN can bypass this throttling and actually improve speeds. However, this is ISP-specific and not guaranteed.</p>'
  },
  {
    question: 'What internet speed do I need for VPN to work well?',
    answer: '<p>For basic browsing and email, 10 Mbps is sufficient. For HD video calls, aim for 25+ Mbps. For 4K streaming, you\'ll want 50+ Mbps. Factor in the 10-20% VPN overhead when calculating your needs.</p>'
  }
