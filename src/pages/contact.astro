---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Contact Us | FloatJet";
const description =
  "Get in touch with the FloatJet team. We'd love to hear your feedback, suggestions, or questions about remote work tools.";
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <div class="max-w-2xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Get in Touch</h1>
        <p class="text-lg text-white/80">
          Have a question, suggestion, or just want to say hello? We'd love to hear from you.
        </p>
      </div>

      <!-- Contact Options -->
      <div class="space-y-6">
        <!-- General Inquiries -->
        <div class="bg-white/5 rounded-xl p-6 border border-white/10">
          <div class="flex items-start gap-4">
            <div class="bg-jet-stream/20 rounded-lg p-3 flex-shrink-0">
              <svg class="w-6 h-6 text-jet-stream" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </div>
            <div>
              <h2 class="text-xl font-semibold text-white mb-2">General Inquiries</h2>
              <p class="text-white/70 mb-3">
                Questions, feedback, or just want to chat about remote work tools.
              </p>
              <a href="mailto:hello@floatjet. Com"
                 class="text-jet-stream hover:text-sky-light transition-colors font-medium">
                hello@floatjet. Com
              </a>
            </div>
          </div>
        </div>

        <!-- Partnership Inquiries -->
        <div class="bg-white/5 rounded-xl p-6 border border-white/10">
          <div class="flex items-start gap-4">
            <div class="bg-jet-stream/20 rounded-lg p-3 flex-shrink-0">
              <svg class="w-6 h-6 text-jet-stream" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div>
              <h2 class="text-xl font-semibold text-white mb-2">Partnerships & PR</h2>
              <p class="text-white/70 mb-3">
                Interested in partnering with FloatJet or have a product you'd like us to review?
              </p>
              <a href="mailto:partnerships@floatjet. Com"
                 class="text-jet-stream hover:text-sky-light transition-colors font-medium">
                partnerships@floatjet. Com
              </a>
            </div>
          </div>
        </div>

        <!-- Privacy & Legal -->
        <div class="bg-white/5 rounded-xl p-6 border border-white/10">
          <div class="flex items-start gap-4">
            <div class="bg-jet-stream/20 rounded-lg p-3 flex-shrink-0">
              <svg class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg>
            </div>
            <div>
              <h2 class="text-xl font-semibold text-white mb-2">Privacy & Legal</h2>
              <p class="text-white/70 mb-3">
                Questions about our privacy policy, data practices, or legal matters.
              </p>
              <a href="mailto:privacy@floatjet. Com"
                 class="text-jet-stream hover:text-sky-light transition-colors font-medium">
                privacy@floatjet. Com
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Response Time Notice -->
      <div class="mt-8 p-4 bg-ocean-deep/20 rounded-lg border border-ocean-deep/30">
        <p class="text-white/70 text-sm text-center">
          <strong class="text-white">Response Time:</strong> We typically respond within 1-2 business days. Thanks for
          your patience!
        </p>
      </div>

      <!-- What We're Looking For -->
      <div class="mt-12">
        <h2 class="text-xl font-semibold text-white mb-4 text-center">We'd Especially Love to Hear About</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="flex items-center gap-3 text-white/80">
            <svg class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
            <span>Tools you'd like us to review</span>
          </div>
          <div class="flex items-center gap-3 text-white/80">
            <svg class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
            <span>Errors or outdated information</span>
          </div>
          <div class="flex items-center gap-3 text-white/80">
            <svg class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
            <span>Topic suggestions</span>
          </div>
          <div class="flex items-center gap-3 text-white/80">
            <svg class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
            <span>Your remote work story</span>
          </div>
        </div>
      </div>

      <!-- FAQ Callout -->
      <div class="mt-12 text-center">
        <p class="text-white/60 text-sm">
          Looking for information about our editorial process or affiliate relationships?
          <a href="/about" class="text-jet-stream hover:text-sky-light transition-colors">Visit our About page</a>.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
