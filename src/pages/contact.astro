---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Contact Us | FloatJet';
const description = 'Get in touch with the FloatJet team. We\'d love to hear your feedback, suggestions, or questions about remote work tools.';
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <div class="max-w-2xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Get in Touch</h1>
        <p class="text-lg text-white/80">
          Have a question, suggestion, or just want to say hello? We'd love to hear from you.
        </p>
      </div>

      <!-- Contact Options -->
      <div class="space-y-6">
        <!-- General Inquiries -->
        <div class="bg-white/5 rounded-xl p-6 border border-white/10">
          <div class="flex items-start gap-4">
            <div class="bg-jet-stream/20 rounded-lg p-3 flex-shrink-0">
              <svg class="w-6 h-6 text-jet-stream" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <h2 class="text-xl font-semibold text-white mb-2">General Inquiries</h2>
              <p class="text-white/70 mb-3">
                Questions, feedback, or just want to chat about remote work tools.
              </p>
              <a href="mailto:hello@floatjet.com" class="text-jet-stream hover:text-sky-light transition-colors font-medium">
                hello@floatjet.com
              </a>
            </div>
          </div>
        </div>

        <!-- Partnership Inquiries -->
        <div class="bg-white/5 rounded-xl p-6 border border-white/10">
          <div class="flex items-start gap-4">
            <div class="bg-jet-stream/20 rounded-lg p-3 flex-shrink-0">
              <svg class="w-6 h-6 text-jet-stream" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
              </svg>
            </div>
            <div>
              <h2 class="text-xl font-semibold text-white mb-2">Partnerships & PR</h2>
              <p class="text-white/70 mb-3">
                Interested in partnering with FloatJet or have a product you'd like us to review?
              </p>
              <a href="mailto:partnerships@floatjet.com" class="text-jet-stream hover:text-sky-light transition-colors font-medium">
                partnerships@floatjet.com
              </a>
            </div>
          </div>
        </div>

        <!-- Privacy & Legal -->
        <div class="bg-white/5 rounded-xl p-6 border border-white/10">
          <div class="flex items-start gap-4">
            <div class="bg-jet-stream/20 rounded-lg p-3 flex-shrink-0">
              <svg class="w-6 h-6 text-jet-stream" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <div>
              <h2 class="text-xl font-semibold text-white mb-2">Privacy & Legal</h2>
              <p class="text-white/70 mb-3">
                Questions about our privacy policy, data practices, or legal matters.
              </p>
              <a href="mailto:privacy@floatjet.com" class="text-jet-stream hover:text-sky-light transition-colors font-medium">
                privacy@floatjet.com
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Response Time Notice -->
      <div class="mt-8 p-4 bg-ocean-deep/20 rounded-lg border border-ocean-deep/30">
        <p class="text-white/70 text-sm text-center">
          <strong class="text-white">Response Time:</strong> We typically respond within 1-2 business days. Thanks for your patience!
        </p>
      </div>

      <!-- What We're Looking For -->
      <div class="mt-12">
        <h2 class="text-xl font-semibold text-white mb-4 text-center">We'd Especially Love to Hear About</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="flex items-center gap-3 text-white/80">
            <svg class="w-5 h-5 text-jet-stream flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span>Tools you'd like us to review</span>
          </div>
          <div class="flex items-center gap-3 text-white/80">
            <svg class="w-5 h-5 text-jet-stream flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span>Errors or outdated information</span>
          </div>
          <div class="flex items-center gap-3 text-white/80">
            <svg class="w-5 h-5 text-jet-stream flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span>Topic suggestions</span>
          </div>
          <div class="flex items-center gap-3 text-white/80">
            <svg class="w-5 h-5 text-jet-stream flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span>Your remote work story</span>
          </div>
        </div>
      </div>

      <!-- FAQ Callout -->
      <div class="mt-12 text-center">
        <p class="text-white/60 text-sm">
          Looking for information about our editorial process or affiliate relationships?
          <a href="/about" class="text-jet-stream hover:text-sky-light transition-colors">Visit our About page</a>.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
