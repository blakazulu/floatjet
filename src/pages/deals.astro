---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Remote Work Tool Deals & Discounts | FloatJet";
const description =
  "Save on the best remote work tools with our curated deals and exclusive discounts on software, gear, and services.";

// Featured deals
const deals = [
  {
    name: "NordVPN",
    discount: "Up to 68% off",
    description: "2-year plan with 3 months free. Secure your connection while working remotely.",
    link: "/tools/best-vpn-digital-nomads/#nordvpn",
    category: "VPN",
    highlight: true,
  },
  {
    name: "Notion",
    discount: "Free for personal use",
    description: "Full-featured workspace for notes, docs, and project management.",
    link: "/tools/best-project-management-software/#notion",
    category: "Productivity",
  },
  {
    name: "ClickUp",
    discount: "Free tier available",
    description: "Powerful project management with generous free plan for small teams.",
    link: "/tools/best-project-management-software/#clickup",
    category: "Productivity",
  },
  {
    name: "1Password",
    discount: "14-day free trial",
    description: "Secure password management for individuals and teams.",
    link: "/tools/best-password-manager-remote-work/#1password",
    category: "Security",
  },
  {
    name: "ConvertKit",
    discount: "Free up to 1,000 subscribers",
    description: "Email marketing built for creators and online businesses.",
    link: "/tools/best-email-marketing-tools/#convertkit",
    category: "Marketing",
  },
  {
    name: "Toggl Track",
    discount: "Free for up to 5 users",
    description: "Simple time tracking for freelancers and small teams.",
    link: "/tools/best-time-tracking-software/#toggl",
    category: "Productivity",
  },
];
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-28 md:pt-36 pb-16 md:pb-20">
    <!-- Header -->
    <div class="text-center mb-14">
      <p class="eyebrow mb-2">Current discounts</p>
      <h1 class="font-display font-bold text-4xl md:text-6xl tracking-[-0.04em] leading-[0.95] text-ink text-balance mb-5">Deals & Discounts</h1>
      <p class="text-lg text-ink/85 max-w-2xl mx-auto">
        Save money on the tools you need. We've curated the best deals on remote work software and gear.
      </p>
    </div>

    <!-- Deals Grid -->
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 max-w-6xl mx-auto">
      {deals.map(deal => (
          <a
              href={deal.link}
              class={`group relative flex flex-col sticker sticker-hover rounded-[22px] p-6 ${deal.highlight ? 'bg-sand' : ''}`}
          >
            {deal.highlight && (
                <span
                    class="absolute -top-4 left-4 px-3 py-1 bg-coral border-[1.5px] border-ink text-ink text-xs font-bold rounded-full">
              Popular
            </span>
            )}
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-medium text-ink-soft uppercase tracking-wider">{deal.category}</span>
              <span class="px-3 py-1 bg-sun border-[1.5px] border-ink text-ink text-xs font-bold rounded-full rotate-2">
              {deal.discount}
            </span>
            </div>
            <h2 class="font-display text-xl font-bold text-ink group-hover:underline decoration-2 underline-offset-4 mb-2">
              {deal.name}
            </h2>
            <p class="text-ink-soft text-sm mb-4">
              {deal.description}
            </p>
            <span class="mt-auto text-teal-ink text-sm font-bold flex items-center">
            View Deal
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
          </span>
          </a>
      ))}
    </div>

    <!-- Newsletter CTA -->
    <div
        class="mt-16 max-w-2xl mx-auto text-center rounded-[28px] p-8 border-[1.5px] border-dashed border-ink">
      <h2 class="font-display text-2xl md:text-3xl font-bold tracking-tight text-ink mb-3">Get Deal Alerts</h2>
      <p class="text-ink-soft mb-6">
        Be the first to know about exclusive discounts and limited-time offers on remote work tools.
      </p>
      <p class="text-ink-soft text-sm">
        Newsletter coming soon. For now, check our reviews for the latest pricing info.
      </p>
    </div>

  </div>
</BaseLayout>
