---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Remote Work Tool Deals & Discounts | FloatJet';
const description = 'Save on the best remote work tools with our curated deals and exclusive discounts on software, gear, and services.';

// Featured deals
const deals = [
  {
    name: 'NordVPN',
    discount: 'Up to 68% off',
    description: '2-year plan with 3 months free. Secure your connection while working remotely.',
    link: '/tools/best-vpn-digital-nomads#nordvpn',
    category: 'VPN',
    highlight: true
  },
  {
    name: 'Notion',
    discount: 'Free for personal use',
    description: 'Full-featured workspace for notes, docs, and project management.',
    link: '/tools/best-project-management-software#notion',
    category: 'Productivity'
  },
  {
    name: 'ClickUp',
    discount: 'Free tier available',
    description: 'Powerful project management with generous free plan for small teams.',
    link: '/tools/best-project-management-software#clickup',
    category: 'Productivity'
  },
  {
    name: '1Password',
    discount: '14-day free trial',
    description: 'Secure password management for individuals and teams.',
    link: '/tools/best-password-manager-remote-work#1password',
    category: 'Security'
  },
  {
    name: 'ConvertKit',
    discount: 'Free up to 1,000 subscribers',
    description: 'Email marketing built for creators and online businesses.',
    link: '/tools/best-email-marketing-tools#convertkit',
    category: 'Marketing'
  },
  {
    name: 'Toggl Track',
    discount: 'Free for up to 5 users',
    description: 'Simple time tracking for freelancers and small teams.',
    link: '/tools/best-time-tracking-software#toggl',
    category: 'Productivity'
  }
];
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Deals & Discounts</h1>
      <p class="text-lg text-white/80 max-w-2xl mx-auto">
        Save money on the tools you need. We've curated the best deals on remote work software and gear.
      </p>
    </div>

    <!-- Deals Grid -->
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 max-w-6xl mx-auto">
      {deals.map(deal => (
          <a
              href={deal.link}
              class={`group relative bg-white/5 hover:bg-white/10 border rounded-xl p-6 transition-all duration-300 ${
                deal.highlight ? 'border-jet-stream/50 hover:border-jet-stream' : 'border-white/10 hover:border-white/20'
              }`}
          >
            {deal.highlight && (
                <span
                    class="absolute -top-3 left-4 px-3 py-1 bg-jet-stream text-ocean-deep text-xs font-bold rounded-full">
              Popular
            </span>
            )}
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-medium text-white/50 uppercase tracking-wider">{deal.category}</span>
              <span class="px-2 py-1 bg-green-500/20 text-green-400 text-xs font-semibold rounded">
              {deal.discount}
            </span>
            </div>
            <h2 class="text-xl font-semibold text-white group-hover:text-jet-stream transition-colors mb-2">
              {deal.name}
            </h2>
            <p class="text-white/70 text-sm mb-4">
              {deal.description}
            </p>
            <span class="text-jet-stream text-sm font-medium flex items-center">
            View Deal
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor"
                 viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </span>
          </a>
      ))}
    </div>

    <!-- Newsletter CTA -->
    <div
        class="mt-16 max-w-2xl mx-auto text-center bg-gradient-to-r from-ocean-deep/40 to-jet-stream/20 rounded-xl p-8 border border-white/10">
      <h2 class="text-2xl font-bold text-white mb-3">Get Deal Alerts</h2>
      <p class="text-white/70 mb-6">
        Be the first to know about exclusive discounts and limited-time offers on remote work tools.
      </p>
      <p class="text-white/50 text-sm">
        Newsletter coming soon. For now, check our reviews for the latest pricing info.
      </p>
    </div>

  </div>
</BaseLayout>
