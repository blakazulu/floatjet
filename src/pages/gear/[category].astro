---
import BaseLayout from "../../layouts/BaseLayout.astro";

// Category configuration with metadata
const categoryConfig: Record<string, {
  name: string;
  title: string;
  subtitle: string;
  description: string;
  filterKey: string;
}> = {
  computers: {
    name: "Computers",
    title: "Computer Gear",
    subtitle: "Laptops, monitors & workstations",
    description: "Find the best laptops, monitors, and computer equipment for remote work. In-depth reviews and buying guides.",
    filterKey: "Computers",
  },
  furniture: {
    name: "Furniture",
    title: "Office Furniture",
    subtitle: "Desks, chairs & ergonomics",
    description: "Best standing desks, ergonomic chairs, and office furniture for comfortable remote work.",
    filterKey: "Furniture",
  },
  audio: {
    name: "Audio",
    title: "Audio Equipment",
    subtitle: "Headphones, mics & speakers",
    description: "Top noise-canceling headphones, microphones, and audio gear for remote meetings and focus.",
    filterKey: "Audio",
  },
  accessories: {
    name: "Accessories",
    title: "Accessories",
    subtitle: "Keyboards, bags & more",
    description: "Essential accessories for remote workers - keyboards, webcams, bags, and productivity gear.",
    filterKey: "Accessories",
  },
};

// Category filters with gradients (same as main page)
const categories = [
  { name: "All", href: "/gear", gradient: "from-jet-stream to-sky-light", slug: "" },
  { name: "Computers", href: "/gear/computers", gradient: "from-blue-500 to-indigo-600", slug: "computers" },
  { name: "Furniture", href: "/gear/furniture", gradient: "from-amber-500 to-orange-500", slug: "furniture" },
  { name: "Audio", href: "/gear/audio", gradient: "from-pink-500 to-rose-500", slug: "audio" },
  { name: "Accessories", href: "/gear/accessories", gradient: "from-emerald-500 to-teal-500", slug: "accessories" },
];

// All gear data (same as main page)
const allGear = [
  {
    title: "Best Laptops for Remote Work",
    description: "Find the perfect laptop for productivity on the go.",
    href: "/gear/best-laptops-remote-work",
    category: "Computers",
    readTime: 18,
    image: "/images/unsplash/photo-1496181133206-80ce9b88a853-1200w.webp",
    featured: true,
  },
  {
    title: "Best Monitors for Remote Work",
    description: "Find the best 4K, ultrawide, and budget monitors.",
    href: "/gear/best-monitors-remote-work",
    category: "Computers",
    readTime: 16,
    image: "/images/unsplash/photo-1527443224154-c4a3942d3acf-1200w.webp",
    featured: true,
  },
  {
    title: "Best Portable Monitors",
    description: "Dual-screen productivity on the go.",
    href: "/gear/best-portable-monitors",
    category: "Computers",
    readTime: 14,
    image: "/images/unsplash/photo-1587829741301-dc798b83add3-1200w.webp",
    featured: false,
  },
  {
    title: "Best Standing Desks",
    description: "Ergonomic standing desks for healthier workdays.",
    href: "/gear/best-standing-desks",
    category: "Furniture",
    readTime: 18,
    image: "/images/unsplash/photo-1593642632559-0c6d3fc62b89-1200w.webp",
    featured: true,
  },
  {
    title: "Best Ergonomic Chairs",
    description: "Find the perfect chair for all-day comfort.",
    href: "/gear/best-ergonomic-chairs",
    category: "Furniture",
    readTime: 18,
    image: "/images/unsplash/photo-1580480055273-228ff5388ef8-1200w.webp",
    featured: true,
  },
  {
    title: "Best Desk Converters",
    description: "Transform your desk into a standing desk.",
    href: "/gear/best-desk-converters",
    category: "Furniture",
    readTime: 14,
    image: "/images/unsplash/photo-1518455027359-f3f8164ba6bd-1200w.webp",
    featured: false,
  },
  {
    title: "Best Noise-Canceling Headphones",
    description: "Block out distractions with premium headphones.",
    href: "/gear/best-noise-canceling-headphones",
    category: "Audio",
    readTime: 18,
    image: "/images/unsplash/photo-1505740420928-5e560c06d30e-1200w.webp",
    featured: true,
  },
  {
    title: "Best Microphones for Remote Meetings",
    description: "USB and XLR microphones for video call clarity.",
    href: "/gear/best-microphones-remote-meetings",
    category: "Audio",
    readTime: 16,
    image: "/images/unsplash/photo-1590602847861-f357a9332bbc-1200w.webp",
    featured: false,
  },
  {
    title: "Best Laptop Bags & Backpacks",
    description: "Protect your gear while traveling light.",
    href: "/gear/best-laptop-bags-backpacks",
    category: "Accessories",
    readTime: 16,
    image: "/images/unsplash/photo-1553062407-98eeb64c6a62-1200w.webp",
    featured: true,
  },
  {
    title: "Best Webcams for Video Calls",
    description: "Look professional on every video call.",
    href: "/gear/best-webcams-video-calls",
    category: "Accessories",
    readTime: 14,
    image: "/images/unsplash/photo-1587825140708-dfaf72ae4b04-1200w.webp",
    featured: false,
  },
  {
    title: "Best Mechanical Keyboards",
    description: "Type faster and more comfortably.",
    href: "/gear/best-mechanical-keyboards",
    category: "Accessories",
    readTime: 14,
    image: "/images/unsplash/photo-1595225476474-87563907a212-1200w.webp",
    featured: false,
  },
];

// Generate static paths for all categories
export function getStaticPaths() {
  return [
    { params: { category: "computers" } },
    { params: { category: "furniture" } },
    { params: { category: "audio" } },
    { params: { category: "accessories" } },
  ];
}

// Get current category from URL
const { category } = Astro.params;
const config = categoryConfig[category as string];

// Filter gear by category
const filteredGear = allGear.filter(g => g.category === config.filterKey);

// Pick hero from featured (or first item if none featured)
const featuredInCategory = filteredGear.filter(g => g.featured);
const hero = featuredInCategory.length > 0
  ? featuredInCategory[Math.floor(Math.random() * featuredInCategory.length)]
  : filteredGear[0];

// Remaining gear
const remaining = filteredGear.filter(g => g.href !== hero?.href);

// Page meta
const title = `${config.title} | FloatJet`;
const description = config.description;
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <!-- Compact Header + Filter Bar (same as main page) -->
    <div class="max-w-6xl mx-auto mb-6">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
        <div>
          <h1 class="text-2xl md:text-3xl font-bold text-white">{config.title}</h1>
          <p class="text-white/60 text-sm mt-1">{config.subtitle}</p>
        </div>
        <!-- Filter Pills -->
        <div class="flex flex-wrap gap-2">
          {categories.map((cat) => (
            <a
              href={cat.href}
              class:list={[
                "px-3 py-1.5 rounded-full text-xs transition-all duration-300",
                cat.slug === category
                  ? `bg-gradient-to-r ${cat.gradient} text-white font-bold border-2 border-white`
                  : "bg-white/5 text-white/70 hover:bg-white/10 hover:text-white border border-white/10 font-medium"
              ]}
            >
              {cat.name}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Simple Grid for Subcategory (no category tiles, just articles) -->
    <div class="max-w-6xl mx-auto grid grid-cols-4 md:grid-cols-4 lg:grid-cols-6 gap-2 md:gap-3 auto-rows-[100px] md:auto-rows-[140px] lg:auto-rows-[160px]">

      {hero && (
        <!-- HERO CELL: Large featured article -->
        <a
          href={hero.href}
          class="group col-span-4 md:col-span-4 lg:col-span-4 row-span-2 relative overflow-hidden rounded-2xl transition-all duration-300 hover:shadow-xl hover:shadow-jet-stream/10"
        >
          <img src={hero.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/10"></div>
          <div class="absolute inset-0 p-4 md:p-6 flex flex-col justify-end">
            <span class="inline-block w-fit px-2 py-0.5 md:px-2.5 md:py-1 bg-jet-stream text-ocean-deep text-[10px] md:text-xs font-bold rounded-full mb-2">
              Featured
            </span>
            <h2 class="text-base md:text-2xl font-bold text-white group-hover:text-jet-stream transition-colors mb-1">
              {hero.title}
            </h2>
            <p class="text-white/70 text-sm line-clamp-2 hidden md:block mb-2">{hero.description}</p>
            <div class="flex items-center gap-3 text-[10px] md:text-xs">
              <span class="text-white/50">{hero.readTime} min</span>
              <span class="text-jet-stream font-medium flex items-center">
                Read
                <svg class="w-3 h-3 ml-1 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
              </span>
            </div>
          </div>
        </a>
      )}

      <!-- Info cell -->
      <div class="col-span-2 lg:col-span-2 row-span-1 bg-black/40 border border-white/10 border-b-jet-stream/50 rounded-xl p-4 md:p-5 flex flex-col justify-center items-center text-center">
        <svg class="w-7 h-7 md:w-8 md:h-8 text-jet-stream mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
        </svg>
        <span class="text-white font-semibold text-sm md:text-base">{filteredGear.length} Reviews</span>
        <span class="text-white/60 text-xs md:text-sm">In this category</span>
      </div>

      <!-- CTA cell -->
      <a href="/contact" class="group col-span-2 lg:col-span-2 row-span-1 bg-black/40 border border-jet-stream/30 border-b-jet-stream/60 rounded-xl p-4 md:p-5 flex flex-col justify-center items-center text-center transition-all duration-300 hover:border-jet-stream/50 hover:bg-black/50">
        <svg class="w-7 h-7 md:w-8 md:h-8 text-sky-light mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />
        </svg>
        <span class="text-white font-semibold text-sm md:text-base">Suggest Gear</span>
        <span class="text-jet-stream text-xs md:text-sm flex items-center mt-1">
          Contact us
          <svg class="w-3 h-3 ml-1 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
        </span>
      </a>

      <!-- Remaining articles in grid -->
      {remaining.slice(0, 2).map((item) => (
        <a
          href={item.href}
          class="group col-span-2 md:col-span-2 lg:col-span-3 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg"
        >
          <img src={item.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent"></div>
          <div class="absolute inset-0 p-3 md:p-4 flex flex-col justify-end">
            <span class="text-jet-stream text-[10px] md:text-xs font-medium mb-1 block">{item.category}</span>
            <h3 class="text-xs md:text-lg font-semibold text-white group-hover:text-jet-stream transition-colors line-clamp-2">{item.title}</h3>
            <p class="text-white/60 text-[10px] md:text-xs mt-1 line-clamp-1 hidden md:block">{item.description}</p>
          </div>
        </a>
      ))}

      <!-- More article cells -->
      {remaining.slice(2).map((item, i) => (
        <a
          href={item.href}
          class:list={[
            "group col-span-2 md:col-span-2 lg:col-span-2 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg",
            i >= 4 && "hidden lg:block"
          ]}
        >
          <img src={item.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
          <div class="absolute inset-0 p-2 md:p-3 flex flex-col justify-end">
            <span class="text-white/50 text-[8px] md:text-[10px] uppercase tracking-wide mb-0.5">{item.category}</span>
            <h3 class="text-[10px] md:text-sm font-semibold text-white group-hover:text-jet-stream transition-colors line-clamp-2 leading-tight">{item.title}</h3>
          </div>
        </a>
      ))}

    </div>

  </div>
</BaseLayout>
