---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {ChevronLeft, ChevronRight} from 'lucide-astro';

const title = 'Best Remote Work Accessories | FloatJet';
const description = 'Essential accessories for remote workers. Find the best laptop bags, chargers, webcams, keyboards, and travel gear for working anywhere without hassle.';

const featuredArticle = {
  title: 'Best Laptop Bags & Backpacks for Digital Nomads (2025)',
  description: 'We tested 12+ bags to find the best options for digital nomads. Compare Nomatic, Peak Design, Aer, and more for every travel style.',
  href: '/gear/best-laptop-bags-backpacks',
  readTime: 16,
  icon: '🎒'
};

const articles = [
  {
    title: 'Best Webcams for Professional Video Calls',
    description: 'Look professional on every video call. Compare Logitech, Razer, and Elgato webcams for remote work.',
    href: '/gear/best-webcams-video-calls',
    icon: '📹',
    readTime: 14,
    category: 'Accessories'
  },
  {
    title: 'Best Portable Chargers & Power Banks',
    description: 'Never run out of battery on the go. Compare Anker, Zendure, and Baseus power banks for travel.',
    href: '/gear/best-portable-chargers-power-banks',
    icon: '🔋',
    readTime: 13,
    category: 'Accessories'
  },
  {
    title: 'Best Mechanical Keyboards for Remote Work',
    description: 'Type faster and more comfortably. Compare Keychron, Das Keyboard, and Logitech mechanical keyboards.',
    href: '/gear/best-mechanical-keyboards',
    icon: '⌨️',
    readTime: 14,
    category: 'Accessories'
  },
  {
    title: 'Best Travel Adapters for International Nomads',
    description: 'Power up anywhere in the world. Compare universal adapters from Epicka, Anker, and Satechi.',
    href: '/gear/best-travel-adapters',
    icon: '🔌',
    readTime: 10,
    category: 'Accessories'
  }
];

const whyMatters = [
  {title: 'Stay Powered Up', description: 'Portable chargers and adapters keep you working anywhere', icon: '🔋'},
  {title: 'Travel Light', description: 'Compact accessories that fit in any bag without adding bulk', icon: '✈️'},
  {title: 'Look Professional', description: 'Quality webcams and lighting for client video calls', icon: '📹'},
  {title: 'Work Comfortably', description: 'Ergonomic keyboards and gear for long work sessions', icon: '😌'}
];

const topPicks = [
  {name: 'Nomatic Navigator', tag: 'Best Bag', color: 'bg-blue-500/20 text-blue-400'},
  {name: 'Logitech Brio 4K', tag: 'Best Webcam', color: 'bg-green-500/20 text-green-400'},
  {name: 'Anker 737 PowerCore', tag: 'Best Charger', color: 'bg-purple-500/20 text-purple-400'}
];

// Pagination settings
const ARTICLES_PER_PAGE = 9;
const totalArticles = articles.length;
const totalPages = Math.ceil(totalArticles / ARTICLES_PER_PAGE);
const currentPage = 1;
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <!-- Header -->
    <div class="text-center mb-12">
      <a href="/gear" class="inline-flex items-center text-white/60 hover:text-white text-sm mb-4 transition-colors">
        <ChevronLeft class="w-4 h-4 mr-1" aria-hidden="true"/>
        All Gear
      </a>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Accessories</h1>
      <p class="text-lg text-white/80 max-w-2xl mx-auto">
        Essential accessories and travel gear for productive remote work anywhere.
      </p>
    </div>

    <!-- Featured Article Card -->
    <a
        href={featuredArticle.href}
        class="block max-w-3xl mx-auto mb-12 group bg-gradient-to-r from-ocean-deep/40 to-jet-stream/20 border border-white/20 hover:border-jet-stream/50 rounded-xl p-8 transition-all duration-300"
    >
      <div class="flex items-center gap-2 mb-4">
        <span class="text-4xl">{featuredArticle.icon}</span>
        <span class="px-3 py-1 bg-jet-stream text-ocean-deep text-xs font-bold rounded-full">Featured Guide</span>
      </div>
      <h2 class="text-2xl md:text-3xl font-bold text-white group-hover:text-jet-stream transition-colors mb-3">
        {featuredArticle.title}
      </h2>
      <p class="text-white/70 mb-4">
        {featuredArticle.description}
      </p>
      <div class="flex items-center justify-between">
        <span class="text-white/50 text-sm">{featuredArticle.readTime} min read</span>
        <span class="text-jet-stream font-medium flex items-center">
          Read Review
          <ChevronRight class="w-5 h-5 ml-1 group-hover:translate-x-1 transition-transform" aria-hidden="true"/>
        </span>
      </div>
    </a>

    <!-- Top Picks Preview -->
    <div class="max-w-3xl mx-auto mb-12">
      <h2 class="text-xl font-semibold text-white text-center mb-6">Our Top Picks</h2>
      <div class="grid gap-4 grid-cols-1 sm:grid-cols-3">
        {topPicks.map(pick => (
            <div class="bg-white/5 border border-white/10 rounded-lg p-4 text-center">
            <span class={`inline-block px-2 py-0.5 ${pick.color} text-xs font-medium rounded mb-2`}>
              {pick.tag}
            </span>
              <p class="text-white font-semibold">{pick.name}</p>
            </div>
        ))}
      </div>
    </div>

    <!-- Articles Grid -->
    <div class="mb-12">
      <h2 class="text-xl font-semibold text-white text-center mb-8">More Accessories Reviews</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {articles.map(article => (
            <a
                href={article.href}
                class="group bg-black/40 hover:bg-black/50 border border-white/10 hover:border-white/20 rounded-xl p-6 transition-all duration-300"
            >
              <div class="flex items-start gap-4">
                <span class="text-3xl flex-shrink-0">{article.icon}</span>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-2">
                  <span class="inline-block px-2 py-0.5 bg-jet-stream/20 text-jet-stream text-xs font-medium rounded">
                    {article.category}
                  </span>
                    <span class="text-white/40 text-xs">{article.readTime} min</span>
                  </div>
                  <h2 class="text-lg font-semibold text-white group-hover:text-jet-stream transition-colors mb-2">
                    {article.title}
                  </h2>
                  <p class="text-white/70 text-sm">{article.description}</p>
                </div>
              </div>
              <div class="mt-4 flex items-center text-jet-stream text-sm font-medium">
                Read Review
                <ChevronRight class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" aria-hidden="true"/>
              </div>
            </a>
        ))}
      </div>

      <!-- Pagination Info -->
      <div class="mt-6 text-center">
        {totalPages > 1 && (
            <div class="mt-4 hidden sm:flex justify-center gap-2">
              {Array.from({length: totalPages}, (_, i) => (
                  <button
                      class={`w-10 h-10 rounded-lg text-sm font-medium transition-colors ${
                        i + 1 === currentPage
                          ? 'bg-jet-stream text-ocean-deep'
                          : 'bg-white/10 text-white hover:bg-white/20'
                      }`}
                  >
                    {i + 1}
                  </button>
              ))}
            </div>
        )}
        {totalPages > 1 && (
            <div class="mt-4 sm:hidden">
              <button
                  class="px-6 py-3 bg-jet-stream/20 text-jet-stream font-medium rounded-lg hover:bg-jet-stream/30 transition-colors">
                Load More Articles
              </button>
            </div>
        )}
      </div>
    </div>

    <!-- Why It Matters -->
    <div class="max-w-4xl mx-auto mb-12">
      <h2 class="text-xl font-semibold text-white text-center mb-8">Why Accessories Matter</h2>
      <div class="grid gap-6 grid-cols-1 sm:grid-cols-2">
        {whyMatters.map(item => (
            <div class="flex items-start gap-4 bg-white/5 border border-white/10 rounded-xl p-5">
              <span class="text-2xl">{item.icon}</span>
              <div>
                <h3 class="text-white font-semibold mb-1">{item.title}</h3>
                <p class="text-white/60 text-sm">{item.description}</p>
              </div>
            </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center">
      <a
          href={featuredArticle.href}
          class="inline-flex items-center justify-center px-6 py-3 bg-jet-stream text-ocean-deep font-semibold rounded-lg hover:bg-sky-light transition-colors"
      >
        Start with Laptop Bags
      </a>
    </div>
  </div>
</BaseLayout>
