---

<ArticleLayout
  title={title}
  description={description}
  pubDate={pubDate}
  updatedDate={updatedDate}
  author={author}
  category={category}
  categorySlug={categorySlug}
  readingTime={readingTime}
  image={image}
  imageAlt={imageAlt}
