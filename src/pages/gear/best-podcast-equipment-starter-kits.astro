---
import ComparisonTable from "@components/article/ComparisonTable.astro";
import FAQSection from "@components/article/FAQSection.astro";
import RelatedArticles from "@components/article/RelatedArticles.astro";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { getArticleBySlug } from "../../data/articles";

// Get article metadata from central data file
const article = getArticleBySlug("best-podcast-equipment-starter-kits")!;
const { title, description, authorSlug, readingTime, image, imageAlt } = article;
const pubDate = new Date(article.pubDate);

// Table of contents headings
const headings = [
  { text: "Introduction", slug: "introduction", depth: 2 },
  { text: "Quick Picks", slug: "quick-picks", depth: 2 },
  { text: "What You Actually Need", slug: "what-you-need", depth: 2 },
  { text: "Samson Q2U", slug: "samson-q2u", depth: 2 },
  { text: "Scarlett Solo + Rode PodMic", slug: "scarlett-podmic", depth: 2 },
  { text: "MOVO PodPak-2", slug: "movo-podpak", depth: 2 },
  { text: "AT2020 + Scarlett Solo", slug: "at2020-scarlett", depth: 2 },
  { text: "Cheap Bundles Warning", slug: "cheap-bundles", depth: 2 },
  { text: "What Actually Matters", slug: "what-matters", depth: 2 },
  { text: "Setup Guide", slug: "setup-guide", depth: 2 },
  { text: "FAQ", slug: "faq", depth: 2 },
  { text: "Summary", slug: "summary", depth: 2 },
];

// Quick picks comparison table
const quickPicksColumns = [
  { key: "kit", label: "Kit", width: "160px" },
  { key: "bestFor", label: "Best For", width: "140px" },
  { key: "price", label: "Price" },
  { key: "connection", label: "Connection" },
];

const quickPicksRows = [
  {
    kit: "<strong>Samson Q2U</strong>",
    bestFor: "Budget/Beginners",
    price: "$79",
    connection: "USB + XLR",
  },
  {
    kit: "<strong>Scarlett Solo + PodMic</strong>",
    bestFor: "Serious podcasters",
    price: "$249",
    connection: "XLR",
  },
  {
    kit: "<strong>MOVO PodPak-2</strong>",
    bestFor: "Two-person shows",
    price: "$299",
    connection: "XLR",
  },
];

// Full comparison table
const fullComparisonColumns = [
  { key: "kit", label: "Kit", width: "140px" },
  { key: "bestFor", label: "Best For", width: "120px" },
  { key: "price", label: "Price" },
  { key: "type", label: "Mic Type" },
  { key: "hosts", label: "Hosts" },
  { key: "upgradable", label: "Upgradable" },
];

const fullComparisonRows = [
  {
    kit: "<strong>Samson Q2U</strong>",
    bestFor: "Starting out",
    price: "$79",
    type: "Dynamic",
    hosts: "1",
    upgradable: true,
  },
  {
    kit: "<strong>Scarlett Solo + PodMic</strong>",
    bestFor: "Quality from day one",
    price: "$249",
    type: "Dynamic",
    hosts: "1",
    upgradable: true,
  },
  {
    kit: "<strong>MOVO PodPak-2</strong>",
    bestFor: "Two hosts",
    price: "$299",
    type: "Dynamic",
    hosts: "2",
    upgradable: "Limited",
  },
  {
    kit: "<strong>AT2020 + Scarlett</strong>",
    bestFor: "Quiet rooms",
    price: "$229",
    type: "Condenser",
    hosts: "1",
    upgradable: true,
  },
];

// FAQ items
const faqItems = [
  {
    question: "Can I use my gaming headset mic?",
    answer:
      "Sure, but it'll sound worse than any option here. Gaming headsets prioritize clarity for callouts, not quality for content. Fine for testing if you'll actually make episodes. Get real gear if you're planning to publish.",
  },
  {
    question: "Do I need acoustic foam?",
    answer:
      "Less than you'd think. Bookshelves behind you help. Couches and curtains help. Recording away from flat bare walls helps. Random foam squares stuck everywhere? Does almost nothing. Foam solves specific problems at specific frequencies.",
  },
  {
    question: "What about the Blue Yeti?",
    answer:
      "Meh. It's a condenser so it grabs everything—your keyboard, your roommate, existence. Quality is fine but not meaningfully better than Q2U, and no XLR option when you want to upgrade. Stopped recommending these.",
  },
  {
    question: "USB-C or USB-A interface?",
    answer:
      "USB-C if your computer has ports for it. New Scarlett models are USB-C native now. Old USB-A gear still works with dongles but newer makes more sense long-term.",
  },
  {
    question: "How important is the boom arm?",
    answer:
      "More than people expect. Desk stands mean awkward posture. Arm puts the mic where it should be, swings away when you're not using it. Somewhere between $25-100 covers most needs.",
  },
  {
    question: "Do listeners actually care about audio quality?",
    answer:
      "They won't consciously appreciate good audio. They'll absolutely quit over bad audio. You're not impressing engineers. You're avoiding annoying normal humans with tinny muddy output.",
  },
  {
    question: "Dynamic vs condenser for podcasting?",
    answer:
      "Dynamic for most home setups. Rejects background noise better. Condensers capture more detail but also your fridge, traffic, and neighbor's dog. Unless your space is genuinely quiet, go dynamic.",
  },
  {
    question: "Will anyone notice the difference between $79 and $250 gear?",
    answer:
      "Audiophiles will. Regular listeners probably won't consciously notice—but they'll stick around longer because nothing sounds bad. The real difference is in your own comfort while recording and editing.",
  },
];

// Related articles
const relatedArticles = [
  {
    title: "Best Microphones for Remote Meetings",
    excerpt: "If you're also doing video calls, here's what works best for meetings specifically.",
    href: "/gear/best-microphones-remote-meetings",
    image: "/images/unsplash/photo-1590602847861-f357a9332bbc-800w.webp",
    imageAlt: "Professional microphone for remote meetings",
  },
  {
    title: "USB vs XLR Microphones",
    excerpt: "The full breakdown on when XLR is worth the extra complexity.",
    href: "/gear/usb-vs-xlr-microphones",
    image: "/images/unsplash/photo-1598653222000-6b7b7a552625-800w.webp",
    imageAlt: "USB and XLR microphone comparison",
  },
  {
    title: "How to Reduce Background Noise on Calls",
    excerpt: "Software and hardware tips for cleaner audio on any setup.",
    href: "/gear/reduce-background-noise-calls",
    image: "/images/unsplash/photo-1587560699334-cc4ff634909a-800w.webp",
    imageAlt: "Person on video call with noise-canceling setup",
  },
];
---

<ArticleLayout
    title={title}
    description={description}
    authorSlug={authorSlug}
    pubDate={pubDate}
    readingTime={readingTime}
    image={image}
    imageAlt={imageAlt}
    category="Audio"
    categorySlug="gear"
    subcategorySlug="audio"
    headings={headings}
>
  <!-- Introduction -->
  <section id="introduction">
    <p class="text-xl text-white/90 mb-6">
      <strong>My buddy texted me about his new podcast last month.</strong> Had this $40 USB mic from Amazon—4,000 five-star reviews, must be good right? Sounded like he was broadcasting from inside a soup can. Back to Amazon it went.
    </p>
    <p class="text-white/80 mb-6">
      Here's what nobody tells you about podcast audio: your voice is literally the entire product. Blog posts can lean on formatting. Videos have visuals. Podcasts? Just your voice bouncing around in someone's earbuds. The gap between a $79 mic and a $40 one isn't subtle.
    </p>
    <p class="text-white/80 mb-6">
      I've messed around with maybe 15 different mic and interface combos over two years. Figured out where the money actually matters. Spoiler: not at the expensive end. That $150-300 range? That's where you start sounding better than half the shows on Spotify.
    </p>
    <p class="text-white/80 mb-8">
      <strong>If you're skimming:</strong> Samson Q2U for starting out with USB simplicity. Focusrite Scarlett Solo paired with a Rode PodMic when you're ready to do this properly.
    </p>
  </section>

  <!-- Quick Picks -->
  <section id="quick-picks">
    <h2 class="text-2xl font-bold text-white mb-6">Quick Picks</h2>
    <ComparisonTable columns={quickPicksColumns} rows={quickPicksRows} caption="Best podcast starter kits under $300"/>
  </section>

  <!-- What You Actually Need -->
  <section id="what-you-need">
    <h2 class="text-2xl font-bold text-white mb-6">What You Actually Need</h2>
    <p class="text-white/80 mb-6">
      Most beginners overcomplicate podcast gear. Let's simplify.
    </p>
    <p class="text-white/80 mb-4">You need:</p>
    <ul class="list-disc list-inside text-white/80 mb-6 space-y-2">
      <li>A mic (duh)</li>
      <li>Something connecting it to your computer</li>
      <li>Headphones so you can hear yourself</li>
      <li>Probably a boom arm unless you enjoy hunching over a desk</li>
    </ul>
    <p class="text-white/80 mb-6">
      That's literally it. Skip the mixer. Skip covering your walls in foam. Skip the $500 microphone. Just get something that grabs your voice without also grabbing your mechanical keyboard, the neighbor's lawn care, or the HVAC kicking on.
    </p>
    <p class="text-white/80 mb-8">
      <strong>Dynamic versus condenser mics</strong>—this actually matters. Condensers are touchy. Sound amazing in proper studios, sound terrible in apartments where you can hear traffic. Dynamics reject background garbage much better. For recording at home, dynamic almost always wins.
    </p>
  </section>

  <!-- Samson Q2U -->
  <section id="samson-q2u">
    <h2 class="text-2xl font-bold text-white mb-6">The Budget Champ: Samson Q2U ($79)</h2>
    <div class="bg-gradient-to-r from-green-500/10 to-transparent border border-green-500/20 rounded-xl p-6 mb-6">
      <div class="flex flex-wrap gap-4 mb-4">
        <span class="px-3 py-1 bg-green-500/20 text-green-400 text-sm font-medium rounded-full">Best Budget</span>
        <span class="text-white/60 text-sm">$79</span>
        <span class="text-white/60 text-sm">USB + XLR</span>
      </div>
      <p class="text-white/80 mb-4">
        Been recommending this mic since 2021 or so. Still do.
      </p>
      <p class="text-white/80 mb-4">
        The Q2U pulled off something smart: USB and XLR outputs on the same mic. Plug it into your MacBook via USB right now. Buy an audio interface next year, switch to XLR. Same mic works for both.
      </p>
      <p class="text-white/80 mb-4">
        Whole package runs $79-99. You get the mic, stubby desktop stand, pop filter, both cables. Could record tonight if you wanted.
      </p>
      <p class="text-white/80 mb-4">
        Sound quality? Maybe 80% of mics at double the price. For a podcast where people care about what you're saying more than pristine audio engineering, that's fine. Know several shows recorded on Q2Us pulling thousands of downloads.
      </p>
      <div class="mb-4">
        <p class="text-white font-medium mb-2">Stuff I noticed testing it:</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm">
          <div>
            <span class="text-green-400">+</span>
            <span class="text-white/70 ml-2">Frequency range handles talking well (50Hz-15kHz)</span>
          </div>
          <div>
            <span class="text-green-400">+</span>
            <span class="text-white/70 ml-2">Headphone jack built in, no delay monitoring</span>
          </div>
          <div>
            <span class="text-green-400">+</span>
            <span class="text-white/70 ml-2">Picks up what's in front, ignores what's behind</span>
          </div>
          <div>
            <span class="text-green-400">+</span>
            <span class="text-white/70 ml-2">Physical power switch saves your recordings</span>
          </div>
        </div>
      </div>
      <div>
        <p class="text-white font-medium mb-2">The annoying part:</p>
        <p class="text-white/70 text-sm">Desktop stand is laughably short. You'll be leaning in like you're sharing gossip at a bar. Throw another $20-30 at a cheap boom arm.</p>
      </div>
    </div>
    <p class="text-white/80 mb-6">
      <strong>Good fit for:</strong> People just starting. Those testing whether they'll actually keep podcasting. Anyone who'd rather record this week than research gear for a month.
    </p>
    <div class="not-prose my-8">
      <a
        href="https://www.amazon.com/dp/B001R747SG"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 bg-jet-stream text-white font-semibold rounded-lg hover:bg-jet-stream/90 transition-colors"
      >
        Check Q2U on Amazon
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </section>

  <!-- Scarlett Solo + PodMic -->
  <section id="scarlett-podmic">
    <h2 class="text-2xl font-bold text-white mb-6">The Smart Money: Focusrite Scarlett Solo + Rode PodMic ($249-279)</h2>
    <div class="bg-gradient-to-r from-blue-500/10 to-transparent border border-blue-500/20 rounded-xl p-6 mb-6">
      <div class="flex flex-wrap gap-4 mb-4">
        <span class="px-3 py-1 bg-blue-500/20 text-blue-400 text-sm font-medium rounded-full">My Top Pick</span>
        <span class="text-white/60 text-sm">$249</span>
        <span class="text-white/60 text-sm">XLR</span>
      </div>
      <p class="text-white/80 mb-4">
        Know you're serious? Skip USB mics entirely. This is what I'd grab if I were starting over.
      </p>
      <p class="text-white/80 mb-4">
        Scarlett Solo is Focusrite's smallest audio interface, and "entry-level" here means properly clean preamps in a box roughly the size of a paperback. Fourth gen version dropped recently. Got USB-C finally.
      </p>
      <p class="text-white/80 mb-4">
        The PodMic costs $99 and was built specifically for voices. Pair them together and you've got gear that'll outlast your interest in podcasting.
      </p>
      <p class="text-white/80 mb-4">
        Tested this setup against $400-500 combos. Hard to hear meaningful differences. PodMic punches way above that $99 price tag. Scarlett preamps just sound clean.
      </p>
      <div class="mb-4">
        <p class="text-white font-medium mb-2">What the Scarlett Solo gives you:</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm">
          <div>
            <span class="text-green-400">+</span>
            <span class="text-white/70 ml-2">24-bit/192kHz specs (overkill but nice headroom)</span>
          </div>
          <div>
            <span class="text-green-400">+</span>
            <span class="text-white/70 ml-2">"Air" mode adds presence to voices</span>
          </div>
          <div>
            <span class="text-green-400">+</span>
            <span class="text-white/70 ml-2">Monitor yourself with zero delay</span>
          </div>
          <div>
            <span class="text-green-400">+</span>
            <span class="text-white/70 ml-2">Feels like metal, not plastic garbage</span>
          </div>
        </div>
      </div>
      <div>
        <p class="text-white font-medium mb-2">The annoying part:</p>
        <p class="text-white/70 text-sm">No headphones included. Add $50-80 for something like Audio-Technica ATH-M20x. And yeah, you'll want a boom arm too.</p>
      </div>
    </div>
    <p class="text-white/80 mb-4">
      <strong>Math:</strong> Scarlett Solo Gen 4 is around $130. PodMic is $99. XLR cable maybe $15. Under $250 before you add a boom arm.
    </p>
    <p class="text-white/80 mb-6">
      <strong>Good fit for:</strong> Podcasters planning to stick around more than a few months. Video creators who need mic audio. People who'd prefer sounding professional from episode one.
    </p>
    <div class="not-prose my-8">
      <a
        href="https://www.amazon.com/dp/B0CSJNMVLD"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 bg-jet-stream text-white font-semibold rounded-lg hover:bg-jet-stream/90 transition-colors"
      >
        Check Scarlett Solo on Amazon
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </section>

  <!-- MOVO PodPak-2 -->
  <section id="movo-podpak">
    <h2 class="text-2xl font-bold text-white mb-6">All-In-One Route: MOVO PodPak-2 ($299)</h2>
    <div class="bg-gradient-to-r from-purple-500/10 to-transparent border border-purple-500/20 rounded-xl p-6 mb-6">
      <div class="flex flex-wrap gap-4 mb-4">
        <span class="px-3 py-1 bg-purple-500/20 text-purple-400 text-sm font-medium rounded-full">Best for Two Hosts</span>
        <span class="text-white/60 text-sm">$299</span>
        <span class="text-white/60 text-sm">Dual XLR</span>
      </div>
      <p class="text-white/80 mb-4">
        Buying gear piece by piece getting tedious? Bundles exist. PodPak-2 is one I'd actually consider.
      </p>
      <p class="text-white/80 mb-4">
        $299 gets you: two dynamic mics, stands for both, dual-channel interface, all the cables, pop filters. Two people can start recording from one box. Nothing to research for compatibility.
      </p>
      <p class="text-white/80 mb-4">
        Audio quality sits between the Q2U and Scarlett/PodMic territory. Interface preamps aren't as pristine as Focusrite, but miles better than random USB mics.
      </p>
      <p class="text-white/80 mb-4">
        The dual-channel interface matters more than it sounds. Recording two hosts with independent gain controls? Actually important. Trying to solve that with multiple USB mics? Nightmare fuel.
      </p>
      <div>
        <p class="text-white font-medium mb-2">The annoying parts:</p>
        <p class="text-white/70 text-sm">Mics themselves don't match the PodMic quality. You're trading component quality for convenience. Desktop stands still too short—same complaint.</p>
      </div>
    </div>
    <p class="text-white/80 mb-6">
      <strong>Good fit for:</strong> Two-host shows where budget matters. People who want one purchase and zero thinking. Anyone prioritizing "works together" over "best possible specs."
    </p>
    <div class="not-prose my-8">
      <a
        href="https://www.amazon.com/dp/B08MQ82MTL"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 bg-jet-stream text-white font-semibold rounded-lg hover:bg-jet-stream/90 transition-colors"
      >
        Check MOVO PodPak on Amazon
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </section>

  <!-- AT2020 + Scarlett -->
  <section id="at2020-scarlett">
    <h2 class="text-2xl font-bold text-white mb-6">Different Direction: Audio-Technica AT2020 + Scarlett Solo ($229)</h2>
    <div class="bg-gradient-to-r from-orange-500/10 to-transparent border border-orange-500/20 rounded-xl p-6 mb-6">
      <div class="flex flex-wrap gap-4 mb-4">
        <span class="px-3 py-1 bg-orange-500/20 text-orange-400 text-sm font-medium rounded-full">Best for Quiet Rooms</span>
        <span class="text-white/60 text-sm">$229</span>
        <span class="text-white/60 text-sm">XLR Condenser</span>
      </div>
      <p class="text-white/80 mb-4">
        The AT2020 is a condenser, not dynamic. Grabs more nuance but also more background noise.
      </p>
      <p class="text-white/80 mb-4">
        Got a genuinely quiet space? Not some shared apartment with roommates? AT2020 delivers richer detail than dynamic mics at similar prices. Use one myself for voiceover stuff occasionally.
      </p>
      <p class="text-white/80 mb-4">
        Real tradeoff though. Condensers are microphones for everything. My office sounds normal on dynamic. On the AT2020, my refrigerator two rooms over becomes a co-host. Room treatment stops being optional.
      </p>
      <div>
        <p class="text-white font-medium mb-2">The annoying part:</p>
        <p class="text-white/70 text-sm">Picks up noise you didn't know existed. Forces you to actually deal with your recording environment. Not grab-and-go.</p>
      </div>
    </div>
    <p class="text-white/80 mb-6">
      <strong>Good fit for:</strong> Quiet home offices. Voiceover work doubling with podcasting. People willing to hang blankets or move furniture.
    </p>
    <div class="not-prose my-8">
      <a
        href="https://www.amazon.com/dp/B0006H92QK"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 bg-jet-stream text-white font-semibold rounded-lg hover:bg-jet-stream/90 transition-colors"
      >
        Check AT2020 on Amazon
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </section>

  <!-- Cheap Bundles Warning -->
  <section id="cheap-bundles">
    <h2 class="text-2xl font-bold text-white mb-6">Those Suspiciously Cheap Amazon Bundles</h2>
    <div class="bg-gradient-to-r from-red-500/10 to-transparent border border-red-500/20 rounded-xl p-6 mb-6">
      <p class="text-white/80 mb-4">
        You've scrolled past them. Full podcast kits for $89—mic, stand, pop filter, arm, some mystery interface from a company called like "ZINGYOU."
      </p>
      <p class="text-white/80 mb-4">
        Bought three for science. Same issues across all of them:
      </p>
      <ul class="list-disc list-inside text-white/80 mb-4 space-y-2">
        <li>Interfaces with embarrassing latency (150+ milliseconds in your headphones)</li>
        <li>Mics that sound harsh and tinny regardless of settings</li>
        <li>Boom arms slowly drooping under the mic's weight</li>
        <li>Pop filters that don't actually filter pops</li>
      </ul>
      <p class="text-white/80">
        Reviews are either fake or from people who've never heard decent gear. Not being snobby—there's an actual quality floor these products can't clear. <strong>$79 Q2U trounces $89 bundle kits.</strong>
      </p>
    </div>
  </section>

  <!-- What Actually Matters -->
  <section id="what-matters">
    <h2 class="text-2xl font-bold text-white mb-6">What Actually Affects Your Sound</h2>
    <p class="text-white/80 mb-6">
      Most spec-sheet stuff is marketing. Here's what genuinely matters:
    </p>
    <div class="space-y-6 mb-8">
      <div class="bg-white/5 border border-white/10 rounded-xl p-6">
        <h3 class="text-lg font-semibold text-white mb-2">Your room beats your mic</h3>
        <p class="text-white/70">Recording in a closet with blankets draped around sounds better than a bare room with expensive gear. Hard surfaces bounce sound and create that amateur echo.</p>
      </div>
      <div class="bg-white/5 border border-white/10 rounded-xl p-6">
        <h3 class="text-lg font-semibold text-white mb-2">Technique beats equipment</h3>
        <p class="text-white/70">Where you position the mic matters more than which mic you bought. Best mic badly positioned loses to mediocre mic positioned right.</p>
      </div>
      <div class="bg-white/5 border border-white/10 rounded-xl p-6">
        <h3 class="text-lg font-semibold text-white mb-2">Gain staging prevents noise problems</h3>
        <p class="text-white/70">Proper levels make the difference between a $99 preamp and $500 preamp basically vanish. Most "bad equipment" complaints are actually user setup issues.</p>
      </div>
      <div class="bg-white/5 border border-white/10 rounded-xl p-6">
        <h3 class="text-lg font-semibold text-white mb-2">Editing catches the rest</h3>
        <p class="text-white/70">Background hums, mouth clicks, volume spikes—software fixes these. Try free tools like Audacity before upgrading hardware.</p>
      </div>
    </div>
  </section>

  <!-- Setup Guide -->
  <section id="setup-guide">
    <h2 class="text-2xl font-bold text-white mb-6">Getting It All Working</h2>
    <p class="text-white/80 mb-6">
      Setup takes half an hour tops, even if you've never touched audio gear.
    </p>
    <div class="space-y-6 mb-8">
      <div class="bg-white/5 border border-white/10 rounded-xl p-6">
        <h3 class="text-lg font-semibold text-white mb-2">USB mic route (Q2U)</h3>
        <p class="text-white/70">Plug USB cable into laptop. Pick the mic as your input source. Record. That's actually it.</p>
      </div>
      <div class="bg-white/5 border border-white/10 rounded-xl p-6">
        <h3 class="text-lg font-semibold text-white mb-2">XLR through an interface</h3>
        <p class="text-white/70">USB from interface to computer. XLR from mic to interface. Headphones into interface headphone jack. Turn up gain until meters show movement without red lights. Select interface as input. Done.</p>
      </div>
      <div class="bg-white/5 border border-white/10 rounded-xl p-6">
        <h3 class="text-lg font-semibold text-white mb-2">Mic positioning</h3>
        <p class="text-white/70">Put mic roughly 4-8 inches from your face, angled slightly rather than directly at your mouth. Cuts down on "p" and "s" harshness. Tweak based on what you hear in the headphones.</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq">
    <h2 class="text-2xl font-bold text-white mb-6">Questions People Always Ask</h2>
    <FAQSection faqs={faqItems}/>
  </section>

  <!-- Summary -->
  <section id="summary">
    <h2 class="text-2xl font-bold text-white mb-6">Quick Summary</h2>
    <div class="bg-gradient-to-r from-jet-stream/20 to-ocean-deep/20 border border-jet-stream/30 rounded-xl p-6 mb-8">
      <p class="text-white/90 mb-4">
        <strong>Under $100:</strong> Samson Q2U at $79, plus any cheap boom arm. Works right away. Upgrades later without replacing mic.
      </p>
      <p class="text-white/90 mb-4">
        <strong>Around $250:</strong> Scarlett Solo, PodMic, XLR cable. My recommendation for anyone who knows they're doing this.
      </p>
      <p class="text-white/90 mb-4">
        <strong>$300 for two people:</strong> MOVO PodPak-2 bundle. Components aren't premium but compatibility headaches disappear.
      </p>
      <p class="text-white/90">
        <strong>Skip:</strong> Cheap Amazon bundles, gaming headsets, Blue Yeti.
      </p>
    </div>
    <p class="text-white/80 mb-8">
      My friend swapped that $40 Amazon mic for a Q2U. First episode recorded that same week. Actually sounds like someone with a podcast now. And that's the whole point—sounding competent enough that listeners focus on your words instead of your equipment.
    </p>
  </section>

  <!-- Full Comparison Table -->
  <Fragment slot="full-width">
    <section class="py-8" id="full-comparison">
      <div class="container mx-auto px-4 md:px-6">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6 text-center font-heading">Complete Starter Kit Comparison</h2>
        <ComparisonTable columns={fullComparisonColumns} rows={fullComparisonRows} caption="Full comparison of podcast starter kits under $300"/>
      </div>
    </section>

    <!-- Related Articles -->
    <RelatedArticles articles={relatedArticles}/>
  </Fragment>
</ArticleLayout>
