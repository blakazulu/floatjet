import ArticleLayout from "../../layouts/ArticleLayout.astro";

const title = "Best Portable Monitors for Digital Nomads (2025)";
const description =
  "Tested eight portable monitors to find the best for travel and remote work. Compare ASUS ZenScreen, Lepow, and more for dual-screen productivity on the go.";
const pubDate = new Date("2025-01-12");
const updatedDate = new Date("2024-11-24");
const authorSlug = "marcus-chen";
const category = "Computers";
const categorySlug = "gear";
const subcategorySlug = "computers";
const readingTime = 14;
const image = "/images/unsplash/photo-1587829741301-dc798b83add3-1200w.webp";
const imageAlt = "Portable monitor setup with laptop for digital nomad work";

const headings = [
  { text: "Why Bother With a Portable Monitor", slug: "why-portable-monitors", depth: 2 },
  { text: "What Actually Matters", slug: "what-to-look-for", depth: 2 },
  { text: "Quick Comparison", slug: "quick-comparison", depth: 2 },
  { text: "The Reviews", slug: "detailed-reviews", depth: 2 },
  { text: "ASUS ZenScreen MB16AC", slug: "asus-zenscreen", depth: 3 },
  { text: "Lepow Z1", slug: "lepow-z1", depth: 3 },
  { text: "ViewSonic VG1655", slug: "viewsonic-vg1655", depth: 3 },
  { text: 'INNOCN 15.6" OLED', slug: "innocn-oled", depth: 3 },
  { text: "Lenovo ThinkVision M14", slug: "lenovo-thinkvision", depth: 3 },
  { text: "Mobile Pixels DUEX Plus", slug: "mobile-pixels-duex", depth: 3 },
  { text: "ASUS ZenScreen Touch", slug: "asus-zenscreen-touch", depth: 3 },
  { text: "Espresso Display", slug: "espresso-display", depth: 3 },
  { text: "USB-C vs HDMI", slug: "usb-c-vs-hdmi", depth: 2 },
  { text: "Travel Tips", slug: "travel-tips", depth: 2 },
  { text: "Questions", slug: "faq", depth: 2 },
];

const comparisonColumns = [
  { key: "monitor", label: "Monitor", width: "150px" },
  { key: "resolution", label: "Resolution" },
  { key: "weight", label: "Weight" },
  { key: "connection", label: "Connection" },
  { key: "price", label: "Price" },
];

const comparisonRows = [
