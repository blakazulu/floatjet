    resolution: "1080p",
    weight: "1.7 lbs",
    connection: "USB-C/HDMI",
    price: "$180",
  },
  {
    monitor: "<strong>ViewSonic VG1655</strong>",
    resolution: "1080p",
    weight: "1.5 lbs",
    connection: "USB-C",
    price: "$220",
  },
  {
    monitor: '<strong>INNOCN 15.6" OLED</strong>',
    resolution: "1080p OLED",
    weight: "1.2 lbs",
    connection: "USB-C",
    price: "$350",
  },
  {
    monitor: "<strong>Lenovo ThinkVision M14</strong>",
    resolution: "1080p",
    weight: "1.3 lbs",
    connection: "USB-C",
    price: "$230",
  },
  {
    monitor: "<strong>Mobile Pixels DUEX Plus</strong>",
    resolution: "1080p",
    weight: "1.5 lbs",
    connection: "USB-C",
    price: "$280",
  },
  {
    monitor: "<strong>ASUS ZenScreen Touch</strong>",
    resolution: "1080p",
    weight: "1.9 lbs",
    connection: "USB-C",
    price: "$300",
  },
  {
    monitor: "<strong>Espresso Display</strong>",
    resolution: "1080p/4K",
    weight: "1.3 lbs",
    connection: "USB-C",
    price: "$350+",
  },
];

const faqItems = [
  {
    question: "USB-C power from laptop?",
    answer:
      "Yep. Drains your battery faster though. Get one with pass-through charging if outlets are scarce.",
  },
  {
    question: "Good for video calls?",
    answer: "Absolutely. Call on one screen, notes on the other. Game changer for meetings.",
  },
  {
    question: "Work with my laptop?",
    answer:
      "Probably. Need USB-C with DisplayPort or HDMI. MacBooks yes. Windows from 2018ish onward yes. Check your specs if unsure.",
  },
  {
    question: "Is 1080p sharp enough?",
    answer:
      "At fifteen inches? Plenty sharp. Same density as a bigger desktop monitor. 4K exists but drains battery faster.",
  },
  {
    question: "How do attachment monitors work?",
    answer:
      "Magnets stick it behind your laptop screen. Slides out for dual display. DUEX Plus is the popular one. Solid for planes.",
  },
];

const relatedArticles = [
  {
    title: "Best Laptops for Remote Work",
    excerpt: "Find the perfect laptop to pair with your portable monitor.",
    href: "/gear/best-laptops-remote-work",
    image: "/images/unsplash/photo-1496181133206-80ce9b88a853-800w.webp",
    imageAlt: "Modern laptop on desk",
  },
  {
    title: "Best Monitors for Remote Work",
    excerpt: "Desktop monitors for your home office setup.",
    href: "/gear/best-monitors-remote-work",
    image: "/images/unsplash/photo-1527443224154-c4a3942d3acf-800w.webp",
    imageAlt: "Desktop monitor setup",
  },
  {
    title: "Essential Travel Tech for Nomads",
    excerpt: "Complete guide to tech gear for digital nomads.",
    href: "/blog/essential-travel-tech-nomads",
