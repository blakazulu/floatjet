---
import AffiliateButton from "@components/article/AffiliateButton.astro";
import ComparisonTable from "@components/article/ComparisonTable.astro";
import FAQSection from "@components/article/FAQSection.astro";
import RelatedArticles from "@components/article/RelatedArticles.astro";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { getArticleBySlug } from "../../data/articles";

// Get article metadata from central data file
const article = getArticleBySlug("best-soundproofing-solutions-home-office")!;
const { title, description, authorSlug, readingTime, image, imageAlt } = article;
const pubDate = new Date(article.pubDate);

// Table of contents headings
const headings = [
  { text: "Introduction", slug: "introduction", depth: 2 },
  { text: "Quick Picks", slug: "quick-picks", depth: 2 },
  { text: "Absorption vs Blocking", slug: "absorption-vs-blocking", depth: 2 },
  { text: "The Gap Problem", slug: "gap-problem", depth: 2 },
  { text: "Door Seals and Sweeps", slug: "door-seals", depth: 2 },
  { text: "Acoustic Panels", slug: "acoustic-panels", depth: 2 },
  { text: "Foam Panels", slug: "foam-panels", depth: 2 },
  { text: "Mass Loaded Vinyl", slug: "mlv", depth: 2 },
  { text: "Window Solutions", slug: "windows", depth: 2 },
  { text: "My Setup", slug: "my-setup", depth: 2 },
  { text: "What Doesn't Work", slug: "doesnt-work", depth: 2 },
  { text: "FAQ", slug: "faq", depth: 2 },
  { text: "Summary", slug: "summary", depth: 2 },
];

// Quick picks comparison table
const quickPicksColumns = [
  { key: "solution", label: "Solution", width: "150px" },
  { key: "bestFor", label: "Best For", width: "130px" },
  { key: "price", label: "Price" },
  { key: "roi", label: "ROI" },
];

const quickPicksRows = [
  {
    solution: "<strong>Door Seals</strong>",
    bestFor: "Noise bleeding",
    price: "$30-80",
    roi: "Highest",
  },
  {
    solution: "<strong>Acoustic Panels</strong>",
    bestFor: "Echo reduction",
    price: "$100-200",
    roi: "High",
  },
  {
    solution: "<strong>Heavy Curtains</strong>",
    bestFor: "Window noise",
    price: "$50-100",
    roi: "Medium",
  },
  {
    solution: "<strong>Mass Loaded Vinyl</strong>",
    bestFor: "Serious blocking",
    price: "$150+",
    roi: "Medium",
  },
];

// Full comparison table
const fullComparisonColumns = [
  { key: "product", label: "Product", width: "130px" },
  { key: "purpose", label: "Purpose", width: "110px" },
  { key: "price", label: "Price" },
  { key: "nrc", label: "NRC" },
  { key: "blocking", label: "Blocks Sound" },
  { key: "difficulty", label: "Install" },
];

const fullComparisonRows = [
  {
    product: "<strong>Drop-Seal Sweep</strong>",
    purpose: "Gap sealing",
    price: "$40-80",
    nrc: "N/A",
    blocking: true,
    difficulty: "Easy",
  },
  {
    product: "<strong>ATS Panels</strong>",
    purpose: "Absorption",
    price: "$40-50/ea",
    nrc: "1.0",
    blocking: false,
    difficulty: "Easy",
  },
  {
    product: "<strong>BUBOS Art Panels</strong>",
    purpose: "Absorption",
    price: "$50-70/6pk",
    nrc: "0.95",
    blocking: false,
    difficulty: "Easy",
  },
  {
    product: "<strong>Foam Wedges</strong>",
    purpose: "Light absorption",
    price: "$20-40/12pk",
    nrc: "0.65-0.75",
    blocking: false,
    difficulty: "Easy",
  },
  {
    product: "<strong>Mass Loaded Vinyl</strong>",
    purpose: "Sound blocking",
    price: "$1-2/sqft",
    nrc: "N/A",
    blocking: true,
    difficulty: "Medium",
  },
  {
    product: "<strong>Window Inserts</strong>",
    purpose: "Window blocking",
    price: "$200-500/ea",
    nrc: "N/A",
    blocking: true,
    difficulty: "Easy",
  },
];

// FAQ items
const faqItems = [
  {
    question: "Does foam actually soundproof?",
    answer:
      "Nope. Foam absorbs echo inside your room. Doesn't stop sound going in or out. Different products for different problems—you need mass and sealed gaps for blocking.",
  },
  {
    question: "How much wall coverage do I need?",
    answer:
      "For absorption, 15-25% is usually plenty. More than that and the room starts sounding artificially dead. Start behind your desk and on side walls, add more only if it's still too echoey.",
  },
  {
    question: "Do I need to cover all four walls?",
    answer:
      "Usually not. Wall behind your monitor and walls beside you matter most. Wall behind your back matters least unless you're recording with a mic that picks up that direction.",
  },
  {
    question: "Are corner bass traps worth it?",
    answer:
      "For recording studios and home theaters, sure. For typical home office, overkill. Heavy furniture and room placement handle bass better than foam triangles in corners anyway.",
  },
  {
    question: "Can I make DIY acoustic panels?",
    answer:
      "Definitely. Rigid fiberglass or mineral wool, some wood frames, fabric to wrap it. Maybe $15-20 per panel versus $40-50 for store bought. Takes a few hours and basic tools.",
  },
  {
    question: "What options work for renters?",
    answer:
      "Door seals come off easy, heavy curtains are furniture, rugs are rugs. Freestanding panels or blankets behind your desk. Just avoid stuff that damages walls unless your landlord says okay.",
  },
  {
    question: "Will this help my video call audio?",
    answer:
      "Door seals help if outside noise bleeds into your mic. Panels help if your voice sounds echoey. Most people get more improvement from better mic technique and an actual decent microphone though, honestly.",
  },
  {
    question: "What about egg carton foam?",
    answer:
      "Does nothing meaningful, potential fire hazard, looks ridiculous. The internet keeps suggesting this but it's basically acoustic theater. Just don't.",
  },
];

// Related articles
const relatedArticles = [
  {
    title: "Best Podcast Equipment Starter Kits",
    excerpt: "Microphone and interface bundles under $300 that actually sound good.",
    href: "/gear/best-podcast-equipment-starter-kits",
    image: "/images/unsplash/photo-1598488035139-bdbb2231ce04-800w.webp",
    imageAlt: "Podcast equipment starter kit with microphone",
  },
  {
    title: "Best Microphones for Remote Meetings",
    excerpt: "If you're also doing video calls, here's what works best for meetings specifically.",
    href: "/gear/best-microphones-remote-meetings",
    image: "/images/unsplash/photo-1590602847861-f357a9332bbc-800w.webp",
    imageAlt: "Professional microphone for remote meetings",
  },
  {
    title: "How to Reduce Background Noise on Calls",
    excerpt: "Software and hardware tips for cleaner audio on any setup.",
    href: "/gear/reduce-background-noise-calls",
    image: "/images/unsplash/photo-1587560699334-cc4ff634909a-800w.webp",
    imageAlt: "Person on video call with noise-canceling setup",
  },
];
---

<ArticleLayout
    title={title}
    description={description}
    authorSlug={authorSlug}
    pubDate={pubDate}
    readingTime={readingTime}
    image={image}
    imageAlt={imageAlt}
    category="Audio"
    categorySlug="gear"
    subcategorySlug="audio"
    headings={headings}
>
  <!-- Introduction -->
  <section id="introduction">
    <p class="text-xl text-white/90 mb-6">
      <strong>Got a new neighbor last year. Nice guy. Works from home like me.</strong> Also apparently runs a woodworking side business in his garage at 2pm every Tuesday when I have client calls. Fantastic.
    </p>
    <p class="text-white/80 mb-6">
      Spent about three months testing different soundproofing products trying to fix this without having an awkward conversation. Turns out most soundproofing advice online is either wildly expensive or completely wrong about what actually works. Acoustic foam on your walls looks cool in YouTube videos but does almost nothing to stop your neighbor's table saw.
    </p>
    <p class="text-white/80 mb-6">
      Here's what I learned the expensive way: there's a difference between sound absorption (reducing echo inside your room) and sound blocking (stopping noise from coming in or going out). Most cheap products do the first thing and pretend they do the second.
    </p>
    <p class="text-white/80 mb-8">
      <strong>If you're skimming:</strong> door seals are the biggest bang for your buck. Seriously. That gap under your door leaks more sound than you'd believe. After that, consider acoustic panels if your own audio sounds echoey on calls. Foam is mostly aesthetic.
    </p>
  </section>

  <!-- Quick Picks -->
  <section id="quick-picks">
    <h2 class="text-2xl font-bold text-white mb-6">Quick Picks by Problem</h2>
    <ComparisonTable columns={quickPicksColumns} rows={quickPicksRows} caption="Best soundproofing solutions by use case"/>
  </section>

  <!-- Absorption vs Blocking -->
  <section id="absorption-vs-blocking">
    <h2 class="text-2xl font-bold text-white mb-6">Absorption vs Blocking—Why This Matters</h2>
    <p class="text-white/80 mb-6">
      Got confused by this for weeks before I figured it out. Two completely different problems, completely different solutions.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <div class="bg-gradient-to-r from-blue-500/10 to-transparent border border-blue-500/20 rounded-xl p-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 bg-blue-500/20 rounded-full flex items-center justify-center">
            <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-white">Sound Absorption</h3>
        </div>
        <p class="text-white/70 mb-4">
          Deals with echo inside your room. Voice bounces off hard walls, you get that hollow bathroom sound. Soft stuff like foam and fabric panels catch some of those bounces.
        </p>
        <p class="text-white/70 text-sm">
          <strong>Products:</strong> Acoustic panels, foam, curtains, rugs
        </p>
      </div>
      <div class="bg-gradient-to-r from-orange-500/10 to-transparent border border-orange-500/20 rounded-xl p-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 bg-orange-500/20 rounded-full flex items-center justify-center">
            <svg class="w-5 h-5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-white">Sound Blocking</h3>
        </div>
        <p class="text-white/70 mb-4">
          The harder problem. Keeping sound from traveling between rooms or from outside. You need heavy stuff, airtight seals, mass.
        </p>
        <p class="text-white/70 text-sm">
          <strong>Products:</strong> Door seals, MLV, solid doors, window inserts
        </p>
      </div>
    </div>
    <p class="text-white/80 mb-8">
      Most home office situations need a bit of both, depending on what's actually driving you crazy.
    </p>
  </section>

  <!-- The Gap Problem -->
  <section id="gap-problem">
    <h2 class="text-2xl font-bold text-white mb-6">The Gap Problem Nobody Talks About</h2>
    <div class="bg-gradient-to-r from-red-500/10 to-transparent border border-red-500/20 rounded-xl p-6 mb-6">
      <p class="text-white/90 font-medium mb-4">
        This one genuinely changed how I think about the whole thing.
      </p>
      <p class="text-white/80 mb-4">
        Sound travels through air. Air travels through gaps. That $500 worth of wall treatment means nothing when there's an 11mm gap under your door.
      </p>
      <p class="text-white/80">
        Measured mine with a ruler. Eleven millimeters. Doesn't look like much. Put my phone playing music in the hallway, shut the door, still totally audible. Slapped on a $30 door sweep, immediately noticeable difference.
      </p>
    </div>
    <p class="text-white/80 mb-8">
      Every home office door has these gaps somewhere. Bottom, sides where the weatherstripping got old, around the frame where the trim meets the wall. All of them are basically open highways for sound.
    </p>
  </section>

  <!-- Door Seals and Sweeps -->
  <section id="door-seals">
    <h2 class="text-2xl font-bold text-white mb-6">Door Seals and Sweeps (Best ROI)</h2>
    <div class="bg-gradient-to-r from-green-500/10 to-transparent border border-green-500/20 rounded-xl p-6 mb-6">
      <div class="flex flex-wrap gap-4 mb-4">
        <span class="px-3 py-1 bg-green-500/20 text-green-400 text-sm font-medium rounded-full">Best Value</span>
        <span class="text-white/60 text-sm">$30-80</span>
        <span class="text-white/60 text-sm">40-50% noise reduction</span>
      </div>
      <p class="text-white/80 mb-4">
        This is where you start. Cheapest fix, most dramatic improvement. Bottom sweep is the big one. Tried three types over a few months:
      </p>
      <div class="space-y-4 mb-4">
        <div class="bg-white/5 rounded-lg p-4">
          <h4 class="text-white font-medium mb-2">Automatic Drop Seals ($40-80)</h4>
          <p class="text-white/70 text-sm">They drop down when the door shuts and lift back up when you open it. Ended up keeping this type—seals tight, doesn't drag on my carpet, feels like actual hardware.</p>
        </div>
        <div class="bg-white/5 rounded-lg p-4">
          <h4 class="text-white font-medium mb-2">Stick-On Strips ($8-15)</h4>
          <p class="text-white/70 text-sm">Just adhesive rubber that goes on the door bottom. Works okay but wears out, and the adhesive can be annoying.</p>
        </div>
        <div class="bg-white/5 rounded-lg p-4">
          <h4 class="text-white font-medium mb-2">Brush-Style Sweeps ($15-25)</h4>
          <p class="text-white/70 text-sm">Less tight seal than rubber, but handles uneven floors better. Mine's pretty level so I went rubber.</p>
        </div>
      </div>
      <p class="text-white/70 text-sm">
        <strong>Pro tip:</strong> Frame weatherstripping is the other half. Foam tape costs like $10, takes 20 minutes to stick on. Together? Probably cut noise bleed by 40-50%.
      </p>
    </div>
    <p class="text-white/80 mb-6">
      Watch out for thick carpet though—some sweeps drag badly. Drop-seal type avoids that.
    </p>
    <AffiliateButton href="/go/amazon/door-sweep-soundproof" text="Check Door Seals on Amazon" program="amazon"/>
  </section>

  <!-- Acoustic Panels -->
  <section id="acoustic-panels">
    <h2 class="text-2xl font-bold text-white mb-6">Acoustic Panels (For Echo Issues)</h2>
    <p class="text-white/80 mb-6">
      These catch sound bouncing around inside your room. Won't keep outside noise from getting in, but will clean up how you sound on recordings and calls. NRC matters here—it's a rating from 0 to 1. Closer to 1 is better for absorption.
    </p>
    <div class="space-y-4 mb-6">
      <div class="bg-gradient-to-r from-blue-500/10 to-transparent border border-blue-500/20 rounded-xl p-6">
        <div class="flex flex-wrap gap-4 mb-4">
          <span class="px-3 py-1 bg-blue-500/20 text-blue-400 text-sm font-medium rounded-full">Best Performance</span>
          <span class="text-white/60 text-sm">NRC 1.0</span>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">ATS Acoustic Panels ($40-50 each)</h3>
        <p class="text-white/70 mb-2">
          2x4 footers with NRC of 1.0, which is about as good as it gets. Fabric wrapped over solid wood frames. Look like actual office décor instead of gaming-bedroom vibes.
        </p>
        <p class="text-white/60 text-sm">Got four of these behind my monitor and the Zoom audio difference was pretty clear.</p>
      </div>
      <div class="bg-gradient-to-r from-purple-500/10 to-transparent border border-purple-500/20 rounded-xl p-6">
        <div class="flex flex-wrap gap-4 mb-4">
          <span class="px-3 py-1 bg-purple-500/20 text-purple-400 text-sm font-medium rounded-full">Best Looking</span>
          <span class="text-white/60 text-sm">NRC 0.95</span>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">BUBOS Art Panels ($50-70 for 6-pack)</h3>
        <p class="text-white/70 mb-2">
          Come in colors and actual designs, not just black rectangles. Sold my wife on putting a couple in our shared workspace because they don't look like studio equipment.
        </p>
      </div>
    </div>
    <p class="text-white/80 mb-6">
      <strong>Placement tip:</strong> behind your monitor first, then walls on either side of you. Don't go crazy covering everything—25-30% max or the room sounds dead and weird.
    </p>
    <p class="text-white/80 mb-6">
      Honest answer: if video calls are your main thing and your room doesn't currently sound echoey, skip these. The difference really shows up for podcasts, voiceovers, music stuff.
    </p>
    <AffiliateButton href="/go/amazon/acoustic-panels" text="Check Acoustic Panels on Amazon" program="amazon"/>
  </section>

  <!-- Foam Panels -->
  <section id="foam-panels">
    <h2 class="text-2xl font-bold text-white mb-6">Foam Panels—The Real Story</h2>
    <div class="bg-gradient-to-r from-yellow-500/10 to-transparent border border-yellow-500/20 rounded-xl p-6 mb-6">
      <div class="flex flex-wrap gap-4 mb-4">
        <span class="px-3 py-1 bg-yellow-500/20 text-yellow-400 text-sm font-medium rounded-full">Budget Option</span>
        <span class="text-white/60 text-sm">$20-40 for 12-pack</span>
        <span class="text-white/60 text-sm">NRC 0.65-0.75</span>
      </div>
      <p class="text-white/80 mb-4">
        Those Amazon deals where you get 48 foam squares for $30. Had to test them. They do absorb high-frequency stuff. Your room gets slightly less reflective. Keyboard clicks and sibilance calm down a bit.
      </p>
      <div class="mb-4">
        <p class="text-white font-medium mb-2">What they don't do:</p>
        <ul class="space-y-2">
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-1">✗</span>
            <span class="text-white/70">Stop noise going in or out of your room</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-1">✗</span>
            <span class="text-white/70">Handle bass or low-frequency rumble at all</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-1">✗</span>
            <span class="text-white/70">Last more than six months before looking dusty and gross</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-1">✗</span>
            <span class="text-white/70">Leave clean walls when you pull them off</span>
          </li>
        </ul>
      </div>
      <p class="text-white/70 text-sm">
        <strong>Bottom line:</strong> Skip these unless budget is really tight. If you're doing foam anyway, at least get 2-inch thick, denser stuff.
      </p>
    </div>
  </section>

  <!-- Mass Loaded Vinyl -->
  <section id="mlv">
    <h2 class="text-2xl font-bold text-white mb-6">Mass Loaded Vinyl (The Heavy Stuff)</h2>
    <div class="bg-gradient-to-r from-orange-500/10 to-transparent border border-orange-500/20 rounded-xl p-6 mb-6">
      <div class="flex flex-wrap gap-4 mb-4">
        <span class="px-3 py-1 bg-orange-500/20 text-orange-400 text-sm font-medium rounded-full">Serious Blocking</span>
        <span class="text-white/60 text-sm">$1-2 per sqft</span>
      </div>
      <p class="text-white/80 mb-4">
        Did the door seals and still have issues? Mass loaded vinyl is the escalation path. This stuff actually blocks sound, not just absorbs it.
      </p>
      <p class="text-white/80 mb-4">
        It's a flexible dense vinyl sheet with heavy minerals mixed in. Hang it on walls, sandwich it behind drywall, drape it over whatever needs help. Adds weight without thickness.
      </p>
      <p class="text-white/80 mb-4">
        Put some behind the wall I share with the neighbor's garage. Timed it with a repaint weekend. Didn't completely eliminate the table saw, but knocked down the higher pitched sounds noticeably.
      </p>
      <p class="text-white/70 text-sm">
        <strong>Fair warning:</strong> This stuff is floppy and heavy. Bring a friend and a staple gun.
      </p>
    </div>
    <AffiliateButton href="/go/amazon/mass-loaded-vinyl" text="Check Mass Loaded Vinyl on Amazon" program="amazon"/>
  </section>

  <!-- Window Solutions -->
  <section id="windows">
    <h2 class="text-2xl font-bold text-white mb-6">Window Solutions</h2>
    <p class="text-white/80 mb-6">
      Windows are often the weakest spot, especially single-pane glass.
    </p>
    <div class="space-y-4 mb-6">
      <div class="bg-white/5 border border-white/10 rounded-xl p-6">
        <h3 class="text-lg font-semibold text-white mb-2">Heavy Curtains ($50-100)</h3>
        <p class="text-white/70">Look for "blackout" or "thermal" labels—more mass usually. Not magic, but takes the edge off street noise. I've got heavy velvet curtains that stay closed during calls. Some sound reduction, better video lighting. Two birds.</p>
      </div>
      <div class="bg-white/5 border border-white/10 rounded-xl p-6">
        <h3 class="text-lg font-semibold text-white mb-2">Window Inserts ($200-500 per window)</h3>
        <p class="text-white/70">Secondary panes that fit inside your frame, creating an air gap. Actually effective but pricey. Some pop out when you want fresh air.</p>
      </div>
      <div class="bg-white/5 border border-white/10 rounded-xl p-6">
        <h3 class="text-lg font-semibold text-white mb-2">Weatherstripping ($10-20)</h3>
        <p class="text-white/70">Same deal as doors. Old windows especially get gaps from settling over time.</p>
      </div>
    </div>
  </section>

  <!-- My Setup -->
  <section id="my-setup">
    <h2 class="text-2xl font-bold text-white mb-6">What I Actually Ended Up With</h2>
    <div class="bg-gradient-to-r from-jet-stream/20 to-ocean-deep/20 border border-jet-stream/30 rounded-xl p-6 mb-6">
      <p class="text-white/90 font-medium mb-4">After testing a bunch of stuff, here's my office now:</p>
      <div class="space-y-3 mb-6">
        <div class="flex justify-between items-center py-2 border-b border-white/10">
          <span class="text-white/80">Drop-seal door bottom</span>
          <span class="text-jet-stream font-medium">$65</span>
        </div>
        <div class="flex justify-between items-center py-2 border-b border-white/10">
          <span class="text-white/80">Foam tape around door frame</span>
          <span class="text-jet-stream font-medium">$8</span>
        </div>
        <div class="flex justify-between items-center py-2 border-b border-white/10">
          <span class="text-white/80">Four ATS 2x4 panels</span>
          <span class="text-jet-stream font-medium">$180</span>
        </div>
        <div class="flex justify-between items-center py-2 border-b border-white/10">
          <span class="text-white/80">Heavy blackout curtains</span>
          <span class="text-jet-stream font-medium">$60</span>
        </div>
        <div class="flex justify-between items-center py-2 border-b border-white/10">
          <span class="text-white/80">Thick rug with dense pad</span>
          <span class="text-jet-stream font-medium">$150</span>
        </div>
        <div class="flex justify-between items-center py-3 font-bold">
          <span class="text-white">Total</span>
          <span class="text-jet-stream">~$460</span>
        </div>
      </div>
      <p class="text-white/80 mb-4">
        Perfect silence? Nope. Faint table saw audible on Tuesdays? Yep. Client calls picking it up? <strong>Not anymore.</strong> That was the whole point.
      </p>
      <div class="bg-white/5 rounded-lg p-4">
        <p class="text-white font-medium mb-2">Tighter budget version:</p>
        <p class="text-white/70">Door seals first ($30-80), then maybe two panels behind the monitor ($100). Under $150 gets you meaningful improvement.</p>
      </div>
    </div>
  </section>

  <!-- What Doesn't Work -->
  <section id="doesnt-work">
    <h2 class="text-2xl font-bold text-white mb-6">Stuff That Doesn't Work</h2>
    <div class="bg-gradient-to-r from-red-500/10 to-transparent border border-red-500/20 rounded-xl p-6 mb-6">
      <div class="space-y-4">
        <div class="flex items-start gap-3">
          <span class="text-red-400 text-xl">✗</span>
          <div>
            <span class="text-white font-medium">Egg carton foam:</span>
            <span class="text-white/70 ml-1">Does nothing, fire hazard, looks ridiculous. Just don't.</span>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-red-400 text-xl">✗</span>
          <div>
            <span class="text-white font-medium">Moving blankets by themselves:</span>
            <span class="text-white/70 ml-1">Some absorption but way less than real panels. Fine for packing boxes.</span>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-red-400 text-xl">✗</span>
          <div>
            <span class="text-white font-medium">Spray foam insulation:</span>
            <span class="text-white/70 ml-1">That's for temperature, not sound. Different problem.</span>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-red-400 text-xl">✗</span>
          <div>
            <span class="text-white font-medium">Carpet on walls:</span>
            <span class="text-white/70 ml-1">Internet meme that somehow persists. Minimal absorption, looks exactly as weird as it sounds.</span>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-red-400 text-xl">✗</span>
          <div>
            <span class="text-white font-medium">"Soundproof paint":</span>
            <span class="text-white/70 ml-1">Pure marketing garbage. Adds basically no mass, costs more than normal paint.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Reality Check -->
  <section>
    <h2 class="text-2xl font-bold text-white mb-6">Reality Check</h2>
    <p class="text-white/80 mb-6">
      Even unlimited budget can't make perfect soundproofing happen in an existing room. Sound finds gaps, travels through structure, and bass goes through pretty much anything.
    </p>
    <div class="space-y-4 mb-8">
      <div class="bg-white/5 border border-white/10 rounded-xl p-6">
        <h3 class="text-lg font-semibold text-white mb-2">Kill echo on calls and recordings — $100-300</h3>
        <p class="text-white/70">Totally doable. This is what most remote workers actually need.</p>
      </div>
      <div class="bg-white/5 border border-white/10 rounded-xl p-6">
        <h3 class="text-lg font-semibold text-white mb-2">Reduce casual noise bleeding — $50-150</h3>
        <p class="text-white/70">Doable with door seals and basics.</p>
      </div>
      <div class="bg-white/5 border border-white/10 rounded-xl p-6">
        <h3 class="text-lg font-semibold text-white mb-2">Block serious noise — $1000+</h3>
        <p class="text-white/70">Real investment needed. Might need actual renovation.</p>
      </div>
      <div class="bg-white/5 border border-white/10 rounded-xl p-6">
        <h3 class="text-lg font-semibold text-white mb-2">True sound isolation — $5000+</h3>
        <p class="text-white/70">Professional studio territory. Requires construction work.</p>
      </div>
    </div>
    <p class="text-white/80 mb-8">
      Most people working from home need the first two. If you're in categories three or four, you probably need an acoustic consultant, not Amazon.
    </p>
  </section>

  <!-- FAQ -->
  <section id="faq">
    <h2 class="text-2xl font-bold text-white mb-6">Questions People Ask</h2>
    <FAQSection faqs={faqItems}/>
  </section>

  <!-- Summary -->
  <section id="summary">
    <h2 class="text-2xl font-bold text-white mb-6">Bottom Line</h2>
    <div class="bg-gradient-to-r from-jet-stream/20 to-ocean-deep/20 border border-jet-stream/30 rounded-xl p-6 mb-8">
      <div class="space-y-4">
        <p class="text-white/90">
          <strong>Door seals first. Always.</strong> Under $100, biggest improvement you'll find.
        </p>
        <p class="text-white/90">
          <strong>Acoustic panels</strong> when echo is the issue or you're recording content. Plan $100-200 for decent coverage.
        </p>
        <p class="text-white/90">
          <strong>Foam wedges</strong> only when budget is truly tight and you know they're just for absorption.
        </p>
        <p class="text-white/90">
          <strong>Heavy curtains and thick rugs</strong> do more than you'd expect, especially if you already own them.
        </p>
        <p class="text-white/90">
          <strong>MLV and window inserts</strong> when basic fixes aren't cutting it for serious noise.
        </p>
      </div>
    </div>
    <p class="text-white/80 mb-8">
      That table saw still fires up every Tuesday. My clients have no idea.
    </p>
  </section>

  <!-- Full Comparison Table -->
  <Fragment slot="full-width">
    <section class="py-8" id="full-comparison">
      <div class="container mx-auto px-4 md:px-6">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6 text-center font-heading">Complete Product Comparison</h2>
        <ComparisonTable columns={fullComparisonColumns} rows={fullComparisonRows} caption="Full comparison of soundproofing solutions"/>
      </div>
    </section>

    <!-- Related Articles -->
    <RelatedArticles articles={relatedArticles}/>
  </Fragment>
</ArticleLayout>
