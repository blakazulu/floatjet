// Get article metadata from central data file
const article = getArticleBySlug("best-speakers-home-office", "gear")!;
const { title, description, authorSlug, readingTime, image, imageAlt } = article;
const pubDate = new Date(article.pubDate);

const updatedDate = new Date("2024-11-24");
const category = "Audio";
const categorySlug = "gear";
const subcategorySlug = "audio";

const headings = [
  { text: "Quick Picks", slug: "quick-picks" },
  { text: "Why Bother", slug: "why-desktop-speakers" },
  { text: "What Matters", slug: "what-to-look-for" },
  { text: "Audioengine A2+", slug: "audioengine-a2-plus" },
  { text: "Edifier R1280DB", slug: "edifier-r1280db" },
  { text: "Creative Pebble V3", slug: "creative-pebble-v3" },
  { text: "Logitech Z407", slug: "logitech-z407" },
  { text: "Bose Companion 2 III", slug: "bose-companion-2" },
  { text: "Klipsch ProMedia 2.1", slug: "klipsch-promedia" },
  { text: "Edifier R1280T", slug: "edifier-r1280t" },
  { text: "Razer Nommo", slug: "razer-nommo" },
