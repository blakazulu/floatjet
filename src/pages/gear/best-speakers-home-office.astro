const faqItems = [
  {
    question: "Which is better for remote work?",
    answer:
      "Both. Speakers for long sessions. No ear fatigue. Better for background music and staying aware of your space. Headphones for calls, noise, focus. Most people use both.",
  },
  {
    question: "Subwoofer needed?",
    answer:
      "Nah, not really. For calls and podcasts, regular speakers are fine. If you listen to music or watch stuff, subwoofer adds depth. Think about neighbors though.",
  },
  {
    question: "How much to spend?",
    answer:
      "Basic use? Forty to eighty. Want good music? One to two hundred. Above that you're paying for stuff most ears can't hear.",
  },
  {
    question: "Desktop speakers for calls?",
    answer:
      "Yeah, they work for hearing people. Still need a separate mic though. Laptop mics pick up speaker audio and create echo. External speakers plus good mic is the setup.",
