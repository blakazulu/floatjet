---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {ChevronLeft, ChevronRight} from 'lucide-astro';

const title = 'Best Office Furniture for Remote Work | FloatJet';
const description = 'Find the best standing desks, chairs, and office furniture for your home office. Ergonomic picks for healthier, more productive workdays without pain.';

const featuredArticle = {
  title: 'Best Standing Desks (2025)',
  description: 'We tested 15+ standing desks to find the best options for home offices. Compare Uplift, Flexispot, Jarvis, and more for every budget.',
  href: '/gear/best-standing-desks',
  readTime: 18,
  icon: '🪑'
};

const articles = [
  {
    title: 'Best Ergonomic Chairs',
    description: 'Top office chairs for all-day comfort. From premium Herman Miller to budget-friendly options.',
    href: '/gear/best-ergonomic-chairs',
    icon: '🪑',
    readTime: 18,
    category: 'Furniture'
  },
  {
    title: 'Best Desk Converters',
    description: 'Transform your existing desk into a standing desk with these top-rated converters.',
    href: '/gear/best-desk-converters',
    icon: '📐',
    readTime: 14,
    category: 'Furniture'
  },
  {
    title: 'Best Compact Desks for Small Offices',
    description: 'Space-saving desks for small home offices. Maximize productivity in tight spaces.',
    href: '/gear/best-compact-desks-small-office',
    icon: '🏠',
    readTime: 14,
    category: 'Furniture'
  },
  {
    title: 'Ergonomic Desk Setup Guide',
    description: 'Complete guide to setting up your workspace for maximum comfort and health.',
    href: '/gear/ergonomic-desk-setup-guide',
    icon: '📋',
    readTime: 12,
    category: 'Furniture'
  },
  {
    title: 'Standing Desk Cost Guide',
    description: 'How much should you spend? Price breakdown at every budget level.',
    href: '/gear/standing-desk-cost-guide',
    icon: '💰',
    readTime: 8,
    category: 'Furniture'
  }
];

const whyMatters = [
  {title: 'Better Posture', description: 'Reduce back pain and improve your posture throughout the day', icon: '🧘'},
  {
    title: 'More Energy',
    description: 'Standing burns calories and keeps you alert during long work sessions',
    icon: '⚡'
  },
  {
    title: 'Increased Focus',
    description: 'Movement throughout the day improves concentration and productivity',
    icon: '🎯'
  },
  {title: 'Long-term Health', description: 'Reduce risks associated with prolonged sitting', icon: '❤️'}
];

const topPicks = [
  {name: 'Uplift V2', tag: 'Best Overall Desk', color: 'bg-blue-500/20 text-blue-400'},
  {name: 'Herman Miller Aeron', tag: 'Best Chair', color: 'bg-green-500/20 text-green-400'},
  {name: 'FlexiSpot E7', tag: 'Best Value', color: 'bg-purple-500/20 text-purple-400'}
];
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <!-- Header -->
    <div class="text-center mb-12">
      <a href="/gear" class="inline-flex items-center text-white/60 hover:text-white text-sm mb-4 transition-colors">
        <ChevronLeft class="w-4 h-4 mr-1" aria-hidden="true"/>
        All Gear
      </a>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Office Furniture</h1>
      <p class="text-lg text-white/80 max-w-2xl mx-auto">
        Ergonomic desks, chairs, and furniture for a healthier, more productive home office.
      </p>
    </div>

    <!-- Featured Article Card -->
    <a
        href={featuredArticle.href}
        class="block max-w-3xl mx-auto mb-12 group bg-gradient-to-r from-ocean-deep/40 to-jet-stream/20 border border-white/20 hover:border-jet-stream/50 rounded-xl p-8 transition-all duration-300"
    >
      <div class="flex items-center gap-2 mb-4">
        <span class="text-4xl">{featuredArticle.icon}</span>
        <span class="px-3 py-1 bg-jet-stream text-ocean-deep text-xs font-bold rounded-full">Featured Guide</span>
      </div>
      <h2 class="text-2xl md:text-3xl font-bold text-white group-hover:text-jet-stream transition-colors mb-3">
        {featuredArticle.title}
      </h2>
      <p class="text-white/70 mb-4">
        {featuredArticle.description}
      </p>
      <div class="flex items-center justify-between">
        <span class="text-white/50 text-sm">{featuredArticle.readTime} min read</span>
        <span class="text-jet-stream font-medium flex items-center">
          Read Full Guide
          <ChevronRight class="w-5 h-5 ml-1 group-hover:translate-x-1 transition-transform" aria-hidden="true"/>
        </span>
      </div>
    </a>

    <!-- Top Picks Preview -->
    <div class="max-w-3xl mx-auto mb-12">
      <h2 class="text-xl font-semibold text-white text-center mb-6">Our Top Picks</h2>
      <div class="grid gap-4 grid-cols-1 sm:grid-cols-3">
        {topPicks.map(pick => (
            <div class="bg-white/5 border border-white/10 rounded-lg p-4 text-center">
            <span class={`inline-block px-2 py-0.5 ${pick.color} text-xs font-medium rounded mb-2`}>
              {pick.tag}
            </span>
              <p class="text-white font-semibold">{pick.name}</p>
            </div>
        ))}
      </div>
    </div>

    <!-- Articles Grid -->
    <div class="mb-12">
      <h2 class="text-xl font-semibold text-white text-center mb-8">More Furniture Reviews</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {articles.map(article => (
            <a
                href={article.href}
                class="group bg-black/40 hover:bg-black/50 border border-white/10 hover:border-white/20 rounded-xl p-6 transition-all duration-300"
            >
              <div class="flex items-start gap-4">
                <span class="text-3xl flex-shrink-0">{article.icon}</span>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-2">
                  <span class="inline-block px-2 py-0.5 bg-jet-stream/20 text-jet-stream text-xs font-medium rounded">
                    {article.category}
                  </span>
                    <span class="text-white/40 text-xs">{article.readTime} min</span>
                  </div>
                  <h2 class="text-lg font-semibold text-white group-hover:text-jet-stream transition-colors mb-2">
                    {article.title}
                  </h2>
                  <p class="text-white/70 text-sm">{article.description}</p>
                </div>
              </div>
              <div class="mt-4 flex items-center text-jet-stream text-sm font-medium">
                Read Review
                <ChevronRight class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" aria-hidden="true"/>
              </div>
            </a>
        ))}
      </div>
    </div>

    <!-- Why It Matters -->
    <div class="max-w-4xl mx-auto mb-12">
      <h2 class="text-xl font-semibold text-white text-center mb-8">Why Ergonomic Furniture Matters</h2>
      <div class="grid gap-6 grid-cols-1 sm:grid-cols-2">
        {whyMatters.map(item => (
            <div class="flex items-start gap-4 bg-white/5 border border-white/10 rounded-xl p-5">
              <span class="text-2xl">{item.icon}</span>
              <div>
                <h3 class="text-white font-semibold mb-1">{item.title}</h3>
                <p class="text-white/60 text-sm">{item.description}</p>
              </div>
            </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center">
      <a
          href={featuredArticle.href}
          class="inline-flex items-center justify-center px-6 py-3 bg-jet-stream text-ocean-deep font-semibold rounded-lg hover:bg-sky-light transition-colors"
      >
        View Standing Desk Comparison
      </a>
    </div>
  </div>
</BaseLayout>
