  {
    title: 'Best Microphones for Remote Meetings',
    excerpt: 'Our top picks for USB and XLR microphones for video calls.',
    href: '/gear/best-microphones-remote-meetings',
    image: 'https://images.unsplash.com/photo-1590602847861-f357a9332bbc?auto=format&fit=crop&w=800&q=80',
    imageAlt: 'Professional USB microphone for remote work',
  },
  {
    title: 'How to Reduce Background Noise on Calls',
    excerpt: 'Tips and techniques to eliminate distracting noise from your meetings.',
    href: '/gear/reduce-background-noise-calls',
