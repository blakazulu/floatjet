---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Remote Work Guides & Tips | FloatJet";
const description =
  "Expert guides for remote workers and digital nomads. Learn best practices for async communication, time management, home office setup, and more.";

// Category pages
const categories = [
  {
    name: "Travel",
    href: "/guides/travel",
    icon: "✈️",
    description: "Destinations, visas & travel tips",
  },
  {
    name: "Communication",
    href: "/guides/communication",
    icon: "💬",
    description: "Async workflows & collaboration",
  },
  {
    name: "Productivity",
    href: "/guides/productivity",
    icon: "⚡",
    description: "Time management & focus",
  },
  {
    name: "Security",
    href: "/guides/security",
    icon: "🔐",
    description: "VPNs, passwords & online safety",
  },
  { name: "Setup", href: "/guides/setup", icon: "🏠", description: "Home office & gear guides" },
  { name: "Finance", href: "/guides/finance", icon: "📊", description: "Taxes, banking & money" },
];

// All guides with correct reading times from articles
const allGuides = [
  {
    title: "Top Destinations for Digital Nomads",
    description: "Best places to work remotely with great WiFi, community, and cost of living.",
    href: "/blog/top-destinations-digital-nomads",
    category: "Travel",
    readTime: 14,
    icon: "✈️",
  },
  {
    title: "Essential Travel Tech for Nomads",
    description: "The tech essentials every digital nomad needs for productive travel.",
    href: "/blog/essential-travel-tech-nomads",
    category: "Travel",
    readTime: 10,
    icon: "🎒",
  },
  {
    title: "Find Reliable WiFi Anywhere",
    description: "Tips and tools for finding fast, reliable internet on the road.",
    href: "/blog/find-reliable-wifi-anywhere",
    category: "Travel",
    readTime: 9,
    icon: "📶",
  },
  {
    title: "Best Travel Insurance for Remote Workers",
    description: "Compare travel insurance options designed for digital nomads.",
    href: "/blog/best-travel-insurance-remote-workers",
    category: "Travel",
    readTime: 11,
    icon: "🛡️",
  },
  {
    title: "Async Communication for Remote Teams",
    description: "Master asynchronous communication to boost productivity and reduce meetings.",
    href: "/blog/async-communication-remote-teams",
    category: "Communication",
    readTime: 12,
    icon: "💬",
  },
  {
    title: "Best Team Communication Tools",
    description: "Compare Slack, Teams, Discord, and more for remote team communication.",
    href: "/blog/best-team-communication-tools",
    category: "Communication",
    readTime: 11,
    icon: "📢",
  },
  {
    title: "Managing Time Zones in Remote Teams",
    description: "Strategies for effective collaboration across different time zones.",
    href: "/blog/managing-time-zones-remote-teams",
    category: "Productivity",
    readTime: 11,
    icon: "🌍",
  },
  {
    title: "VPN & Public WiFi Security",
    description: "Essential cybersecurity practices for working from anywhere.",
    href: "/blog/vpn-public-wifi-guide",
    category: "Security",
    readTime: 13,
    icon: "🔐",
  },
  {
    title: "VPN Speed Comparison",
    description: "Real-world speed tests of popular VPNs for remote workers.",
    href: "/blog/vpn-speed-comparison",
    category: "Security",
    readTime: 10,
    icon: "⚡",
  },
  {
    title: "Ultimate Home Office Setup",
    description: "Build the perfect home office on any budget.",
    href: "/blog/ultimate-home-office-setup",
    category: "Setup",
    readTime: 11,
    icon: "🏠",
  },
  {
    title: "Tax Tips for Remote Workers",
    description: "Navigate taxes as a remote worker or digital nomad.",
    href: "/blog/tax-tips-remote-workers",
    category: "Finance",
    readTime: 12,
    icon: "📊",
  },
  {
    title: "Best Banking for Digital Nomads",
    description: "Compare international banking options for remote workers.",
    href: "/blog/best-banking-digital-nomads",
    category: "Finance",
    readTime: 12,
    icon: "🏦",
  },
  {
    title: "Crypto-Friendly Banks",
    description: "Banks that support cryptocurrency for digital nomads.",
    href: "/blog/crypto-friendly-banks",
    category: "Finance",
    readTime: 10,
    icon: "₿",
  },
  {
    title: "Best CRM Software for Small Business",
    description: "Compare HubSpot, Pipedrive, Zoho, and more CRM tools.",
    href: "/blog/best-crm-software-small-business",
    category: "Productivity",
    readTime: 12,
    icon: "👥",
  },
  {
    title: "Cloud vs Traditional Hosting",
    description: "Understand the differences between cloud and traditional hosting.",
    href: "/blog/cloud-vs-traditional-hosting",
    category: "Setup",
    readTime: 9,
    icon: "☁️",
  },
  {
    title: "Managed WordPress Hosting Compared",
    description: "Compare WP Engine, Kinsta, Flywheel, and other managed hosts.",
    href: "/blog/managed-wordpress-hosting-compared",
    category: "Setup",
    readTime: 11,
    icon: "🌐",
  },
];

// Shuffle and limit articles - render all 9, CSS handles responsive visibility
const shuffled = [... AllGuides]. Sort(() => Math. Random() - 0.5);
const displayGuides = shuffled. Slice(0, 9);
const totalArticles = allGuides. Length;
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Remote Work Guides</h1>
      <p class="text-lg text-white/80 max-w-2xl mx-auto">
        Practical guides and tutorials to help you thrive as a remote worker, freelancer, or digital nomad.
      </p>
    </div>

    <!-- Category Links -->
    <div class="grid gap-3 grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 mb-12 max-w-5xl mx-auto">
      {categories. Map(cat => (
          <a
              href={cat. Href}
              class="group flex flex-col items-center text-center p-4 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-jet-stream/50 rounded-xl transition-all duration-300"
          >
            <span class="text-2xl mb-2">{cat. Icon}</span>
            <span class="text-white font-medium group-hover:text-jet-stream transition-colors">{cat. Name}</span>
            <span class="text-white/50 text-xs mt-1 hidden sm:block">{cat. Description}</span>
          </a>
      ))}
    </div>

    <!-- Guides Grid - Responsive: 3 mobile, 6 tablet, 9 desktop -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {displayGuides. Map((guide, index) => (
          <a
              href={guide. Href}
              class:list={[
                'group bg-black/40 hover:bg-black/50 border border-white/10 hover:border-white/20 rounded-xl p-6 transition-all duration-300',
                // Mobile: show first 3

                index >= 3 && 'hidden sm:block',
                // Tablet: show first 6

                index >= 6 && 'sm:hidden lg:block'
              ]}
          >
            <div class="flex items-start gap-4">
              <span class="text-3xl">{guide. Icon}</span>
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-2">
                <span class="inline-block px-2 py-0.5 bg-jet-stream/20 text-jet-stream text-xs font-medium rounded">
                  {guide. Category}
                </span>
                  <span class="text-white/40 text-xs">{guide. ReadTime} min</span>
                </div>
                <h2 class="text-lg font-semibold text-white group-hover:text-jet-stream transition-colors mb-2">
                  {guide. Title}
                </h2>
                <p class="text-white/70 text-sm">
                  {guide. Description}
                </p>
              </div>
            </div>
            <div class="mt-4 flex items-center text-jet-stream text-sm font-medium">
              Read Guide
              <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
            </div>
          </a>
      ))}
    </div>

    <!-- View All Link -->
    <div class="mt-8 text-center">
      <p class="text-white/60 text-sm">Browse by category above to see all guides</p>
    </div>

    <!-- CTA Section -->
    <div class="mt-12 text-center">
      <a href="/contact" class="inline-flex items-center text-jet-stream hover:text-sky-light transition-colors">
        Request a guide topic
        <svg class="w-4 h-4 ml-1" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</BaseLayout>
