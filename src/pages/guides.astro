---
import HubPage from "@components/hub/HubPage.astro";
import { getArticlesBySection } from "@data/articles";
import { getSectionFilters, sections } from "@data/sections";

const config = sections.guides;
---

<HubPage
    metaTitle={config.metaTitle}
    metaDescription={config.metaDescription}
    heading={config.heading}
    subtitle={config.subtitle}
    note={config.note}
    countLabel={config.countLabel}
    articles={getArticlesBySection("guides")}
    filters={getSectionFilters("guides")}
    activeHref="/guides/"
    breadcrumbs={[{ label: "Home", href: "/" }, { label: config.label, href: "/guides/" }]}
/>
