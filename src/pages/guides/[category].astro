---
import HubPage from "@components/hub/HubPage.astro";
import { getArticlesByCategory } from "@data/articles";
import { getSectionFilters, sections, type CategoryConfig } from "@data/sections";

export function getStaticPaths() {
  return sections.guides.categories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props as { category: CategoryConfig };
const config = sections.guides;
---

<HubPage
    metaTitle={`${category.title} | FloatJet`}
    metaDescription={category.description}
    heading={category.title}
    subtitle={category.subtitle}
    intro={category.intro}
    startHere={category.startHere}
    note={config.note}
    countLabel={config.countLabel}
    articles={getArticlesByCategory("guides", category.slug)}
    filters={getSectionFilters("guides")}
    activeHref={`/guides/${category.slug}/`}
    breadcrumbs={[
      { label: "Home", href: "/" },
      { label: config.label, href: "/guides/" },
      { label: category.name, href: `/guides/${category.slug}/` },
    ]}
/>
