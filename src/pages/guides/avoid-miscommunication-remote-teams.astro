  {text: 'FAQ', slug: 'faq', depth: 2},
];

// FAQ data
const faqs = [
  {
    question: 'How do I know if my message was understood correctly?',
    answer: '<p>Strategies to confirm understanding:</p><ul><li><strong>Ask for confirmation:</strong> "Can you summarize your understanding of the next steps?"</li><li><strong>Request acknowledgment:</strong> "Please reply to confirm you got this"</li><li><strong>Check in later:</strong> Follow up before deadlines to catch misalignment early</li><li><strong>Watch for questions:</strong> No questions sometimes means the message wasn\'t fully read</li></ul><p>For important communications, explicit confirmation beats assumptions.</p>'
  },
  {
    question: 'What\'s the best way to give critical feedback remotely?',
    answer: '<p>Critical feedback needs extra care without in-person cues:</p><ol><li><strong>Use video:</strong> Tone and facial expressions prevent misreading</li><li><strong>Lead with intent:</strong> "I\'m sharing this because I want to help you succeed"</li><li><strong>Be specific:</strong> Concrete examples, not general impressions</li><li><strong>Focus forward:</strong> What to do differently, not just what went wrong</li><li><strong>Allow response:</strong> Give space for their perspective</li></ol><p>Written feedback works for minor points; video is better for anything significant.</p>'
