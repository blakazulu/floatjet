    href: '/guides/how-to-run-effective-remote-meetings',
    image: 'https://images.unsplash.com/photo-1609619385002-f40f1df9b7eb?auto=format&fit=crop&w=800&q=80',
    imageAlt: 'Remote team in productive video conference'
  },
  {
    title: 'Best Team Communication Tools',
