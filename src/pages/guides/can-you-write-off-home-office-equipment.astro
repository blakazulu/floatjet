  { text: "Can You Write Off Home Office Equipment?", slug: "can-you-write-off", depth: 2 },
  { text: "What counts as deductible", slug: "what-qualifies", depth: 2 },
  { text: "Two requirements the IRS checks", slug: "requirements", depth: 2 },
