];

const relatedArticles = [
  {
    title: 'Top Destinations for Digital Nomads',
    excerpt: 'Compare Portugal with other top remote work destinations.',
    href: '/blog/top-destinations-digital-nomads',
    image: '/images/unsplash/photo-1488646953014-85cb44e25828-800w.webp',
    imageAlt: 'World travel destinations concept'
  },
  {
    title: 'Best Travel Insurance for Remote Workers',
    excerpt: 'Protect yourself abroad with the right coverage.',
    href: '/blog/best-travel-insurance-remote-workers',
    image: '/images/unsplash/photo-1454165804606-c3d57bc86b40-800w.webp',
    imageAlt: 'Travel insurance documents'
  },
  {
    title: 'Tax Tips for Remote Workers',
    excerpt: 'Navigate international tax obligations as a nomad.',
    href: '/blog/tax-tips-remote-workers',
