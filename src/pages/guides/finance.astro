---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Finance Guides for Remote Workers | FloatJet";
const description =
  "Navigate finances as a remote worker or digital nomad. Guides on taxes, banking, crypto, and managing money abroad without headaches or frozen accounts.";

const mainArticle = {
  title: "Tax Tips for Remote Workers",
  description:
    "Navigate taxes as a remote worker or digital nomad. Understand deductions, international tax obligations, and strategies to optimize your tax situation.",
  href: "/blog/tax-tips-remote-workers",
  readTime: "14 min",
};

const guides = [
  {
    title: "Best Banking for Digital Nomads",
    description: "International banks and accounts perfect for location-independent workers.",
    href: "/blog/best-banking-digital-nomads",
    icon: "🏦",
    category: "Finance",
    readTime: 12,
  },
  {
    title: "Crypto-Friendly Banks",
    description: "Banks that work well with cryptocurrency for remote workers.",
    href: "/blog/crypto-friendly-banks",
    icon: "₿",
    category: "Finance",
    readTime: 10,
  },
  {
    title: "Freelancer Tax Deductions Guide",
    description: "Discover every tax deduction available to keep more of what you earn.",
    href: "/guides/freelancer-tax-deductions-guide",
    icon: "💰",
    category: "Finance",
    readTime: 16,
  },
  {
    title: "Retirement Savings for Freelancers",
    description:
      "Set up Solo 401(k), SEP IRA, or other retirement accounts for self-employed workers.",
    href: "/guides/retirement-savings-freelancer",
    icon: "🏖️",
    category: "Finance",
    readTime: 14,
  },
  {
    title: "Invoice Payment Terms Guide",
    description: "Understand Net 30, Net 15, and Due on Receipt to get paid faster.",
    href: "/guides/invoice-payment-terms-guide",
    icon: "📄",
    category: "Finance",
    readTime: 10,
  },
  {
    title: "Multi-Currency Banking for Nomads",
    description: "Hold and manage multiple currencies with Wise, Revolut, and more.",
    href: "/guides/multi-currency-banking-nomads",
    icon: "💱",
    category: "Finance",
    readTime: 13,
  },
  {
    title: "How to Expense Home Office Furniture",
    description: "Learn the rules for deducting desks, chairs, and office equipment on taxes.",
    href: "/guides/expense-home-office-furniture",
    icon: "🪑",
    category: "Finance",
    readTime: 9,
  },
];

const tips = [
  { title: "Track Everything", description: "Keep records of all business expenses", icon: "📝" },
  {
    title: "Understand Tax Treaties",
    description: "Know how countries share tax information",
    icon: "🌍",
  },
  {
    title: "Use Multi-Currency Accounts",
    description: "Avoid excessive forex fees on transfers",
    icon: "💱",
  },
  {
    title: "Consult a Professional",
    description: "Get expert advice for complex situations",
    icon: "👨‍💼",
  },
];
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <!-- Header -->
    <div class="text-center mb-12">
      <a href="/guides" class="inline-flex items-center text-white/60 hover:text-white text-sm mb-4 transition-colors">
        <svg class="w-4 h-4 mr-1" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg>
        All Guides
      </a>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Finance Guides</h1>
      <p class="text-lg text-white/80 max-w-2xl mx-auto">
        Manage your money wisely as a remote worker, freelancer, or digital nomad.
      </p>
    </div>

    <!-- Main Article Card -->
    <a
        href={mainArticle. Href}
        class="block max-w-3xl mx-auto mb-16 group bg-gradient-to-r from-ocean-deep/40 to-jet-stream/20 border border-white/20 hover:border-jet-stream/50 rounded-xl p-8 transition-all duration-300"
    >
      <div class="flex items-center gap-2 mb-4">
        <span class="text-4xl">📊</span>
        <span class="px-3 py-1 bg-jet-stream text-ocean-deep text-xs font-bold rounded-full">Featured Guide</span>
      </div>
      <h2 class="text-2xl md:text-3xl font-bold text-white group-hover:text-jet-stream transition-colors mb-3">
        {mainArticle. Title}
      </h2>
      <p class="text-white/70 mb-4">
        {mainArticle. Description}
      </p>
      <div class="flex items-center justify-between">
        <span class="text-white/50 text-sm">{mainArticle. ReadTime} read</span>
        <span class="text-jet-stream font-medium flex items-center">
          Read Full Guide
          <svg class="w-5 h-5 ml-1 group-hover:translate-x-1 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
        </span>
      </div>
    </a>

    <!-- More Guides -->
    <div class="mb-12">
      <h2 class="text-xl font-semibold text-white text-center mb-8">More Finance Guides</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {guides. Map(guide => (
            <a
                href={guide. Href}
                class="group bg-black/40 hover:bg-black/50 border border-white/10 hover:border-white/20 rounded-xl p-6 transition-all duration-300"
            >
              <div class="flex items-start gap-4">
                <span class="text-3xl">{guide. Icon}</span>
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="inline-block px-2 py-0.5 bg-jet-stream/20 text-jet-stream text-xs font-medium rounded">
                      {guide. Category}
                    </span>
                    <span class="text-white/40 text-xs">{guide. ReadTime} min</span>
                  </div>
                  <h2 class="text-lg font-semibold text-white group-hover:text-jet-stream transition-colors mb-2">
                    {guide. Title}
                  </h2>
                  <p class="text-white/70 text-sm">{guide. Description}</p>
                </div>
              </div>
              <div class="mt-4 flex items-center text-jet-stream text-sm font-medium">
                Read Guide
                <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
              </div>
            </a>
        ))}
      </div>

      <!-- Article Count -->
      <div class="mt-6 text-center">
        <p class="text-white/50 text-sm">
          {guides. Length + 1} articles in Finance
        </p>
      </div>
    </div>

    <!-- Tips Section -->
    <div class="max-w-4xl mx-auto">
      <h2 class="text-xl font-semibold text-white text-center mb-8">Money Management Tips</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {tips. Map(tip => (
            <div class="flex items-start gap-4 bg-white/5 border border-white/10 rounded-xl p-5">
              <span class="text-2xl">{tip. Icon}</span>
              <div>
                <h3 class="text-white font-semibold mb-1">{tip. Title}</h3>
                <p class="text-white/60 text-sm">{tip. Description}</p>
              </div>
            </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-12 text-center">
      <a
          href={mainArticle. Href}
          class="inline-flex items-center justify-center px-6 py-3 bg-jet-stream text-ocean-deep font-semibold rounded-lg hover:bg-sky-light transition-colors"
      >
        Master Remote Work Taxes
      </a>
    </div>
  </div>
</BaseLayout>
