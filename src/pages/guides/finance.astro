---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Finance Guides for Remote Workers | FloatJet';
const description = 'Navigate finances as a remote worker or digital nomad. Guides on taxes, international banking, crypto, and managing money while working abroad.';

const mainArticle = {
  title: 'Tax Tips for Remote Workers',
  description: 'Navigate taxes as a remote worker or digital nomad. Understand deductions, international tax obligations, and strategies to optimize your tax situation.',
  href: '/blog/tax-tips-remote-workers',
  readTime: '14 min'
};

const guides = [
  {
    title: 'Best Banking for Digital Nomads',
    description: 'International banks and accounts perfect for location-independent workers.',
    href: '/blog/best-banking-digital-nomads',
    icon: '🏦',
    category: 'Banking',
    readTime: 12
  },
  {
    title: 'Crypto-Friendly Banks',
    description: 'Banks that work well with cryptocurrency for remote workers.',
    href: '/blog/crypto-friendly-banks',
    icon: '₿',
    category: 'Crypto',
    readTime: 10
  }
];

const tips = [
  {title: 'Track Everything', description: 'Keep records of all business expenses', icon: '📝'},
  {title: 'Understand Tax Treaties', description: 'Know how countries share tax information', icon: '🌍'},
  {title: 'Use Multi-Currency Accounts', description: 'Avoid excessive forex fees on transfers', icon: '💱'},
  {title: 'Consult a Professional', description: 'Get expert advice for complex situations', icon: '👨‍💼'}
];
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <!-- Header -->
    <div class="text-center mb-12">
      <a href="/guides" class="inline-flex items-center text-white/60 hover:text-white text-sm mb-4 transition-colors">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        All Guides
      </a>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Finance Guides</h1>
      <p class="text-lg text-white/80 max-w-2xl mx-auto">
        Manage your money wisely as a remote worker, freelancer, or digital nomad.
      </p>
    </div>

    <!-- Main Article Card -->
    <a
        href={mainArticle.href}
        class="block max-w-3xl mx-auto mb-16 group bg-gradient-to-r from-ocean-deep/40 to-jet-stream/20 border border-white/20 hover:border-jet-stream/50 rounded-xl p-8 transition-all duration-300"
    >
      <div class="flex items-center gap-2 mb-4">
        <span class="text-4xl">📊</span>
        <span class="px-3 py-1 bg-jet-stream text-ocean-deep text-xs font-bold rounded-full">Featured Guide</span>
      </div>
      <h2 class="text-2xl md:text-3xl font-bold text-white group-hover:text-jet-stream transition-colors mb-3">
        {mainArticle.title}
      </h2>
      <p class="text-white/70 mb-4">
        {mainArticle.description}
      </p>
      <div class="flex items-center justify-between">
        <span class="text-white/50 text-sm">{mainArticle.readTime} read</span>
        <span class="text-jet-stream font-medium flex items-center">
          Read Full Guide
          <svg class="w-5 h-5 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor"
               viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </span>
      </div>
    </a>

    <!-- More Guides -->
    <div class="mb-12">
      <h2 class="text-xl font-semibold text-white text-center mb-8">Banking & Money Guides</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {guides.map(guide => (
            <a
                href={guide.href}
                class="group bg-black/40 hover:bg-black/50 border border-white/10 hover:border-white/20 rounded-xl p-6 transition-all duration-300"
            >
              <div class="flex items-start gap-4">
                <span class="text-3xl">{guide.icon}</span>
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="inline-block px-2 py-0.5 bg-jet-stream/20 text-jet-stream text-xs font-medium rounded">
                      {guide.category}
                    </span>
                    <span class="text-white/40 text-xs">{guide.readTime} min</span>
                  </div>
                  <h2 class="text-lg font-semibold text-white group-hover:text-jet-stream transition-colors mb-2">
                    {guide.title}
                  </h2>
                  <p class="text-white/70 text-sm">{guide.description}</p>
                </div>
              </div>
              <div class="mt-4 flex items-center text-jet-stream text-sm font-medium">
                Read Guide
                <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </div>
            </a>
        ))}
      </div>
    </div>

    <!-- Tips Section -->
    <div class="max-w-4xl mx-auto">
      <h2 class="text-xl font-semibold text-white text-center mb-8">Money Management Tips</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {tips.map(tip => (
            <div class="flex items-start gap-4 bg-white/5 border border-white/10 rounded-xl p-5">
              <span class="text-2xl">{tip.icon}</span>
              <div>
                <h3 class="text-white font-semibold mb-1">{tip.title}</h3>
                <p class="text-white/60 text-sm">{tip.description}</p>
              </div>
            </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-12 text-center">
      <a
          href={mainArticle.href}
          class="inline-flex items-center justify-center px-6 py-3 bg-jet-stream text-ocean-deep font-semibold rounded-lg hover:bg-sky-light transition-colors"
      >
        Master Remote Work Taxes
      </a>
    </div>
  </div>
</BaseLayout>
