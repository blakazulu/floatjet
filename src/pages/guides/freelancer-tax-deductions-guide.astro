// Related articles
const relatedArticles = [
  {
    title: 'Tax Tips for Remote Workers',
    excerpt: 'Navigate taxes as a remote worker or digital nomad with these essential strategies.',
    href: '/blog/tax-tips-remote-workers',
    image: '/images/unsplash/photo-1554224155-6726b3ff858f-800w.webp',
    imageAlt: 'Tax planning documents'
  },
  {
