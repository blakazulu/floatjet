---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import FAQSection from '@components/article/FAQSection.astro';
import RelatedArticles from '@components/article/RelatedArticles.astro';

// Article metadata
const title = 'How to Run Effective Remote Meetings: A Complete Guide (2025)';
const description = 'Master virtual meeting best practices to boost productivity and reduce meeting fatigue. Learn facilitation techniques, tools, and templates for distributed teams.';
const author = 'FloatJet Team';
const authorUrl = '/about';
const pubDate = new Date('2025-11-24');
const readingTime = 14;
const image = 'https://images.unsplash.com/photo-1609619385002-f40f1df9b7eb?auto=format&fit=crop&w=1200&q=80';
const imageAlt = 'Remote team participating in a productive video conference meeting';

// Table of contents headings
const headings = [
  {text: 'Introduction', slug: 'introduction', depth: 2},
  {text: 'Before the Meeting', slug: 'before-meeting', depth: 2},
  {text: 'Starting Strong', slug: 'starting-strong', depth: 2},
  {text: 'Facilitating Engagement', slug: 'facilitating-engagement', depth: 2},
  {text: 'Managing Different Personalities', slug: 'managing-personalities', depth: 2},
  {text: 'Recording and Notes', slug: 'recording-notes', depth: 2},
  {text: 'Ending with Action Items', slug: 'action-items', depth: 2},
  {text: 'Follow-Up Essentials', slug: 'follow-up', depth: 2},
  {text: 'Tools That Help', slug: 'tools', depth: 2},
  {text: 'Meeting-Free Alternatives', slug: 'alternatives', depth: 2},
  {text: 'FAQ', slug: 'faq', depth: 2},
