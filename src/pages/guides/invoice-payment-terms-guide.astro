// Article metadata
const title = 'Invoice Payment Terms: Net 30 vs Net 15 vs Due on Receipt (2025)';
const description = 'Understand invoice payment terms, choose the right terms for your clients, and get paid faster. Complete guide to Net 30, Net 15, and more.';
const author = 'FloatJet Team';
const authorUrl = '/about';
const pubDate = new Date('2025-11-24');
const readingTime = 10;
const image = 'https://images.unsplash.com/photo-1554224154-26032ffc0d07?auto=format&fit=crop&w=1200&q=80';
const imageAlt = 'Invoice document showing payment terms';

// Table of contents headings
const headings = [
  {text: 'Introduction', slug: 'introduction', depth: 2},
  {text: 'Common Payment Terms', slug: 'payment-terms', depth: 2},
  {text: 'Net 30 vs Net 15', slug: 'net-30-vs-15', depth: 2},
