// FAQ data
const faqs = [
  {
    question: 'What does "Net 30" actually mean?',
    answer: '<p><strong>Net 30</strong> means payment is due within 30 days of the invoice date. "Net" refers to the total amount due, and "30" is the number of days.</p><p>If you invoice on January 1st with Net 30 terms, payment is due by January 31st. Some clients count from receipt date rather than invoice date—clarify this in your contract.</p>'
  },
  {
    question: 'What payment terms should new freelancers use?',
    answer: '<p>For new freelancers, start with shorter terms:</p><ul><li><strong>Net 15</strong> or <strong>Due on Receipt</strong> for new clients</li><li>Require <strong>50% deposit</strong> before starting work</li><li>Consider <strong>milestone payments</strong> for larger projects</li></ul><p>As you build trust and cash reserves, you can offer more flexible terms to valuable clients.</p>'
  },
  {
    question: 'Is it legal to charge late fees?',
    answer: '<p><strong>Yes, but with conditions:</strong></p><ul><li>Late fee terms must be in the contract or clearly stated on the invoice</li><li>Client must be aware of fees before work begins</li><li>Fees must be reasonable (typically 1-1.5% monthly or 10-18% annually)</li><li>Some states cap late fee amounts—check local laws</li></ul><p>Having late fees stated clearly, even if you rarely enforce them, encourages timely payment.</p>'
  },
  {
    question: 'How do I transition existing clients to shorter terms?',
    answer: '<p>Transition respectfully:</p><ol><li>Give advance notice (at least one billing cycle)</li><li>Explain the reason (cash flow management, industry standard)</li><li>Offer a transition period (Net 21 before Net 14)</li><li>Consider grandfathering loyal clients on existing terms</li></ol><p>Frame it positively: "I\'m standardizing my billing to serve you better."</p>'
  },
  {
    question: 'Should I offer early payment discounts?',
    answer: '<p>It depends on your cash flow needs:</p><ul><li><strong>Pros:</strong> Faster payment, improved cash flow, client goodwill</li><li><strong>Cons:</strong> Reduced revenue, may set expectations, can be expensive</li></ul><p>A 2/10 Net 30 discount (2% off if paid in 10 days) equals about 36% annually. Only offer if faster payment is more valuable than the discount cost.</p>'
  },
  {
    question: 'What if a client has their own payment terms?',
    answer: '<p>Large clients often have standard payment policies. Options:</p><ul><li><strong>Accept their terms</strong> if the relationship is valuable</li><li><strong>Negotiate middle ground</strong> (their Net 60 becomes Net 45)</li><li><strong>Adjust pricing</strong> to account for longer payment cycles</li><li><strong>Request deposit</strong> even if remaining balance is on their terms</li></ul><p>Factor longer terms into your cash flow planning if you accept them.</p>'
  },
  {
    question: 'How do payment terms affect my cash flow?',
    answer: '<p>Payment terms directly impact when money arrives:</p><ul><li><strong>Due on Receipt:</strong> Typically paid within 7-14 days</li><li><strong>Net 15:</strong> Cash arrives 15-25 days after invoicing</li><li><strong>Net 30:</strong> Cash arrives 30-45 days after invoicing</li><li><strong>Net 60:</strong> Cash arrives 60-90 days after invoicing</li></ul><p>Plan for worst-case timing. If a client pays Net 30 late, you might wait 45-60 days. Maintain a cash reserve covering 2-3 months of expenses.</p>'
  },
  {
    question: 'Do payment terms apply to retainers?',
    answer: '<p>Retainers typically work differently:</p><ul><li><strong>Pre-paid retainers:</strong> Client pays in advance for hours or services</li><li><strong>Monthly retainers:</strong> Often invoiced 1st of month, due immediately or Net 7</li><li><strong>Post-paid retainers:</strong> Invoiced after work, with standard terms</li></ul><p>Pre-paid retainers offer the best cash flow. Clearly define what happens to unused hours.</p>'
  }
];

// Related articles
const relatedArticles = [
  {
    title: 'Freelancer Tax Deductions Guide',
    excerpt: 'Discover every tax deduction available to freelancers and self-employed workers.',
    href: '/guides/freelancer-tax-deductions-guide',
    image: 'https://images.unsplash.com/photo-1554224155-6726b3ff858f?auto=format&fit=crop&w=800&q=80',
    imageAlt: 'Tax documents'
  },
  {
    title: 'Best Banking for Digital Nomads',
    excerpt: 'Find international-friendly bank accounts for your freelance business.',
    href: '/blog/best-banking-digital-nomads',
    image: 'https://images.unsplash.com/photo-1563013544-824ae1b704d3?auto=format&fit=crop&w=800&q=80',
    imageAlt: 'Digital banking interface'
  },
  {
    title: 'Multi-Currency Banking for Nomads',
    excerpt: 'Manage multiple currencies efficiently with the right accounts and tools.',
    href: '/guides/multi-currency-banking-nomads',
