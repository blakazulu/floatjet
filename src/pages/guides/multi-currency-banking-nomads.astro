        <td class="py-3 px-4">10+ countries</td>
        <td class="py-3 px-4">UK, EU, US</td>
        <td class="py-3 px-4">Germany</td>
        <td class="py-3 px-4">5 countries</td>
      </tr>
      <tr class="border-b border-white/10">
        <td class="py-3 px-4 font-medium">Exchange fee</td>
        <td class="py-3 px-4">0.4-0.6%</td>
        <td class="py-3 px-4">0-1%*</td>
        <td class="py-3 px-4">1.7%</td>
        <td class="py-3 px-4">Up to 2%</td>
      </tr>
      <tr class="border-b border-white/10">
        <td class="py-3 px-4 font-medium">Debit card</td>
        <td class="py-3 px-4">Free</td>
        <td class="py-3 px-4">Free</td>
        <td class="py-3 px-4">Free</td>
        <td class="py-3 px-4">$29.95/year</td>
      </tr>
      <tr class="border-b border-white/10">
        <td class="py-3 px-4 font-medium">US availability</td>
        <td class="py-3 px-4">Yes</td>
        <td class="py-3 px-4">Limited</td>
        <td class="py-3 px-4">No</td>
        <td class="py-3 px-4">Yes</td>
      </tr>
      <tr class="border-b border-white/10">
        <td class="py-3 px-4 font-medium">Best use case</td>
        <td class="py-3 px-4">Payments</td>
        <td class="py-3 px-4">Spending</td>
