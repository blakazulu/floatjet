// Related articles
const relatedArticles = [
  {
    title: 'Best Banking for Digital Nomads',
    excerpt: 'Compare international-friendly banks and accounts for location-independent workers.',
    href: '/blog/best-banking-digital-nomads',
    image: 'https://images.unsplash.com/photo-1563013544-824ae1b704d3?auto=format&fit=crop&w=800&q=80',
