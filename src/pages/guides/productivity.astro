---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Productivity Guides for Remote Workers | FloatJet';
const description = 'Boost your productivity while working remotely. Learn time management, focus techniques, and strategies for distributed teams.';

const mainArticle = {
  title: 'Managing Time Zones in Remote Teams',
  description: 'Strategies for effective collaboration across different time zones. Learn scheduling techniques, async workflows, and tools that help distributed teams thrive.',
  href: '/blog/managing-time-zones-remote-teams',
  readTime: '10 min'
};

const guides = [
  {
    title: 'Async Communication for Remote Teams',
    description: 'Reduce meetings and boost productivity with async communication.',
    href: '/blog/async-communication-remote-teams',
    icon: '💬',
    category: 'Communication'
  }
];

const tips = [
  {title: 'Time Block Your Day', description: 'Dedicate focused hours for deep work', icon: '📅'},
  {title: 'Use World Clocks', description: 'Always know what time it is for teammates', icon: '🌍'},
  {title: 'Set Core Hours', description: 'Establish overlap windows for real-time collaboration', icon: '⏰'},
  {title: 'Batch Similar Tasks', description: 'Group meetings and calls to protect focus time', icon: '📦'}
];
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <!-- Header -->
    <div class="text-center mb-12">
      <a href="/guides" class="inline-flex items-center text-white/60 hover:text-white text-sm mb-4 transition-colors">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        All Guides
      </a>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Productivity Guides</h1>
      <p class="text-lg text-white/80 max-w-2xl mx-auto">
        Work smarter, not harder. Maximize your output while maintaining work-life balance.
      </p>
    </div>

    <!-- Main Article Card -->
    <a
        href={mainArticle.href}
        class="block max-w-3xl mx-auto mb-16 group bg-gradient-to-r from-ocean-deep/40 to-jet-stream/20 border border-white/20 hover:border-jet-stream/50 rounded-xl p-8 transition-all duration-300"
    >
      <div class="flex items-center gap-2 mb-4">
        <span class="text-4xl">🌍</span>
        <span class="px-3 py-1 bg-jet-stream text-ocean-deep text-xs font-bold rounded-full">Featured Guide</span>
      </div>
      <h2 class="text-2xl md:text-3xl font-bold text-white group-hover:text-jet-stream transition-colors mb-3">
        {mainArticle.title}
      </h2>
      <p class="text-white/70 mb-4">
        {mainArticle.description}
      </p>
      <div class="flex items-center justify-between">
        <span class="text-white/50 text-sm">{mainArticle.readTime} read</span>
        <span class="text-jet-stream font-medium flex items-center">
          Read Full Guide
          <svg class="w-5 h-5 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor"
               viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </span>
      </div>
    </a>

    <!-- More Guides -->
    <div class="max-w-4xl mx-auto mb-16">
      <h2 class="text-xl font-semibold text-white text-center mb-8">Related Guides</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {guides.map(guide => (
            <a
                href={guide.href}
                class="group flex items-start gap-4 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 rounded-xl p-5 transition-all duration-300"
            >
              <span class="text-3xl">{guide.icon}</span>
              <div class="flex-1">
              <span class="inline-block px-2 py-0.5 bg-jet-stream/20 text-jet-stream text-xs font-medium rounded mb-2">
                {guide.category}
              </span>
                <h3 class="text-white font-semibold group-hover:text-jet-stream transition-colors mb-1">
                  {guide.title}
                </h3>
                <p class="text-white/60 text-sm">{guide.description}</p>
              </div>
            </a>
        ))}
      </div>
    </div>

    <!-- Tips Section -->
    <div class="max-w-4xl mx-auto">
      <h2 class="text-xl font-semibold text-white text-center mb-8">Productivity Tips</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {tips.map(tip => (
            <div class="flex items-start gap-4 bg-white/5 border border-white/10 rounded-xl p-5">
              <span class="text-2xl">{tip.icon}</span>
              <div>
                <h3 class="text-white font-semibold mb-1">{tip.title}</h3>
                <p class="text-white/60 text-sm">{tip.description}</p>
              </div>
            </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-12 text-center">
      <a
          href={mainArticle.href}
          class="inline-flex items-center justify-center px-6 py-3 bg-jet-stream text-ocean-deep font-semibold rounded-lg hover:bg-sky-light transition-colors"
      >
        Master Time Zone Management
      </a>
    </div>
  </div>
</BaseLayout>
