---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Productivity Guides for Remote Workers | FloatJet";
const description =
  "Boost your productivity while working remotely. Learn time management, focus techniques, and strategies for distributed teams without burning out completely.";

const mainArticle = {
  title: "Managing Time Zones in Remote Teams",
  description:
    "Strategies for effective collaboration across different time zones. Learn scheduling techniques, async workflows, and tools that help distributed teams thrive.",
  href: "/blog/managing-time-zones-remote-teams",
  readTime: "10 min",
};

const guides = [
  {
    title: "Pomodoro Technique for Remote Workers",
    description: "Master the classic focus technique adapted for remote work environments.",
    href: "/guides/pomodoro-technique-remote-workers",
    icon: "🍅",
    category: "Productivity",
    readTime: 12,
  },
  {
    title: "How to Stay Focused Working from Home",
    description: "Eliminate distractions and maintain concentration throughout your workday.",
    href: "/guides/how-to-stay-focused-working-from-home",
    icon: "🎯",
    category: "Productivity",
    readTime: 11,
  },
  {
    title: "Building a Morning Routine for Remote Work",
    description: "Create the perfect morning routine to start each day productively.",
    href: "/guides/morning-routine-remote-work",
    icon: "🌅",
    category: "Productivity",
    readTime: 11,
  },
  {
    title: "Time Blocking vs Time Tracking",
    description: "Compare two powerful time management methods for remote work.",
    href: "/guides/time-blocking-vs-time-tracking",
    icon: "⏰",
    category: "Productivity",
    readTime: 9,
  },
  {
    title: "Internet Speed for Remote Work",
    description: "What speeds do you really need for video calls and cloud apps?",
    href: "/guides/internet-speed-remote-work",
    icon: "📶",
    category: "Productivity",
    readTime: 7,
  },
  {
    title: "Async Communication for Remote Teams",
    description: "Reduce meetings and boost productivity with async communication.",
    href: "/blog/async-communication-remote-teams",
    icon: "💬",
    category: "Communication",
    readTime: 12,
  },
];

const tips = [
  { title: "Time Block Your Day", description: "Dedicate focused hours for deep work", icon: "📅" },
  {
    title: "Use World Clocks",
    description: "Always know what time it is for teammates",
    icon: "🌍",
  },
  {
    title: "Set Core Hours",
    description: "Establish overlap windows for real-time collaboration",
    icon: "⏰",
  },
  {
    title: "Batch Similar Tasks",
    description: "Group meetings and calls to protect focus time",
    icon: "📦",
  },
];
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <!-- Header -->
    <div class="text-center mb-12">
      <a href="/guides" class="inline-flex items-center text-white/60 hover:text-white text-sm mb-4 transition-colors">
        <svg class="w-4 h-4 mr-1" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg>
        All Guides
      </a>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Productivity Guides</h1>
      <p class="text-lg text-white/80 max-w-2xl mx-auto">
        Work smarter, not harder. Maximize your output while maintaining work-life balance.
      </p>
    </div>

    <!-- Main Article Card -->
    <a
        href={mainArticle. Href}
        class="block max-w-3xl mx-auto mb-16 group bg-gradient-to-r from-ocean-deep/40 to-jet-stream/20 border border-white/20 hover:border-jet-stream/50 rounded-xl p-8 transition-all duration-300"
    >
      <div class="flex items-center gap-2 mb-4">
        <span class="text-4xl">🌍</span>
        <span class="px-3 py-1 bg-jet-stream text-ocean-deep text-xs font-bold rounded-full">Featured Guide</span>
      </div>
      <h2 class="text-2xl md:text-3xl font-bold text-white group-hover:text-jet-stream transition-colors mb-3">
        {mainArticle. Title}
      </h2>
      <p class="text-white/70 mb-4">
        {mainArticle. Description}
      </p>
      <div class="flex items-center justify-between">
        <span class="text-white/50 text-sm">{mainArticle. ReadTime} read</span>
        <span class="text-jet-stream font-medium flex items-center">
          Read Full Guide
          <svg class="w-5 h-5 ml-1 group-hover:translate-x-1 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
        </span>
      </div>
    </a>

    <!-- More Guides -->
    <div class="mb-12">
      <h2 class="text-xl font-semibold text-white text-center mb-8">Related Guides</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {guides. Map(guide => (
            <a
                href={guide. Href}
                class="group bg-black/40 hover:bg-black/50 border border-white/10 hover:border-white/20 rounded-xl p-6 transition-all duration-300"
            >
              <div class="flex items-start gap-4">
                <span class="text-3xl">{guide. Icon}</span>
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="inline-block px-2 py-0.5 bg-jet-stream/20 text-jet-stream text-xs font-medium rounded">
                      {guide. Category}
                    </span>
                    <span class="text-white/40 text-xs">{guide. ReadTime} min</span>
                  </div>
                  <h2 class="text-lg font-semibold text-white group-hover:text-jet-stream transition-colors mb-2">
                    {guide. Title}
                  </h2>
                  <p class="text-white/70 text-sm">{guide. Description}</p>
                </div>
              </div>
              <div class="mt-4 flex items-center text-jet-stream text-sm font-medium">
                Read Guide
                <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
              </div>
            </a>
        ))}
      </div>
    </div>

    <!-- Tips Section -->
    <div class="max-w-4xl mx-auto">
      <h2 class="text-xl font-semibold text-white text-center mb-8">Productivity Tips</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {tips. Map(tip => (
            <div class="flex items-start gap-4 bg-white/5 border border-white/10 rounded-xl p-5">
              <span class="text-2xl">{tip. Icon}</span>
              <div>
                <h3 class="text-white font-semibold mb-1">{tip. Title}</h3>
                <p class="text-white/60 text-sm">{tip. Description}</p>
              </div>
            </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-12 text-center">
      <a
          href={mainArticle. Href}
          class="inline-flex items-center justify-center px-6 py-3 bg-jet-stream text-ocean-deep font-semibold rounded-lg hover:bg-sky-light transition-colors"
      >
        Master Time Zone Management
      </a>
    </div>
  </div>
</BaseLayout>
