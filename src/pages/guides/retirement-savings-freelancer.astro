---

<ArticleLayout
    title={title}
    description={description}
    author={author}
    authorUrl={authorUrl}
    pubDate={pubDate}
    readingTime={readingTime}
    image={image}
    imageAlt={imageAlt}
    category="Finance"
    categorySlug="guides/finance"
