---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Security Guides for Remote Workers | FloatJet";
const description =
  "Protect yourself online while working remotely. Learn about VPNs, secure connections, password management, and cybersecurity practices without complexity.";

const mainArticle = {
  title: "VPN & Public WiFi Security",
  description:
    "Essential cybersecurity practices for working from anywhere. Learn how to stay safe on public networks and protect your data while traveling.",
  href: "/blog/vpn-public-wifi-guide",
  readTime: "13 min",
};

const guides = [
  {
    title: "Two-Factor Authentication Setup Guide",
    description: "Step-by-step guide to enabling 2FA on all your accounts for maximum security.",
    href: "/guides/two-factor-authentication-guide",
    icon: "📱",
    category: "Security",
    readTime: 14,
  },
  {
    title: "How to Secure Your Home WiFi Network",
    description: "Lock down your home network with proper router settings and encryption.",
    href: "/guides/secure-home-wifi-network",
    icon: "📶",
    category: "Security",
    readTime: 13,
  },
  {
    title: "Phishing Scams: How Remote Workers Can Stay Safe",
    description: "Learn to identify and avoid phishing attacks targeting remote workers.",
    href: "/guides/phishing-scams-remote-workers",
    icon: "🎣",
    category: "Security",
    readTime: 11,
  },
  {
    title: "VPN vs Proxy: Which is Better for Remote Work?",
    description: "Understand the key differences and why VPNs are essential for remote work.",
    href: "/guides/vpn-vs-proxy-remote-work",
    icon: "⚖️",
    category: "Security",
    readTime: 9,
  },
  {
    title: "Do I Need a VPN When Working from Cafes?",
    description: "Short answer: yes. Learn why VPNs are essential for public WiFi security.",
    href: "/guides/do-i-need-vpn-cafes",
    icon: "☕",
    category: "Security",
    readTime: 7,
  },
  {
    title: "VPN Speed Comparison",
    description: "Find the fastest VPN that does not slow down your work.",
    href: "/blog/vpn-speed-comparison",
    icon: "⚡",
    category: "Performance",
    readTime: 10,
  },
  {
    title: "Best VPN for Digital Nomads",
    description: "Top VPN services compared for remote workers and travelers.",
    href: "/tools/best-vpn-digital-nomads",
    icon: "🔐",
    category: "Tools",
    readTime: 15,
  },
  {
    title: "Best Password Managers",
    description: "Secure your accounts with the right password manager.",
    href: "/tools/best-password-manager-remote-work",
    icon: "🔑",
    category: "Tools",
    readTime: 14,
  },
];

const tips = [
  {
    title: "Always Use a VPN",
    description: "Encrypt your connection on public networks",
    icon: "🛡️",
  },
  {
    title: "Enable 2FA Everywhere",
    description: "Add extra protection to all accounts",
    icon: "📱",
  },
  { title: "Update Regularly", description: "Keep devices and software patched", icon: "🔄" },
  { title: "Use Unique Passwords", description: "Never reuse passwords across sites", icon: "🔑" },
];
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <!-- Header -->
    <div class="text-center mb-12">
      <a href="/guides" class="inline-flex items-center text-white/60 hover:text-white text-sm mb-4 transition-colors">
        <svg class="w-4 h-4 mr-1" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg>
        All Guides
      </a>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Security Guides</h1>
      <p class="text-lg text-white/80 max-w-2xl mx-auto">
        Stay safe online with essential cybersecurity practices for remote workers.
      </p>
    </div>

    <!-- Main Article Card -->
    <a
        href={mainArticle. Href}
        class="block max-w-3xl mx-auto mb-16 group bg-gradient-to-r from-ocean-deep/40 to-jet-stream/20 border border-white/20 hover:border-jet-stream/50 rounded-xl p-8 transition-all duration-300"
    >
      <div class="flex items-center gap-2 mb-4">
        <span class="text-4xl">🔐</span>
        <span class="px-3 py-1 bg-jet-stream text-ocean-deep text-xs font-bold rounded-full">Featured Guide</span>
      </div>
      <h2 class="text-2xl md:text-3xl font-bold text-white group-hover:text-jet-stream transition-colors mb-3">
        {mainArticle. Title}
      </h2>
      <p class="text-white/70 mb-4">
        {mainArticle. Description}
      </p>
      <div class="flex items-center justify-between">
        <span class="text-white/50 text-sm">{mainArticle. ReadTime} read</span>
        <span class="text-jet-stream font-medium flex items-center">
          Read Full Guide
          <svg class="w-5 h-5 ml-1 group-hover:translate-x-1 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
        </span>
      </div>
    </a>

    <!-- More Guides -->
    <div class="mb-12">
      <h2 class="text-xl font-semibold text-white text-center mb-8">More Security Resources</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {guides. Map(guide => (
            <a
                href={guide. Href}
                class="group bg-black/40 hover:bg-black/50 border border-white/10 hover:border-white/20 rounded-xl p-6 transition-all duration-300"
            >
              <div class="flex items-start gap-4">
                <span class="text-3xl">{guide. Icon}</span>
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="inline-block px-2 py-0.5 bg-jet-stream/20 text-jet-stream text-xs font-medium rounded">
                      {guide. Category}
                    </span>
                    <span class="text-white/40 text-xs">{guide. ReadTime} min</span>
                  </div>
                  <h2 class="text-lg font-semibold text-white group-hover:text-jet-stream transition-colors mb-2">
                    {guide. Title}
                  </h2>
                  <p class="text-white/70 text-sm">{guide. Description}</p>
                </div>
              </div>
              <div class="mt-4 flex items-center text-jet-stream text-sm font-medium">
                Read Guide
                <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
              </div>
            </a>
        ))}
      </div>
    </div>

    <!-- Tips Section -->
    <div class="max-w-4xl mx-auto">
      <h2 class="text-xl font-semibold text-white text-center mb-8">Security Essentials</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {tips. Map(tip => (
            <div class="flex items-start gap-4 bg-white/5 border border-white/10 rounded-xl p-5">
              <span class="text-2xl">{tip. Icon}</span>
              <div>
                <h3 class="text-white font-semibold mb-1">{tip. Title}</h3>
                <p class="text-white/60 text-sm">{tip. Description}</p>
              </div>
            </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-12 text-center">
      <a
          href={mainArticle. Href}
          class="inline-flex items-center justify-center px-6 py-3 bg-jet-stream text-ocean-deep font-semibold rounded-lg hover:bg-sky-light transition-colors"
      >
        Learn WiFi Security
      </a>
    </div>
  </div>
</BaseLayout>
