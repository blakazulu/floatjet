---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Home Office Setup Guides | FloatJet";
const description =
  "Build the perfect remote work setup. Guides on ergonomic furniture, essential gear, and creating a productive home office without blowing your entire budget.";

const mainArticle = {
  title: "Ultimate Home Office Setup",
  description:
    "Build the perfect home office on any budget. From ergonomic essentials to productivity-boosting gear, everything you need for a professional remote workspace.",
  href: "/blog/ultimate-home-office-setup",
  readTime: "11 min",
};

const guides = [
  {
    title: "Complete Home Office Checklist",
    description: "The ultimate checklist from furniture to tech, lighting, and ergonomics.",
    href: "/guides/complete-home-office-checklist",
    icon: "📋",
    category: "Setup",
    readTime: 16,
  },
  {
    title: "Minimalist Home Office Setup",
    description: "Create a clean, distraction-free workspace with minimal gear.",
    href: "/guides/minimalist-home-office-setup",
    icon: "✨",
    category: "Setup",
    readTime: 12,
  },
  {
    title: "Budget Home Office Under $500",
    description: "Build a complete, comfortable workspace without breaking the bank.",
    href: "/guides/budget-home-office-setup-500",
    icon: "💰",
    category: "Setup",
    readTime: 14,
  },
  {
    title: "Cable Management Guide",
    description: "Tame the wire chaos and keep your desk clean and organized.",
    href: "/guides/cable-management-guide",
    icon: "🔌",
    category: "Setup",
    readTime: 11,
  },
  {
    title: "Personal Laptop for Remote Work",
    description: "Can you use your own device? BYOD policies, security, and setup tips.",
    href: "/guides/personal-laptop-remote-work",
    icon: "💻",
    category: "Setup",
    readTime: 13,
  },
  {
    title: "Best Standing Desks",
    description: "Top standing desks for health and productivity.",
    href: "/gear/best-standing-desks",
    icon: "🪑",
    category: "Furniture",
    readTime: 16,
  },
  {
    title: "Best Laptops for Remote Work",
    description: "Find the perfect laptop for working from anywhere.",
    href: "/gear/best-laptops-remote-work",
    icon: "🖥️",
    category: "Hardware",
    readTime: 18,
  },
  {
    title: "Best Noise-Canceling Headphones",
    description: "Block distractions and focus on your work.",
    href: "/gear/best-noise-canceling-headphones",
    icon: "🎧",
    category: "Audio",
    readTime: 14,
  },
];

const tips = [
  {
    title: "Ergonomics First",
    description: "Invest in a good chair and proper desk height",
    icon: "🪑",
  },
  {
    title: "Natural Light",
    description: "Position your desk near windows when possible",
    icon: "☀️",
  },
  {
    title: "Declutter Your Space",
    description: "A clean desk promotes clear thinking",
    icon: "✨",
  },
  {
    title: "Cable Management",
    description: "Organize cables for a cleaner, safer setup",
    icon: "🔌",
  },
];
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <!-- Header -->
    <div class="text-center mb-12">
      <a href="/guides" class="inline-flex items-center text-white/60 hover:text-white text-sm mb-4 transition-colors">
        <svg class="w-4 h-4 mr-1" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg>
        All Guides
      </a>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Setup Guides</h1>
      <p class="text-lg text-white/80 max-w-2xl mx-auto">
        Create your ideal remote work environment for maximum comfort and productivity.
      </p>
    </div>

    <!-- Main Article Card -->
    <a
        href={mainArticle. Href}
        class="block max-w-3xl mx-auto mb-16 group bg-gradient-to-r from-ocean-deep/40 to-jet-stream/20 border border-white/20 hover:border-jet-stream/50 rounded-xl p-8 transition-all duration-300"
    >
      <div class="flex items-center gap-2 mb-4">
        <span class="text-4xl">🏠</span>
        <span class="px-3 py-1 bg-jet-stream text-ocean-deep text-xs font-bold rounded-full">Featured Guide</span>
      </div>
      <h2 class="text-2xl md:text-3xl font-bold text-white group-hover:text-jet-stream transition-colors mb-3">
        {mainArticle. Title}
      </h2>
      <p class="text-white/70 mb-4">
        {mainArticle. Description}
      </p>
      <div class="flex items-center justify-between">
        <span class="text-white/50 text-sm">{mainArticle. ReadTime} read</span>
        <span class="text-jet-stream font-medium flex items-center">
          Read Full Guide
          <svg class="w-5 h-5 ml-1 group-hover:translate-x-1 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
        </span>
      </div>
    </a>

    <!-- More Guides -->
    <div class="mb-12">
      <h2 class="text-xl font-semibold text-white text-center mb-8">Essential Gear Guides</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {guides. Map(guide => (
            <a
                href={guide. Href}
                class="group bg-black/40 hover:bg-black/50 border border-white/10 hover:border-white/20 rounded-xl p-6 transition-all duration-300"
            >
              <div class="flex items-start gap-4">
                <span class="text-3xl">{guide. Icon}</span>
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="inline-block px-2 py-0.5 bg-jet-stream/20 text-jet-stream text-xs font-medium rounded">
                      {guide. Category}
                    </span>
                    <span class="text-white/40 text-xs">{guide. ReadTime} min</span>
                  </div>
                  <h2 class="text-lg font-semibold text-white group-hover:text-jet-stream transition-colors mb-2">
                    {guide. Title}
                  </h2>
                  <p class="text-white/70 text-sm">{guide. Description}</p>
                </div>
              </div>
              <div class="mt-4 flex items-center text-jet-stream text-sm font-medium">
                Read Guide
                <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
              </div>
            </a>
        ))}
      </div>
    </div>

    <!-- Tips Section -->
    <div class="max-w-4xl mx-auto">
      <h2 class="text-xl font-semibold text-white text-center mb-8">Setup Tips</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {tips. Map(tip => (
            <div class="flex items-start gap-4 bg-white/5 border border-white/10 rounded-xl p-5">
              <span class="text-2xl">{tip. Icon}</span>
              <div>
                <h3 class="text-white font-semibold mb-1">{tip. Title}</h3>
                <p class="text-white/60 text-sm">{tip. Description}</p>
              </div>
            </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-12 text-center">
      <a
          href={mainArticle. Href}
          class="inline-flex items-center justify-center px-6 py-3 bg-jet-stream text-ocean-deep font-semibold rounded-lg hover:bg-sky-light transition-colors"
      >
        Build Your Perfect Setup
      </a>
    </div>
  </div>
</BaseLayout>
