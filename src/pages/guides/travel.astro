---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Travel Guides for Digital Nomads | FloatJet';
const description = 'Essential travel guides for digital nomads and remote workers. Find the best destinations, travel tech, and tips for working abroad without visa headaches.';

const mainArticle = {
  title: 'Top Destinations for Digital Nomads (2025)',
  description: 'We researched visa policies, cost of living, WiFi speeds, and nomad communities in 30+ countries to find the best places to work remotely.',
  href: '/blog/top-destinations-digital-nomads',
  readTime: '20 min'
};

const travelGuides = [
  {
    title: 'Portugal Digital Nomad Visa Guide',
    description: 'Complete guide to working legally from Portugal with the digital nomad visa.',
    href: '/guides/digital-nomad-visa-portugal',
    icon: '🇵🇹',
    category: 'Travel',
    readTime: 15
  },
  {
    title: 'Spain Digital Nomad Visa Guide',
    description: 'Everything about Spain\'s visa including Beckham Law tax benefits.',
    href: '/guides/digital-nomad-visa-spain',
    icon: '🇪🇸',
    category: 'Travel',
    readTime: 14
  },
  {
    title: 'Best Coworking Spaces in Lisbon',
    description: 'Top coworking spaces for digital nomads in Portugal\'s capital.',
    href: '/guides/best-coworking-spaces-lisbon',
    icon: '💼',
    category: 'Travel',
    readTime: 13
  },
  {
    title: 'Working Across Time Zones',
    description: 'Master working with teams in different time zones while traveling.',
    href: '/guides/work-remotely-different-time-zones',
    icon: '🌍',
    category: 'Travel',
    readTime: 12
  },
  {
    title: 'Can You Work Remotely from Another Country?',
    description: 'Legal guide to visa requirements and tax implications.',
    href: '/guides/can-you-work-remotely-another-country',
    icon: '⚖️',
    category: 'Travel',
    readTime: 10
  },
  {
    title: 'Essential Travel Tech for Nomads',
    description: 'The must-have gadgets and gear for productive travel.',
    href: '/blog/essential-travel-tech-nomads',
    icon: '🎒',
    category: 'Gear',
    readTime: 10
  },
  {
    title: 'Best Travel Insurance',
    description: 'Protect yourself abroad with insurance built for remote workers.',
    href: '/blog/best-travel-insurance-remote-workers',
    icon: '🛡️',
    category: 'Insurance',
    readTime: 11
  },
  {
    title: 'Find Reliable WiFi Anywhere',
    description: 'Tips and tools for finding fast, stable internet while traveling.',
    href: '/blog/find-reliable-wifi-anywhere',
    icon: '📶',
    category: 'Connectivity',
    readTime: 9
  },
  {
    title: 'VPN & Public WiFi Security',
    description: 'Stay safe on public networks with these essential security practices.',
    href: '/blog/vpn-public-wifi-guide',
    icon: '🔐',
    category: 'Security',
    readTime: 13
  }
];

const topDestinations = [
  {name: 'Lisbon', tag: 'Europe', color: 'bg-blue-500/20 text-blue-400'},
  {name: 'Bali', tag: 'Asia', color: 'bg-green-500/20 text-green-400'},
  {name: 'Mexico City', tag: 'Americas', color: 'bg-purple-500/20 text-purple-400'}
];

const travelTips = [
  {title: 'Visa Research', description: 'Know entry requirements and digital nomad visa options', icon: '📄'},
  {title: 'Cost of Living', description: 'Budget for accommodation, food, coworking, and more', icon: '💰'},
  {title: 'Time Zone Planning', description: 'Manage client calls across different time zones', icon: '🌍'},
  {title: 'Community Finding', description: 'Connect with other nomads and build your network', icon: '👥'}
];
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <!-- Header -->
    <div class="text-center mb-12">
      <a href="/guides" class="inline-flex items-center text-white/60 hover:text-white text-sm mb-4 transition-colors">
        <svg class="w-4 h-4 mr-1" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg>
        All Guides
      </a>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Travel Guides</h1>
      <p class="text-lg text-white/80 max-w-2xl mx-auto">
        Everything you need to work and travel the world as a digital nomad.
      </p>
    </div>

    <!-- Main Article Card -->
    <a
        href={mainArticle.href}
        class="block max-w-3xl mx-auto mb-12 group bg-gradient-to-r from-ocean-deep/40 to-jet-stream/20 border border-white/20 hover:border-jet-stream/50 rounded-xl p-8 transition-all duration-300"
    >
      <div class="flex items-center gap-2 mb-4">
        <span class="text-4xl">✈️</span>
        <span class="px-3 py-1 bg-jet-stream text-ocean-deep text-xs font-bold rounded-full">Featured Guide</span>
      </div>
      <h2 class="text-2xl md:text-3xl font-bold text-white group-hover:text-jet-stream transition-colors mb-3">
        {mainArticle.title}
      </h2>
      <p class="text-white/70 mb-4">
        {mainArticle.description}
      </p>
      <div class="flex items-center justify-between">
        <span class="text-white/50 text-sm">{mainArticle.readTime} read</span>
        <span class="text-jet-stream font-medium flex items-center">
          Read Full Guide
          <svg class="w-5 h-5 ml-1 group-hover:translate-x-1 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
        </span>
      </div>
    </a>

    <!-- Top Destinations Preview -->
    <div class="max-w-3xl mx-auto mb-12">
      <h2 class="text-xl font-semibold text-white text-center mb-6">Popular Destinations</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {topDestinations.map(dest => (
            <a
                href={`${mainArticle.href}#${dest.name.toLowerCase().replace(' ', '-')}`}
                class="bg-white/5 hover:bg-white/10 border border-white/10 rounded-lg p-4 text-center transition-colors"
            >
            <span class={`inline-block px-2 py-0.5 ${dest.color} text-xs font-medium rounded mb-2`}>
              {dest.tag}
            </span>
              <p class="text-white font-semibold">{dest.name}</p>
            </a>
        ))}
      </div>
    </div>

    <!-- More Travel Guides -->
    <div class="mb-12">
      <h2 class="text-xl font-semibold text-white text-center mb-8">Essential Travel Guides</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {travelGuides.map(guide => (
            <a
                href={guide.href}
                class="group bg-black/40 hover:bg-black/50 border border-white/10 hover:border-white/20 rounded-xl p-6 transition-all duration-300"
            >
              <div class="flex items-start gap-4">
                <span class="text-3xl flex-shrink-0">{guide.icon}</span>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="inline-block px-2 py-0.5 bg-jet-stream/20 text-jet-stream text-xs font-medium rounded">
                      {guide.category}
                    </span>
                    <span class="text-white/40 text-xs">{guide.readTime} min</span>
                  </div>
                  <h2 class="text-lg font-semibold text-white group-hover:text-jet-stream transition-colors mb-2">
                    {guide.title}
                  </h2>
                  <p class="text-white/70 text-sm">{guide.description}</p>
                </div>
              </div>
              <div class="mt-4 flex items-center text-jet-stream text-sm font-medium">
                Read Guide
                <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
              </div>
            </a>
        ))}
      </div>
    </div>

    <!-- Travel Planning Tips -->
    <div class="max-w-4xl mx-auto mb-12">
      <h2 class="text-xl font-semibold text-white text-center mb-8">Before You Go</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {travelTips.map(tip => (
            <div class="flex items-start gap-4 bg-white/5 border border-white/10 rounded-xl p-5">
              <span class="text-2xl">{tip.icon}</span>
              <div>
                <h3 class="text-white font-semibold mb-1">{tip.title}</h3>
                <p class="text-white/60 text-sm">{tip.description}</p>
              </div>
            </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-12 text-center">
      <a
          href={mainArticle.href}
          class="inline-flex items-center justify-center px-6 py-3 bg-jet-stream text-ocean-deep font-semibold rounded-lg hover:bg-sky-light transition-colors"
      >
        Explore Top Destinations
      </a>
    </div>
  </div>
</BaseLayout>
