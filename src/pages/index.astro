---
// FloatJet Test Homepage
import '@styles/global.css';

const title = 'FloatJet - Find the Best Remote Work Tools';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-off-white">
    <!-- Hero Section - Testing FloatJet Theme -->
    <section class="min-h-screen py-12 px-4 md:py-20">
      <div class="max-w-screen-xl mx-auto">

        <!-- Heading - Testing Outfit Font & Ocean Deep Color -->
        <h1 class="text-4xl md:text-6xl font-bold text-ocean-deep mb-6">
          FloatJet Theme Test
        </h1>

        <!-- Subheading - Testing Inter Font & Slate Color -->
        <p class="text-lg md:text-xl text-slate mb-12 max-w-2xl">
          Testing the FloatJet design system with custom colors, typography, and Tailwind CSS configuration.
        </p>

        <!-- Color Palette Showcase -->
        <div class="mb-12">
          <h2 class="text-2xl md:text-3xl font-semibold text-ocean-deep mb-6">
            Color Palette
          </h2>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
            <!-- Ocean Deep -->
            <div class="space-y-2">
              <div class="h-24 bg-ocean-deep rounded-xl shadow-md"></div>
              <p class="text-sm font-medium">Ocean Deep</p>
              <code class="text-xs text-gray">#0F4C5C</code>
            </div>

            <!-- Jet Stream -->
            <div class="space-y-2">
              <div class="h-24 bg-jet-stream rounded-xl shadow-md"></div>
              <p class="text-sm font-medium">Jet Stream</p>
              <code class="text-xs text-gray">#38A3A5</code>
            </div>

            <!-- Sky Light -->
            <div class="space-y-2">
              <div class="h-24 bg-sky-light rounded-xl shadow-md"></div>
              <p class="text-sm font-medium">Sky Light</p>
              <code class="text-xs text-gray">#80CED7</code>
            </div>

            <!-- Sand -->
            <div class="space-y-2">
              <div class="h-24 bg-sand rounded-xl shadow-md border border-gray/20"></div>
              <p class="text-sm font-medium">Sand</p>
              <code class="text-xs text-gray">#E0FBFC</code>
            </div>

            <!-- Alert -->
            <div class="space-y-2">
              <div class="h-24 bg-alert rounded-xl shadow-md"></div>
              <p class="text-sm font-medium">Alert</p>
              <code class="text-xs text-gray">#EE6C4D</code>
            </div>
          </div>
        </div>

        <!-- Button Components -->
        <div class="mb-12">
          <h2 class="text-2xl md:text-3xl font-semibold text-ocean-deep mb-6">
            Button Styles
          </h2>
          <div class="flex flex-wrap gap-4">
            <button class="px-6 py-3 bg-jet-stream text-white rounded-full font-medium shadow-md hover:shadow-lg transition-shadow">
              Primary Button
            </button>
            <button class="px-6 py-3 bg-transparent border-2 border-jet-stream text-jet-stream rounded-full font-medium hover:bg-jet-stream hover:text-white transition-colors">
              Secondary Button
            </button>
            <button class="px-6 py-3 bg-alert text-white rounded-full font-medium shadow-md hover:shadow-lg transition-shadow">
              Alert Button
            </button>
          </div>
        </div>

        <!-- Typography Showcase -->
        <div class="mb-12">
          <h2 class="text-2xl md:text-3xl font-semibold text-ocean-deep mb-6">
            Typography
          </h2>
          <div class="space-y-4 max-w-3xl">
            <h1 class="text-4xl md:text-5xl font-bold">Heading 1 - Outfit Bold</h1>
            <h2 class="text-3xl md:text-4xl font-semibold">Heading 2 - Outfit SemiBold</h2>
            <h3 class="text-2xl md:text-3xl font-semibold">Heading 3 - Outfit SemiBold</h3>
            <p class="text-base md:text-lg text-slate">
              Body text uses Inter for superior readability. This paragraph demonstrates the Inter font family at regular weight (400) with relaxed line height for comfortable reading.
            </p>
            <code class="block p-4 bg-slate text-sand rounded-lg font-mono text-sm">
              const greeting = 'Code uses JetBrains Mono';
            </code>
          </div>
        </div>

        <!-- Glassmorphism Card -->
        <div class="mb-12">
          <h2 class="text-2xl md:text-3xl font-semibold text-ocean-deep mb-6">
            Glassmorphism Effect
          </h2>
          <div class="relative h-64 bg-gradient-to-br from-jet-stream to-sky-light rounded-2xl overflow-hidden">
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="glass-morphism p-8 rounded-2xl max-w-md">
                <h3 class="text-xl font-semibold text-ocean-deep mb-2">
                  Glass Card
                </h3>
                <p class="text-slate">
                  This card demonstrates the glassmorphism effect with backdrop blur and semi-transparent background.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Mobile-First Responsive Grid -->
        <div class="mb-12">
          <h2 class="text-2xl md:text-3xl font-semibold text-ocean-deep mb-6">
            Responsive Grid (Mobile-First)
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="bg-white p-6 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
              <h3 class="text-lg font-semibold text-jet-stream mb-2">Card 1</h3>
              <p class="text-gray">Mobile: 1 column, Tablet: 2 columns, Desktop: 3 columns</p>
            </div>
            <div class="bg-white p-6 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
              <h3 class="text-lg font-semibold text-jet-stream mb-2">Card 2</h3>
              <p class="text-gray">Demonstrates mobile-first responsive breakpoints</p>
            </div>
            <div class="bg-white p-6 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
              <h3 class="text-lg font-semibold text-jet-stream mb-2">Card 3</h3>
              <p class="text-gray">Using Tailwind's md: and lg: modifiers</p>
            </div>
          </div>
        </div>

        <!-- Status Message -->
        <div class="bg-sand border border-jet-stream/20 p-6 rounded-2xl">
          <h3 class="text-lg font-semibold text-ocean-deep mb-2">
            ✅ FloatJet Theme Configured Successfully
          </h3>
          <p class="text-slate mb-4">
            All custom colors, fonts, and design tokens are working correctly. The mobile-first approach is verified with responsive breakpoints.
          </p>
          <ul class="space-y-2 text-sm text-gray">
            <li>✓ Custom colors (Ocean Deep, Jet Stream, Sky Light, Sand, Alert)</li>
            <li>✓ Typography (Outfit, Inter, JetBrains Mono via Google Fonts)</li>
            <li>✓ Tailwind CSS v4 with @theme configuration</li>
            <li>✓ Glassmorphism utility class</li>
            <li>✓ Mobile-first responsive design (375px → 1280px)</li>
            <li>✓ TypeScript strict mode + Path aliases</li>
          </ul>
        </div>

      </div>
    </section>
  </body>
</html>
