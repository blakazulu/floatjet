---
import ArticleCarousel from "../components/ArticleCarousel.astro";
import CategorySelector from "../components/CategorySelector.astro";
import FeaturedContent from "../components/FeaturedContent.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "FloatJet | Tools & Resources for Remote Professionals";
const description =
  "Discover the best software, gear, and strategies to work efficiently from anywhere. Expert reviews on VPNs, project management tools, and home office setups.";
---

<BaseLayout title={title} description={description}>
  <h1 class="font-heading text-2xl md:text-3xl font-bold text-white text-center pt-24 md:pt-28 px-4 overflow-hidden">
    <span id="rotating-headline" class="inline-block headline-visible">
      Work From Anywhere, Like a Pro
    </span>
  </h1>

  <style>
    #rotating-headline {
      transition: all 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    }

    . Headline-visible {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }

    . Headline-exit {
      opacity: 0;
      transform: translateY(-30px) scale(0.95);
      filter: blur(8px);
    }

    . Headline-enter {
      opacity: 0;
      transform: translateY(30px) scale(0.95);
      filter: blur(8px);
    }
  </style>

  <script is:inline>
    // Headline rotation with proper cleanup for View Transitions

    if (!window.__headlineInit) {
      window.__headlineInit = true;
      window.__headlineInterval = null;

      function cleanupHeadlineRotation() {
        if (window.__headlineInterval) {
          clearInterval(window.__headlineInterval);
          window.__headlineInterval = null;
        }
      }

      function initHeadlineRotation() {
        // Clean up first
        cleanupHeadlineRotation();

        // Check if element exists on this page
        var element = document. GetElementById('rotating-headline');
        if (!element) return;

        var headlines = [
          'Work From Anywhere, Like a Pro',
          'Your Remote Work Toolkit',
          'Find Your Perfect Remote Setup',
          'The Tools That Power Remote Work',
          'Work Smarter, From Anywhere'
        ];

        // Shuffle array (Fisher-Yates)
        function shuffle(array) {
          var arr = array. Slice();
          for (var i = arr. Length - 1; i > 0; i--) {
            var j = Math. Floor(Math. Random() * (i + 1));
            var temp = arr[i];
            arr[i] = arr[j];
            arr[j] = temp;
          }
          return arr;
        }

        var shuffled = shuffle(headlines);
        var currentIndex = 0;

        element. TextContent = shuffled[0];
        element. ClassList. Remove('headline-exit', 'headline-enter');
        element. ClassList. Add('headline-visible');

        window.__headlineInterval = setInterval(function() {
          // Exit animation - slide up + blur + fade
          element. ClassList. Remove('headline-visible');
          element. ClassList. Add('headline-exit');

          setTimeout(function() {
            // Change text and prepare for enter
            currentIndex = (currentIndex + 1) % shuffled. Length;
            element. TextContent = shuffled[currentIndex];
            element. ClassList. Remove('headline-exit');
            element. ClassList. Add('headline-enter');

            // Use double rAF to ensure browser processes class change before transition
            requestAnimationFrame(function() {
              requestAnimationFrame(function() {
                element. ClassList. Remove('headline-enter');
                element. ClassList. Add('headline-visible');
              });
            });
          }, 700);
        }, 8000);
      }

      // Register event listeners once
      document. AddEventListener('astro:page-load', initHeadlineRotation);
      document. AddEventListener('astro:before-swap', cleanupHeadlineRotation);
    }
  </script>
  <CategorySelector/>
  <ArticleCarousel/>
  <FeaturedContent/>
</BaseLayout>
