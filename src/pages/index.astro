---
import BaseLayout from "../layouts/BaseLayout.astro";
import DeskScene from "@components/home/DeskScene.astro";
import ArticleCard from "@components/ui/ArticleCard.astro";
import { blogArticles, gearArticles, guidesArticles, toolsArticles } from "../data/articles";
import { drawers, editorsPicks, featured, homeMeta, latestReviews, startHereGuides, toolStrip } from "../data/home";

const { title, description } = homeMeta;

const counts = {
  tools: toolsArticles.length,
  gear: gearArticles.length,
  guides: guidesArticles.length,
  blog: blogArticles.length,
};
const totalReviews = counts.tools + counts.gear + counts.guides + counts.blog;

// Visual treatment per drawer; names, blurbs and links come from src/data/home.ts
const drawerClasses: Record<string, string> = {
  tools: "bg-sun text-ink",
  gear: "bg-sand text-ink",
  guides: "bg-ink text-sand",
  blog: "bg-coral text-ink",
};

const sections = drawers.map((drawer) => ({
  name: drawer.name,
  count: `${counts[drawer.section]} ${drawer.unit}`,
  blurb: drawer.blurb,
  href: drawer.href,
  classes: drawerClasses[drawer.section],
}));
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="relative px-4 pt-28 md:pt-36 pb-14 md:pb-20">
    <div class="mx-auto max-w-5xl text-center">
      <span class="inline-flex items-center rounded-full bg-card border-[1.5px] border-ink px-4 py-1.5 text-sm font-bold text-ink mb-5">Independent, reader-supported reviews</span>
      <h1 class="font-display font-bold text-[42px] leading-[1.02] sm:text-6xl md:text-7xl lg:text-[80px] tracking-[-0.035em] text-ink text-balance">
        {homeMeta.headline}
      </h1>
      <p class="mt-6 text-lg md:text-xl font-medium text-ink-soft max-w-2xl mx-auto">
        {totalReviews} honest reviews of the software, gear and setups behind a good remote workday.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/tools/" class="btn-pill btn-ink">
          Find my tools
          <svg class="h-4 w-4" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </a>
        <a href="/guides/complete-home-office-checklist/" class="btn-pill btn-outline">Start with the checklist</a>
      </div>
    </div>
  </section>

  <!-- The desk -->
  <section class="px-3 md:px-6" aria-labelledby="desk-heading">
    <h2 id="desk-heading" class="sr-only">Explore FloatJet from the desk</h2>
    <div class="mx-auto max-w-7xl relative">
      <DeskScene counts={counts} featured={featured} />
    </div>
  </section>

  <!-- Tools we review -->
  <section class="px-4 pt-12 md:pt-14" aria-label="Tools we review">
    <p class="mx-auto max-w-5xl flex flex-wrap justify-center gap-x-6 gap-y-2 text-[15px] font-semibold text-ink-soft">
      <span class="text-ink font-bold">Tools we review:</span>
      {toolStrip.map((name) => <span>{name}</span>)}
    </p>
  </section>

  <!-- Start here -->
  <section class="px-4 pt-20 md:pt-28" aria-labelledby="start-heading">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-3 mb-8 md:mb-10">
        <div>
          <p class="eyebrow mb-2">New here?</p>
          <h2 id="start-heading" class="font-display font-bold text-3xl md:text-[44px] tracking-tight">Start with these three</h2>
        </div>
        <p class="text-ink-soft md:max-w-sm">Our most-read guides for setting up a remote workday that actually works.</p>
      </div>
      <ol class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
        {startHereGuides.map((guide, index) => (
          <li>
            <a href={guide.href} class="sticker sticker-hover group flex h-full flex-col gap-3 rounded-[24px] p-6 md:p-7 text-ink">
              <span class="font-display font-bold text-5xl text-jet-stream leading-none" aria-hidden="true">0{index + 1}</span>
              <h3 class="font-display font-bold text-xl leading-snug group-hover:underline decoration-2 underline-offset-4">{guide.title}</h3>
              <p class="text-ink-soft text-[15px]">{guide.description}</p>
              <span class="mt-auto pt-2 inline-flex items-center gap-1 text-sm font-bold text-teal-ink">
                Read it
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- On our desk this month -->
  <section class="px-4 pt-20 md:pt-28" aria-labelledby="picks-heading">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10">
        <div>
          <p class="eyebrow mb-2">Editor's picks</p>
          <h2 id="picks-heading" class="font-display font-bold text-3xl md:text-[44px] tracking-tight">On our desk this month</h2>
        </div>
        <a href="/tools/" class="btn-pill btn-outline self-start sm:self-auto">See every review</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {editorsPicks.map((pick) => (
          <ArticleCard
            href={pick.href}
            title={pick.title}
            image={pick.image}
            imageAlt={pick.imageAlt}
            category={pick.category}
            readTime={pick.readTime}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Browse by section -->
  <section class="px-4 pt-20 md:pt-28" aria-labelledby="sections-heading">
    <div class="mx-auto max-w-7xl">
      <h2 id="sections-heading" class="font-display font-bold text-3xl md:text-[44px] tracking-tight mb-8 md:mb-10">Pick a drawer</h2>
      <ul class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
        {sections.map((section) => (
          <li>
            <a
              href={section.href}
              class:list={[
                "section-block group flex h-40 sm:h-48 md:h-56 flex-col justify-between gap-3 rounded-[24px] border-[1.5px] border-ink p-5 md:p-7 transition-transform hover:-translate-y-1",
                section.classes,
              ]}
            >
              <span class="text-sm md:text-base font-bold">{section.count}</span>
              <span>
                <span class="block font-display font-bold text-2xl md:text-4xl leading-none">{section.name}</span>
                <span class="hidden md:block mt-2 text-[15px] opacity-90">{section.blurb}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Latest reviews -->
  <section class="px-4 pt-20 md:pt-28" aria-labelledby="latest-heading">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
        <div>
          <p class="eyebrow mb-2">Fresh off the desk</p>
          <h2 id="latest-heading" class="font-display font-bold text-3xl md:text-[44px] tracking-tight">Latest reviews</h2>
        </div>
        <a href="/blog/" class="btn-pill btn-outline self-start sm:self-auto">All articles</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {latestReviews.map((review) => (
          <ArticleCard
            href={review.href}
            title={review.title}
            description={review.description}
            image={review.image}
            imageAlt={review.imageAlt}
            category={review.category}
            readTime={review.readTime}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="px-4 pt-20 md:pt-28">
    <div class="mx-auto max-w-5xl relative">
      <div class="relative bg-sky-light border-[1.5px] border-ink rounded-[32px] px-6 py-12 md:px-16 md:py-14 text-center shadow-[5px_6px_0_0_var(--color-ink)]">
        <h2 class="font-display font-bold text-3xl md:text-[44px] tracking-tight text-balance">Not sure where to start?</h2>
        <p class="mt-4 text-lg text-ink max-w-xl mx-auto">
          Grab the home office checklist, then fill the gaps with the tools we would buy again.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/guides/complete-home-office-checklist/" class="btn-pill btn-ink">Open the checklist</a>
          <a href="/tools/" class="btn-pill btn-sun">Browse all tools</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

