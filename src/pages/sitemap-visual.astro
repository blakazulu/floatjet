---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CATEGORY_COLORS, generateSiteStructure } from "../utils/generateSiteStructure";

const title = "Interactive Site Map | FloatJet";
const description =
  "Explore the FloatJet site structure with our interactive visualization. Navigate through tools, gear, guides, and articles.";

// Dynamically get all pages using Astro's glob
const allPages = import.meta.glob("/src/pages/**/*.astro");

// Generate site structure dynamically
const SITE_STRUCTURE = generateSiteStructure(allPages);

// Pass data to client
const siteData = JSON.stringify(SITE_STRUCTURE);
const colorData = JSON.stringify(CATEGORY_COLORS);
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen pt-24 md:pt-28 pb-12 px-4">
    <!-- Header -->
    <div class="max-w-7xl mx-auto mb-8">
      <div class="text-center">
        <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-4">
          Interactive Site Map
        </h1>
        <p class="text-sky-100 text-lg max-w-2xl mx-auto">
          Explore FloatJet's content structure. Click nodes to navigate, drag to
          explore, and scroll to zoom.
        </p>
      </div>

      <!-- Controls -->
      <div class="flex flex-wrap justify-center gap-3 mt-6">
        <button
            id="btn-reset"
            class="px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-full text-sm font-medium backdrop-blur-sm border border-white/20 transition-all duration-300"
        >
          Reset View
        </button>
        <button
            id="btn-check-links"
            class="px-4 py-2 bg-jet-stream/80 hover:bg-jet-stream text-white rounded-full text-sm font-medium backdrop-blur-sm transition-all duration-300"
        >
          Check Links
        </button>
        <div
            class="flex items-center gap-2 px-4 py-2 bg-white/10 rounded-full backdrop-blur-sm border border-white/20"
        >
          <label for="layout-select" class="text-white text-sm">Layout:</label>
          <select
              id="layout-select"
              aria-label="Select visualization layout"
              class="bg-transparent text-white text-sm border-none outline-none cursor-pointer"
          >
            <option value="force" class="text-slate-800">Force Graph</option>
            <option value="radial" class="text-slate-800">Radial Tree</option>
            <option value="tree" class="text-slate-800">Hierarchical</option>
          </select>
        </div>
      </div>

      <!-- Legend -->
      <div class="flex flex-wrap justify-center gap-4 mt-6" id="legend">
        <div class="flex items-center gap-2 text-sm text-white/80">
          <span
              class="w-4 h-4 rounded-full bg-ocean-deep border-2 border-white/50"
          ></span>
          <span>Home</span>
        </div>
        <div class="flex items-center gap-2 text-sm text-white/80">
          <span
              class="w-4 h-4 rounded-full bg-jet-stream border-2 border-white/50"
          ></span>
          <span>Hubs</span>
        </div>
        <div class="flex items-center gap-2 text-sm text-white/80">
          <span
              class="w-4 h-4 rounded-full bg-sky-light border-2 border-white/50"
          ></span>
          <span>Categories</span>
        </div>
        <div class="flex items-center gap-2 text-sm text-white/80">
          <span
              class="w-4 h-4 rounded-full bg-blue-500 border-2 border-white/50"
          ></span>
          <span>Articles</span>
        </div>
        <div class="flex items-center gap-2 text-sm text-white/80">
          <span
              class="w-4 h-4 rounded-full bg-slate-500 border-2 border-white/50"
          ></span>
          <span>Pages</span>
        </div>
      </div>
    </div>

    <!-- Visualization Container -->
    <div
        id="sitemap-wrapper"
        class="max-w-7xl mx-auto transition-all duration-300"
    >
      <div
          id="sitemap-container"
          class="relative w-full bg-white/5 backdrop-blur-md rounded-3xl border border-white/20 shadow-2xl overflow-hidden transition-all duration-300"
          style="height: 70vh; min-height: 500px;"
      >
        <!-- Fullscreen Toggle Button -->
        <button
            id="btn-fullscreen"
            class="absolute top-4 right-4 z-40 p-3 bg-white/10 hover:bg-white/20 text-white rounded-full backdrop-blur-sm border border-white/20 transition-all duration-300 group"
            aria-label="Toggle fullscreen"
        >
          <svg
              id="icon-expand"
              class="w-5 h-5 transition-transform group-hover:scale-110"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
          >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"
            ></path>
          </svg>
          <svg
              id="icon-collapse"
              class="w-5 h-5 hidden transition-transform group-hover:scale-110"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
          >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 9L4 4m0 0v4m0-4h4m7 5l5-5m0 0v4m0-4h-4M9 15l-5 5m0 0v-4m0 4h4m7-5l5 5m0 0v-4m0 4h-4"
            ></path>
          </svg>
        </button>

        <!-- Fullscreen Controls Overlay (hidden by default) -->
        <div
            id="fullscreen-controls"
            class="hidden absolute top-0 left-0 right-0 z-20 pt-4 pb-6 px-4 bg-gradient-to-b from-black/80 via-black/50 to-transparent"
        >
          <div class="flex flex-col items-center gap-4">
            <!-- Controls -->
            <div class="flex flex-wrap justify-center gap-3">
              <button
                  id="btn-reset-fs"
                  class="px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-full text-sm font-medium backdrop-blur-sm border border-white/20 transition-all duration-300"
              >
                Reset View
              </button>
              <button
                  id="btn-check-links-fs"
                  class="px-4 py-2 bg-jet-stream/80 hover:bg-jet-stream text-white rounded-full text-sm font-medium backdrop-blur-sm transition-all duration-300"
              >
                Check Links
              </button>
              <div
                  class="flex items-center gap-2 px-4 py-2 bg-white/10 rounded-full backdrop-blur-sm border border-white/20"
              >
                <label for="layout-select-fs" class="text-white text-sm"
                >Layout:</label
                >
                <select
                    id="layout-select-fs"
                    aria-label="Select visualization layout"
                    class="bg-transparent text-white text-sm border-none outline-none cursor-pointer"
                >
                  <option value="force" class="text-slate-800"
                  >Force Graph
                  </option
                  >
                  <option value="radial" class="text-slate-800"
                  >Radial Tree
                  </option
                  >
                  <option value="tree" class="text-slate-800"
                  >Hierarchical
                  </option
                  >
                </select>
              </div>
              <button
                  id="btn-exit-fullscreen"
                  class="px-4 py-2 bg-red-500/60 hover:bg-red-500/80 text-white rounded-full text-sm font-medium backdrop-blur-sm border border-red-400/30 transition-all duration-300"
              >
                Exit Fullscreen
              </button>
            </div>

            <!-- Legend -->
            <div class="flex flex-wrap justify-center gap-4">
              <div class="flex items-center gap-2 text-sm text-white/80">
                <span
                    class="w-4 h-4 rounded-full bg-ocean-deep border-2 border-white/50"
                ></span>
                <span>Home</span>
              </div>
              <div class="flex items-center gap-2 text-sm text-white/80">
                <span
                    class="w-4 h-4 rounded-full bg-jet-stream border-2 border-white/50"
                ></span>
                <span>Hubs</span>
              </div>
              <div class="flex items-center gap-2 text-sm text-white/80">
                <span
                    class="w-4 h-4 rounded-full bg-sky-light border-2 border-white/50"
                ></span>
                <span>Categories</span>
              </div>
              <div class="flex items-center gap-2 text-sm text-white/80">
                <span
                    class="w-4 h-4 rounded-full bg-blue-500 border-2 border-white/50"
                ></span>
                <span>Articles</span>
              </div>
              <div class="flex items-center gap-2 text-sm text-white/80">
                <span
                    class="w-4 h-4 rounded-full bg-slate-500 border-2 border-white/50"
                ></span>
                <span>Pages</span>
              </div>
            </div>
          </div>
        </div>
        <!-- Loading State -->
        <div
            id="loading"
            class="absolute inset-0 flex items-center justify-center bg-ocean-deep/50 backdrop-blur-sm z-10"
        >
          <div class="text-center">
            <div
                class="w-16 h-16 border-4 border-sky-light border-t-transparent rounded-full animate-spin mx-auto mb-4"
            >
            </div>
            <p class="text-white font-medium">Building visualization...</p>
          </div>
        </div>

        <!-- SVG will be injected here -->
        <svg id="sitemap-svg" class="w-full h-full"></svg>

        <!-- Tooltip -->
        <div
            id="tooltip"
            class="absolute pointer-events-none opacity-0 transition-opacity duration-200 z-20 px-4 py-3 bg-ocean-deep/95 backdrop-blur-md rounded-xl shadow-xl border border-white/20 text-white max-w-xs"
        >
          <div id="tooltip-name" class="font-heading font-bold text-lg mb-1">
          </div>
          <div id="tooltip-path" class="text-sky-light text-sm font-mono mb-2">
          </div>
          <div
              id="tooltip-type"
              class="text-xs text-white/70 uppercase tracking-wide"
          >
          </div>
          <div id="tooltip-status" class="mt-2 text-sm hidden">
            <span id="tooltip-status-icon"></span>
            <span id="tooltip-status-text"></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats Panel -->
    <div class="max-w-7xl mx-auto mt-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div
            class="bg-white/10 backdrop-blur-sm rounded-2xl p-4 border border-white/20 text-center"
        >
          <div class="text-3xl font-bold text-white" id="stat-total">0</div>
          <div class="text-sky-100 text-sm">Total Pages</div>
        </div>
        <div
            class="bg-white/10 backdrop-blur-sm rounded-2xl p-4 border border-white/20 text-center"
        >
          <div class="text-3xl font-bold text-emerald-400" id="stat-healthy">
            -
          </div>
          <div class="text-sky-100 text-sm">Healthy Links</div>
        </div>
        <div
            class="bg-white/10 backdrop-blur-sm rounded-2xl p-4 border border-white/20 text-center"
        >
          <div class="text-3xl font-bold text-amber-400" id="stat-pending">
            -
          </div>
          <div class="text-sky-100 text-sm">Unchecked</div>
        </div>
        <div
            class="bg-white/10 backdrop-blur-sm rounded-2xl p-4 border border-white/20 text-center"
        >
          <div class="text-3xl font-bold text-red-400" id="stat-broken">-</div>
          <div class="text-sky-100 text-sm">Broken Links</div>
        </div>
      </div>
    </div>

    <!-- Link Check Results -->
    <div id="link-results" class="max-w-7xl mx-auto mt-8 hidden">
      <div
          class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 border border-white/20"
      >
        <h2 class="font-heading text-xl font-bold text-white mb-4">
          Link Check Results
        </h2>
        <div id="link-results-content" class="space-y-2"></div>
      </div>
    </div>
  </div>
</BaseLayout>

<!-- D3.js CDN -->
<script is:inline src="https://d3js. Org/d3. V7. Min.js"></script>

<script define:vars={{siteData, colorData}}>
  // Store data globally for reinitialization
  window.__sitemapData = {
    siteData: siteData,
    colorData: colorData,
  };
</script>

<script is:inline>
  // Sitemap Visualization with proper cleanup for View Transitions

  if (!window.__sitemapInit) {
    window.__sitemapInit = true;
    window.__sitemapHandlers = { resize: null, keydown: null };
    window.__sitemapState = { simulation: null, isFullscreen: false };

    function cleanupSitemap() {
      // Remove global listeners
      if (window.__sitemapHandlers. Resize) {
        window. RemoveEventListener('resize', window.__sitemapHandlers. Resize);
        window.__sitemapHandlers. Resize = null;
      }
      if (window.__sitemapHandlers. Keydown) {
        document. RemoveEventListener('keydown', window.__sitemapHandlers. Keydown);
        window.__sitemapHandlers. Keydown = null;
      }
      // Stop simulation
      if (window.__sitemapState.simulation) {
        window.__sitemapState.simulation.stop();
        window.__sitemapState.simulation = null;
      }
      // Reset fullscreen state
      window.__sitemapState. IsFullscreen = false;
    }

    function initSitemapVisualization() {
      // Clean up first
      cleanupSitemap();

      // Check if D3 is loaded
      if (typeof d3 === 'undefined') {
        console.error('D3 not loaded');
        return;
      }

      // Check if container exists (we're on the right page)
      var container = document. GetElementById('sitemap-container');
      if (!container) return;

      // Check if data exists
      if (!window.__sitemapData) return;

      // Parse data
      var siteStructure = JSON.parse(window.__sitemapData. SiteData);
      var categoryColors = JSON.parse(window.__sitemapData. ColorData);

      // State
      var currentLayout = 'force';
      var simulation = null;
      var linkStatus = new Map();

    // DOM Elements
    var svgEl = document. GetElementById('sitemap-svg');
    var loading = document. GetElementById('loading');
    var tooltip = document. GetElementById('tooltip');

    // Clear any existing SVG content
    svgEl. InnerHTML = '';

    var svg = d3.select('#sitemap-svg');

    // Dimensions
    var width = container. ClientWidth;
    var height = container. ClientHeight;

    // Create main group for zoom/pan
    var g = svg.append('g');

    // Initialize zoom behavior
    var zoom = d3
      .zoom()
      . ScaleExtent([0.1, 4])
      .on('zoom', function(event) {
        g.attr('transform', event.transform);
      });

    svg.call(zoom);

    // Define gradients and filters
    var defs = svg.append('defs');

    // Glow filter for nodes
    var glow = defs
      .append('filter')
      .attr('id', 'glow')
      .attr('x', '-50%')
      .attr('y', '-50%')
      .attr('width', '200%')
      .attr('height', '200%');

    glow
      .append('feGaussianBlur')
      .attr('stdDeviation', '3')
      .attr('result', 'coloredBlur');

    var glowMerge = glow.append('feMerge');
    glowMerge.append('feMergeNode').attr('in', 'coloredBlur');
    glowMerge.append('feMergeNode').attr('in', 'SourceGraphic');

    // Create arrow marker for links
    defs
      .append('marker')
      .attr('id', 'arrowhead')
      .attr('viewBox', '-0 -5 10 10')
      .attr('refX', 20)
      .attr('refY', 0)
      .attr('orient', 'auto')
      .attr('markerWidth', 6)
      .attr('markerHeight', 6)
      .append('path')
      .attr('d', 'M 0,-5 L 10,0 L 0,5')
      .attr('fill', 'rgba(128, 206, 215, 0.5)');

    // Get node color based on type and category
    function getNodeColor(node) {
      if (node.type === 'root') return '#0F4C5C';
      if (node.type === 'hub') return '#38A3A5';
      if (node.type === 'category') return '#80CED7';
      if (node.type === 'page') return '#64748B';

      // Article colors by category
      var categoryColorMap = {
        security: '#10B981',
        saas: '#3B82F6',
        hosting: '#8B5CF6',
        finance: '#F59E0B',
        travel: '#EC4899',
        gear: '#EE6C4D',
        guides: '#9333EA',
        tools: '#38A3A5',
      };

      return categoryColorMap[node.category] || '#38A3A5';
    }

    // Get node size based on type
    function getNodeSize(node) {
      if (node.type === 'root') return 30;
      if (node.type === 'hub') return 20;
      if (node.type === 'category') return 15;
      return 10;
    }

    // Initialize force simulation
    function createForceSimulation(nodes, links) {
      return d3
        .forceSimulation(nodes)
        .force(
          'link',
          d3
            .forceLink(links)
            .id(function(d) { return d.id; })
            .distance(function(d) {
              var sourceType = d. Source.type || 'article';
              if (sourceType === 'root') return 150;
              if (sourceType === 'hub') return 100;
              return 70;
            })
            .strength(0.5),
        )
        .force(
          'charge',
          d3.forceManyBody().strength(function(d) {
            if (d.type === 'root') return -800;
            if (d.type === 'hub') return -400;
            return -150;
          }),
        )
        .force('center', d3.forceCenter(width / 2, height / 2))
        .force(
          'collision',
          d3.forceCollide().radius(function(d) { return getNodeSize(d) + 10; }),
        );
    }

    // Build hierarchy from flat structure
    function buildHierarchy() {
      var nodeMap = new Map();

      // Create node objects
      siteStructure. Nodes. ForEach(function(n) {
        nodeMap.set(n.id, Object.assign({}, n, { children: [] }));
      });

      // Build parent-child relationships
      siteStructure. Links. ForEach(function(link) {
        var parent = nodeMap.get(link.source);
        var child = nodeMap.get(link.target);
        if (parent && child) {
          parent. Children.push(child);
        }
      });

      return nodeMap.get('/');
    }

    // Render the visualization
    function render(layout) {
      layout = layout || 'force';
      // Clear previous content
      g.selectAll('*').remove();

      // Stop any running simulation
      if (simulation) {
        simulation.stop();
        simulation = null;
      }

      // Update stats
      document. GetElementById('stat-total'). TextContent =
        siteStructure. Nodes.length;

      if (layout === 'force') {
        renderForceLayout();
      } else if (layout === 'radial') {
        renderRadialLayout();
      } else if (layout === 'tree') {
        renderTreeLayout();
      }

      // Remove loading state
      loading.classList.add('hidden');
    }

    // Force-directed layout
    function renderForceLayout() {
      var nodes = siteStructure. Nodes.map(function(d) { return Object.assign({}, d); });
      var links = siteStructure. Links.map(function(d) {
        return {
          source: d. Source,
          target: d. Target,
          type: d.type
        };
      });

      var link = g
        .append('g')
        .attr('class', 'links')
        .selectAll('line')
        .data(links)
        .enter()
        .append('line')
        .attr('stroke', 'rgba(128, 206, 215, 0.3)')
        .attr('stroke-width', 1.5)
        .attr('marker-end', 'url(#arrowhead)');

      var node = g
        .append('g')
        .attr('class', 'nodes')
        .selectAll('g')
        .data(nodes)
        .enter()
        .append('g')
        .attr('class', 'node')
        .style('cursor', 'pointer')
        .call(
          d3
            .drag()
            .on('start', dragstarted)
            .on('drag', dragged)
            .on('end', dragended),
        );

      addNodeElements(node);
      addNodeInteractions(node, link);

      simulation = createForceSimulation(nodes, links);
      window.__sitemapState.simulation = simulation;

      simulation.on('tick', function() {
        link
          .attr('x1', function(d) { return d. Source. X; })
          .attr('y1', function(d) { return d. Source. Y; })
          .attr('x2', function(d) { return d. Target. X; })
          .attr('y2', function(d) { return d. Target. Y; });
        node.attr('transform', function(d) { return 'translate(' + d.x + ',' + d.y + ')'; });
      });

      animateIn(node, link);
      window. CurrentNodes = node;
    }

    // Radial tree layout
    function renderRadialLayout() {
      var hierarchy = buildHierarchy();
      var root = d3.hierarchy(hierarchy);

      var radius = Math.min(width, height) / 2 - 100;

      var treeLayout = d3
        .tree()
        .size([2 * Math.PI, radius])
        .separation(function(a, b) { return (a.parent === b.parent ? 1 : 2) / a.depth; });

      treeLayout(root);

      // Create curved links
      var link = g
        .append('g')
        .attr('class', 'links')
        .attr('transform', 'translate(' + (width / 2) + ',' + (height / 2) + ')')
        .selectAll('path')
        .data(root.links())
        .enter()
        .append('path')
        .attr('fill', 'none')
        .attr('stroke', 'rgba(128, 206, 215, 0.4)')
        .attr('stroke-width', 1.5)
        .attr(
          'd',
          d3
            .linkRadial()
            .angle(function(d) { return d.x; })
            .radius(function(d) { return d.y; }),
        );

      var node = g
        .append('g')
        .attr('class', 'nodes')
        .attr('transform', 'translate(' + (width / 2) + ',' + (height / 2) + ')')
        .selectAll('g')
        .data(root.descendants())
        .enter()
        .append('g')
        .attr('class', 'node')
        .style('cursor', 'pointer')
        .attr(
          'transform',
          function(d) { return 'rotate(' + ((d.x * 180) / Math.PI - 90) + ') translate(' + d.y + ',0)'; },
        );

      addNodeElements(node, true);
      addNodeInteractions(node, link, true);

      // Add labels with proper rotation
      node
        .append('text')
        .attr('dy', '0.31em')
        .attr('x', function(d) { return (d.x < Math.PI === !d.children ? 6 : -6); })
        .attr('text-anchor', function(d) {
          return d.x < Math.PI === !d.children ? 'start' : 'end';
        })
        .attr('transform', function(d) { return d.x >= Math.PI ? 'rotate(180)' : null; })
        .attr('fill', 'white')
        .attr('font-size', function(d) { return d.data.type === 'root' ? '12px' : '10px'; })
        .attr('font-family', 'Outfit, sans-serif')
        .text(function(d) { return d.data.name; })
        .style('text-shadow', '0 2px 4px rgba(0,0,0,0.8)')
        .clone(true)
        .lower()
        .attr('stroke', 'rgba(0,0,0,0.5)')
        .attr('stroke-width', 3);

      animateIn(node, link);
      window. CurrentNodes = node;
    }

    // Hierarchical tree layout
    function renderTreeLayout() {
      var hierarchy = buildHierarchy();
      var root = d3.hierarchy(hierarchy);

      var treeLayout = d3.tree().size([width - 200, height - 150]);

      treeLayout(root);

      // Create curved links
      var link = g
        .append('g')
        .attr('class', 'links')
        .attr('transform', 'translate(100, 50)')
        .selectAll('path')
        .data(root.links())
        .enter()
        .append('path')
        .attr('fill', 'none')
        .attr('stroke', 'rgba(128, 206, 215, 0.4)')
        .attr('stroke-width', 1.5)
        .attr(
          'd',
          d3
            . LinkVertical()
            .x(function(d) { return d.x; })
            .y(function(d) { return d.y; }),
        );

      var node = g
        .append('g')
        .attr('class', 'nodes')
        .attr('transform', 'translate(100, 50)')
        .selectAll('g')
        .data(root.descendants())
        .enter()
        .append('g')
        .attr('class', 'node')
        .style('cursor', 'pointer')
        .attr('transform', function(d) { return 'translate(' + d.x + ',' + d.y + ')'; });

      addNodeElements(node, true);
      addNodeInteractions(node, link, true);

      // Add labels below nodes
      node
        .append('text')
        .attr('dy', function(d) { return getNodeSize(d.data || d) + 14; })
        .attr('text-anchor', 'middle')
        .attr('fill', 'white')
        .attr('font-size', function(d) {
          return (d.data || d).type === 'root' ? '11px' : '9px';
        })
        .attr('font-family', 'Outfit, sans-serif')
        .text(function(d) { return (d.data || d). Name; })
        .style('text-shadow', '0 2px 4px rgba(0,0,0,0.8)');

      animateIn(node, link);
      window. CurrentNodes = node;
    }

    // Shared function to add node visual elements
    function addNodeElements(node, isHierarchy) {
      isHierarchy = isHierarchy || false;
      node
        .append('circle')
        .attr('r', function(d) { return getNodeSize(isHierarchy ? d.data : d); })
        .attr('fill', function(d) { return getNodeColor(isHierarchy ? d.data : d); })
        .attr('stroke', 'rgba(255, 255, 255, 0.5)')
        .attr('stroke-width', 2)
        .attr('filter', function(d) {
          var data = isHierarchy ? d.data : d;
          return data.type === 'root' || data.type === 'hub'
            ? 'url(#glow)'
            : null;
        })
        .style('transition', 'all 0.3s ease');

      node
        .append('circle')
        .attr('class', 'status-indicator')
        .attr('r', 5)
        .attr('cx', function(d) { return getNodeSize(isHierarchy ? d.data : d) - 2; })
        .attr('cy', function(d) { return -getNodeSize(isHierarchy ? d.data : d) + 2; })
        .attr('fill', 'transparent')
        .attr('stroke', 'transparent');
    }

    // Shared function to add hover/click interactions
    function addNodeInteractions(node, link, isHierarchy) {
      isHierarchy = isHierarchy || false;
      node
        .on('mouseover', function (event, d) {
          var data = isHierarchy ? d.data : d;
          d3.select(this)
            .select('circle')
            .attr('stroke', 'white')
            .attr('stroke-width', 3);
          showTooltip(event, data);

          if (!isHierarchy) {
            link
              .attr('stroke', function(l) {
                return l. Source.id === data.id || l. Target.id === data.id
                  ? 'rgba(128, 206, 215, 0.8)'
                  : 'rgba(128, 206, 215, 0.15)';
              })
              .attr('stroke-width', function(l) {
                return l. Source.id === data.id || l. Target.id === data.id ? 3 : 1;
              });
          }
        })
        .on('mouseout', function (event, d) {
          d3.select(this)
            .select('circle')
            .attr('stroke', 'rgba(255, 255, 255, 0.5)')
            .attr('stroke-width', 2);
          hideTooltip();

          if (!isHierarchy) {
            link
              .attr('stroke', 'rgba(128, 206, 215, 0.3)')
              .attr('stroke-width', 1.5);
          }
        })
        .on('click', function (event, d) {
          var data = isHierarchy ? d.data : d;
          if (data.path) {
            window. Location.href = data. Path;
          }
        });
    }

    // Animate nodes and links in
    function animateIn(node, link) {
      node
        .style('opacity', 0)
        .transition()
        .duration(800)
        .delay((d, i) => i * 15)
        .style('opacity', 1);

      link
        .style('opacity', 0)
        .transition()
        .duration(800)
        .delay(300)
        .style('opacity', 1);
    }

    // Drag functions
    function dragstarted(event, d) {
      if (!event.active) simulation.alphaTarget(0.3).restart();
      d. Fx = d.x;
      d. Fy = d.y;
    }

    function dragged(event, d) {
      d. Fx = event. X;
      d. Fy = event. Y;
    }

    function dragended(event, d) {
      if (!event.active) simulation.alphaTarget(0);
      d. Fx = null;
      d. Fy = null;
    }

    // Tooltip functions
    function showTooltip(event, d) {
      const rect = container. GetBoundingClientRect();
      const x = event. ClientX - rect. Left;
      const y = event. ClientY - rect. Top;

      document. GetElementById('tooltip-name'). TextContent = d. Name;
      document. GetElementById('tooltip-path'). TextContent = d. Path;
      document. GetElementById('tooltip-type'). TextContent =
        `${d.type}${d.category ? ' • ' + d.category : ''}`;

      // Show link status if available
      const statusEl = document. GetElementById('tooltip-status');
      const statusIconEl = document. GetElementById('tooltip-status-icon');
      const statusTextEl = document. GetElementById('tooltip-status-text');

      if (linkStatus.has(d.path)) {
        const status = linkStatus.get(d.path);
        statusEl.classList.remove('hidden');
        if (status === 'ok') {
          statusIconEl. TextContent = '✓ ';
          statusIconEl. ClassName = 'text-emerald-400';
          statusTextEl. TextContent = 'Link OK';
          statusTextEl. ClassName = 'text-emerald-400';
        } else if (status === 'error') {
          statusIconEl. TextContent = '✗ ';
          statusIconEl. ClassName = 'text-red-400';
          statusTextEl. TextContent = 'Link broken';
          statusTextEl. ClassName = 'text-red-400';
        } else {
          statusIconEl. TextContent = '○ ';
          statusIconEl. ClassName = 'text-amber-400';
          statusTextEl. TextContent = 'Checking...';
          statusTextEl. ClassName = 'text-amber-400';
        }
      } else {
        statusEl.classList.add('hidden');
      }

      tooltip. Style. Left = `${Math.min(x + 10, width - 200)}px`;
      tooltip. Style. Top = `${Math.min(y + 10, height - 100)}px`;
      tooltip.classList.remove('opacity-0');
      tooltip.classList.add('opacity-100');
    }

    function hideTooltip() {
      tooltip.classList.remove('opacity-100');
      tooltip.classList.add('opacity-0');
    }

    // Fullscreen state
    var wrapper = document. GetElementById('sitemap-wrapper');
    var fullscreenControls = document. GetElementById('fullscreen-controls');
    var iconExpand = document. GetElementById('icon-expand');
    var iconCollapse = document. GetElementById('icon-collapse');
    var layoutSelectFs = document. GetElementById('layout-select-fs');
    var layoutSelect = document. GetElementById('layout-select');

    function enterFullscreen() {
      window.__sitemapState. IsFullscreen = true;

      // Hide page content, navbar, footer, and affiliate disclosure
      document. Body. Style. Overflow = 'hidden';
      var header = document. QuerySelector('header');
      if (header) header. Style. Display = 'none';
      var footer = document. QuerySelector('footer');
      if (footer) footer. Style. Display = 'none';
      var affiliateDisclosure = document. QuerySelector(
        '. Affiliate-disclosure, [class*="affiliate"], #affiliate-disclosure'
      );
      if (affiliateDisclosure) affiliateDisclosure. Style. Display = 'none';

      // Make wrapper fullscreen with highest z-index
      wrapper.classList.remove('max-w-7xl', 'mx-auto');
      wrapper.classList.add('fixed', 'inset-0');
      wrapper. Style. ZIndex = '9999';

      // Make container fullscreen
      container.classList.remove('rounded-3xl', 'border', 'border-white/20');
      container. Style. Height = '100vh';
      container. Style. MinHeight = '100vh';
      container. Style. BorderRadius = '0';

      // Show fullscreen controls, hide normal controls
      fullscreenControls.classList.remove('hidden');
      iconExpand.classList.add('hidden');
      iconCollapse.classList.remove('hidden');

      // Sync layout select
      layoutSelectFs.value = currentLayout;

      // Update dimensions and re-render
      setTimeout(function() {
        width = container. ClientWidth;
        height = container. ClientHeight;
        render(currentLayout);
      }, 350);
    }

    function exitFullscreen() {
      window.__sitemapState. IsFullscreen = false;

      // Restore page scroll, navbar, footer, and affiliate disclosure
      document. Body. Style. Overflow = '';
      var header = document. QuerySelector('header');
      if (header) header. Style. Display = '';
      var footer = document. QuerySelector('footer');
      if (footer) footer. Style. Display = '';
      var affiliateDisclosure = document. QuerySelector(
        '. Affiliate-disclosure, [class*="affiliate"], #affiliate-disclosure'
      );
      if (affiliateDisclosure) affiliateDisclosure. Style. Display = '';

      // Restore wrapper
      wrapper.classList.add('max-w-7xl', 'mx-auto');
      wrapper.classList.remove('fixed', 'inset-0');
      wrapper. Style. ZIndex = '';

      // Restore container
      container.classList.add('rounded-3xl', 'border', 'border-white/20');
      container. Style. Height = '70vh';
      container. Style. MinHeight = '500px';
      container. Style. BorderRadius = '';

      // Hide fullscreen controls
      fullscreenControls.classList.add('hidden');
      iconExpand.classList.remove('hidden');
      iconCollapse.classList.add('hidden');

      // Sync layout select
      layoutSelect.value = currentLayout;

      // Update dimensions and re-render
      setTimeout(function() {
        width = container. ClientWidth;
        height = container. ClientHeight;
        render(currentLayout);
      }, 350);
    }

    // Fullscreen toggle button
    document. GetElementById('btn-fullscreen'). AddEventListener('click', function(e) {
      e. PreventDefault();
      e. StopPropagation();
      if (window.__sitemapState. IsFullscreen) {
        exitFullscreen();
      } else {
        enterFullscreen();
      }
    });

    // Exit fullscreen button
    document
      . GetElementById('btn-exit-fullscreen')
      . AddEventListener('click', exitFullscreen);

    // ESC key to exit fullscreen - store for cleanup
    window.__sitemapHandlers. Keydown = function(e) {
      if (e.key === 'Escape' && window.__sitemapState. IsFullscreen) {
        exitFullscreen();
      }
    };
    document. AddEventListener('keydown', window.__sitemapHandlers. Keydown);

    // Reset view (both normal and fullscreen)
    document. GetElementById('btn-reset'). AddEventListener('click', function() {
      svg.transition().duration(750).call(zoom.transform, d3.zoomIdentity);
    });

    document. GetElementById('btn-reset-fs'). AddEventListener('click', function() {
      svg.transition().duration(750).call(zoom.transform, d3.zoomIdentity);
    });

    // Layout change (both normal and fullscreen)
    document. GetElementById('layout-select'). AddEventListener('change', function(e) {
      currentLayout = e. Target. Value;
      layoutSelectFs.value = currentLayout;
      render(currentLayout);
    });

    document
      . GetElementById('layout-select-fs')
      . AddEventListener('change', function(e) {
        currentLayout = e. Target. Value;
        layoutSelect.value = currentLayout;
        render(currentLayout);
      });

    // Link checking function
    function checkLinks(btn, btnFs) {
      btn. TextContent = 'Checking...';
      btn.disabled = true;
      if (btnFs) {
        btnFs. TextContent = 'Checking...';
        btnFs.disabled = true;
      }

      var healthy = 0;
      var broken = 0;
      var pending = siteStructure. Nodes.length;

      document. GetElementById('stat-pending'). TextContent = pending;
      document. GetElementById('stat-healthy'). TextContent = healthy;
      document. GetElementById('stat-broken'). TextContent = broken;

      var results = [];
      var nodeIndex = 0;

      function checkNextNode() {
        if (nodeIndex >= siteStructure. Nodes.length) {
          // All done
          btn. TextContent = 'Check Links';
          btn.disabled = false;
          if (btnFs) {
            btnFs. TextContent = 'Check Links';
            btnFs.disabled = false;
          }
          showResults();
          return;
        }

        var node = siteStructure. Nodes[nodeIndex];
        linkStatus.set(node. Path, 'checking');
        updateNodeStatus(node. Path, 'checking');

        fetch(node. Path, { method: 'HEAD' })
          .then(function(response) {
            if (response. Ok) {
              linkStatus.set(node. Path, 'ok');
              updateNodeStatus(node. Path, 'ok');
              healthy++;
            } else {
              linkStatus.set(node. Path, 'error');
              updateNodeStatus(node. Path, 'error');
              broken++;
              results.push({
                path: node. Path,
                status: response. Status,
                name: node.name
              });
            }
            pending--;
            document. GetElementById('stat-pending'). TextContent = pending;
            document. GetElementById('stat-healthy'). TextContent = healthy;
            document. GetElementById('stat-broken'). TextContent = broken;
            nodeIndex++;
            checkNextNode();
          })
          .catch(function(err) {
            linkStatus.set(node. Path, 'error');
            updateNodeStatus(node. Path, 'error');
            broken++;
            results.push({
              path: node. Path,
              status: 'Network Error',
              name: node.name
            });
            pending--;
            document. GetElementById('stat-pending'). TextContent = pending;
            document. GetElementById('stat-healthy'). TextContent = healthy;
            document. GetElementById('stat-broken'). TextContent = broken;
            nodeIndex++;
            checkNextNode();
          });
      }

      function showResults() {
        var resultsEl = document. GetElementById('link-results');
        var contentEl = document. GetElementById('link-results-content');

        if (results.length > 0) {
          contentEl. InnerHTML = results
            .map(function(r) {
              return '<div class="flex items-center justify-between p-3 bg-red-500/20 rounded-lg border border-red-500/30">' +
                '<div>' +
                '<div class="text-white font-medium">' + r.name + '</div>' +
                '<div class="text-red-300 text-sm font-mono">' + r.path + '</div>' +
                '</div>' +
                '<div class="text-red-400 font-mono">' + r.status + '</div>' +
                '</div>';
            })
            .join('');
        } else {
          contentEl. InnerHTML = '<div class="text-emerald-400 text-center py-4">All links are healthy!</div>';
        }
        resultsEl.classList.remove('hidden');
      }

      checkNextNode();
    }

    // Link check button handlers
    var btnCheckLinks = document. GetElementById('btn-check-links');
    var btnCheckLinksFs = document. GetElementById('btn-check-links-fs');

    btnCheckLinks. AddEventListener('click', function() {
      checkLinks(btnCheckLinks, btnCheckLinksFs);
    });
    btnCheckLinksFs. AddEventListener('click', function() {
      checkLinks(btnCheckLinksFs, btnCheckLinks);
    });

    // Update node visual status
    function updateNodeStatus(path, status) {
      if (!window. CurrentNodes) return;

      window. CurrentNodes
        .filter((d) => d.path === path)
        .select('. Status-indicator')
        .attr(
          'fill',
          status === 'ok'
            ? '#10B981'
            : status === 'error'
              ? '#EF4444'
              : '#F59E0B',
        )
        .attr('stroke', 'white');
    }

    // Handle resize - store for cleanup
    window.__sitemapHandlers. Resize = function() {
      width = container. ClientWidth;
      height = container. ClientHeight;

      if (simulation) {
        simulation.force('center', d3.forceCenter(width / 2, height / 2));
        simulation.alpha(0.3).restart();
      }
    };
    window. AddEventListener('resize', window.__sitemapHandlers. Resize);

    // Initial render
    render('force');
  } // End of initSitemapVisualization function

  // Register event listeners once
  document. AddEventListener('astro:page-load', initSitemapVisualization);
  document. AddEventListener('astro:before-swap', cleanupSitemap);
}
</script>

<style>
  . Node circle {
    transition: all 0.3s ease;
  }

  . Node:hover circle {
    transform: scale(1.1);
  }

  #sitemap-container {
    background: radial-gradient(
            ellipse at 20% 30%,
            rgba(56, 163, 165, 0.15) 0%,
            transparent 50%
    ),
    radial-gradient(
            ellipse at 80% 70%,
            rgba(128, 206, 215, 0.1) 0%,
            transparent 40%
    ),
    radial-gradient(
            ellipse at 50% 50%,
            rgba(15, 76, 92, 0.3) 0%,
            transparent 60%
    ),
    linear-gradient(
            180deg,
            #030a0d 0%,
            #0a1f26 30%,
            #0f3540 60%,
            #0a1f26 85%,
            #030a0d 100%
    );
  }

  #sitemap-svg {
    background: radial-gradient(
            circle at 30% 40%,
            rgba(56, 163, 165, 0.08) 0%,
            transparent 35%
    ),
    radial-gradient(
            circle at 70% 60%,
            rgba(128, 206, 215, 0.06) 0%,
            transparent 30%
    ),
    radial-gradient(
            circle at 50% 80%,
            rgba(15, 76, 92, 0.1) 0%,
            transparent 40%
    );
  }

  /* Animated grid pattern */
  #sitemap-container::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
            rgba(56, 163, 165, 0.03) 1px,
            transparent 1px
    ),
    linear-gradient(90deg, rgba(56, 163, 165, 0.03) 1px, transparent 1px);
    background-size: 50px 50px;
    pointer-events: none;
    z-index: 0;
    border-radius: inherit;
  }

  /* Subtle animated glow */
  #sitemap-container::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 80%;
    height: 80%;
    transform: translate(-50%, -50%);
    background: radial-gradient(
            ellipse at center,
            rgba(56, 163, 165, 0.05) 0%,
            transparent 70%
    );
    pointer-events: none;
    z-index: 0;
    animation: pulse-glow 8s ease-in-out infinite;
  }

  @keyframes pulse-glow {
    0%,
    100% {
      opacity: 0.5;
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.1);
    }
  }
</style>
