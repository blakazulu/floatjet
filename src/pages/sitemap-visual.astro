---
import BaseLayout from '../layouts/BaseLayout.astro';
import {SITE_STRUCTURE, CATEGORY_COLORS} from '../utils/generateSiteStructure';

const title = 'Interactive Site Map | FloatJet';
const description = 'Explore the FloatJet site structure with our interactive visualization. Navigate through tools, gear, guides, and articles.';

// Pass data to client
const siteData = JSON.stringify(SITE_STRUCTURE);
const colorData = JSON.stringify(CATEGORY_COLORS);
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen pt-24 md:pt-28 pb-12 px-4">
    <!-- Header -->
    <div class="max-w-7xl mx-auto mb-8">
      <div class="text-center">
        <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-4">
          Interactive Site Map
        </h1>
        <p class="text-sky-100 text-lg max-w-2xl mx-auto">
          Explore FloatJet's content structure. Click nodes to navigate, drag to explore, and scroll to zoom.
        </p>
      </div>

      <!-- Controls -->
      <div class="flex flex-wrap justify-center gap-3 mt-6">
        <button
            id="btn-reset"
            class="px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-full text-sm font-medium backdrop-blur-sm border border-white/20 transition-all duration-300"
        >
          Reset View
        </button>
        <button
            id="btn-check-links"
            class="px-4 py-2 bg-jet-stream/80 hover:bg-jet-stream text-white rounded-full text-sm font-medium backdrop-blur-sm transition-all duration-300"
        >
          Check Links
        </button>
        <div class="flex items-center gap-2 px-4 py-2 bg-white/10 rounded-full backdrop-blur-sm border border-white/20">
          <label for="layout-select" class="text-white text-sm">Layout:</label>
          <select id="layout-select" aria-label="Select visualization layout"
                  class="bg-transparent text-white text-sm border-none outline-none cursor-pointer">
            <option value="force" class="text-slate-800">Force Graph</option>
            <option value="radial" class="text-slate-800">Radial Tree</option>
            <option value="tree" class="text-slate-800">Hierarchical</option>
          </select>
        </div>
      </div>

      <!-- Legend -->
      <div class="flex flex-wrap justify-center gap-4 mt-6" id="legend">
        <div class="flex items-center gap-2 text-sm text-white/80">
          <span class="w-4 h-4 rounded-full bg-ocean-deep border-2 border-white/50"></span>
          <span>Home</span>
        </div>
        <div class="flex items-center gap-2 text-sm text-white/80">
          <span class="w-4 h-4 rounded-full bg-jet-stream border-2 border-white/50"></span>
          <span>Hubs</span>
        </div>
        <div class="flex items-center gap-2 text-sm text-white/80">
          <span class="w-4 h-4 rounded-full bg-sky-light border-2 border-white/50"></span>
          <span>Categories</span>
        </div>
        <div class="flex items-center gap-2 text-sm text-white/80">
          <span class="w-4 h-4 rounded-full bg-blue-500 border-2 border-white/50"></span>
          <span>Articles</span>
        </div>
        <div class="flex items-center gap-2 text-sm text-white/80">
          <span class="w-4 h-4 rounded-full bg-slate-500 border-2 border-white/50"></span>
          <span>Pages</span>
        </div>
      </div>
    </div>

    <!-- Visualization Container -->
    <div id="sitemap-wrapper" class="max-w-7xl mx-auto transition-all duration-300">
      <div
          id="sitemap-container"
          class="relative w-full bg-white/5 backdrop-blur-md rounded-3xl border border-white/20 shadow-2xl overflow-hidden transition-all duration-300"
          style="height: 70vh; min-height: 500px;"
      >
        <!-- Fullscreen Toggle Button -->
        <button
            id="btn-fullscreen"
            class="absolute top-4 right-4 z-40 p-3 bg-white/10 hover:bg-white/20 text-white rounded-full backdrop-blur-sm border border-white/20 transition-all duration-300 group"
            aria-label="Toggle fullscreen"
        >
          <svg id="icon-expand" class="w-5 h-5 transition-transform group-hover:scale-110" fill="none"
               stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
          </svg>
          <svg id="icon-collapse" class="w-5 h-5 hidden transition-transform group-hover:scale-110" fill="none"
               stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 9L4 4m0 0v4m0-4h4m7 5l5-5m0 0v4m0-4h-4M9 15l-5 5m0 0v-4m0 4h4m7-5l5 5m0 0v-4m0 4h-4"/>
          </svg>
        </button>

        <!-- Fullscreen Controls Overlay (hidden by default) -->
        <div id="fullscreen-controls"
             class="hidden absolute top-0 left-0 right-0 z-20 pt-4 pb-6 px-4 bg-gradient-to-b from-black/80 via-black/50 to-transparent">
          <div class="flex flex-col items-center gap-4">
            <!-- Controls -->
            <div class="flex flex-wrap justify-center gap-3">
              <button
                  id="btn-reset-fs"
                  class="px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-full text-sm font-medium backdrop-blur-sm border border-white/20 transition-all duration-300"
              >
                Reset View
              </button>
              <button
                  id="btn-check-links-fs"
                  class="px-4 py-2 bg-jet-stream/80 hover:bg-jet-stream text-white rounded-full text-sm font-medium backdrop-blur-sm transition-all duration-300"
              >
                Check Links
              </button>
              <div
                  class="flex items-center gap-2 px-4 py-2 bg-white/10 rounded-full backdrop-blur-sm border border-white/20">
                <label for="layout-select-fs" class="text-white text-sm">Layout:</label>
                <select id="layout-select-fs" aria-label="Select visualization layout"
                        class="bg-transparent text-white text-sm border-none outline-none cursor-pointer">
                  <option value="force" class="text-slate-800">Force Graph</option>
                  <option value="radial" class="text-slate-800">Radial Tree</option>
                  <option value="tree" class="text-slate-800">Hierarchical</option>
                </select>
              </div>
              <button
                  id="btn-exit-fullscreen"
                  class="px-4 py-2 bg-red-500/60 hover:bg-red-500/80 text-white rounded-full text-sm font-medium backdrop-blur-sm border border-red-400/30 transition-all duration-300"
              >
                Exit Fullscreen
              </button>
            </div>

            <!-- Legend -->
            <div class="flex flex-wrap justify-center gap-4">
              <div class="flex items-center gap-2 text-sm text-white/80">
                <span class="w-4 h-4 rounded-full bg-ocean-deep border-2 border-white/50"></span>
                <span>Home</span>
              </div>
              <div class="flex items-center gap-2 text-sm text-white/80">
                <span class="w-4 h-4 rounded-full bg-jet-stream border-2 border-white/50"></span>
                <span>Hubs</span>
              </div>
              <div class="flex items-center gap-2 text-sm text-white/80">
                <span class="w-4 h-4 rounded-full bg-sky-light border-2 border-white/50"></span>
                <span>Categories</span>
              </div>
              <div class="flex items-center gap-2 text-sm text-white/80">
                <span class="w-4 h-4 rounded-full bg-blue-500 border-2 border-white/50"></span>
                <span>Articles</span>
              </div>
              <div class="flex items-center gap-2 text-sm text-white/80">
                <span class="w-4 h-4 rounded-full bg-slate-500 border-2 border-white/50"></span>
                <span>Pages</span>
              </div>
            </div>
          </div>
        </div>
        <!-- Loading State -->
        <div id="loading"
             class="absolute inset-0 flex items-center justify-center bg-ocean-deep/50 backdrop-blur-sm z-10">
          <div class="text-center">
            <div
                class="w-16 h-16 border-4 border-sky-light border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
            <p class="text-white font-medium">Building visualization...</p>
          </div>
        </div>

        <!-- SVG will be injected here -->
        <svg id="sitemap-svg" class="w-full h-full"></svg>

        <!-- Tooltip -->
        <div
            id="tooltip"
            class="absolute pointer-events-none opacity-0 transition-opacity duration-200 z-20 px-4 py-3 bg-ocean-deep/95 backdrop-blur-md rounded-xl shadow-xl border border-white/20 text-white max-w-xs"
        >
          <div id="tooltip-name" class="font-heading font-bold text-lg mb-1"></div>
          <div id="tooltip-path" class="text-sky-light text-sm font-mono mb-2"></div>
          <div id="tooltip-type" class="text-xs text-white/70 uppercase tracking-wide"></div>
          <div id="tooltip-status" class="mt-2 text-sm hidden">
            <span id="tooltip-status-icon"></span>
            <span id="tooltip-status-text"></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats Panel -->
    <div class="max-w-7xl mx-auto mt-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-4 border border-white/20 text-center">
          <div class="text-3xl font-bold text-white" id="stat-total">0</div>
          <div class="text-sky-100 text-sm">Total Pages</div>
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-4 border border-white/20 text-center">
          <div class="text-3xl font-bold text-emerald-400" id="stat-healthy">-</div>
          <div class="text-sky-100 text-sm">Healthy Links</div>
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-4 border border-white/20 text-center">
          <div class="text-3xl font-bold text-amber-400" id="stat-pending">-</div>
          <div class="text-sky-100 text-sm">Unchecked</div>
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-4 border border-white/20 text-center">
          <div class="text-3xl font-bold text-red-400" id="stat-broken">-</div>
          <div class="text-sky-100 text-sm">Broken Links</div>
        </div>
      </div>
    </div>

    <!-- Link Check Results -->
    <div id="link-results" class="max-w-7xl mx-auto mt-8 hidden">
      <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 border border-white/20">
        <h2 class="font-heading text-xl font-bold text-white mb-4">Link Check Results</h2>
        <div id="link-results-content" class="space-y-2"></div>
      </div>
    </div>
  </div>
</BaseLayout>

<!-- D3.js CDN -->
<script is:inline src="https://d3js.org/d3.v7.min.js"></script>

<script define:vars={{siteData, colorData}}>
  // Store data globally for reinitialization
  window.__sitemapData = {
    siteData: siteData,
    colorData: colorData
  };
</script>

<script>
  // Main initialization function
  function initSitemapVisualization() {
    // Check if D3 is loaded
    if (typeof d3 === 'undefined') {
      console.error('D3 not loaded');
      return;
    }

    // Check if container exists (we're on the right page)
    const container = document.getElementById('sitemap-container');
    if (!container) return;

    // Parse data
    const siteStructure = JSON.parse(window.__sitemapData.siteData);
    const categoryColors = JSON.parse(window.__sitemapData.colorData);

    // State
    let currentLayout = 'force';
    let simulation = null;
    let linkStatus = new Map();

    // DOM Elements
    const svgEl = document.getElementById('sitemap-svg');
    const loading = document.getElementById('loading');
    const tooltip = document.getElementById('tooltip');

    // Clear any existing SVG content
    svgEl.innerHTML = '';

    const svg = d3.select('#sitemap-svg');

    // Dimensions
    let width = container.clientWidth;
    let height = container.clientHeight;

    // Create main group for zoom/pan
    const g = svg.append('g');

    // Initialize zoom behavior
    const zoom = d3.zoom()
      .scaleExtent([0.1, 4])
      .on('zoom', (event) => {
        g.attr('transform', event.transform);
      });

    svg.call(zoom);

    // Define gradients and filters
    const defs = svg.append('defs');

    // Glow filter for nodes
    const glow = defs.append('filter')
      .attr('id', 'glow')
      .attr('x', '-50%')
      .attr('y', '-50%')
      .attr('width', '200%')
      .attr('height', '200%');

    glow.append('feGaussianBlur')
      .attr('stdDeviation', '3')
      .attr('result', 'coloredBlur');

    const glowMerge = glow.append('feMerge');
    glowMerge.append('feMergeNode').attr('in', 'coloredBlur');
    glowMerge.append('feMergeNode').attr('in', 'SourceGraphic');

    // Create arrow marker for links
    defs.append('marker')
      .attr('id', 'arrowhead')
      .attr('viewBox', '-0 -5 10 10')
      .attr('refX', 20)
      .attr('refY', 0)
      .attr('orient', 'auto')
      .attr('markerWidth', 6)
      .attr('markerHeight', 6)
      .append('path')
      .attr('d', 'M 0,-5 L 10,0 L 0,5')
      .attr('fill', 'rgba(128, 206, 215, 0.5)');

    // Get node color based on type and category
    function getNodeColor(node) {
      if (node.type === 'root') return '#0F4C5C';
      if (node.type === 'hub') return '#38A3A5';
      if (node.type === 'category') return '#80CED7';
      if (node.type === 'page') return '#64748B';

      // Article colors by category
      const categoryColorMap = {
        security: '#10B981',
        saas: '#3B82F6',
        hosting: '#8B5CF6',
        finance: '#F59E0B',
        travel: '#EC4899',
        gear: '#EE6C4D',
        guides: '#9333EA',
        tools: '#38A3A5',
      };

      return categoryColorMap[node.category] || '#38A3A5';
    }

    // Get node size based on type
    function getNodeSize(node) {
      if (node.type === 'root') return 30;
      if (node.type === 'hub') return 20;
      if (node.type === 'category') return 15;
      return 10;
    }

    // Initialize force simulation
    function createForceSimulation(nodes, links) {
      return d3.forceSimulation(nodes)
        .force('link', d3.forceLink(links)
          .id(d => d.id)
          .distance(d => {
            const sourceType = d.source.type || 'article';
            if (sourceType === 'root') return 150;
            if (sourceType === 'hub') return 100;
            return 70;
          })
          .strength(0.5)
        )
        .force('charge', d3.forceManyBody()
          .strength(d => {
            if (d.type === 'root') return -800;
            if (d.type === 'hub') return -400;
            return -150;
          })
        )
        .force('center', d3.forceCenter(width / 2, height / 2))
        .force('collision', d3.forceCollide().radius(d => getNodeSize(d) + 10));
    }

    // Build hierarchy from flat structure
    function buildHierarchy() {
      const nodeMap = new Map();

      // Create node objects
      siteStructure.nodes.forEach(n => {
        nodeMap.set(n.id, {...n, children: []});
      });

      // Build parent-child relationships
      siteStructure.links.forEach(link => {
        const parent = nodeMap.get(link.source);
        const child = nodeMap.get(link.target);
        if (parent && child) {
          parent.children.push(child);
        }
      });

      return nodeMap.get('/');
    }

    // Render the visualization
    function render(layout = 'force') {
      // Clear previous content
      g.selectAll('*').remove();

      // Stop any running simulation
      if (simulation) {
        simulation.stop();
        simulation = null;
      }

      // Update stats
      document.getElementById('stat-total').textContent = siteStructure.nodes.length;

      if (layout === 'force') {
        renderForceLayout();
      } else if (layout === 'radial') {
        renderRadialLayout();
      } else if (layout === 'tree') {
        renderTreeLayout();
      }

      // Remove loading state
      loading.classList.add('hidden');
    }

    // Force-directed layout
    function renderForceLayout() {
      const nodes = siteStructure.nodes.map(d => ({...d}));
      const links = siteStructure.links.map(d => ({
        source: d.source,
        target: d.target,
        type: d.type
      }));

      const link = g.append('g')
        .attr('class', 'links')
        .selectAll('line')
        .data(links)
        .enter()
        .append('line')
        .attr('stroke', 'rgba(128, 206, 215, 0.3)')
        .attr('stroke-width', 1.5)
        .attr('marker-end', 'url(#arrowhead)');

      const node = g.append('g')
        .attr('class', 'nodes')
        .selectAll('g')
        .data(nodes)
        .enter()
        .append('g')
        .attr('class', 'node')
        .style('cursor', 'pointer')
        .call(d3.drag()
          .on('start', dragstarted)
          .on('drag', dragged)
          .on('end', dragended)
        );

      addNodeElements(node);
      addNodeInteractions(node, link);

      simulation = createForceSimulation(nodes, links);

      simulation.on('tick', () => {
        link
          .attr('x1', d => d.source.x)
          .attr('y1', d => d.source.y)
          .attr('x2', d => d.target.x)
          .attr('y2', d => d.target.y);
        node.attr('transform', d => `translate(${d.x},${d.y})`);
      });

      animateIn(node, link);
      window.currentNodes = node;
    }

    // Radial tree layout
    function renderRadialLayout() {
      const hierarchy = buildHierarchy();
      const root = d3.hierarchy(hierarchy);

      const radius = Math.min(width, height) / 2 - 100;

      const treeLayout = d3.tree()
        .size([2 * Math.PI, radius])
        .separation((a, b) => (a.parent === b.parent ? 1 : 2) / a.depth);

      treeLayout(root);

      // Create curved links
      const link = g.append('g')
        .attr('class', 'links')
        .attr('transform', `translate(${width / 2},${height / 2})`)
        .selectAll('path')
        .data(root.links())
        .enter()
        .append('path')
        .attr('fill', 'none')
        .attr('stroke', 'rgba(128, 206, 215, 0.4)')
        .attr('stroke-width', 1.5)
        .attr('d', d3.linkRadial()
          .angle(d => d.x)
          .radius(d => d.y)
        );

      const node = g.append('g')
        .attr('class', 'nodes')
        .attr('transform', `translate(${width / 2},${height / 2})`)
        .selectAll('g')
        .data(root.descendants())
        .enter()
        .append('g')
        .attr('class', 'node')
        .style('cursor', 'pointer')
        .attr('transform', d => `rotate(${d.x * 180 / Math.PI - 90}) translate(${d.y},0)`);

      addNodeElements(node, true);
      addNodeInteractions(node, link, true);

      // Add labels with proper rotation
      node.append('text')
        .attr('dy', '0.31em')
        .attr('x', d => d.x < Math.PI === !d.children ? 6 : -6)
        .attr('text-anchor', d => d.x < Math.PI === !d.children ? 'start' : 'end')
        .attr('transform', d => d.x >= Math.PI ? 'rotate(180)' : null)
        .attr('fill', 'white')
        .attr('font-size', d => d.data.type === 'root' ? '12px' : '10px')
        .attr('font-family', 'Outfit, sans-serif')
        .text(d => d.data.name)
        .style('text-shadow', '0 2px 4px rgba(0,0,0,0.8)')
        .clone(true).lower()
        .attr('stroke', 'rgba(0,0,0,0.5)')
        .attr('stroke-width', 3);

      animateIn(node, link);
      window.currentNodes = node;
    }

    // Hierarchical tree layout
    function renderTreeLayout() {
      const hierarchy = buildHierarchy();
      const root = d3.hierarchy(hierarchy);

      const treeLayout = d3.tree()
        .size([width - 200, height - 150]);

      treeLayout(root);

      // Create curved links
      const link = g.append('g')
        .attr('class', 'links')
        .attr('transform', 'translate(100, 50)')
        .selectAll('path')
        .data(root.links())
        .enter()
        .append('path')
        .attr('fill', 'none')
        .attr('stroke', 'rgba(128, 206, 215, 0.4)')
        .attr('stroke-width', 1.5)
        .attr('d', d3.linkVertical()
          .x(d => d.x)
          .y(d => d.y)
        );

      const node = g.append('g')
        .attr('class', 'nodes')
        .attr('transform', 'translate(100, 50)')
        .selectAll('g')
        .data(root.descendants())
        .enter()
        .append('g')
        .attr('class', 'node')
        .style('cursor', 'pointer')
        .attr('transform', d => `translate(${d.x},${d.y})`);

      addNodeElements(node, true);
      addNodeInteractions(node, link, true);

      // Add labels below nodes
      node.append('text')
        .attr('dy', d => getNodeSize(d.data || d) + 14)
        .attr('text-anchor', 'middle')
        .attr('fill', 'white')
        .attr('font-size', d => (d.data || d).type === 'root' ? '11px' : '9px')
        .attr('font-family', 'Outfit, sans-serif')
        .text(d => (d.data || d).name)
        .style('text-shadow', '0 2px 4px rgba(0,0,0,0.8)');

      animateIn(node, link);
      window.currentNodes = node;
    }

    // Shared function to add node visual elements
    function addNodeElements(node, isHierarchy = false) {
      node.append('circle')
        .attr('r', d => getNodeSize(isHierarchy ? d.data : d))
        .attr('fill', d => getNodeColor(isHierarchy ? d.data : d))
        .attr('stroke', 'rgba(255, 255, 255, 0.5)')
        .attr('stroke-width', 2)
        .attr('filter', d => {
          const data = isHierarchy ? d.data : d;
          return data.type === 'root' || data.type === 'hub' ? 'url(#glow)' : null;
        })
        .style('transition', 'all 0.3s ease');

      node.append('circle')
        .attr('class', 'status-indicator')
        .attr('r', 5)
        .attr('cx', d => getNodeSize(isHierarchy ? d.data : d) - 2)
        .attr('cy', d => -getNodeSize(isHierarchy ? d.data : d) + 2)
        .attr('fill', 'transparent')
        .attr('stroke', 'transparent');
    }

    // Shared function to add hover/click interactions
    function addNodeInteractions(node, link, isHierarchy = false) {
      node
        .on('mouseover', function (event, d) {
          const data = isHierarchy ? d.data : d;
          d3.select(this).select('circle')
            .attr('stroke', 'white')
            .attr('stroke-width', 3);
          showTooltip(event, data);

          if (!isHierarchy) {
            link
              .attr('stroke', l => (l.source.id === data.id || l.target.id === data.id)
                ? 'rgba(128, 206, 215, 0.8)' : 'rgba(128, 206, 215, 0.15)')
              .attr('stroke-width', l => (l.source.id === data.id || l.target.id === data.id) ? 3 : 1);
          }
        })
        .on('mouseout', function (event, d) {
          d3.select(this).select('circle')
            .attr('stroke', 'rgba(255, 255, 255, 0.5)')
            .attr('stroke-width', 2);
          hideTooltip();

          if (!isHierarchy) {
            link
              .attr('stroke', 'rgba(128, 206, 215, 0.3)')
              .attr('stroke-width', 1.5);
          }
        })
        .on('click', function (event, d) {
          const data = isHierarchy ? d.data : d;
          if (data.path) {
            window.location.href = data.path;
          }
        });
    }

    // Animate nodes and links in
    function animateIn(node, link) {
      node.style('opacity', 0)
        .transition()
        .duration(800)
        .delay((d, i) => i * 15)
        .style('opacity', 1);

      link.style('opacity', 0)
        .transition()
        .duration(800)
        .delay(300)
        .style('opacity', 1);
    }

    // Drag functions
    function dragstarted(event, d) {
      if (!event.active) simulation.alphaTarget(0.3).restart();
      d.fx = d.x;
      d.fy = d.y;
    }

    function dragged(event, d) {
      d.fx = event.x;
      d.fy = event.y;
    }

    function dragended(event, d) {
      if (!event.active) simulation.alphaTarget(0);
      d.fx = null;
      d.fy = null;
    }

    // Tooltip functions
    function showTooltip(event, d) {
      const rect = container.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;

      document.getElementById('tooltip-name').textContent = d.name;
      document.getElementById('tooltip-path').textContent = d.path;
      document.getElementById('tooltip-type').textContent = `${d.type}${d.category ? ' • ' + d.category : ''}`;

      // Show link status if available
      const statusEl = document.getElementById('tooltip-status');
      const statusIconEl = document.getElementById('tooltip-status-icon');
      const statusTextEl = document.getElementById('tooltip-status-text');

      if (linkStatus.has(d.path)) {
        const status = linkStatus.get(d.path);
        statusEl.classList.remove('hidden');
        if (status === 'ok') {
          statusIconEl.textContent = '✓ ';
          statusIconEl.className = 'text-emerald-400';
          statusTextEl.textContent = 'Link OK';
          statusTextEl.className = 'text-emerald-400';
        } else if (status === 'error') {
          statusIconEl.textContent = '✗ ';
          statusIconEl.className = 'text-red-400';
          statusTextEl.textContent = 'Link broken';
          statusTextEl.className = 'text-red-400';
        } else {
          statusIconEl.textContent = '○ ';
          statusIconEl.className = 'text-amber-400';
          statusTextEl.textContent = 'Checking...';
          statusTextEl.className = 'text-amber-400';
        }
      } else {
        statusEl.classList.add('hidden');
      }

      tooltip.style.left = `${Math.min(x + 10, width - 200)}px`;
      tooltip.style.top = `${Math.min(y + 10, height - 100)}px`;
      tooltip.classList.remove('opacity-0');
      tooltip.classList.add('opacity-100');
    }

    function hideTooltip() {
      tooltip.classList.remove('opacity-100');
      tooltip.classList.add('opacity-0');
    }

    // Fullscreen state
    let isFullscreen = false;
    const wrapper = document.getElementById('sitemap-wrapper');
    const fullscreenControls = document.getElementById('fullscreen-controls');
    const iconExpand = document.getElementById('icon-expand');
    const iconCollapse = document.getElementById('icon-collapse');
    const layoutSelectFs = document.getElementById('layout-select-fs');
    const layoutSelect = document.getElementById('layout-select');

    function enterFullscreen() {
      isFullscreen = true;

      // Hide page content, navbar, footer, and affiliate disclosure
      document.body.style.overflow = 'hidden';
      const header = document.querySelector('header');
      if (header) header.style.display = 'none';
      const footer = document.querySelector('footer');
      if (footer) footer.style.display = 'none';
      const affiliateDisclosure = document.querySelector('.affiliate-disclosure, [class*="affiliate"], #affiliate-disclosure');
      if (affiliateDisclosure) affiliateDisclosure.style.display = 'none';

      // Make wrapper fullscreen with highest z-index
      wrapper.classList.remove('max-w-7xl', 'mx-auto');
      wrapper.classList.add('fixed', 'inset-0');
      wrapper.style.zIndex = '9999';

      // Make container fullscreen
      container.classList.remove('rounded-3xl', 'border', 'border-white/20');
      container.style.height = '100vh';
      container.style.minHeight = '100vh';
      container.style.borderRadius = '0';

      // Show fullscreen controls, hide normal controls
      fullscreenControls.classList.remove('hidden');
      iconExpand.classList.add('hidden');
      iconCollapse.classList.remove('hidden');

      // Sync layout select
      layoutSelectFs.value = currentLayout;

      // Update dimensions and re-render
      setTimeout(() => {
        width = container.clientWidth;
        height = container.clientHeight;
        render(currentLayout);
      }, 350);
    }

    function exitFullscreen() {
      isFullscreen = false;

      // Restore page scroll, navbar, footer, and affiliate disclosure
      document.body.style.overflow = '';
      const header = document.querySelector('header');
      if (header) header.style.display = '';
      const footer = document.querySelector('footer');
      if (footer) footer.style.display = '';
      const affiliateDisclosure = document.querySelector('.affiliate-disclosure, [class*="affiliate"], #affiliate-disclosure');
      if (affiliateDisclosure) affiliateDisclosure.style.display = '';

      // Restore wrapper
      wrapper.classList.add('max-w-7xl', 'mx-auto');
      wrapper.classList.remove('fixed', 'inset-0');
      wrapper.style.zIndex = '';

      // Restore container
      container.classList.add('rounded-3xl', 'border', 'border-white/20');
      container.style.height = '70vh';
      container.style.minHeight = '500px';
      container.style.borderRadius = '';

      // Hide fullscreen controls
      fullscreenControls.classList.add('hidden');
      iconExpand.classList.remove('hidden');
      iconCollapse.classList.add('hidden');

      // Sync layout select
      layoutSelect.value = currentLayout;

      // Update dimensions and re-render
      setTimeout(() => {
        width = container.clientWidth;
        height = container.clientHeight;
        render(currentLayout);
      }, 350);
    }

    // Fullscreen toggle button
    document.getElementById('btn-fullscreen').addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (isFullscreen) {
        exitFullscreen();
      } else {
        enterFullscreen();
      }
    });

    // Exit fullscreen button
    document.getElementById('btn-exit-fullscreen').addEventListener('click', exitFullscreen);

    // ESC key to exit fullscreen
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isFullscreen) {
        exitFullscreen();
      }
    });

    // Reset view (both normal and fullscreen)
    document.getElementById('btn-reset').addEventListener('click', () => {
      svg.transition()
        .duration(750)
        .call(zoom.transform, d3.zoomIdentity);
    });

    document.getElementById('btn-reset-fs').addEventListener('click', () => {
      svg.transition()
        .duration(750)
        .call(zoom.transform, d3.zoomIdentity);
    });

    // Layout change (both normal and fullscreen)
    document.getElementById('layout-select').addEventListener('change', (e) => {
      currentLayout = e.target.value;
      layoutSelectFs.value = currentLayout;
      render(currentLayout);
    });

    document.getElementById('layout-select-fs').addEventListener('change', (e) => {
      currentLayout = e.target.value;
      layoutSelect.value = currentLayout;
      render(currentLayout);
    });

    // Link checking function
    async function checkLinks(btn, btnFs) {
      btn.textContent = 'Checking...';
      btn.disabled = true;
      if (btnFs) {
        btnFs.textContent = 'Checking...';
        btnFs.disabled = true;
      }

      let healthy = 0;
      let broken = 0;
      let pending = siteStructure.nodes.length;

      document.getElementById('stat-pending').textContent = pending;
      document.getElementById('stat-healthy').textContent = healthy;
      document.getElementById('stat-broken').textContent = broken;

      const results = [];

      for (const node of siteStructure.nodes) {
        try {
          linkStatus.set(node.path, 'checking');
          updateNodeStatus(node.path, 'checking');

          const response = await fetch(node.path, {method: 'HEAD'});

          if (response.ok) {
            linkStatus.set(node.path, 'ok');
            updateNodeStatus(node.path, 'ok');
            healthy++;
          } else {
            linkStatus.set(node.path, 'error');
            updateNodeStatus(node.path, 'error');
            broken++;
            results.push({path: node.path, status: response.status, name: node.name});
          }
        } catch (err) {
          linkStatus.set(node.path, 'error');
          updateNodeStatus(node.path, 'error');
          broken++;
          results.push({path: node.path, status: 'Network Error', name: node.name});
        }

        pending--;
        document.getElementById('stat-pending').textContent = pending;
        document.getElementById('stat-healthy').textContent = healthy;
        document.getElementById('stat-broken').textContent = broken;
      }

      btn.textContent = 'Check Links';
      btn.disabled = false;
      if (btnFs) {
        btnFs.textContent = 'Check Links';
        btnFs.disabled = false;
      }

      // Show results if there are broken links
      if (results.length > 0) {
        const resultsEl = document.getElementById('link-results');
        const contentEl = document.getElementById('link-results-content');

        contentEl.innerHTML = results.map(r => `
        <div class="flex items-center justify-between p-3 bg-red-500/20 rounded-lg border border-red-500/30">
          <div>
            <div class="text-white font-medium">${r.name}</div>
            <div class="text-red-300 text-sm font-mono">${r.path}</div>
          </div>
          <div class="text-red-400 font-mono">${r.status}</div>
        </div>
      `).join('');

        resultsEl.classList.remove('hidden');
      } else {
        const resultsEl = document.getElementById('link-results');
        const contentEl = document.getElementById('link-results-content');
        contentEl.innerHTML = '<div class="text-emerald-400 text-center py-4">All links are healthy!</div>';
        resultsEl.classList.remove('hidden');
      }
    }

    // Link check button handlers
    const btnCheckLinks = document.getElementById('btn-check-links');
    const btnCheckLinksFs = document.getElementById('btn-check-links-fs');

    btnCheckLinks.addEventListener('click', () => checkLinks(btnCheckLinks, btnCheckLinksFs));
    btnCheckLinksFs.addEventListener('click', () => checkLinks(btnCheckLinksFs, btnCheckLinks));

    // Update node visual status
    function updateNodeStatus(path, status) {
      if (!window.currentNodes) return;

      window.currentNodes
        .filter(d => d.path === path)
        .select('.status-indicator')
        .attr('fill', status === 'ok' ? '#10B981' : status === 'error' ? '#EF4444' : '#F59E0B')
        .attr('stroke', 'white');
    }

    // Handle resize
    function handleResize() {
      width = container.clientWidth;
      height = container.clientHeight;

      if (simulation) {
        simulation.force('center', d3.forceCenter(width / 2, height / 2));
        simulation.alpha(0.3).restart();
      }
    }

    window.addEventListener('resize', handleResize);

    // Initial render
    render('force');
  } // End of initSitemapVisualization function

  // Initialize on first load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSitemapVisualization);
  } else {
    initSitemapVisualization();
  }

  // Re-initialize on View Transitions navigation
  document.addEventListener('astro:page-load', initSitemapVisualization);
</script>

<style>
  .node circle {
    transition: all 0.3s ease;
  }

  .node:hover circle {
    transform: scale(1.1);
  }

  #sitemap-container {
    background: radial-gradient(ellipse at 20% 30%, rgba(56, 163, 165, 0.15) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 70%, rgba(128, 206, 215, 0.1) 0%, transparent 40%),
    radial-gradient(ellipse at 50% 50%, rgba(15, 76, 92, 0.3) 0%, transparent 60%),
    linear-gradient(180deg, #030a0d 0%, #0a1f26 30%, #0f3540 60%, #0a1f26 85%, #030a0d 100%);
  }

  #sitemap-svg {
    background: radial-gradient(circle at 30% 40%, rgba(56, 163, 165, 0.08) 0%, transparent 35%),
    radial-gradient(circle at 70% 60%, rgba(128, 206, 215, 0.06) 0%, transparent 30%),
    radial-gradient(circle at 50% 80%, rgba(15, 76, 92, 0.1) 0%, transparent 40%);
  }

  /* Animated grid pattern */
  #sitemap-container::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(56, 163, 165, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(56, 163, 165, 0.03) 1px, transparent 1px);
    background-size: 50px 50px;
    pointer-events: none;
    z-index: 0;
    border-radius: inherit;
  }

  /* Subtle animated glow */
  #sitemap-container::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 80%;
    height: 80%;
    transform: translate(-50%, -50%);
    background: radial-gradient(ellipse at center, rgba(56, 163, 165, 0.05) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
    animation: pulse-glow 8s ease-in-out infinite;
  }

  @keyframes pulse-glow {
    0%, 100% {
      opacity: 0.5;
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.1);
    }
  }
</style>
