---
import { Image } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import { team, getFounder } from "@data/team";

const title = "Meet the Team | FloatJet";
const description = "Meet the people behind FloatJet. The FloatJet Editorial Team researches and writes our guides to remote work tools, gear, and productivity.";

const founder = getFounder();

// AboutPage schema - the organization itself is defined site-wide in BaseLayout
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  url: "https://floatjet.com/team/",
  name: "Meet the Team",
  about: {
    "@type": "Organization",
    "@id": "https://floatjet.com/#organization",
    department: {
      "@type": "Organization",
      name: "FloatJet Editorial Team",
      url: "https://floatjet.com/team/",
    },
    employee: team.map((member) => ({
      "@type": "Person",
      name: member.name,
      jobTitle: member.title,
      url: `https://floatjet.com/authors/${member.slug}/`,
    })),
  },
};
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-28 md:pt-36 pb-16 md:pb-20">
    <article class="max-w-5xl mx-auto">
      <!-- Hero Section -->
      <header class="text-center mb-12">
        <h1 class="page-title">Meet the Team</h1>
        <p class="page-subtitle">
          The people behind the reviews, guides, and recommendations that help you work better from anywhere.
        </p>
      </header>

      <!-- Founder Section -->
      {founder && (
        <section class="founder-section">
          <h2 class="section-title">Founder</h2>
          <div class="founder-card">
            <div class="founder-image-wrap">
              <a href={`/authors/${founder.slug}/`}>
                <Image
                  src={founder.image}
                  alt={founder.name}
                  width={200}
                  height={200}
                  class="founder-image"
                  loading="eager"
                />
              </a>
              <span class="founder-badge">Founder</span>
            </div>
            <div class="founder-content">
              <h3 class="founder-name">
                <a href={`/authors/${founder.slug}/`}>{founder.name}</a>
              </h3>
              <p class="founder-title">{founder.title}</p>
              <p class="founder-location">
                <svg class="location-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
                {founder.location}
              </p>
              <p class="founder-bio">{founder.bioShort}</p>
              {founder.social && (
                <div class="founder-social">
                  {founder.social.linkedin && (
                    <a href={founder.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${founder.name} on LinkedIn`} class="social-link">
                      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                      </svg>
                    </a>
                  )}
                  {founder.social.github && (
                    <a href={founder.social.github} target="_blank" rel="noopener noreferrer" aria-label={`${founder.name} on GitHub`} class="social-link">
                      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                      </svg>
                    </a>
                  )}
                </div>
              )}
              <a href={`/authors/${founder.slug}/`} class="view-profile-link">
                View Full Profile
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="m9 18 6-6-6-6"/>
                </svg>
              </a>
            </div>
          </div>
        </section>
      )}

      <!-- Editorial Team Section -->
      <section class="writers-section" id="editorial-team">
        <h2 class="section-title">FloatJet Editorial Team</h2>
        <p class="section-description">
          Every article on FloatJet is published under the FloatJet Editorial Team byline. We research each topic using
          manufacturer specifications, official documentation, current pricing, and published studies, and we link to our
          sources so you can check them yourself.
        </p>
        <p class="section-description">
          Spotted an error or something out of date? <a href="/contact/" class="view-profile-link">Let us know</a> and we will fix it.
        </p>
      </section>

      <!-- Join Us Section -->
      <section class="join-section">
        <h2 class="join-title">Want to Write for FloatJet?</h2>
        <p class="join-text">
          We're always looking for experienced remote workers who want to share their expertise. If you have hands-on experience with remote work tools, productivity systems, or the digital nomad lifestyle, we'd love to hear from you.
        </p>
        <a href="/contact/" class="join-link">
          Get in Touch
        </a>
      </section>
    </article>
  </div>

  <!-- Organization Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
</BaseLayout>

<style>
  /* Page Header */
  .page-title {
    font-family: var(--font-display);
    font-weight: 900;
    letter-spacing: -0.04em;
    font-size: 2.5rem;
    color: var(--color-ink);
    margin: 0 0 1rem 0;
  }

  @media (min-width: 640px) {
    .page-title {
      font-size: 3rem;
    }
  }

  .page-subtitle {
    font-size: 1.125rem;
    color: var(--color-ink-soft);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Section Title */
  .section-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.75rem;
    color: var(--color-ink);
    margin: 0 0 1rem 0;
  }

  .section-description {
    font-size: 1rem;
    color: var(--color-ink-soft);
    margin: 0 0 2rem 0;
    max-width: 700px;
  }

  /* Founder Section */
  .founder-section {
    margin-bottom: 4rem;
  }

  .founder-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding: 2rem;
    background: var(--color-card);
    border-radius: 1.5rem;
    border: 2px solid var(--color-ink);
    box-shadow: 6px 8px 0 0 var(--color-ink);
  }

  @media (min-width: 768px) {
    .founder-card {
      flex-direction: row;
      align-items: flex-start;
      padding: 2.5rem;
    }
  }

  .founder-image-wrap {
    position: relative;
    flex-shrink: 0;
  }

  .founder-image {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--color-ink);
    transition: border-color 0.2s ease;
  }

  @media (min-width: 768px) {
    .founder-image {
      width: 200px;
      height: 200px;
    }
  }

  .founder-image-wrap:hover .founder-image {
    border-color: var(--color-teal-ink);
  }

  .founder-badge {
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-sun);
    color: var(--color-ink);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .founder-content {
    flex: 1;
    text-align: center;
  }

  @media (min-width: 768px) {
    .founder-content {
      text-align: left;
    }
  }

  .founder-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.75rem;
    color: var(--color-ink);
    margin: 0 0 0.25rem 0;
  }

  .founder-name a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .founder-name a:hover {
    color: var(--color-teal-ink);
  }

  .founder-title {
    font-size: 1.125rem;
    color: var(--color-teal-ink);
    margin: 0 0 0.5rem 0;
    font-weight: 500;
  }

  .founder-location {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: var(--color-ink-soft);
    margin: 0 0 1rem 0;
  }

  @media (min-width: 768px) {
    .founder-location {
      justify-content: flex-start;
    }
  }

  .location-icon {
    width: 18px;
    height: 18px;
  }

  .founder-bio {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink);
    margin: 0 0 1.25rem 0;
  }

  .founder-social {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .founder-social {
      justify-content: flex-start;
    }
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--color-card);
    border-radius: 50%;
    border: 2px solid var(--color-ink);
    color: var(--color-ink-soft);
    transition: all 0.2s ease;
  }

  .social-link:hover {
    color: var(--color-teal-ink);
    background: var(--color-sand);
    border-color: var(--color-ink);
  }

  .social-link svg {
    width: 20px;
    height: 20px;
  }

  .view-profile-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-teal-ink);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9375rem;
    transition: gap 0.2s ease;
  }

  .view-profile-link:hover {
    gap: 0.75rem;
  }

  .view-profile-link svg {
    width: 18px;
    height: 18px;
  }

  /* Writers Section */
  .writers-section {
    margin-bottom: 4rem;
  }

  /* Join Section */
  .join-section {
    text-align: center;
    padding: 2.5rem;
    background: var(--color-card);
    border-radius: 1.5rem;
    border: 2px solid var(--color-ink);
    box-shadow: 6px 8px 0 0 var(--color-ink);
  }

  .join-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--color-ink);
    margin: 0 0 1rem 0;
  }

  .join-text {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink);
    max-width: 600px;
    margin: 0 auto 1.5rem auto;
  }

  .join-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    background: var(--color-ink);
    color: var(--color-sun);
    font-weight: 600;
    font-size: 1rem;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .join-link:hover {
    background: var(--color-sun);
    color: var(--color-ink);
  }
</style>
