---
import { Image } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import { team, getFounder, getWriters } from "@data/team";

const title = "Meet the Team | FloatJet";
const description = "Meet the team behind FloatJet. Our writers and experts help remote workers find the best tools, gear, and guides for productive work-from-anywhere lifestyles.";

const founder = getFounder();
const writers = getWriters();

// Organization schema
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "FloatJet",
  "url": "https://floatjet.com",
  "description": "FloatJet helps remote workers find the best tools, gear, and guides for productive work-from-anywhere lifestyles.",
  "employee": team.map(member => ({
    "@type": "Person",
    "name": member. Name,
    "jobTitle": member. Title,
    "url": `https://floatjet.com/authors/${member.slug}`
  }))
};
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <article class="max-w-5xl mx-auto">
      <!-- Hero Section -->
      <header class="text-center mb-12">
        <h1 class="page-title">Meet the Team</h1>
        <p class="page-subtitle">
          The people behind the reviews, guides, and recommendations that help you work better from anywhere.
        </p>
      </header>

      <!-- Founder Section -->
      {founder && (
        <section class="founder-section">
          <h2 class="section-title">Founder</h2>
          <div class="founder-card">
            <div class="founder-image-wrap">
              <a href={`/authors/${founder.slug}`}>
                <Image
                  src={founder.image}
                  alt={founder.name}
                  width={200}
                  height={200}
                  class="founder-image"
                  loading="eager"
                />
              </a>
              <span class="founder-badge">Founder</span>
            </div>
            <div class="founder-content">
              <h3 class="founder-name">
                <a href={`/authors/${founder.slug}`}>{founder.name}</a>
              </h3>
              <p class="founder-title">{founder.title}</p>
              <p class="founder-location">
                <svg class="location-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
                {founder.location}
              </p>
              <p class="founder-bio">{founder. BioShort}</p>
              {founder. Social && (
                <div class="founder-social">
                  {founder.social.linkedin && (
                    <a href={founder.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${founder.name} on LinkedIn`} class="social-link">
                      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                      </svg>
                    </a>
                  )}
                  {founder.social.github && (
                    <a href={founder.social.github} target="_blank" rel="noopener noreferrer" aria-label={`${founder.name} on GitHub`} class="social-link">
                      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                      </svg>
                    </a>
                  )}
                </div>
              )}
              <a href={`/authors/${founder.slug}`} class="view-profile-link">
                View Full Profile
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="m9 18 6-6-6-6"/>
                </svg>
              </a>
            </div>
          </div>
        </section>
      )}

      <!-- Writers Section -->
      <section class="writers-section">
        <h2 class="section-title">Our Writers</h2>
        <p class="section-description">
          Each writer brings real-world experience in their specialty. No generic advice. Just tested insights from people who actually work remotely.
        </p>

        <div class="writers-grid">
          {writers.map((writer) => (
            <div class="writer-card">
              <a href={`/authors/${writer.slug}`} class="writer-image-link">
                <Image
                  src={writer.image}
                  alt={writer.name}
                  width={120}
                  height={120}
                  class="writer-image"
                  loading="lazy"
                />
              </a>
              <div class="writer-content">
                <h3 class="writer-name">
                  <a href={`/authors/${writer.slug}`}>{writer.name}</a>
                </h3>
                <p class="writer-title">{writer.title}</p>
                <p class="writer-location">
                  <svg class="location-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                  {writer.location}
                </p>
                <p class="writer-bio">{writer.bioShort}</p>
                <div class="writer-categories">
                  {writer.categories.slice(0, 4).map((cat) => (
                    <span class="category-tag">{cat}</span>
                  ))}
                </div>
                <a href={`/authors/${writer.slug}`} class="view-profile-link-sm">
                  View Profile
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="m9 18 6-6-6-6"/>
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Join Us Section -->
      <section class="join-section">
        <h2 class="join-title">Want to Write for FloatJet?</h2>
        <p class="join-text">
          We're always looking for experienced remote workers who want to share their expertise. If you have hands-on experience with remote work tools, productivity systems, or the digital nomad lifestyle, we'd love to hear from you.
        </p>
        <a href="/contact" class="join-link">
          Get in Touch
        </a>
      </section>
    </article>
  </div>

  <!-- Organization Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
</BaseLayout>

<style>
  /* Page Header */
  . Page-title {
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 2.5rem;
    color: white;
    margin: 0 0 1rem 0;
  }

  @media (min-width: 640px) {
    . Page-title {
      font-size: 3rem;
    }
  }

  . Page-subtitle {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.7);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Section Title */
  . Section-title {
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 1.75rem;
    color: white;
    margin: 0 0 1rem 0;
  }

  . Section-description {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 2rem 0;
    max-width: 700px;
  }

  /* Founder Section */
  . Founder-section {
    margin-bottom: 4rem;
  }

  . Founder-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding: 2rem;
    background:
      linear-gradient(to bottom right, rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0.05), transparent),
      rgba(15, 23, 42, 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-top-color: rgba(255, 255, 255, 0.2);
    border-left-color: rgba(255, 255, 255, 0.2);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
  }

  @media (min-width: 768px) {
    . Founder-card {
      flex-direction: row;
      align-items: flex-start;
      padding: 2.5rem;
    }
  }

  . Founder-image-wrap {
    position: relative;
    flex-shrink: 0;
  }

  . Founder-image {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid rgba(56, 163, 165, 0.4);
    transition: border-color 0.2s ease;
  }

  @media (min-width: 768px) {
    . Founder-image {
      width: 200px;
      height: 200px;
    }
  }

  . Founder-image-wrap:hover . Founder-image {
    border-color: #80CED7;
  }

  . Founder-badge {
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, #38A3A5, #0F4C5C);
    color: white;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  . Founder-content {
    flex: 1;
    text-align: center;
  }

  @media (min-width: 768px) {
    . Founder-content {
      text-align: left;
    }
  }

  . Founder-name {
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 1.75rem;
    color: white;
    margin: 0 0 0.25rem 0;
  }

  . Founder-name a {
    color: white;
    text-decoration: none;
  }

  . Founder-name a:hover {
    color: #80CED7;
  }

  . Founder-title {
    font-size: 1.125rem;
    color: #38A3A5;
    margin: 0 0 0.5rem 0;
    font-weight: 500;
  }

  . Founder-location {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.6);
    margin: 0 0 1rem 0;
  }

  @media (min-width: 768px) {
    . Founder-location {
      justify-content: flex-start;
    }
  }

  . Location-icon {
    width: 18px;
    height: 18px;
  }

  . Founder-bio {
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 1.25rem 0;
  }

  . Founder-social {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    . Founder-social {
      justify-content: flex-start;
    }
  }

  . Social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.7);
    transition: all 0.2s ease;
  }

  . Social-link:hover {
    color: #80CED7;
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(128, 206, 215, 0.3);
  }

  . Social-link svg {
    width: 20px;
    height: 20px;
  }

  . View-profile-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #80CED7;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9375rem;
    transition: gap 0.2s ease;
  }

  . View-profile-link:hover {
    gap: 0.75rem;
  }

  . View-profile-link svg {
    width: 18px;
    height: 18px;
  }

  /* Writers Section */
  . Writers-section {
    margin-bottom: 4rem;
  }

  . Writers-grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    . Writers-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    . Writers-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  . Writer-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.5rem;
    background:
      linear-gradient(to bottom right, rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0.05), transparent),
      rgba(15, 23, 42, 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-top-color: rgba(255, 255, 255, 0.2);
    border-left-color: rgba(255, 255, 255, 0.2);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
  }

  . Writer-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
    background:
      linear-gradient(to bottom right, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02)),
      rgba(15, 23, 42, 0.85);
  }

  . Writer-image-link {
    display: block;
    margin-bottom: 1rem;
  }

  . Writer-image {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid rgba(56, 163, 165, 0.3);
    transition: border-color 0.2s ease;
  }

  @media (min-width: 640px) {
    . Writer-image {
      width: 120px;
      height: 120px;
    }
  }

  . Writer-image-link:hover . Writer-image {
    border-color: #80CED7;
  }

  . Writer-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  . Writer-name {
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    font-size: 1.25rem;
    color: white;
    margin: 0 0 0.25rem 0;
  }

  . Writer-name a {
    color: white;
    text-decoration: none;
  }

  . Writer-name a:hover {
    color: #80CED7;
  }

  . Writer-title {
    font-size: 0.875rem;
    color: #38A3A5;
    margin: 0 0 0.5rem 0;
    font-weight: 500;
  }

  . Writer-location {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.5);
    margin: 0 0 0.75rem 0;
  }

  . Location-icon-sm {
    width: 14px;
    height: 14px;
  }

  . Writer-bio {
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 1rem 0;
    flex: 1;
  }

  . Writer-categories {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  . Category-tag {
    display: inline-block;
    padding: 0.25rem 0.625rem;
    background: rgba(56, 163, 165, 0.15);
    border: 1px solid rgba(56, 163, 165, 0.25);
    border-radius: 9999px;
    font-size: 0.6875rem;
    color: #80CED7;
    font-weight: 500;
  }

  . View-profile-link-sm {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    font-size: 0.8125rem;
    transition: color 0.2s ease;
  }

  . View-profile-link-sm:hover {
    color: #80CED7;
  }

  . View-profile-link-sm svg {
    width: 16px;
    height: 16px;
  }

  /* Join Section */
  . Join-section {
    text-align: center;
    padding: 2.5rem;
    background:
      linear-gradient(to bottom right, rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0.05), transparent),
      rgba(15, 23, 42, 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-top-color: rgba(255, 255, 255, 0.2);
    border-left-color: rgba(255, 255, 255, 0.2);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
  }

  . Join-title {
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 1.5rem;
    color: white;
    margin: 0 0 1rem 0;
  }

  . Join-text {
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
    max-width: 600px;
    margin: 0 auto 1.5rem auto;
  }

  . Join-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    background: #38A3A5;
    color: white;
    font-weight: 600;
    font-size: 1rem;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  . Join-link:hover {
    background: #80CED7;
    color: #0F4C5C;
  }
</style>
