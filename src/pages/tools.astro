---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { toolsArticles, getArticlePath } from "../data/articles";

// Import category background images (from src/images for Astro Image optimization)
import categoryVpn from "../images/categories/category-vpn-security.webp";
import categorySaas from "../images/categories/category-saas-dashboard.webp";
import categoryHosting from "../images/categories/category-hosting-cloud.webp";
import categoryFinance from "../images/categories/category-finance-charts.webp";

const title = "Best Remote Work Tools & Software | FloatJet";
const description =
  "Discover the best tools and software for remote workers. In-depth reviews of project management, VPNs, productivity apps, and more.";

// Category filters with gradients
const categories = [
  { name: "All", href: "/tools", gradient: "from-jet-stream to-sky-light" },
  { name: "VPN & Security", href: "/tools/vpn", gradient: "from-violet-500 to-purple-600" },
  { name: "SaaS", href: "/tools/saas", gradient: "from-blue-500 to-cyan-500" },
  { name: "Hosting", href: "/tools/hosting", gradient: "from-emerald-500 to-teal-500" },
  { name: "Finance", href: "/tools/finance", gradient: "from-amber-500 to-orange-500" },
];

// Transform articles from data file into bento grid format
const allTools = toolsArticles.map((article) => ({
  title: article.title,
  description: article.description,
  href: getArticlePath(article),
  category: article.category.toUpperCase() === "VPN" ? "VPN" : article.category.charAt(0).toUpperCase() + article.category.slice(1),
  readTime: article.readingTime,
  image: article.image,
  featured: article.featured || false,
}));

// Pick random hero from featured articles
const featuredTools = allTools.filter((t) => t.featured);
const hero = featuredTools.length > 0
  ? featuredTools[Math.floor(Math.random() * featuredTools.length)]
  : allTools[0];

// Remaining tools shuffled
const remaining = allTools.filter((t) => t.href !== hero.href);
const shuffled = [...remaining].sort(() => Math.random() - 0.5);
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <!-- Compact Header + Filter Bar -->
    <div class="max-w-6xl mx-auto mb-6">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
        <div>
          <h1 class="text-2xl md:text-3xl font-bold text-white">Remote Work Tools</h1>
          <p class="text-white/60 text-sm mt-1">In-depth reviews & comparisons</p>
        </div>
        <!-- Filter Pills -->
        <div class="flex flex-wrap gap-2">
          {categories.map((cat, i) => (
            <a
              href={cat.href}
              class:list={[
                "px-3 py-1.5 rounded-full text-xs font-medium transition-all duration-300",
                i === 0
                  ? `bg-gradient-to-r ${cat.gradient} text-ocean-deep`
                  : "bg-white/5 text-white/70 hover:bg-white/10 hover:text-white border border-white/10"
              ]}
            >
              {cat.name}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Bento Mosaic Grid -->
    <div class="max-w-6xl mx-auto grid grid-cols-4 md:grid-cols-4 lg:grid-cols-6 gap-2 md:gap-3 auto-rows-[100px] md:auto-rows-[140px] lg:auto-rows-[160px]">

      <!-- HERO CELL: Large featured article -->
      <a
        href={hero.href}
        class="group col-span-4 md:col-span-2 lg:col-span-3 row-span-2 md:row-span-2 relative overflow-hidden rounded-2xl transition-all duration-300 hover:shadow-xl hover:shadow-jet-stream/10"
      >
        <img src={hero.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/10"></div>
        <div class="absolute inset-0 p-4 md:p-6 flex flex-col justify-end">
          <div class="flex items-center gap-2 mb-2">
            <span class="inline-block w-fit px-2 py-0.5 md:px-2.5 md:py-1 bg-jet-stream text-ocean-deep text-[10px] md:text-xs font-bold rounded-full">
              Featured
            </span>
            <span class="inline-block w-fit px-2 py-0.5 md:px-2.5 md:py-1 bg-white text-ocean-deep text-[10px] md:text-xs font-medium rounded-full">
              {hero.category}
            </span>
          </div>
          <h2 class="text-base md:text-2xl font-bold text-white group-hover:text-jet-stream transition-colors mb-1">
            {hero.title}
          </h2>
          <p class="text-white/70 text-sm line-clamp-2 hidden md:block mb-2">{hero.description}</p>
          <div class="flex items-center gap-3 text-[10px] md:text-xs">
            <span class="text-white/50">{hero.readTime} min</span>
            <span class="text-jet-stream font-medium flex items-center">
              Read
              <svg class="w-3 h-3 ml-1 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
            </span>
          </div>
        </div>
      </a>

      <!-- CATEGORY MINI CELLS: Glassmorphic with accent line + image background -->
      <a href="/tools/vpn" class="group col-span-1 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:scale-[1.02]">
        <Image src={categoryVpn} alt="" class="absolute inset-0 w-full h-full object-cover opacity-30 group-hover:opacity-40 transition-opacity" />
        <div class="absolute inset-0 bg-gradient-to-br from-black/70 to-black/50"></div>
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-violet-400 to-violet-600 rounded-l-xl"></div>
        <div class="relative z-10 h-full p-3 md:p-4 flex flex-col justify-between">
          <svg class="w-6 h-6 md:w-8 md:h-8 text-violet-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
          </svg>
          <div>
            <span class="text-white font-semibold text-sm md:text-base block leading-tight">VPN</span>
            <span class="text-white/50 text-[10px] md:text-xs">5 guides</span>
          </div>
        </div>
      </a>

      <a href="/tools/saas" class="group col-span-1 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:scale-[1.02]">
        <Image src={categorySaas} alt="" class="absolute inset-0 w-full h-full object-cover opacity-30 group-hover:opacity-40 transition-opacity" />
        <div class="absolute inset-0 bg-gradient-to-br from-black/70 to-black/50"></div>
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-blue-400 to-cyan-500 rounded-l-xl"></div>
        <div class="relative z-10 h-full p-3 md:p-4 flex flex-col justify-between">
          <svg class="w-6 h-6 md:w-8 md:h-8 text-cyan-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
          </svg>
          <div>
            <span class="text-white font-semibold text-sm md:text-base block leading-tight">SaaS</span>
            <span class="text-white/50 text-[10px] md:text-xs">8 guides</span>
          </div>
        </div>
      </a>

      <a href="/tools/hosting" class="group col-span-1 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:scale-[1.02]">
        <Image src={categoryHosting} alt="" class="absolute inset-0 w-full h-full object-cover opacity-30 group-hover:opacity-40 transition-opacity" />
        <div class="absolute inset-0 bg-gradient-to-br from-black/70 to-black/50"></div>
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-emerald-400 to-teal-500 rounded-l-xl"></div>
        <div class="relative z-10 h-full p-3 md:p-4 flex flex-col justify-between">
          <svg class="w-6 h-6 md:w-8 md:h-8 text-emerald-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 0 1-3-3m3 3a3 3 0 1 0 0 6h13.5a3 3 0 1 0 0-6m-16.5-3a3 3 0 0 1 3-3h13.5a3 3 0 0 1 3 3m-19.5 0a4.5 4.5 0 0 1 .9-2.7L5.737 5.1a3.375 3.375 0 0 1 2.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 0 1 .9 2.7m0 0a3 3 0 0 1-3 3m0 3h.008v.008h-.008v-.008Zm0-6h.008v.008h-.008v-.008Zm-3 6h.008v.008h-.008v-.008Zm0-6h.008v.008h-.008v-.008Z" />
          </svg>
          <div>
            <span class="text-white font-semibold text-sm md:text-base block leading-tight">Hosting</span>
            <span class="text-white/50 text-[10px] md:text-xs">4 guides</span>
          </div>
        </div>
      </a>

      <a href="/tools/finance" class="group col-span-1 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:scale-[1.02]">
        <Image src={categoryFinance} alt="" class="absolute inset-0 w-full h-full object-cover opacity-30 group-hover:opacity-40 transition-opacity" />
        <div class="absolute inset-0 bg-gradient-to-br from-black/70 to-black/50"></div>
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-amber-400 to-orange-500 rounded-l-xl"></div>
        <div class="relative z-10 h-full p-3 md:p-4 flex flex-col justify-between">
          <svg class="w-6 h-6 md:w-8 md:h-8 text-amber-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z" />
          </svg>
          <div>
            <span class="text-white font-semibold text-sm md:text-base block leading-tight">Finance</span>
            <span class="text-white/50 text-[10px] md:text-xs">3 guides</span>
          </div>
        </div>
      </a>

      <!-- ROW: 2 small + 1 wide (mobile: 2 small + full width) -->
      <a
        href={shuffled[0]?.href}
        class="group col-span-2 md:col-span-1 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg"
      >
        <img src={shuffled[0]?.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
        <div class="absolute top-2 right-2 md:top-3 md:right-3">
          <span class="inline-block w-fit px-1.5 py-0.5 bg-white text-ocean-deep text-[10px] font-medium rounded">{shuffled[0]?.category}</span>
        </div>
        <div class="absolute inset-0 p-2 md:p-3 flex flex-col justify-end">
          <h3 class="text-[10px] md:text-sm font-semibold text-white group-hover:text-jet-stream transition-colors line-clamp-2 leading-tight">{shuffled[0]?.title}</h3>
        </div>
      </a>

      <a
        href={shuffled[1]?.href}
        class="group col-span-2 md:col-span-1 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg"
      >
        <img src={shuffled[1]?.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
        <div class="absolute top-2 right-2 md:top-3 md:right-3">
          <span class="inline-block w-fit px-1.5 py-0.5 bg-white text-ocean-deep text-[10px] font-medium rounded">{shuffled[1]?.category}</span>
        </div>
        <div class="absolute inset-0 p-2 md:p-3 flex flex-col justify-end">
          <h3 class="text-[10px] md:text-sm font-semibold text-white group-hover:text-jet-stream transition-colors line-clamp-2 leading-tight">{shuffled[1]?.title}</h3>
        </div>
      </a>

      <!-- Wide article - spans 2 on tablet, 4 on desktop -->
      <a
        href={shuffled[2]?.href}
        class="group col-span-4 md:col-span-2 lg:col-span-4 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg"
      >
        <img src={shuffled[2]?.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent"></div>
        <div class="absolute top-2 right-2 md:top-3 md:right-3">
          <span class="inline-block w-fit px-1.5 py-0.5 bg-jet-stream text-white text-[10px] font-medium rounded">{shuffled[2]?.category}</span>
        </div>
        <div class="absolute inset-0 p-3 md:p-4 flex flex-col justify-end">
          <h3 class="text-xs md:text-lg font-semibold text-white group-hover:text-jet-stream transition-colors line-clamp-2">{shuffled[2]?.title}</h3>
          <p class="text-white/60 text-[10px] md:text-xs mt-1 line-clamp-1 hidden md:block">{shuffled[2]?.description}</p>
        </div>
      </a>

      <!-- ROW: 4 small cells (tablet+) -->
      {shuffled.slice(3, 7).map((tool, i) => (
        <a
          href={tool.href}
          class:list={[
            "group col-span-2 md:col-span-1 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg",
            i >= 2 && "hidden md:block"
          ]}
        >
          <img src={tool.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
          <div class="absolute top-2 right-2 md:top-3 md:right-3">
            <span class="inline-block w-fit px-1.5 py-0.5 bg-white text-ocean-deep text-[10px] font-medium rounded">{tool.category}</span>
          </div>
          <div class="absolute inset-0 p-2 md:p-3 flex flex-col justify-end">
            <h3 class="text-[10px] md:text-sm font-semibold text-white group-hover:text-jet-stream transition-colors line-clamp-2 leading-tight">{tool.title}</h3>
          </div>
        </a>
      ))}

      <!-- Desktop only: another wide + small combo -->
      <a
        href={shuffled[7]?.href}
        class="group hidden lg:block col-span-2 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg"
      >
        <img src={shuffled[7]?.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent"></div>
        <div class="absolute top-2 right-2 md:top-3 md:right-3">
          <span class="inline-block w-fit px-1.5 py-0.5 bg-jet-stream text-white text-[10px] font-medium rounded">{shuffled[7]?.category}</span>
        </div>
        <div class="absolute inset-0 p-3 flex flex-col justify-end">
          <h3 class="text-sm font-semibold text-white group-hover:text-jet-stream transition-colors line-clamp-2">{shuffled[7]?.title}</h3>
        </div>
      </a>

      <!-- Desktop only: 2 more small cells -->
      {shuffled.slice(8, 10).map((tool) => (
        <a
          href={tool.href}
          class="group hidden lg:block col-span-1 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg"
        >
          <img src={tool.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
          <div class="absolute top-2 right-2 md:top-3 md:right-3">
            <span class="inline-block w-fit px-1.5 py-0.5 bg-white text-ocean-deep text-[10px] font-medium rounded">{tool.category}</span>
          </div>
          <div class="absolute inset-0 p-2 md:p-3 flex flex-col justify-end">
            <h3 class="text-[10px] md:text-sm font-semibold text-white group-hover:text-jet-stream transition-colors line-clamp-2 leading-tight">{tool.title}</h3>
          </div>
        </a>
      ))}

      <!-- Info cell + CTA cell -->
      <div class="col-span-2 md:col-span-2 lg:col-span-3 row-span-1 bg-black/40 border border-white/10 border-b-jet-stream/50 rounded-xl p-4 md:p-5 flex flex-col justify-center items-center text-center">
        <svg class="w-7 h-7 md:w-8 md:h-8 text-jet-stream mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
        </svg>
        <span class="text-white font-semibold text-sm md:text-base">13+ Reviews</span>
        <span class="text-white/60 text-xs md:text-sm">Updated weekly</span>
      </div>

      <a href="/contact" class="group col-span-2 md:col-span-2 lg:col-span-3 row-span-1 bg-black/40 border border-jet-stream/30 border-b-jet-stream/60 rounded-xl p-4 md:p-5 flex flex-col justify-center items-center text-center transition-all duration-300 hover:border-jet-stream/50 hover:bg-black/50">
        <svg class="w-7 h-7 md:w-8 md:h-8 text-sky-light mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />
        </svg>
        <span class="text-white font-semibold text-sm md:text-base">Suggest a Tool</span>
        <span class="text-jet-stream text-xs md:text-sm flex items-center mt-1">
          Contact us
          <svg class="w-3 h-3 ml-1 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
        </span>
      </a>

    </div>

  </div>
</BaseLayout>
