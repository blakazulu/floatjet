---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Best Remote Work Tools & Software | FloatJet";
const description =
  "Discover the best tools and software for remote workers. In-depth reviews of project management, VPNs, productivity apps, and more.";

// Category filters with gradients
const categories = [
  { name: "All", href: "/tools", gradient: "from-jet-stream to-sky-light" },
  { name: "VPN & Security", href: "/tools/vpn", gradient: "from-violet-500 to-purple-600" },
  { name: "SaaS", href: "/tools/saas", gradient: "from-blue-500 to-cyan-500" },
  { name: "Hosting", href: "/tools/hosting", gradient: "from-emerald-500 to-teal-500" },
  { name: "Finance", href: "/tools/finance", gradient: "from-amber-500 to-orange-500" },
];

// All tools with images and featured flag
const allTools = [
  {
    title: "Best Project Management Software",
    description: "Compare Notion, ClickUp, Asana, Monday.com and more for remote teams.",
    href: "/tools/best-project-management-software",
    category: "SaaS",
    readTime: 14,
    image: "/images/unsplash/photo-1454165804606-c3d57bc86b40-1200w.webp",
    featured: true,
  },
  {
    title: "Best VPN for Digital Nomads",
    description: "Secure your connection while working from anywhere in the world.",
    href: "/tools/best-vpn-digital-nomads",
    category: "VPN",
    readTime: 15,
    image: "/images/unsplash/photo-1526374965328-7f61d4dc18c5-1200w.webp",
    featured: true,
  },
  {
    title: "Best Email Marketing Tools",
    description: "Grow your audience with the right email marketing platform.",
    href: "/tools/best-email-marketing-tools",
    category: "SaaS",
    readTime: 14,
    image: "/images/unsplash/photo-1563986768494-4dee2763ff3f-1200w.webp",
    featured: false,
  },
  {
    title: "Best Password Managers",
    description: "Keep your accounts secure with a reliable password manager.",
    href: "/tools/best-password-manager-remote-work",
    category: "VPN",
    readTime: 14,
    image: "/images/unsplash/photo-1633265486064-086b219458ec-1200w.webp",
    featured: false,
  },
  {
    title: "Best Web Hosting",
    description: "Reliable hosting for your remote business or side project.",
    href: "/tools/best-web-hosting-remote-business",
    category: "Hosting",
    readTime: 15,
    image: "/images/unsplash/photo-1558494949-ef010cbdcc31-1200w.webp",
    featured: true,
  },
  {
    title: "Best Time Tracking Software",
    description: "Track billable hours and boost productivity.",
    href: "/tools/best-time-tracking-software",
    category: "SaaS",
    readTime: 15,
    image: "/images/unsplash/photo-1611532736597-de2d4265fba3-1200w.webp",
    featured: false,
  },
  {
    title: "Best Online Course Platforms",
    description: "Learn new skills or create courses to share your expertise.",
    href: "/tools/best-online-course-platforms",
    category: "SaaS",
    readTime: 16,
    image: "/images/unsplash/photo-1501504905252-473c47e087f8-1200w.webp",
    featured: false,
  },
  {
    title: "Best Productivity Apps",
    description: "Apps to help you focus, organize, and get more done.",
    href: "/tools/best-productivity-apps",
    category: "SaaS",
    readTime: 16,
    image: "/images/unsplash/photo-1484480974693-6ca0a78fb36b-1200w.webp",
    featured: true,
  },
  {
    title: "Best Video Conferencing Tools",
    description: "Compare Zoom, Google Meet, Teams and more for remote meetings.",
    href: "/tools/best-video-conferencing-tools",
    category: "SaaS",
    readTime: 18,
    image: "/images/unsplash/photo-1587825140708-dfaf72ae4b04-1200w.webp",
    featured: false,
  },
  {
    title: "Best Cloud Storage",
    description: "Find the perfect cloud storage solution for your team.",
    href: "/tools/best-cloud-storage-remote-work",
    category: "SaaS",
    readTime: 16,
    image: "/images/unsplash/photo-1544197150-b99a580bb7a8-1200w.webp",
    featured: false,
  },
  {
    title: "Best Note-Taking Apps",
    description: "Compare Notion, Obsidian, Evernote and more.",
    href: "/tools/best-note-taking-apps",
    category: "SaaS",
    readTime: 17,
    image: "/images/unsplash/photo-1517842645767-c639042777db-1200w.webp",
    featured: false,
  },
  {
    title: "Notion vs ClickUp vs Monday",
    description: "Ultimate comparison of top productivity platforms.",
    href: "/tools/notion-vs-clickup-vs-monday",
    category: "SaaS",
    readTime: 14,
    image: "/images/unsplash/photo-1454165804606-c3d57bc86b40-1200w.webp",
    featured: false,
  },
];

// Pick random hero from featured articles
const featuredTools = allTools.filter((t) => t.featured);
const hero = featuredTools[Math.floor(Math.random() * featuredTools.length)];

// Remaining tools shuffled
const remaining = allTools.filter((t) => t.href !== hero.href);
const shuffled = [...remaining].sort(() => Math.random() - 0.5);
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <!-- Compact Header + Filter Bar -->
    <div class="max-w-6xl mx-auto mb-6">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
        <div>
          <h1 class="text-2xl md:text-3xl font-bold text-white">Remote Work Tools</h1>
          <p class="text-white/60 text-sm mt-1">In-depth reviews & comparisons</p>
        </div>
        <!-- Filter Pills -->
        <div class="flex flex-wrap gap-2">
          {categories.map((cat, i) => (
            <a
              href={cat.href}
              class:list={[
                "px-3 py-1.5 rounded-full text-xs font-medium transition-all duration-300",
                i === 0
                  ? `bg-gradient-to-r ${cat.gradient} text-ocean-deep`
                  : "bg-white/5 text-white/70 hover:bg-white/10 hover:text-white border border-white/10"
              ]}
            >
              {cat.name}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Bento Mosaic Grid -->
    <div class="max-w-6xl mx-auto grid grid-cols-4 md:grid-cols-4 lg:grid-cols-6 gap-2 md:gap-3 auto-rows-[100px] md:auto-rows-[140px] lg:auto-rows-[160px]">

      <!-- HERO CELL: Large featured article -->
      <a
        href={hero.href}
        class="group col-span-4 md:col-span-2 lg:col-span-3 row-span-2 md:row-span-2 relative overflow-hidden rounded-2xl transition-all duration-300 hover:shadow-xl hover:shadow-jet-stream/10"
      >
        <img src={hero.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/10"></div>
        <div class="absolute inset-0 p-4 md:p-6 flex flex-col justify-end">
          <span class="inline-block w-fit px-2 py-0.5 md:px-2.5 md:py-1 bg-jet-stream text-ocean-deep text-[10px] md:text-xs font-bold rounded-full mb-2">
            Featured
          </span>
          <h2 class="text-base md:text-2xl font-bold text-white group-hover:text-jet-stream transition-colors mb-1">
            {hero.title}
          </h2>
          <p class="text-white/70 text-sm line-clamp-2 hidden md:block mb-2">{hero.description}</p>
          <div class="flex items-center gap-3 text-[10px] md:text-xs">
            <span class="text-white/50">{hero.readTime} min</span>
            <span class="text-jet-stream font-medium flex items-center">
              Read
              <svg class="w-3 h-3 ml-1 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
            </span>
          </div>
        </div>
      </a>

      <!-- CATEGORY MINI CELLS: All 4 visible on mobile as compact tiles -->
      <a href="/tools/vpn" class="group col-span-1 row-span-1 relative overflow-hidden bg-gradient-to-br from-violet-900/80 to-purple-900/60 border border-violet-500/20 rounded-xl p-3 md:p-4 flex flex-col justify-between transition-all duration-300 hover:scale-[1.03] hover:shadow-lg hover:shadow-violet-500/20 hover:border-violet-400/40">
        <div class="absolute -right-4 -top-4 w-20 h-20 bg-violet-500/10 rounded-full blur-xl group-hover:bg-violet-500/20 transition-all"></div>
        <span class="text-2xl md:text-3xl relative z-10">🔒</span>
        <div class="relative z-10">
          <span class="text-white font-semibold text-sm md:text-base block leading-tight">VPN</span>
          <span class="text-violet-300/70 text-[10px] md:text-xs">5 guides</span>
        </div>
      </a>

      <a href="/tools/saas" class="group col-span-1 row-span-1 relative overflow-hidden bg-gradient-to-br from-blue-900/80 to-cyan-900/60 border border-blue-500/20 rounded-xl p-3 md:p-4 flex flex-col justify-between transition-all duration-300 hover:scale-[1.03] hover:shadow-lg hover:shadow-blue-500/20 hover:border-blue-400/40">
        <div class="absolute -right-4 -top-4 w-20 h-20 bg-blue-500/10 rounded-full blur-xl group-hover:bg-blue-500/20 transition-all"></div>
        <span class="text-2xl md:text-3xl relative z-10">📋</span>
        <div class="relative z-10">
          <span class="text-white font-semibold text-sm md:text-base block leading-tight">SaaS</span>
          <span class="text-blue-300/70 text-[10px] md:text-xs">8 guides</span>
        </div>
      </a>

      <a href="/tools/hosting" class="group col-span-1 row-span-1 relative overflow-hidden bg-gradient-to-br from-emerald-900/80 to-teal-900/60 border border-emerald-500/20 rounded-xl p-3 md:p-4 flex flex-col justify-between transition-all duration-300 hover:scale-[1.03] hover:shadow-lg hover:shadow-emerald-500/20 hover:border-emerald-400/40">
        <div class="absolute -right-4 -top-4 w-20 h-20 bg-emerald-500/10 rounded-full blur-xl group-hover:bg-emerald-500/20 transition-all"></div>
        <span class="text-2xl md:text-3xl relative z-10">🌐</span>
        <div class="relative z-10">
          <span class="text-white font-semibold text-sm md:text-base block leading-tight">Hosting</span>
          <span class="text-emerald-300/70 text-[10px] md:text-xs">4 guides</span>
        </div>
      </a>

      <a href="/tools/finance" class="group col-span-1 row-span-1 relative overflow-hidden bg-gradient-to-br from-amber-900/80 to-orange-900/60 border border-amber-500/20 rounded-xl p-3 md:p-4 flex flex-col justify-between transition-all duration-300 hover:scale-[1.03] hover:shadow-lg hover:shadow-amber-500/20 hover:border-amber-400/40">
        <div class="absolute -right-4 -top-4 w-20 h-20 bg-amber-500/10 rounded-full blur-xl group-hover:bg-amber-500/20 transition-all"></div>
        <span class="text-2xl md:text-3xl relative z-10">💰</span>
        <div class="relative z-10">
          <span class="text-white font-semibold text-sm md:text-base block leading-tight">Finance</span>
          <span class="text-amber-300/70 text-[10px] md:text-xs">3 guides</span>
        </div>
      </a>

      <!-- ROW: 2 small + 1 wide (mobile: 2 small + full width) -->
      <a
        href={shuffled[0]?.href}
        class="group col-span-2 md:col-span-1 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg"
      >
        <img src={shuffled[0]?.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
        <div class="absolute inset-0 p-2 md:p-3 flex flex-col justify-end">
          <span class="text-white/50 text-[8px] md:text-[10px] uppercase tracking-wide mb-0.5">{shuffled[0]?.category}</span>
          <h3 class="text-[10px] md:text-sm font-semibold text-white group-hover:text-jet-stream transition-colors line-clamp-2 leading-tight">{shuffled[0]?.title}</h3>
        </div>
      </a>

      <a
        href={shuffled[1]?.href}
        class="group col-span-2 md:col-span-1 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg"
      >
        <img src={shuffled[1]?.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
        <div class="absolute inset-0 p-2 md:p-3 flex flex-col justify-end">
          <span class="text-white/50 text-[8px] md:text-[10px] uppercase tracking-wide mb-0.5">{shuffled[1]?.category}</span>
          <h3 class="text-[10px] md:text-sm font-semibold text-white group-hover:text-jet-stream transition-colors line-clamp-2 leading-tight">{shuffled[1]?.title}</h3>
        </div>
      </a>

      <!-- Wide article - spans 2 on tablet, 4 on desktop -->
      <a
        href={shuffled[2]?.href}
        class="group col-span-4 md:col-span-2 lg:col-span-4 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg"
      >
        <img src={shuffled[2]?.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
        <div class="absolute inset-0 p-3 md:p-4 flex items-center">
          <div class="max-w-md">
            <span class="text-jet-stream text-[10px] md:text-xs font-medium mb-1 block">{shuffled[2]?.category}</span>
            <h3 class="text-xs md:text-lg font-semibold text-white group-hover:text-jet-stream transition-colors line-clamp-2">{shuffled[2]?.title}</h3>
            <p class="text-white/60 text-[10px] md:text-xs mt-1 line-clamp-1 hidden md:block">{shuffled[2]?.description}</p>
          </div>
        </div>
      </a>

      <!-- ROW: 4 small cells (tablet+) -->
      {shuffled.slice(3, 7).map((tool, i) => (
        <a
          href={tool.href}
          class:list={[
            "group col-span-2 md:col-span-1 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg",
            i >= 2 && "hidden md:block"
          ]}
        >
          <img src={tool.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
          <div class="absolute inset-0 p-2 md:p-3 flex flex-col justify-end">
            <span class="text-white/50 text-[8px] md:text-[10px] uppercase tracking-wide mb-0.5">{tool.category}</span>
            <h3 class="text-[10px] md:text-sm font-semibold text-white group-hover:text-jet-stream transition-colors line-clamp-2 leading-tight">{tool.title}</h3>
          </div>
        </a>
      ))}

      <!-- Desktop only: another wide + small combo -->
      <a
        href={shuffled[7]?.href}
        class="group hidden lg:block col-span-2 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg"
      >
        <img src={shuffled[7]?.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-transparent"></div>
        <div class="absolute inset-0 p-3 flex items-center">
          <div>
            <span class="text-jet-stream text-[10px] font-medium mb-1 block">{shuffled[7]?.category}</span>
            <h3 class="text-sm font-semibold text-white group-hover:text-jet-stream transition-colors line-clamp-2">{shuffled[7]?.title}</h3>
          </div>
        </div>
      </a>

      <!-- Desktop only: 2 more small cells -->
      {shuffled.slice(8, 10).map((tool) => (
        <a
          href={tool.href}
          class="group hidden lg:block col-span-1 row-span-1 relative overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg"
        >
          <img src={tool.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
          <div class="absolute inset-0 p-2 md:p-3 flex flex-col justify-end">
            <span class="text-white/50 text-[8px] md:text-[10px] uppercase tracking-wide mb-0.5">{tool.category}</span>
            <h3 class="text-[10px] md:text-sm font-semibold text-white group-hover:text-jet-stream transition-colors line-clamp-2 leading-tight">{tool.title}</h3>
          </div>
        </a>
      ))}

      <!-- Info cell + CTA cell -->
      <div class="col-span-2 md:col-span-1 row-span-1 bg-white/5 border border-white/10 rounded-xl p-3 md:p-4 flex flex-col justify-center items-center text-center">
        <span class="text-xl md:text-2xl mb-1">🎯</span>
        <span class="text-white/80 text-[10px] md:text-xs font-medium">13+ Reviews</span>
        <span class="text-white/40 text-[8px] md:text-[10px]">Updated weekly</span>
      </div>

      <a href="/contact" class="group col-span-2 md:col-span-1 row-span-1 bg-gradient-to-br from-jet-stream/20 to-sky-light/10 border border-jet-stream/30 rounded-xl p-3 md:p-4 flex flex-col justify-center items-center text-center transition-all duration-300 hover:border-jet-stream/50 hover:bg-jet-stream/30">
        <span class="text-xl md:text-2xl mb-1">💡</span>
        <span class="text-white/90 text-[10px] md:text-xs font-medium">Suggest a Tool</span>
        <span class="text-jet-stream text-[8px] md:text-[10px] flex items-center mt-0.5">
          Contact us
          <svg class="w-2.5 h-2.5 ml-0.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
        </span>
      </a>

    </div>

  </div>
</BaseLayout>
