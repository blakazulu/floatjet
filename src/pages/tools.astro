---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Best Remote Work Tools & Software | FloatJet";
const description =
  "Discover the best tools and software for remote workers. In-depth reviews of project management, VPNs, productivity apps, and more.";

// Category pages
const categories = [
  {
    name: "VPN & Security",
    href: "/tools/vpn",
    icon: "🔒",
    description: "Protect your data & privacy",
  },
  {
    name: "SaaS Tools",
    href: "/tools/saas",
    icon: "📋",
    description: "Project management & productivity",
  },
  {
    name: "Web Hosting",
    href: "/tools/hosting",
    icon: "🌐",
    description: "Reliable hosting solutions",
  },
  { name: "Finance", href: "/tools/finance", icon: "💰", description: "Invoicing & accounting" },
];

// Tool articles data with correct reading times
const allTools = [
  {
    title: "Best Project Management Software",
    description: "Compare Notion, ClickUp, Asana, Monday.com and more for remote teams.",
    href: "/tools/best-project-management-software",
    category: "SaaS",
    icon: "📋",
    readTime: 14,
  },
  {
    title: "Best VPN for Digital Nomads",
    description: "Secure your connection while working from anywhere in the world.",
    href: "/tools/best-vpn-digital-nomads",
    category: "VPN",
    icon: "🔒",
    readTime: 15,
  },
  {
    title: "Best Email Marketing Tools",
    description: "Grow your audience with the right email marketing platform.",
    href: "/tools/best-email-marketing-tools",
    category: "SaaS",
    icon: "📧",
    readTime: 14,
  },
  {
    title: "Best Password Managers",
    description: "Keep your accounts secure with a reliable password manager.",
    href: "/tools/best-password-manager-remote-work",
    category: "VPN",
    icon: "🔐",
    readTime: 14,
  },
  {
    title: "Best Web Hosting",
    description: "Reliable hosting for your remote business or side project.",
    href: "/tools/best-web-hosting-remote-business",
    category: "Hosting",
    icon: "🌐",
    readTime: 15,
  },
  {
    title: "Best Time Tracking Software",
    description: "Track billable hours and boost productivity.",
    href: "/tools/best-time-tracking-software",
    category: "SaaS",
    icon: "⏱️",
    readTime: 15,
  },
  {
    title: "Best Online Course Platforms",
    description: "Learn new skills or create courses to share your expertise.",
    href: "/tools/best-online-course-platforms",
    category: "SaaS",
    icon: "🎓",
    readTime: 16,
  },
  {
    title: "Best Productivity Apps",
    description: "Apps to help you focus, organize, and get more done.",
    href: "/tools/best-productivity-apps",
    category: "SaaS",
    icon: "🚀",
    readTime: 16,
  },
  {
    title: "Best Video Conferencing Tools",
    description: "Compare Zoom, Google Meet, Teams and more for remote meetings.",
    href: "/tools/best-video-conferencing-tools",
    category: "SaaS",
    icon: "📹",
    readTime: 18,
  },
  {
    title: "Best Cloud Storage for Remote Work",
    description: "Find the perfect cloud storage solution for your team and files.",
    href: "/tools/best-cloud-storage-remote-work",
    category: "SaaS",
    icon: "☁️",
    readTime: 16,
  },
  {
    title: "Best Note-Taking Apps",
    description: "Compare Notion, Obsidian, Evernote and more for digital notes.",
    href: "/tools/best-note-taking-apps",
    category: "SaaS",
    icon: "📝",
    readTime: 17,
  },
  {
    title: "Notion vs ClickUp vs Monday",
    description: "Ultimate comparison of the top 3 productivity platforms.",
    href: "/tools/notion-vs-clickup-vs-monday",
    category: "SaaS",
    icon: "⚖️",
    readTime: 14,
  },
  {
    title: "Is Notion Worth It?",
    description: "Honest review: pros, cons, pricing, and who should use Notion.",
    href: "/tools/is-notion-worth-it",
    category: "SaaS",
    icon: "💭",
    readTime: 9,
  },
];

// Shuffle and limit articles - render all 9, CSS handles responsive visibility
const shuffled = [...allTools].sort(() => Math.random() - 0.5);
const displayTools = shuffled.slice(0, 9);
const totalArticles = allTools.length;
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Remote Work Tools</h1>
      <p class="text-lg text-white/80 max-w-2xl mx-auto">
        In-depth reviews and comparisons of the best software and tools for remote workers, freelancers, and digital
        nomads.
      </p>
    </div>

    <!-- Category Links -->
    <div class="grid gap-3 grid-cols-2 sm:grid-cols-4 mb-12 max-w-4xl mx-auto">
      {categories.map(cat => (
          <a
              href={cat.href}
              class="group flex flex-col items-center text-center p-4 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-jet-stream/50 rounded-xl transition-all duration-300"
          >
            <span class="text-2xl mb-2">{cat.icon}</span>
            <span class="text-white font-medium group-hover:text-jet-stream transition-colors">{cat.name}</span>
            <span class="text-white/50 text-xs mt-1 hidden sm:block">{cat.description}</span>
          </a>
      ))}
    </div>

    <!-- Tools Grid - Responsive: 3 mobile, 6 tablet, 9 desktop -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {displayTools.map((tool, index) => (
          <a
              href={tool.href}
              class:list={[
                'group bg-black/40 hover:bg-black/50 border border-white/10 hover:border-white/20 rounded-xl p-6 transition-all duration-300',
                // Mobile: show first 3

                index >= 3 && 'hidden sm:block',
                // Tablet: show first 6

                index >= 6 && 'sm:hidden lg:block'
              ]}
          >
            <div class="flex items-start gap-4">
              <span class="text-3xl">{tool.icon}</span>
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-2">
                <span class="inline-block px-2 py-0.5 bg-jet-stream/20 text-jet-stream text-xs font-medium rounded">
                  {tool.category}
                </span>
                  <span class="text-white/40 text-xs">{tool.readTime} min</span>
                </div>
                <h2 class="text-lg font-semibold text-white group-hover:text-jet-stream transition-colors mb-2">
                  {tool.title}
                </h2>
                <p class="text-white/70 text-sm">
                  {tool.description}
                </p>
              </div>
            </div>
            <div class="mt-4 flex items-center text-jet-stream text-sm font-medium">
              Read Review
              <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
            </div>
          </a>
      ))}
    </div>

    <!-- View All Link -->
    <div class="mt-8 text-center">
      <p class="text-white/60 text-sm">Browse by category above to see all articles</p>
    </div>

    <!-- CTA Section -->
    <div class="mt-12 text-center">
      <a href="/contact" class="inline-flex items-center text-jet-stream hover:text-sky-light transition-colors">
        Suggest a tool for us to review
        <svg class="w-4 h-4 ml-1" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</BaseLayout>
