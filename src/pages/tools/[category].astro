// Category filters with gradients (same as main page)
const categories = [
  { name: "All", href: "/tools", gradient: "from-jet-stream to-sky-light", slug: "" },
  { name: "VPN & Security", href: "/tools/vpn", gradient: "from-violet-500 to-purple-600", slug: "vpn" },
  { name: "SaaS", href: "/tools/saas", gradient: "from-blue-500 to-cyan-500", slug: "saas" },
  { name: "Hosting", href: "/tools/hosting", gradient: "from-emerald-500 to-teal-500", slug: "hosting" },
