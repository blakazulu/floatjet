---
import BaseLayout from "../../layouts/BaseLayout.astro";

// Category configuration with metadata
const categoryConfig: Record<string, {
  name: string;
  title: string;
  subtitle: string;
  description: string;
  filterKey: string;
}> = {
  vpn: {
    name: "VPN & Security",
    title: "VPN & Security Tools",
    subtitle: "Protect your remote work connection",
    description: "Find the best VPN for secure remote work. Compare top VPNs for speed, security, and reliability when working from anywhere.",
    filterKey: "VPN",
  },
  saas: {
    name: "SaaS",
    title: "SaaS Tools",
    subtitle: "Software to power your workflow",
    description: "Discover the best SaaS tools for remote workers. Project management, productivity, collaboration and more.",
    filterKey: "SaaS",
  },
  hosting: {
    name: "Hosting",
    title: "Web Hosting",
    subtitle: "Reliable hosting for remote businesses",
    description: "Compare the best web hosting providers for remote businesses. VPS, cloud, and managed hosting solutions.",
    filterKey: "Hosting",
  },
  finance: {
    name: "Finance",
