const imageAlt = 'Calculator and financial documents representing accounting software';

const headings = [
  {depth: 2, slug: 'why-accounting-software', text: 'Why Freelancers Need Accounting Software'},
  {depth: 2, slug: 'what-to-look-for', text: 'What to Look for in Accounting Software'},
  {depth: 2, slug: 'top-picks', text: 'Top 8 Accounting Software for Freelancers'},
  {depth: 2, slug: 'comparison-table', text: 'Feature Comparison Table'},
  {depth: 2, slug: 'pricing-breakdown', text: 'Pricing Breakdown'},
  {depth: 2, slug: 'tax-features', text: 'Tax Integration Features'},
