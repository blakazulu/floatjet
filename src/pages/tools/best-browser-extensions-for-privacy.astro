import { getArticleBySlug } from "../../data/articles";

// Get article metadata from central data file
const article = getArticleBySlug("best-browser-extensions-for-privacy")!;
const { title, description, authorSlug, readingTime, image, imageAlt } = article;
const pubDate = new Date(article.pubDate);

// Table of contents headings
const headings = [
  { text: "Introduction", slug: "introduction", depth: 2 },
  { text: "Quick Picks", slug: "quick-picks", depth: 2 },
  { text: "Why Extensions Matter on Public WiFi", slug: "why-extensions-matter", depth: 2 },
  { text: "uBlock Origin", slug: "ublock-origin", depth: 2 },
  { text: "Privacy Badger", slug: "privacy-badger", depth: 2 },
  { text: "Password Manager Extensions", slug: "password-managers", depth: 2 },
  { text: "Other Extensions Worth Knowing", slug: "other-extensions", depth: 2 },
  { text: "My Actual Setup", slug: "my-setup", depth: 2 },
  { text: "Browser Choice Matters", slug: "browser-choice", depth: 2 },
  { text: "Setting Everything Up", slug: "setup-guide", depth: 2 },
  { text: "FAQ", slug: "faq", depth: 2 },
