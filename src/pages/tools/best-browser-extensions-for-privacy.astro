// Related articles
const relatedArticles = [
  {
    title: "Best VPNs for Digital Nomads & Remote Workers",
    excerpt:
      "Protect your data on public WiFi with these top-rated VPNs tested across 15 countries.",
    href: "/tools/best-vpn-digital-nomads",
    image: "/images/unsplash/photo-1526374965328-7f61d4dc18c5-800w.webp",
    imageAlt: "Digital security concept with encrypted data visualization",
  },
  {
    title: "Best Password Managers for Remote Workers",
    excerpt:
      "Stop reusing passwords. Compare NordPass, 1Password, Bitwarden and more.",
    href: "/tools/best-password-manager-remote-work",
    image: "/images/unsplash/photo-1633265486064-086b219458ec-800w.webp",
    imageAlt: "Digital security and password protection",
  },
  {
    title: "Two-Factor Authentication Guide for Remote Workers",
    excerpt:
      "Guide to setting up 2FA on all your accounts. Authenticator apps, hardware keys, and best practices.",
    href: "/guides/two-factor-authentication-guide",
