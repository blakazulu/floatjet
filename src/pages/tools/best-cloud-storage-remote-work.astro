// FAQ data with schema markup
const faqs = [
  {
    question: 'What is the best cloud storage for small businesses?',
    answer: '<strong>Google Drive</strong> (via Google Workspace) offers the best value for small businesses at $6/user/month with 30GB storage, plus Gmail, Docs, Sheets, and video calling. <strong>Dropbox Business</strong> is excellent if file syncing and version history are priorities. For Microsoft-centric teams, <strong>OneDrive for Business</strong> ($5-12.50/user/mo) is the obvious choice.'
