// Related articles
const relatedArticles = [
  {
    title: "Best Project Management Software for Remote Teams",
    excerpt:
      "Compare Notion, ClickUp, Asana, and more to find the perfect PM tool for your distributed team.",
    href: "/tools/best-project-management-software",
    image: "/images/unsplash/photo-1454165804606-c3d57bc86b40-800w.webp",
    imageAlt: "Modern workspace with laptop displaying project management dashboard",
  },
  {
    title: "Best VPNs for Digital Nomads & Remote Workers",
    excerpt:
      "Protect your data on public WiFi and access content from anywhere with these top-rated VPNs.",
    href: "/tools/best-vpn-digital-nomads",
    image: "/images/unsplash/photo-1526374965328-7f61d4dc18c5-800w.webp",
    imageAlt: "Digital security concept with encrypted data visualization",
  },
  {
    title: "Best Laptops for Remote Work",
    excerpt: "Find the perfect laptop for working from anywhere with our tested recommendations.",
    href: "/gear/best-laptops-remote-work",
