// FAQ data
const faqs = [
  {
    question: "Best free email marketing tool?",
    answer:
      "<p><strong>ConvertKit</strong> offers the most generous free tier for creators. Up to ten thousand subscribers with landing pages and forms included. <strong>MailerLite</strong> is another excellent free option with one thousand subscribers and full automation capabilities.</p><p>Key difference is that ConvertKit limits some automation features on the free plan while MailerLite includes them. For pure newsletter publishing, <strong>Beehiiv</strong> gives you twenty-five hundred subscribers free with monetization tools built in.</p>",
  },
