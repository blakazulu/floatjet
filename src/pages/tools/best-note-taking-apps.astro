// FAQ data with schema markup
const faqs = [
  {
    question: 'What is the best note-taking app for productivity?',
    answer: '<strong>Notion</strong> is the best all-around note-taking and productivity app, combining notes, tasks, databases, and wikis in one flexible workspace. For knowledge workers who want to connect ideas, <strong>Obsidian</strong> excels with its powerful linking and local-first approach. For simple, fast note capture, <strong>Apple Notes</strong> (iOS/Mac) or <strong>Evernote</strong> (all platforms) are excellent.'
  },
