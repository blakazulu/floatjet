// Related articles
const relatedArticles = [
  {
    title: 'Best Email Marketing Tools for Creators',
    excerpt: 'Build your audience with the best email platforms for course creators and online businesses.',
    href: '/tools/best-email-marketing-tools',
    image: '/images/unsplash/photo-1563986768494-4dee2763ff3f-800w.webp',
    imageAlt: 'Email marketing concept'
  },
  {
    title: 'Best Project Management Software for Remote Teams',
    excerpt: 'Organize your course creation workflow with the right project management tools.',
    href: '/tools/best-project-management-software',
