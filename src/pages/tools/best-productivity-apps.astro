import ArticleLayout from "../../layouts/ArticleLayout.astro";

// Article metadata
const title = "Best Productivity Apps for Remote Workers (2025)";
const description =
  "Compare the top productivity apps for remote work. We tested Notion, Todoist, Obsidian and more to find the best tools for focus and task management daily.";
const authorSlug = "marcus-chen";
const pubDate = new Date("2025-11-23");
const readingTime = 16;
const image = "/images/unsplash/photo-1484480974693-6ca0a78fb36b-1200w.webp";
const imageAlt = "Organized workspace with productivity tools on screen";

// Table of contents headings
const headings = [
  { text: "Introduction", slug: "introduction", depth: 2 },
  { text: "Quick Picks", slug: "quick-picks", depth: 2 },
  { text: "Why Productivity Apps Matter", slug: "why-productivity-apps", depth: 2 },
  { text: "Detailed Reviews", slug: "detailed-reviews", depth: 2 },
  { text: "Notion", slug: "notion", depth: 3 },
  { text: "Todoist", slug: "todoist", depth: 3 },
  { text: "Obsidian", slug: "obsidian", depth: 3 },
