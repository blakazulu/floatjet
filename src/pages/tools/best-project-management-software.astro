// Related articles
const relatedArticles = [
  {
    title: "Best VPNs for Digital Nomads",
    excerpt:
      "Secure your connection on public WiFi with our top-tested VPN recommendations for remote workers.",
    href: "/tools/best-vpn-digital-nomads",
    image: "/images/unsplash/photo-1614064641938-3bbee52942c7-800w.webp",
    imageAlt: "VPN security shield concept",
  },
  {
    title: "Best Team Communication Tools",
    excerpt:
      "Keep your distributed team connected with these top-rated communication and collaboration platforms.",
    href: "/blog/best-team-communication-tools",
