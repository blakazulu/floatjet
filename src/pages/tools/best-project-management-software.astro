    imageAlt: "Remote team on video call",
  },
  {
    title: "Ultimate Home Office Setup Guide",
    excerpt:
      "Create the perfect workspace for maximum productivity with our comprehensive setup guide.",
    href: "/blog/ultimate-home-office-setup",
