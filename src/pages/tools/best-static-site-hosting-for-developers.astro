---
import AffiliateButton from "@components/article/AffiliateButton.astro";
import ComparisonTable from "@components/article/ComparisonTable.astro";
import FAQSection from "@components/article/FAQSection.astro";
import RelatedArticles from "@components/article/RelatedArticles.astro";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { getArticleBySlug } from "../../data/articles";

// Get article metadata from central data file
const article = getArticleBySlug("best-static-site-hosting-for-developers")!;
const { title, description, authorSlug, readingTime, image, imageAlt } = article;
const pubDate = new Date(article.pubDate);

// Table of contents headings
const headings = [
  { text: "Introduction", slug: "introduction", depth: 2 },
  { text: "Quick Picks", slug: "quick-picks", depth: 2 },
  { text: "Why Static Site Hosting Matters", slug: "why-static-hosting", depth: 2 },
  { text: "The Big Three Compared", slug: "big-three-compared", depth: 2 },
  { text: "Netlify", slug: "netlify", depth: 3 },
  { text: "Vercel", slug: "vercel", depth: 3 },
  { text: "Cloudflare Pages", slug: "cloudflare-pages", depth: 3 },
  { text: "Other Options Worth Knowing About", slug: "other-options", depth: 2 },
  { text: "GitHub Pages", slug: "github-pages", depth: 3 },
  { text: "Render", slug: "render", depth: 3 },
  { text: "Surge", slug: "surge", depth: 3 },
  { text: "Build Time Comparison", slug: "build-times", depth: 2 },
  { text: "Pricing Breakdown", slug: "pricing-breakdown", depth: 2 },
  { text: "Framework Support", slug: "framework-support", depth: 2 },
  { text: "Okay Which One Though", slug: "how-to-choose", depth: 2 },
  { text: "FAQ", slug: "faq", depth: 2 },
  { text: "After 50+ Projects", slug: "conclusion", depth: 2 },
];

// Quick picks comparison table
const quickPicksColumns = [
  { key: "provider", label: "Provider", width: "140px" },
  { key: "bestFor", label: "Best For", width: "150px" },
  { key: "price", label: "Free Tier" },
  { key: "rating", label: "Rating" },
];

const quickPicksRows = [
  {
    provider: "<strong>Netlify</strong>",
    bestFor: "Overall experience",
    price: "100GB bandwidth",
    rating: "9.5/10",
  },
  {
    provider: "<strong>Vercel</strong>",
    bestFor: "Next.js projects",
    price: "100GB bandwidth",
    rating: "9.4/10",
  },
  {
    provider: "<strong>Cloudflare Pages</strong>",
    bestFor: "Performance",
    price: "Unlimited bandwidth",
    rating: "9.3/10",
  },
];

// Full comparison table
const fullComparisonColumns = [
  { key: "provider", label: "Provider", width: "120px" },
  { key: "bandwidth", label: "Free Bandwidth" },
  { key: "builds", label: "Build Minutes" },
  { key: "sites", label: "Sites" },
  { key: "edge", label: "Edge Functions" },
  { key: "domains", label: "Custom Domains" },
];

const fullComparisonRows = [
  {
    provider: "<strong>Netlify</strong>",
    bandwidth: "100GB/mo",
    builds: "300 min/mo",
    sites: "Unlimited",
    edge: "Yes",
    domains: "Unlimited",
  },
  {
    provider: "<strong>Vercel</strong>",
    bandwidth: "100GB/mo",
    builds: "6000 min/mo",
    sites: "Unlimited",
    edge: "Yes",
    domains: "Unlimited",
  },
  {
    provider: "<strong>Cloudflare</strong>",
    bandwidth: "Unlimited",
    builds: "500/mo",
    sites: "Unlimited",
    edge: "Yes (Workers)",
    domains: "Unlimited",
  },
  {
    provider: "<strong>GitHub Pages</strong>",
    bandwidth: "100GB/mo",
    builds: "10/hour",
    sites: "1/repo",
    edge: "No",
    domains: "1/site",
  },
  {
    provider: "<strong>Render</strong>",
    bandwidth: "100GB/mo",
    builds: "500/mo",
    sites: "Unlimited",
    edge: "No",
    domains: "Unlimited",
  },
  {
    provider: "<strong>Surge</strong>",
    bandwidth: "Unlimited",
    builds: "Unlimited",
    sites: "Unlimited",
    edge: "No",
    domains: "1 (free)",
  },
];

// FAQ data
const faqItems = [
  {
    question: "Wait what even is static site hosting?",
    answer:
      "Your site gets built once and then it's just files on a CDN. No PHP or Node running on every page view. No database to hack. Loads way faster because there's nothing to compute. Portfolios and doc sites and blogs are perfect for this. Anything that doesn't need real-time data basically.",
  },
  {
    question: "Netlify or Vercel for React stuff?",
    answer:
      "Both work fine honestly. If you're specifically using Next.js then Vercel has an edge since they built it. But for plain React or Gatsby or whatever Netlify handles it just as well. I've got React sites on both and they're basically the same experience. Just pick whichever dashboard you like better.",
  },
  {
    question: "Can I sell stuff on a static site?",
    answer:
      "Kind of? You can build a static frontend with Astro or Next.js and hook it up to Shopify or Snipcart for the commerce bits. Works great for product catalogs and checkout. But if you need real-time inventory tracking or complicated cart rules you'll want serverless functions which both Netlify and Vercel have.",
  },
  {
    question: "What if I go over the free limits?",
    answer:
      "They don't just kill your site. You get warning emails first and usually a grace period to upgrade or cut back. Netlify and Vercel charge by the GB after you hit 100GB. Cloudflare's unlimited thing is actually unlimited. No surprise bills there.",
  },
  {
    question: "Do I need to know DevOps stuff?",
    answer:
      "Nope that's the whole point. Connect your git repo and push code and it builds and deploys. You don't need to SSH into anything or manage servers. Knowing basic CI/CD concepts helps when builds fail but you definitely don't need to be a sysadmin.",
  },
  {
    question: "Who has the best edge functions?",
    answer:
      "Cloudflare Workers are the most powerful because they run on Cloudflare's huge network. Vercel's edge stuff is nice if you're using Next.js middleware. Netlify's edge functions use Deno and work fine but fewer locations globally. For raw performance Cloudflare wins.",
  },
];

// Related articles
const relatedArticles = [
  {
    title: "Best VPS Hosting for Remote Business",
    excerpt: "When you outgrow static hosting, here are your VPS options.",
    href: "/tools/best-vps-hosting-remote-business",
    image: "/images/unsplash/photo-1544197150-b99a580bb7a8-400w.webp",
    imageAlt: "VPS server infrastructure",
  },
  {
    title: "Website Speed Optimization Guide",
    excerpt: "Make your sites load faster with these optimization techniques.",
    href: "/tools/website-speed-optimization-guide",
    image: "/images/unsplash/photo-1586281380349-632531db7ed4-400w.webp",
    imageAlt: "Website performance dashboard",
  },
  {
    title: "Cloud vs Traditional Hosting",
    excerpt: "Understanding the key differences between hosting types.",
    href: "/blog/cloud-vs-traditional-hosting",
    image: "/images/unsplash/photo-1451187580459-43490279c0fa-400w.webp",
    imageAlt: "Cloud computing concept",
  },
];
---

<ArticleLayout
    title={title}
    description={description}
    authorSlug={authorSlug}
    pubDate={pubDate}
    readingTime={readingTime}
    image={image}
    imageAlt={imageAlt}
    headings={headings}
    category="Hosting"
    categorySlug="tools"
    subcategorySlug="hosting"
>
  <!-- Introduction -->
  <section id="introduction">
    <p class="lead">
      First site I pushed to Netlify was back in 2019. Before that I was FTPing files to shared hosting and crossing my fingers. So when I connected my git repo and watched it deploy in 30 seconds I was like... wait that's it? Where's the suffering?
    </p>
    <p>
      Fifty-ish projects later across Netlify, Vercel, and Cloudflare Pages and I've got opinions. Good news is all three are legit good. Bad news is you can waste hours reading comparisons when you should just be shipping. So let me save you some time.
    </p>
    <p>
      <strong>Don't want to read?</strong> Netlify for most projects. Works with everything, good free tier, I like the dashboard. Vercel if you're all-in on Next.js since they made it. Cloudflare Pages if you want unlimited bandwidth and don't mind a rougher experience. For <a href="/tools/best-web-hosting-remote-business">traditional hosting stuff</a> check that guide instead.
    </p>
  </section>

  <!-- Quick Picks -->
  <section id="quick-picks">
    <h2>Quick Picks</h2>
    <ComparisonTable columns={quickPicksColumns} rows={quickPicksRows} highlight={0}/>

    <div class="grid gap-4 sm:grid-cols-3 mt-6">
      <div class="bg-white/5 border border-white/10 rounded-lg p-4">
        <span class="text-jet-stream font-semibold">Best Overall</span>
        <p class="text-white font-bold mt-1">Netlify</p>
        <p class="text-white/60 text-sm mt-2">Works with everything, excellent docs, best form handling</p>
      </div>
      <div class="bg-white/5 border border-white/10 rounded-lg p-4">
        <span class="text-jet-stream font-semibold">Best for Next.js</span>
        <p class="text-white font-bold mt-1">Vercel</p>
        <p class="text-white/60 text-sm mt-2">Made by the Next.js team, optimized specifically for it</p>
      </div>
      <div class="bg-white/5 border border-white/10 rounded-lg p-4">
        <span class="text-jet-stream font-semibold">Best Free Tier</span>
        <p class="text-white font-bold mt-1">Cloudflare Pages</p>
        <p class="text-white/60 text-sm mt-2">Unlimited bandwidth, 500 builds/month, crazy fast CDN</p>
      </div>
    </div>
  </section>

  <!-- Why Static Hosting -->
  <section id="why-static-hosting">
    <h2>Why Static Site Hosting Matters</h2>
    <p>
      This isn't just shared hosting with better marketing. The architecture is completely different. Your site builds once and then it's just files sitting on a CDN. No PHP executing on every page view. No WordPress database waiting to get pwned.
    </p>

    <div class="space-y-4 my-6">
      <div class="bg-white/5 border border-white/10 rounded-lg p-4">
        <h4 class="text-white font-semibold">Speed</h4>
        <p class="text-white/70 text-sm mt-2">Files come from the closest edge location to whoever's loading your site. No waiting for a server to render anything. Sub-100ms TTFB is totally normal. Meanwhile WordPress sites are regularly hitting 500ms or worse.</p>
      </div>
      <div class="bg-white/5 border border-white/10 rounded-lg p-4">
        <h4 class="text-white font-semibold">Security</h4>
        <p class="text-white/70 text-sm mt-2">No database to SQL inject. No PHP to exploit. Your attack surface is basically just... your CDN provider. And they employ actual security teams unlike you or me.</p>
      </div>
      <div class="bg-jet-stream/20 border border-jet-stream/40 rounded-lg p-4">
        <h4 class="text-white font-semibold">Developer Experience</h4>
        <p class="text-white/70 text-sm mt-2">This is the real reason people switch. Push to git and deploys just happen. Preview URLs for every branch automatically. One-click rollbacks when you break something. It's the future we were promised. Compare with <a
              href="/tools/migrate-website-without-downtime">traditional hosting migration pain</a>.</p>
      </div>
      <div class="bg-white/5 border border-white/10 rounded-lg p-4">
        <h4 class="text-white font-semibold">Cost</h4>
        <p class="text-white/70 text-sm mt-2">Free tiers are actually generous not just teasers. Most personal projects and small business sites never pay anything. And if you do scale up the pricing makes sense.</p>
      </div>
    </div>
  </section>

  <!-- Big Three Compared -->
  <section id="big-three-compared">
    <h2>The Big Three Compared</h2>

    <!-- Netlify -->
    <div id="netlify" class="mt-8 bg-white/5 border border-white/10 rounded-xl p-6">
      <div class="flex items-start justify-between flex-wrap gap-4">
        <div>
          <span class="text-xs text-jet-stream bg-jet-stream/20 px-2 py-1 rounded">My Main Pick</span>
          <h3 class="text-2xl font-bold text-white mt-2">Netlify</h3>
        </div>
        <div class="text-right">
          <p class="text-white/60 text-sm">Free tier includes</p>
          <p class="text-2xl font-bold text-jet-stream">100GB/mo</p>
        </div>
      </div>

      <p class="text-white/80 mt-4">
        This is what runs most of my projects. The site you're reading right now? Netlify. Been using it about five years and I can count the problems I've had on one hand. Dashboard actually makes sense which is rarer than you'd think. Build logs tell you what went wrong. Deploy previews just show up for every PR without configuring anything.
      </p>

      <div class="grid gap-4 sm:grid-cols-2 mt-4">
        <div>
          <h4 class="text-white font-semibold text-sm mb-2">What I Like</h4>
          <ul class="text-white/70 text-sm space-y-1">
            <li>+ Form handling built in. No backend needed for contact forms</li>
            <li>+ Split testing for A/B experiments</li>
            <li>+ Identity/auth if you need user accounts</li>
            <li>+ Plugins ecosystem is actually useful</li>
            <li>+ Documentation is excellent</li>
          </ul>
        </div>
        <div>
          <h4 class="text-white font-semibold text-sm mb-2">The Tradeoffs</h4>
          <ul class="text-white/70 text-sm space-y-1">
            <li>- Build minutes cap can bite on large sites</li>
            <li>- Edge functions not as mature as Cloudflare</li>
            <li>- Pricing gets expensive at scale</li>
          </ul>
        </div>
      </div>

      <div class="mt-4 pt-4 border-t border-white/10">
        <AffiliateButton href="/go/netlify" text="Deploy to Netlify" program="netlify"/>
      </div>
    </div>

    <!-- Vercel -->
    <div id="vercel" class="mt-6 bg-white/5 border border-white/10 rounded-xl p-6">
      <div class="flex items-start justify-between flex-wrap gap-4">
        <div>
          <span class="text-xs text-jet-stream bg-jet-stream/20 px-2 py-1 rounded">Best for Next.js</span>
          <h3 class="text-2xl font-bold text-white mt-2">Vercel</h3>
        </div>
        <div class="text-right">
          <p class="text-white/60 text-sm">Free tier includes</p>
          <p class="text-2xl font-bold text-jet-stream">100GB/mo</p>
        </div>
      </div>

      <p class="text-white/80 mt-4">
        Vercel literally made Next.js so unsurprisingly it's optimized for it. ISR and middleware and image optimization all work without any configuration. If you're building with React and Next.js this is probably the obvious choice. The deploy experience is slick too. Might even be smoother than Netlify if I'm being honest.
      </p>

      <div class="grid gap-4 sm:grid-cols-2 mt-4">
        <div>
          <h4 class="text-white font-semibold text-sm mb-2">What I Like</h4>
          <ul class="text-white/70 text-sm space-y-1">
            <li>+ Next.js features just work. No config needed</li>
            <li>+ Image optimization is genuinely good</li>
            <li>+ Analytics built in</li>
            <li>+ Edge middleware is powerful</li>
            <li>+ More build minutes than Netlify free tier</li>
          </ul>
        </div>
        <div>
          <h4 class="text-white font-semibold text-sm mb-2">The Tradeoffs</h4>
          <ul class="text-white/70 text-sm space-y-1">
            <li>- Commercial use on free tier is murky</li>
            <li>- Some Next.js features only work here</li>
            <li>- Lock-in concerns if you go deep</li>
          </ul>
        </div>
      </div>

      <div class="mt-4 pt-4 border-t border-white/10">
        <AffiliateButton href="/go/vercel" text="Deploy to Vercel" program="vercel"/>
      </div>
    </div>

    <!-- Cloudflare Pages -->
    <div id="cloudflare-pages" class="mt-6 bg-white/5 border border-white/10 rounded-xl p-6">
      <div class="flex items-start justify-between flex-wrap gap-4">
        <div>
          <span class="text-xs text-jet-stream bg-jet-stream/20 px-2 py-1 rounded">Best Free Tier</span>
          <h3 class="text-2xl font-bold text-white mt-2">Cloudflare Pages</h3>
        </div>
        <div class="text-right">
          <p class="text-white/60 text-sm">Free tier includes</p>
          <p class="text-2xl font-bold text-jet-stream">Unlimited</p>
        </div>
      </div>

      <p class="text-white/80 mt-4">
        Cloudflare runs like a quarter of the internet's traffic. Pages is their static hosting thing and honestly it's kind of absurd. Unlimited bandwidth on the free tier. Not 100GB. Unlimited. Plus you get access to Workers for edge compute stuff. The catch? It's newer than Netlify and you can tell. Dashboard is rougher. Some framework integrations are still catching up.
      </p>

      <div class="grid gap-4 sm:grid-cols-2 mt-4">
        <div>
          <h4 class="text-white font-semibold text-sm mb-2">What I Like</h4>
          <ul class="text-white/70 text-sm space-y-1">
            <li>+ Unlimited bandwidth. Actually unlimited</li>
            <li>+ Workers are incredibly powerful</li>
            <li>+ Global network is massive. 300+ cities</li>
            <li>+ KV storage for edge data</li>
            <li>+ R2 storage if you need object storage</li>
          </ul>
        </div>
        <div>
          <h4 class="text-white font-semibold text-sm mb-2">The Tradeoffs</h4>
          <ul class="text-white/70 text-sm space-y-1">
            <li>- Dashboard is less polished</li>
            <li>- Build output size limits</li>
            <li>- Framework support not as deep</li>
          </ul>
        </div>
      </div>

      <div class="mt-4 pt-4 border-t border-white/10">
        <AffiliateButton href="/go/cloudflare-pages" text="Deploy to Cloudflare Pages" program="cloudflare-pages"/>
      </div>
    </div>
  </section>

  <!-- Other Options -->
  <section id="other-options">
    <h2>Other Options Worth Knowing About</h2>
    <p>
      Not everything has to be Netlify or Vercel or Cloudflare. These work too depending on what you're building.
    </p>

    <!-- GitHub Pages -->
    <div id="github-pages" class="mt-6 bg-white/5 border border-white/10 rounded-xl p-6">
      <div class="flex items-start justify-between flex-wrap gap-4">
        <div>
          <span class="text-xs text-jet-stream bg-jet-stream/20 px-2 py-1 rounded">Best for Open Source</span>
          <h3 class="text-2xl font-bold text-white mt-2">GitHub Pages</h3>
        </div>
        <div class="text-right">
          <p class="text-white/60 text-sm">Free for</p>
          <p class="text-2xl font-bold text-jet-stream">Public repos</p>
        </div>
      </div>

      <p class="text-white/80 mt-4">
        Project already on GitHub? Open source? Pages is zero friction. Doc sites and project landing pages and personal portfolios. You don't need another account. Push to a branch and it updates. The limits only start mattering when you need serverless functions or fancy build stuff.
      </p>

      <div class="grid gap-4 sm:grid-cols-2 mt-4">
        <div>
          <h4 class="text-white font-semibold text-sm mb-2">What I Like</h4>
          <ul class="text-white/70 text-sm space-y-1">
            <li>+ Zero additional accounts needed</li>
            <li>+ GitHub Actions for builds</li>
            <li>+ Free custom domains with HTTPS</li>
            <li>+ Great for documentation sites</li>
          </ul>
        </div>
        <div>
          <h4 class="text-white font-semibold text-sm mb-2">The Tradeoffs</h4>
          <ul class="text-white/70 text-sm space-y-1">
            <li>- One site per repo</li>
            <li>- No serverless functions</li>
            <li>- Build limits can be tight</li>
          </ul>
        </div>
      </div>

      <div class="mt-4 pt-4 border-t border-white/10">
        <AffiliateButton href="/go/github-pages" text="Try GitHub Pages" program="github-pages"/>
      </div>
    </div>

    <!-- Render -->
    <div id="render" class="mt-6 bg-white/5 border border-white/10 rounded-xl p-6">
      <div class="flex items-start justify-between flex-wrap gap-4">
        <div>
          <span class="text-xs text-jet-stream bg-jet-stream/20 px-2 py-1 rounded">Best Heroku Alternative</span>
          <h3 class="text-2xl font-bold text-white mt-2">Render</h3>
        </div>
        <div class="text-right">
          <p class="text-white/60 text-sm">Static sites</p>
          <p class="text-2xl font-bold text-jet-stream">Free</p>
        </div>
      </div>

      <p class="text-white/80 mt-4">
        Render does static sites but also backends, databases, and background workers. If you need a full stack and want
        one platform for everything, this is a solid pick. The static hosting is genuinely free and works well. Just not
        as feature-rich as the big three for pure static.
      </p>

      <div class="grid gap-4 sm:grid-cols-2 mt-4">
        <div>
          <h4 class="text-white font-semibold text-sm mb-2">What I Like</h4>
          <ul class="text-white/70 text-sm space-y-1">
            <li>+ Full stack on one platform</li>
            <li>+ Free PostgreSQL databases</li>
            <li>+ Background workers available</li>
            <li>+ Straightforward pricing</li>
          </ul>
        </div>
        <div>
          <h4 class="text-white font-semibold text-sm mb-2">The Tradeoffs</h4>
          <ul class="text-white/70 text-sm space-y-1">
            <li>- Static features less mature</li>
            <li>- Fewer edge locations</li>
            <li>- No edge functions</li>
          </ul>
        </div>
      </div>

      <div class="mt-4 pt-4 border-t border-white/10">
        <AffiliateButton href="/go/render" text="Try Render Free" program="render"/>
      </div>
    </div>

    <!-- Surge -->
    <div id="surge" class="mt-6 bg-white/5 border border-white/10 rounded-xl p-6">
      <div class="flex items-start justify-between flex-wrap gap-4">
        <div>
          <span class="text-xs text-jet-stream bg-jet-stream/20 px-2 py-1 rounded">Best for Quick Deploys</span>
          <h3 class="text-2xl font-bold text-white mt-2">Surge</h3>
        </div>
        <div class="text-right">
          <p class="text-white/60 text-sm">Starting at</p>
          <p class="text-2xl font-bold text-jet-stream">Free</p>
        </div>
      </div>

      <p class="text-white/80 mt-4">
        Surge is old school simple static deploys. Type one command in your terminal and boom the site is live. No git setup required. Perfect for quick prototypes or demos or when you need something online in literally 30 seconds. Way fewer features than the others but also way less to learn.
      </p>

      <div class="grid gap-4 sm:grid-cols-2 mt-4">
        <div>
          <h4 class="text-white font-semibold text-sm mb-2">What I Like</h4>
          <ul class="text-white/70 text-sm space-y-1">
            <li>+ Literally one command to deploy</li>
            <li>+ No Git setup required</li>
            <li>+ Unlimited projects</li>
            <li>+ Clean URLs by default</li>
          </ul>
        </div>
        <div>
          <h4 class="text-white font-semibold text-sm mb-2">The Tradeoffs</h4>
          <ul class="text-white/70 text-sm space-y-1">
            <li>- No CI/CD unless you build it yourself</li>
            <li>- One custom domain on free tier</li>
            <li>- Basic compared to others</li>
          </ul>
        </div>
      </div>

      <div class="mt-4 pt-4 border-t border-white/10">
        <AffiliateButton href="/go/surge" text="Try Surge" program="surge"/>
      </div>
    </div>
  </section>

  <!-- Build Times -->
  <section id="build-times">
    <h2>Build Time Comparison</h2>
    <p>
      Ran the same Astro site through each platform to see how they compare. 50 pages with image optimization. Actual numbers from actual deploys not marketing claims.
    </p>

    <div class="bg-white/5 border border-white/10 rounded-lg p-4 my-6">
      <table class="w-full text-sm">
        <thead>
        <tr class="border-b border-white/10">
          <th class="text-left py-2 text-white">Platform</th>
          <th class="text-left py-2 text-white">Cold Build</th>
          <th class="text-left py-2 text-white">Cached Build</th>
          <th class="text-left py-2 text-white">Deploy</th>
        </tr>
        </thead>
        <tbody class="text-white/70">
        <tr class="border-b border-white/5">
          <td class="py-2">Netlify</td>
          <td>1m 42s</td>
          <td>52s</td>
          <td>8s</td>
        </tr>
        <tr class="border-b border-white/5">
          <td class="py-2">Vercel</td>
          <td>1m 28s</td>
          <td>45s</td>
          <td>6s</td>
        </tr>
        <tr class="border-b border-white/5">
          <td class="py-2">Cloudflare</td>
          <td>1m 55s</td>
          <td>1m 12s</td>
          <td>4s</td>
        </tr>
        <tr>
          <td class="py-2">GitHub Pages</td>
          <td>2m 15s</td>
          <td>1m 30s</td>
          <td>15s</td>
        </tr>
        </tbody>
      </table>
      <p class="text-white/50 text-xs mt-2">*Same 50-page Astro site, measured December 2024</p>
    </div>

    <p>
      Vercel edges out slightly on build times. Cloudflare's deploys are fastest since their edge network propagates
      changes almost instantly. Netlify's caching has gotten better. These differences matter more on larger sites.
    </p>
  </section>

  <!-- Pricing Breakdown -->
  <section id="pricing-breakdown">
    <h2>Pricing Breakdown</h2>
    <p>
      Free tiers are generous enough that most personal projects never pay. Here is where it gets real:
    </p>

    <div class="space-y-4 my-6">
      <div class="bg-white/5 border border-white/10 rounded-lg p-4">
        <h4 class="text-white font-semibold">Netlify</h4>
        <p class="text-white/70 text-sm mt-2">Pro starts at $19/month per member. Main upgrade is 400GB bandwidth and
          priority support. Enterprise gets expensive fast. Overage charges after bandwidth cap.</p>
      </div>
      <div class="bg-white/5 border border-white/10 rounded-lg p-4">
        <h4 class="text-white font-semibold">Vercel</h4>
        <p class="text-white/70 text-sm mt-2">Pro is $20/month per member. More generous function limits and better
          analytics. Team features unlock at this tier. Watch for hobby vs commercial usage rules.</p>
      </div>
      <div class="bg-jet-stream/20 border border-jet-stream/40 rounded-lg p-4">
        <h4 class="text-white font-semibold">Cloudflare Pages</h4>
        <p class="text-white/70 text-sm mt-2">Paid plans mainly for Workers usage limits. Pages itself stays generous. $5/month
          gets you way more builds. Best value if bandwidth is your main concern.</p>
      </div>
    </div>

    <p>
      Honestly, for sites under 100GB bandwidth monthly, you probably never pay. That covers a lot of traffic. I have
      sites with 10k monthly visitors comfortably on free tiers.
    </p>
  </section>

  <!-- Framework Support -->
  <section id="framework-support">
    <h2>Framework Support</h2>
    <p>
      All three support most modern frameworks out of the box. But there are differences in how well:
    </p>

    <div class="bg-white/5 border border-white/10 rounded-lg p-4 my-6">
      <table class="w-full text-sm">
        <thead>
        <tr class="border-b border-white/10">
          <th class="text-left py-2 text-white">Framework</th>
          <th class="text-left py-2 text-white">Netlify</th>
          <th class="text-left py-2 text-white">Vercel</th>
          <th class="text-left py-2 text-white">Cloudflare</th>
        </tr>
        </thead>
        <tbody class="text-white/70">
        <tr class="border-b border-white/5">
          <td class="py-2">Next.js</td>
          <td>Good</td>
          <td>Excellent</td>
          <td>Good</td>
        </tr>
        <tr class="border-b border-white/5">
          <td class="py-2">Astro</td>
          <td>Excellent</td>
          <td>Excellent</td>
          <td>Excellent</td>
        </tr>
        <tr class="border-b border-white/5">
          <td class="py-2">Gatsby</td>
          <td>Excellent</td>
          <td>Good</td>
          <td>Good</td>
        </tr>
        <tr class="border-b border-white/5">
          <td class="py-2">SvelteKit</td>
          <td>Good</td>
          <td>Excellent</td>
          <td>Good</td>
        </tr>
        <tr class="border-b border-white/5">
          <td class="py-2">Hugo</td>
          <td>Excellent</td>
          <td>Good</td>
          <td>Excellent</td>
        </tr>
        <tr>
          <td class="py-2">11ty</td>
          <td>Excellent</td>
          <td>Good</td>
          <td>Good</td>
        </tr>
        </tbody>
      </table>
    </div>

    <p>
      Vercel obviously wins for Next.js since they made it. Netlify is the most consistent across all the different frameworks. Cloudflare is catching up but some of their framework adapters are still maintained by random community members which makes me nervous.
    </p>
  </section>

  <!-- How to Choose -->
  <section id="how-to-choose">
    <h2>Okay Which One Though</h2>
    <p>
      Here's how I think about it:
    </p>

    <div class="space-y-4 my-6">
      <div class="bg-white/5 border border-white/10 rounded-lg p-4">
        <h4 class="text-white font-semibold">Netlify makes sense when...</h4>
        <p class="text-white/70 text-sm mt-2">You want the most polished experience and you're not tied to a specific framework. Agencies and freelancers love it because you can deploy like 50 different projects without learning 50 different platforms. Built-in forms are clutch too.</p>
      </div>
      <div class="bg-white/5 border border-white/10 rounded-lg p-4">
        <h4 class="text-white font-semibold">Vercel makes sense when...</h4>
        <p class="text-white/70 text-sm mt-2">You're building with Next.js. Period. The integration is just too good to ignore. ISR and image optimization and edge middleware all work without touching config files. Watch the commercial use thing on free tier though.</p>
      </div>
      <div class="bg-white/5 border border-white/10 rounded-lg p-4">
        <h4 class="text-white font-semibold">Cloudflare Pages makes sense when...</h4>
        <p class="text-white/70 text-sm mt-2">Bandwidth is a concern or you want Workers for edge logic. Unlimited bandwidth on free is absurd. Also makes sense if you're already using Cloudflare for DNS or their CDN stuff.</p>
      </div>
      <div class="bg-white/5 border border-white/10 rounded-lg p-4">
        <h4 class="text-white font-semibold">GitHub Pages makes sense when...</h4>
        <p class="text-white/70 text-sm mt-2">Open source project that just needs to be online with zero extra accounts or setup. Documentation sites are perfect for this. Dead simple.</p>
      </div>
    </div>
  </section>

  <!-- Full Comparison Table -->
  <section id="full-comparison">
    <h2>Full Comparison Table</h2>
    <ComparisonTable columns={fullComparisonColumns} rows={fullComparisonRows}/>
  </section>

  <!-- FAQ Section -->
  <section id="faq">
    <h2>Frequently Asked Questions</h2>
    <FAQSection faqs={faqItems}/>
  </section>

  <!-- Conclusion -->
  <section id="conclusion">
    <h2>After 50+ Projects</h2>
    <p>
      Five years of deploying stuff. Fifty-ish projects across these platforms. <strong>Netlify</strong> is still what I reach for first. Works with everything, dashboard doesn't annoy me, and the built-in form handling has saved me from spinning up backends more times than I can count.
    </p>
    <p>
      <strong>Vercel</strong> when the project is Next.js. Their integration is just too smooth to pass up. ISR works, image optimization works, edge middleware works. All without config files.
    </p>
    <p>
      <strong>Cloudflare Pages</strong> when bandwidth matters or I want to mess with Workers. That unlimited free tier is hard to argue with even if the experience is a bit rougher.
    </p>
    <p>
      Real talk though? You can't really screw this up. All three are miles ahead of what hosting used to be. Pick one and start shipping. You can always switch later. It's not like picking a database where migration is a nightmare.</p>

    <div class="bg-gradient-to-r from-ocean-deep/40 to-jet-stream/20 border border-jet-stream/30 rounded-xl p-6 mt-6">
      <p class="text-white font-semibold">My Top Pick: Netlify</p>
      <p class="text-white/70 text-sm mt-2">Best overall static hosting experience for developers. Works with any
        framework, excellent documentation, and a generous free tier.</p>
      <div class="mt-4">
        <AffiliateButton href="/go/netlify" text="Start Deploying Free" program="netlify"/>
      </div>
    </div>
  </section>

  <!-- Related Articles -->
  <Fragment slot="full-width">
    <RelatedArticles articles={relatedArticles}/>
  </Fragment>
</ArticleLayout>
