// FAQ data
const faqs = [
  {
    question: "What is the best free time tracking app for freelancers?",
    answer:
      "<p><strong>Clockify</strong> is the best free time tracking app, offering unlimited tracking, unlimited users, and unlimited projects at no cost. The free tier includes most features you need: timer, manual entry, reports, and integrations.</p><p><strong>Toggl Track</strong> also offers a solid free tier for up to 5 users with core tracking features. For solo freelancers, either works well. Clockify's free tier is more generous for growing teams.</p>",
