    bestFor: 'Developers',
    price: '$4/mo',
    rating: '9.5/10'
  },
  {
    provider: '<strong>Vultr</strong>',
    bestFor: 'Performance/price',
    price: '$2.50/mo',
    rating: '9.4/10'
  },
  {
    provider: '<strong>Cloudways</strong>',
    bestFor: 'Managed VPS',
    price: '$14/mo',
    rating: '9.3/10'
  },
];

// Full comparison table
const fullComparisonColumns = [
  {key: 'provider', label: 'Provider', width: '120px'},
  {key: 'price', label: 'Starting At'},
  {key: 'ram', label: 'Min RAM'},
  {key: 'storage', label: 'Min Storage'},
  {key: 'bandwidth', label: 'Bandwidth'},
  {key: 'locations', label: 'Data Centers'},
];

const fullComparisonRows = [
  {
    provider: '<strong>DigitalOcean</strong>',
    price: '$4/mo',
    ram: '512MB',
    storage: '10GB SSD',
    bandwidth: '500GB',
    locations: '15'
  },
  {
    provider: '<strong>Vultr</strong>',
    price: '$2.50/mo',
    ram: '512MB',
    storage: '10GB SSD',
    bandwidth: '500GB',
    locations: '32'
  },
  {
    provider: '<strong>Linode</strong>',
    price: '$5/mo',
    ram: '1GB',
    storage: '25GB SSD',
    bandwidth: '1TB',
    locations: '11'
  },
  {
    provider: '<strong>AWS Lightsail</strong>',
    price: '$3.50/mo',
    ram: '512MB',
    storage: '20GB SSD',
    bandwidth: '1TB',
    locations: '18'
  },
  {
    provider: '<strong>Hostinger</strong>',
    price: '$3.99/mo',
    ram: '1GB',
    storage: '20GB SSD',
    bandwidth: '1TB',
    locations: '8'
  },
  {
    provider: '<strong>A2 Hosting</strong>',
    price: '$7.99/mo',
    ram: '1GB',
    storage: '150GB SSD',
    bandwidth: '2TB',
    locations: '4'
  },
  {
    provider: '<strong>Cloudways</strong>',
    price: '$14/mo',
    ram: '1GB',
    storage: '25GB SSD',
