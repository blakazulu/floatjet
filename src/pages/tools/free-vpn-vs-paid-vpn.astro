// Related articles
const relatedArticles = [
  {
    title: 'Best VPNs for Digital Nomads',
    excerpt: 'Our tested recommendations for VPNs that actually work for remote workers.',
    href: '/tools/best-vpn-digital-nomads',
    image: '/images/unsplash/photo-1526374965328-7f61d4dc18c5-800w.webp',
    imageAlt: 'Digital security concept'
  },
  {
    title: 'Do I Need a VPN When Working from Cafes?',
    excerpt: 'Understanding when you actually need VPN protection for remote work.',
    href: '/guides/do-i-need-vpn-cafes',
    image: '/images/unsplash/photo-1521017432531-fbd92d768814-800w.webp',
    imageAlt: 'Person working on laptop in cafe'
  },
  {
    title: 'VPN & Public WiFi Security Guide',
    excerpt: 'Complete guide to staying secure on public networks.',
    href: '/blog/vpn-public-wifi-guide',
    image: '/images/unsplash/photo-1563986768494-4dee2763ff3f-800w.webp',
    imageAlt: 'Digital security concept'
