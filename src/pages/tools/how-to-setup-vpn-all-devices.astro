---
import AffiliateButton from "@components/article/AffiliateButton.astro";
import FAQSection from "@components/article/FAQSection.astro";
import RelatedArticles from "@components/article/RelatedArticles.astro";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { getArticleBySlug } from "../../data/articles";

// Get article metadata from central data file
const article = getArticleBySlug("how-to-setup-vpn-all-devices", "tools")!;
const { title, description, authorSlug, readingTime, image, imageAlt } = article;
const pubDate = new Date(article.pubDate);

// Table of contents headings
const headings = [
  { text: "It's Easier Than You Think", slug: "introduction", depth: 2 },
  { text: "Windows", slug: "windows-setup", depth: 2 },
  { text: "Mac", slug: "mac-setup", depth: 2 },
  { text: "iPhone/iPad", slug: "ios-setup", depth: 2 },
  { text: "Android", slug: "android-setup", depth: 2 },
  { text: "Linux", slug: "linux-setup", depth: 2 },
  { text: "Router", slug: "router-setup", depth: 2 },
  { text: "Browser Extensions", slug: "browser-extensions", depth: 2 },
  { text: "Smart TVs & Streaming", slug: "smart-tv-setup", depth: 2 },
  { text: "Troubleshooting", slug: "troubleshooting", depth: 2 },
  { text: "Questions", slug: "faq", depth: 2 },
];

// FAQ data
const faqs = [
  {
    question: "Set up on every device?",
    answer:
      "<p>Yes. Most VPNs allow 5-10 devices. Surfshark and PIA do unlimited. Or set up on router to cover everything at once.</p>",
  },
  {
    question: "Which protocol?",
    answer: "<p>WireGuard. Fastest and secure. OpenVPN as backup if WireGuard has issues.</p>",
  },
  {
    question: "Auto-connect?",
    answer: "<p>Yes. Turn it on. You'll forget to connect manually otherwise.</p>",
  },
  {
    question: "Split tunneling?",
    answer:
      "<p>Route work through VPN, personal stuff through regular connection. Useful if banking apps hate VPNs.</p>",
  },
  {
    question: "How to test it's working?",
    answer: "<p>whatismyipaddress. Com. Should show VPN location, not yours.</p>",
  },
  {
    question: "Why is it slow?",
    answer:
      "<p>Connect closer. Try different server. Use WireGuard. 10-20% slowdown is normal.</p>",
  },
  {
    question: "Work laptop?",
    answer: "<p>Check with IT first. Company devices may have restrictions.</p>",
  },
  {
    question: "Devices without apps?",
    answer: "<p>Router VPN, Smart DNS, or share connection from a device that has VPN.</p>",
  },
];

// Related articles
const relatedArticles = [
  {
    title: "Best VPNs for Digital Nomads",
    excerpt: "Our tested recommendations for the best VPN services for remote workers.",
    href: "/tools/best-vpn-digital-nomads",
    image: "/images/unsplash/photo-1526374965328-7f61d4dc18c5-800w.webp",
    imageAlt: "Digital security concept",
  },
  {
    title: "Best VPN for Streaming While Traveling",
    excerpt: "Unblock Netflix, Disney+, and more with these streaming-optimized VPNs.",
    href: "/tools/best-vpn-streaming-travel",
    image: "/images/unsplash/photo-1522199755839-a2bacb67c546-800w.webp",
    imageAlt: "Person streaming content on laptop",
  },
  {
    title: "VPN & Public WiFi Security Guide",
    excerpt: "Essential security practices for working on public networks.",
    href: "/blog/vpn-public-wifi-guide",
    image: "/images/unsplash/photo-1563986768494-4dee2763ff3f-800w.webp",
    imageAlt: "Digital security concept",
  },
];
---

<ArticleLayout
    title={title}
    description={description}
    authorSlug={authorSlug}
    pubDate={pubDate}
    readingTime={readingTime}
    image={image}
    imageAlt={imageAlt}
    category="VPN"
    categorySlug="tools"
    subcategorySlug="vpn"
    headings={headings}
>
  <!-- Introduction -->
  <h2 id="introduction">It's Easier Than You Think</h2>
  <p>
    VPN setup used to be technical. Like, actually technical. Command lines, config files, the whole deal.
  </p>
  <p>
    Not anymore. Modern VPN apps are basically "download, install, click connect." My mom asked me to put one on her iPad last month.
    Took maybe four minutes including showing her how to use it.
  </p>
  <p>
    That said, there are settings that actually matter. Default configs work, but a few tweaks make the difference
    between "VPN that protects you" and "VPN that protects you AND doesn't annoy you daily."
  </p>
  <p>
    Here's setup for every major platform. Windows, Mac, iPhone, Android, Linux, routers, smart TVs. Pick your device,
    follow along.
  </p>
  <p>
    <strong>Quick note:</strong> You need a VPN subscription first. If you haven't picked one, check our <a
      href="/tools/best-vpn-digital-nomads">VPN comparison guide</a>. I use <a
      href="/go/nordvpn" target="_blank">NordVPN</a>. Works everywhere, doesn't slow me down.
  </p>

  <!-- Windows Setup -->
  <h2 id="windows-setup">Windows</h2>
  <p>
    Most common platform. Here's the quick version:
  </p>

  <h3>Download</h3>
  <ol>
    <li>Go to your VPN's website</li>
    <li>Log in, find Downloads</li>
    <li>Download Windows app</li>
    <li>Run the installer</li>
  </ol>

  <h3>Install</h3>
  <p>
    The wizard handles everything. Default settings are fine. Log in when it opens.
  </p>

  <h3>The Settings That Matter</h3>
  <p>
    Open settings (gear icon) and turn these on:
  </p>
  <ul>
    <li><strong>Kill switch</strong> . cuts internet if VPN drops. Non-negotiable.</li>
    <li><strong>Auto-connect</strong> . starts VPN when Windows boots or you join <a href="/blog/vpn-public-wifi-guide">WiFi</a>
    </li>
    <li><strong>Protocol</strong> . set to WireGuard (or NordLynx/Lightway depending on your VPN). Fastest option.</li>
    <li><strong>Start on login</strong> . so you don't forget</li>
  </ul>

  <h3>Connect</h3>
  <p>
    Click Quick Connect. Done. Check whatismyipaddress.com if you're paranoid. Should show the VPN location, not yours.
  </p>

  <!-- Mac Setup -->
  <h2 id="mac-setup">Mac</h2>
  <p>
    Similar to Windows with some macOS quirks.
  </p>

  <h3>Download</h3>
  <p>
    Get the app from your VPN's site or the Mac App Store. Drag to Applications.
  </p>

  <h3>Permissions</h3>
  <p>
    macOS will ask to add VPN configurations. Click Allow. Enter your password. Some VPNs need System Extension enabled
    in Security settings. The app will tell you.
  </p>

  <h3>Settings</h3>
  <p>
    Same as Windows: kill switch on, auto-connect on, WireGuard protocol. Set it to launch at login in System
    Preferences.
  </p>

  <h3>Connect</h3>
  <p>
    Quick Connect button. VPN icon shows in menu bar when active.
  </p>

  <!-- iOS Setup -->
  <h2 id="ios-setup">iPhone/iPad</h2>
  <p>
    iOS makes this dead simple.
  </p>

  <h3>Get the App</h3>
  <p>
    App Store. Search your VPN. Download.
  </p>

  <h3>Setup</h3>
  <p>
    Open app, log in. iOS asks to add VPN config. Tap Allow, authenticate with Face ID or passcode.
  </p>

  <h3>Settings</h3>
  <ul>
    <li><strong>Auto-connect on WiFi</strong> . must have</li>
    <li><strong>Kill switch</strong> . iOS calls it "On Demand"</li>
    <li><strong>Protocol</strong> . IKEv2 or WireGuard both work well</li>
  </ul>

  <h3>Connect</h3>
  <p>
    Tap Quick Connect. "VPN" appears in your status bar.
  </p>

  <h3>iOS Tip</h3>
  <p>
    Add VPN toggle to Control Center. Way faster than opening the app every time. Also, iOS kills background apps
    aggressively. Auto-connect helps when your VPN gets disconnected.
  </p>

  <!-- Android Setup -->
  <h2 id="android-setup">Android</h2>
  <p>
    Android gives you more control than iOS. Also more ways to mess things up.
  </p>

  <h3>Get the App</h3>
  <p>
    Play Store. Search. Install.
  </p>

  <h3>Setup</h3>
  <p>
    Open app, log in. Tap OK when Android asks about VPN connection. Grant notification permissions.
  </p>

  <h3>Settings</h3>
  <ul>
    <li><strong>Always-on VPN</strong> . Android Settings &gt; Network &gt; VPN. System-level protection.</li>
    <li><strong>Block connections without VPN</strong> . prevents any traffic if VPN drops</li>
    <li><strong>Split tunneling</strong> . exclude banking apps that hate VPNs</li>
    <li><strong>Protocol</strong> . WireGuard</li>
  </ul>

  <h3>Connect</h3>
  <p>
    Quick Connect.key icon in status bar means you're protected.
  </p>

  <h3>Android Bonus</h3>
  <p>
    Some VPNs (<a href="/tools/free-vpn-vs-paid-vpn">Surfshark</a>) can spoof your GPS to match VPN location. Useful for
    apps that check location. Add widget to
    home screen for one-tap connection.
  </p>

  <!-- Linux Setup -->
  <h2 id="linux-setup">Linux</h2>
  <p>
    Varies by distro, but most VPNs have native apps now.
  </p>

  <h3>Native App (Easiest)</h3>
  <p>
    For NordVPN on Ubuntu/Debian:
  </p>
  <pre><code>sh &lt;(curl -sSf https://downloads.nordcdn.com/apps/linux/install.sh)
nordvpn login
nordvpn connect
nordvpn set autoconnect on</code></pre>
  <p>
    Done. Four commands.
  </p>

  <h3>OpenVPN Method</h3>
  <p>
    If no native app:
  </p>
  <pre><code>sudo apt install openvpn</code></pre>
  <p>
    Download . Ovpn files from your VPN. Connect with:
  </p>
  <pre><code>sudo openvpn --config /path/to/server. Ovpn</code></pre>

  <h3>WireGuard</h3>
  <pre><code>sudo apt install wireguard</code></pre>
  <p>
    Get config from VPN dashboard. Import with wg-quick.
  </p>

  <h3>GUI?</h3>
  <p>
    NetworkManager handles VPN configs. GNOME and KDE both support it through system settings.
  </p>

  <!-- Router Setup -->
  <h2 id="router-setup">Router</h2>
  <p>
    Set up VPN on your router = every device protected automatically. Even stuff that can't run VPN apps. Smart TVs, game
    consoles, that random IoT thing.
  </p>

  <h3>Why Bother</h3>
  <ul>
    <li>One setup, all devices covered</li>
    <li>Protects devices without native VPN support</li>
    <li>Counts as single device connection</li>
    <li>Always-on protection</li>
  </ul>

  <h3>The Catch</h3>
  <ul>
    <li>Setup is more complex</li>
    <li>Can't switch servers per device easily</li>
    <li>All traffic routes through VPN (can be slow)</li>
    <li>Not all routers support it</li>
  </ul>

  <h3>Routers That Work</h3>
  <ul>
    <li><strong>ASUS</strong> (many models have built-in VPN)</li>
    <li><strong>Netgear Nighthawk</strong> (higher-end)</li>
    <li><strong>GL. INet travel routers</strong> (excellent VPN support)</li>
    <li>Any router running DD-WRT, Tomato, or OpenWrt</li>
  </ul>

  <h3>Basic Steps</h3>
  <ol>
    <li>Log into router admin (usually 192.168.1.1)</li>
    <li>Find VPN settings</li>
    <li>Upload OpenVPN config from your VPN provider</li>
    <li>Enter credentials</li>
    <li>Enable</li>
  </ol>
  <p>
    Make sure your <a href="/guides/secure-home-wifi-network">router security settings</a> are properly configured
    before adding VPN.
  </p>
  <p>
    Every router is different. Check your VPN's help docs for specific instructions.
  </p>

  <!-- Browser Extensions -->
  <h2 id="browser-extensions">Browser Extensions</h2>
  <p>
    Quick and dirty protection for browser traffic only.
  </p>

  <h3>Use When</h3>
  <ul>
    <li>Need quick protection for one session</li>
    <li>Unblocking geo-restricted sites</li>
    <li>Can't install full app (shared computer, Chromebook)</li>
  </ul>

  <h3>Limitation</h3>
  <p>
    Only browser traffic. Email clients, Slack, everything else stays unprotected. Not a replacement for the real app.
  </p>

  <h3>Setup</h3>
  <p>
    Chrome Web Store or Firefox Add-ons. Search your VPN. Install. Log in. Click to connect.
  </p>
  <p>
    Most major VPNs have Chrome and Firefox extensions. Safari support is limited. Use the Mac app instead.
  </p>

  <!-- Smart TV & Streaming -->
  <h2 id="smart-tv-setup">Smart TVs and Streaming</h2>
  <p>
    <a href="/tools/best-vpn-streaming-travel">Streaming devices</a> have weird VPN support. Here's the breakdown:
  </p>

  <h3>Fire TV/Fire Stick</h3>
  <p>
    Runs Android, supports VPN apps. Go to Fire TV App Store, download your VPN, log in, connect. Easy.
  </p>

  <h3>Android TV</h3>
  <p>
    Same as Fire TV. Play Store on your TV.
  </p>

  <h3>Apple TV</h3>
  <p>
    No VPN app support. Options:
  </p>
  <ul>
    <li><strong>Router VPN</strong> (protects everything)</li>
    <li><strong>Smart DNS</strong> (configure in network settings)</li>
    <li><strong>Share Mac's VPN connection</strong></li>
  </ul>

  <h3>Roku</h3>
  <p>
    No VPN support at all. Router VPN or Smart DNS only.
  </p>

  <h3>PlayStation/Xbox</h3>
  <p>
    Same deal. No native support. Router VPN, share PC connection, or Smart DNS for streaming (no security though).
  </p>

  <!-- Troubleshooting -->
  <h2 id="troubleshooting">Troubleshooting</h2>

  <h3>Won't Connect</h3>
  <ul>
    <li>Try different server</li>
    <li>Switch protocols (OpenVPN ↔ WireGuard)</li>
    <li>Check regular internet works</li>
    <li>Disable firewall temporarily</li>
    <li>Reinstall app</li>
  </ul>

  <h3>Slow Speeds</h3>
  <ul>
    <li>Connect to closer server</li>
    <li>Try less busy server</li>
    <li>Use WireGuard protocol</li>
    <li>Test speed without VPN to see baseline</li>
  </ul>

  <h3>Sites Blocking You</h3>
  <ul>
    <li>Try different servers</li>
    <li>Use split tunneling to exclude problem sites</li>
    <li>Clear cookies (old location data conflicts)</li>
  </ul>

  <h3>Keeps Disconnecting</h3>
  <ul>
    <li>Enable kill switch</li>
    <li>Check WiFi stability</li>
    <li>Update app</li>
    <li>Contact support if nothing works</li>
  </ul>

  <!-- FAQ Section -->
  <FAQSection faqs={faqs}/>

  <h2>Get It Done</h2>
  <p>
    Five minutes per device. Turn on kill switch, auto-connect, WireGuard. Forget about it.
  </p>
  <p>
    I use NordVPN. Works on everything, setup is painless. 30-day money-back if it doesn't work for you.
  </p>
  <p>
    Just pick something and do it. Next time you're on <a href="/guides/do-i-need-vpn-cafes">airport WiFi
    unprotected</a>, you'll think about this.
  </p>

  <AffiliateButton
      href="/go/nordvpn"
      text="Get NordVPN . Easy Setup on All Devices"
      variant="primary"
      program="nordvpn"
  />

  <!-- Related Articles -->
  <Fragment slot="full-width">
    <RelatedArticles articles={relatedArticles}/>
  </Fragment>
</ArticleLayout>
