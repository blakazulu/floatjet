---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Best SaaS Tools for Remote Workers | FloatJet';
const description = 'Discover the best SaaS tools for remote work. Compare project management, email marketing, time tracking, and productivity software.';

const mainArticle = {
  title: 'Best Project Management Software (2025)',
  description: 'We tested 15+ project management tools to find the best options for remote teams. Compare Notion, ClickUp, Monday, Asana, and more.',
  href: '/tools/best-project-management-software',
  readTime: '18 min'
};

const saasTools = [
  {
    title: 'Best Email Marketing Tools',
    description: 'Build your audience with the right email platform. Compare ConvertKit, Mailchimp, and more.',
    href: '/tools/best-email-marketing-tools',
    icon: '📧',
    category: 'SaaS',
    readTime: 14
  },
  {
    title: 'Best Time Tracking Software',
    description: 'Track billable hours and boost productivity with these time tracking apps.',
    href: '/tools/best-time-tracking-software',
    icon: '⏱️',
    category: 'SaaS',
    readTime: 15
  },
  {
    title: 'Best Productivity Apps',
    description: 'The essential apps every remote worker needs to stay organized and focused.',
    href: '/tools/best-productivity-apps',
    icon: '🚀',
    category: 'SaaS',
    readTime: 16
  },
  {
    title: 'Best Online Course Platforms',
    description: 'Create and sell courses online. Compare Teachable, Thinkific, Kajabi, and more.',
    href: '/tools/best-online-course-platforms',
    icon: '🎓',
    category: 'SaaS',
    readTime: 16
  }
];

const whySaas = [
  {title: 'Work From Anywhere', description: 'Access your tools from any device, any location', icon: '🌍'},
  {title: 'Always Up-to-Date', description: 'Automatic updates mean you always have the latest features', icon: '✨'},
  {title: 'Team Collaboration', description: 'Built-in sharing and collaboration features', icon: '👥'},
  {title: 'Scalable Pricing', description: 'Pay only for what you need, upgrade as you grow', icon: '📈'}
];
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <!-- Header -->
    <div class="text-center mb-12">
      <a href="/tools" class="inline-flex items-center text-white/60 hover:text-white text-sm mb-4 transition-colors">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        All Tools
      </a>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">SaaS Tools</h1>
      <p class="text-lg text-white/80 max-w-2xl mx-auto">
        Cloud-based software to run your remote business. No installations, always accessible.
      </p>
    </div>

    <!-- Main Article Card -->
    <a
        href={mainArticle.href}
        class="block max-w-3xl mx-auto mb-16 group bg-gradient-to-r from-ocean-deep/40 to-jet-stream/20 border border-white/20 hover:border-jet-stream/50 rounded-xl p-8 transition-all duration-300"
    >
      <div class="flex items-center gap-2 mb-4">
        <span class="text-4xl">📋</span>
        <span class="px-3 py-1 bg-jet-stream text-ocean-deep text-xs font-bold rounded-full">Featured Guide</span>
      </div>
      <h2 class="text-2xl md:text-3xl font-bold text-white group-hover:text-jet-stream transition-colors mb-3">
        {mainArticle.title}
      </h2>
      <p class="text-white/70 mb-4">
        {mainArticle.description}
      </p>
      <div class="flex items-center justify-between">
        <span class="text-white/50 text-sm">{mainArticle.readTime} read</span>
        <span class="text-jet-stream font-medium flex items-center">
          Read Full Guide
          <svg class="w-5 h-5 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor"
               viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </span>
      </div>
    </a>

    <!-- More SaaS Tools -->
    <div class="max-w-4xl mx-auto mb-16">
      <h2 class="text-xl font-semibold text-white text-center mb-8">More SaaS Reviews</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {saasTools.map(tool => (
            <a
                href={tool.href}
                class="group bg-black/40 hover:bg-black/50 border border-white/10 hover:border-white/20 rounded-xl p-5 transition-all duration-300"
            >
              <div class="flex items-start gap-4">
                <span class="text-3xl">{tool.icon}</span>
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="inline-block px-2 py-0.5 bg-jet-stream/20 text-jet-stream text-xs font-medium rounded">
                      {tool.category}
                    </span>
                    <span class="text-white/40 text-xs">{tool.readTime} min</span>
                  </div>
                  <h3 class="text-white font-semibold group-hover:text-jet-stream transition-colors mb-1">
                    {tool.title}
                  </h3>
                  <p class="text-white/60 text-sm">{tool.description}</p>
                </div>
              </div>
              <div class="mt-4 flex items-center text-jet-stream text-sm font-medium">
                Read Review
                <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </div>
            </a>
        ))}
      </div>
    </div>

    <!-- Why SaaS -->
    <div class="max-w-4xl mx-auto">
      <h2 class="text-xl font-semibold text-white text-center mb-8">Why Remote Workers Choose SaaS</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {whySaas.map(item => (
            <div class="flex items-start gap-4 bg-white/5 border border-white/10 rounded-xl p-5">
              <span class="text-2xl">{item.icon}</span>
              <div>
                <h3 class="text-white font-semibold mb-1">{item.title}</h3>
                <p class="text-white/60 text-sm">{item.description}</p>
              </div>
            </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-12 text-center">
      <a
          href={mainArticle.href}
          class="inline-flex items-center justify-center px-6 py-3 bg-jet-stream text-ocean-deep font-semibold rounded-lg hover:bg-sky-light transition-colors"
      >
        Start with Project Management
      </a>
    </div>
  </div>
</BaseLayout>
