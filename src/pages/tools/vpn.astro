---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Best VPNs for Remote Workers & Digital Nomads | FloatJet";
const description =
  "Find the best VPN for secure remote work. Compare top VPNs for speed, security, and reliability when working from anywhere without sacrificing performance.";

const mainArticle = {
  title: "Best VPN for Digital Nomads (2025)",
  description:
    "We tested 10+ VPNs across 20 countries to find the best options for remote workers. Compare NordVPN, ExpressVPN, Surfshark, and more.",
  href: "/tools/best-vpn-digital-nomads",
  readTime: "15 min",
};

const whyVpn = [
  {
    title: "Secure Public WiFi",
    description: "Encrypt your connection on coffee shop and hotel networks",
    icon: "☕",
  },
  {
    title: "Access Work Tools",
    description: "Bypass geo-restrictions to access company resources",
    icon: "🔓",
  },
  {
    title: "Protect Sensitive Data",
    description: "Keep client data and communications private",
    icon: "🛡️",
  },
  {
    title: "Avoid Throttling",
    description: "Prevent ISPs from slowing your connection",
    icon: "⚡",
  },
];

const vpnArticles = [
  {
    title: "Best VPN for Streaming While Traveling",
    description:
      "Unblock Netflix, Disney+, and more while abroad. Find the best VPN for streaming overseas.",
    href: "/tools/best-vpn-streaming-travel",
    icon: "📺",
    category: "VPN",
    readTime: 14,
  },
  {
    title: "Best Business VPN for Remote Teams",
    description:
      "Enterprise-grade VPN solutions for distributed teams. Compare NordLayer, Perimeter 81, and more.",
    href: "/tools/best-business-vpn-remote-teams",
    icon: "🏢",
    category: "VPN",
    readTime: 16,
  },
  {
    title: "Free VPN vs Paid VPN",
    description:
      "Should you use a free VPN? Learn the hidden costs and security risks of free VPN services.",
    href: "/tools/free-vpn-vs-paid-vpn",
    icon: "💰",
    category: "VPN",
    readTime: 12,
  },
  {
    title: "How to Set Up VPN on All Devices",
    description: "Step-by-step setup guides for Windows, Mac, iPhone, Android, routers, and more.",
    href: "/tools/how-to-setup-vpn-all-devices",
    icon: "⚙️",
    category: "VPN",
    readTime: 11,
  },
  {
    title: "VPN Kill Switch Explained",
    description:
      "What is a kill switch and why do remote workers need it? Essential security feature explained.",
    href: "/tools/vpn-kill-switch-explained",
    icon: "🔌",
    category: "VPN",
    readTime: 7,
  },
];

const relatedTools = [
  {
    title: "Best Password Managers",
    description: "Secure your accounts with enterprise-grade password management for remote teams.",
    href: "/tools/best-password-manager-remote-work",
    icon: "🔐",
    category: "Security",
    readTime: 14,
  },
];

const topPicks = [
  { name: "NordVPN", tag: "Best Overall", color: "bg-blue-500/20 text-blue-400" },
  { name: "ExpressVPN", tag: "Fastest", color: "bg-green-500/20 text-green-400" },
  { name: "Surfshark", tag: "Best Value", color: "bg-purple-500/20 text-purple-400" },
];
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 pt-24 md:pt-28 pb-16 md:pb-20">
    <!-- Header -->
    <div class="text-center mb-12">
      <a href="/tools" class="inline-flex items-center text-white/60 hover:text-white text-sm mb-4 transition-colors">
        <svg class="w-4 h-4 mr-1" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg>
        All Tools
      </a>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">VPN Tools</h1>
      <p class="text-lg text-white/80 max-w-2xl mx-auto">
        Protect your privacy and secure your connection while working remotely.
      </p>
    </div>

    <!-- Main Article Card -->
    <a
        href={mainArticle. Href}
        class="block max-w-3xl mx-auto mb-12 group bg-gradient-to-r from-ocean-deep/40 to-jet-stream/20 border border-white/20 hover:border-jet-stream/50 rounded-xl p-8 transition-all duration-300"
    >
      <div class="flex items-center gap-2 mb-4">
        <span class="text-4xl">🔒</span>
        <span class="px-3 py-1 bg-jet-stream text-ocean-deep text-xs font-bold rounded-full">Featured Guide</span>
      </div>
      <h2 class="text-2xl md:text-3xl font-bold text-white group-hover:text-jet-stream transition-colors mb-3">
        {mainArticle. Title}
      </h2>
      <p class="text-white/70 mb-4">
        {mainArticle. Description}
      </p>
      <div class="flex items-center justify-between">
        <span class="text-white/50 text-sm">{mainArticle. ReadTime} read</span>
        <span class="text-jet-stream font-medium flex items-center">
          Read Full Guide
          <svg class="w-5 h-5 ml-1 group-hover:translate-x-1 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
        </span>
      </div>
    </a>

    <!-- Top Picks Preview -->
    <div class="max-w-3xl mx-auto mb-12">
      <h2 class="text-xl font-semibold text-white text-center mb-6">Our Top Picks</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {topPicks. Map(pick => (
            <a
                href={`${mainArticle. Href}#${pick. Name. ToLowerCase(). Replace(' ', '-')}`}
                class="bg-white/5 hover:bg-white/10 border border-white/10 rounded-lg p-4 text-center transition-colors"
            >
            <span class={`inline-block px-2 py-0.5 ${pick. Color} text-xs font-medium rounded mb-2`}>
              {pick. Tag}
            </span>
              <p class="text-white font-semibold">{pick. Name}</p>
            </a>
        ))}
      </div>
    </div>

    <!-- VPN Guides & Articles -->
    <div class="mb-12">
      <h2 class="text-xl font-semibold text-white text-center mb-8">VPN Guides & Reviews</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {vpnArticles. Map(article => (
            <a
                href={article. Href}
                class="group bg-black/40 hover:bg-black/50 border border-white/10 hover:border-white/20 rounded-xl p-6 transition-all duration-300"
            >
              <div class="flex items-start gap-4">
                <span class="text-3xl flex-shrink-0">{article. Icon}</span>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="inline-block px-2 py-0.5 bg-jet-stream/20 text-jet-stream text-xs font-medium rounded">
                      {article. Category}
                    </span>
                    <span class="text-white/40 text-xs">{article. ReadTime} min</span>
                  </div>
                  <h2 class="text-lg font-semibold text-white group-hover:text-jet-stream transition-colors mb-2">
                    {article. Title}
                  </h2>
                  <p class="text-white/70 text-sm">{article. Description}</p>
                </div>
              </div>
              <div class="mt-4 flex items-center text-jet-stream text-sm font-medium">
                Read Guide
                <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
              </div>
            </a>
        ))}
      </div>
    </div>

    <!-- Related Security Tools -->
    <div class="mb-12">
      <h2 class="text-xl font-semibold text-white text-center mb-8">Related Security Tools</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {relatedTools. Map(tool => (
            <a
                href={tool. Href}
                class="group bg-black/40 hover:bg-black/50 border border-white/10 hover:border-white/20 rounded-xl p-6 transition-all duration-300"
            >
              <div class="flex items-start gap-4">
                <span class="text-3xl flex-shrink-0">{tool. Icon}</span>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="inline-block px-2 py-0.5 bg-jet-stream/20 text-jet-stream text-xs font-medium rounded">
                      {tool. Category}
                    </span>
                    <span class="text-white/40 text-xs">{tool. ReadTime} min</span>
                  </div>
                  <h2 class="text-lg font-semibold text-white group-hover:text-jet-stream transition-colors mb-2">
                    {tool. Title}
                  </h2>
                  <p class="text-white/70 text-sm">{tool. Description}</p>
                </div>
              </div>
              <div class="mt-4 flex items-center text-jet-stream text-sm font-medium">
                Read Review
                <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
              </div>
            </a>
        ))}
      </div>
    </div>

    <!-- Why Use a VPN -->
    <div class="max-w-4xl mx-auto mb-12">
      <h2 class="text-xl font-semibold text-white text-center mb-8">Why Remote Workers Need a VPN</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {whyVpn. Map(item => (
            <div class="flex items-start gap-4 bg-white/5 border border-white/10 rounded-xl p-5">
              <span class="text-2xl">{item. Icon}</span>
              <div>
                <h3 class="text-white font-semibold mb-1">{item. Title}</h3>
                <p class="text-white/60 text-sm">{item. Description}</p>
              </div>
            </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-12 text-center">
      <a
          href={mainArticle. Href}
          class="inline-flex items-center justify-center px-6 py-3 bg-jet-stream text-ocean-deep font-semibold rounded-lg hover:bg-sky-light transition-colors"
      >
        View Full VPN Comparison
      </a>
    </div>
  </div>
</BaseLayout>
